---
import { Icon } from "astro-icon/components";
import LandingLayout from "@/layouts/LandingLayout.astro";
---

<LandingLayout>
  <nav
    class="border-border bg-background/80 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl"
  >
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
      <a href="/" class="flex shrink-0 items-center gap-2.5">
        <img
          src="/kitchcalc_logo.svg"
          alt="KitchCalc"
          class="h-9 w-9 rounded-xl"
        />
        <span class="text-foreground text-lg font-black">KitchCalc</span>
      </a>
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={18} class="block dark:hidden" />
        <Icon name="lucide:moon" size={18} class="hidden dark:block" />
      </button>
    </div>
  </nav>
  <div class="flex min-h-[80vh] items-center justify-center px-4 pt-20">
    <div
      class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 shadow-lg"
    >
      <div class="mb-8 text-center">
        <div
          class="bg-accent-50 mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl"
        >
          <Icon name="lucide:chef-hat" size={28} class="text-accent-600" />
        </div>
        <h1 class="text-foreground text-2xl font-black">Crear cuenta</h1>
        <p class="text-muted-foreground mt-1 text-sm">
          Regístrate para empezar a costear
        </p>
        <p class="text-muted-foreground mt-1 text-xs">
          No verificamos email. Usa tu correo y contraseña o Google.
        </p>
      </div>

      <div
        id="sign-up-error"
        class="border-danger-border bg-danger-bg text-danger mb-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
      >
      </div>

      <form id="sign-up-form" class="space-y-4">
        <div>
          <label
            for="email"
            class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
          >
            Email
          </label>
          <input
            id="email"
            type="email"
            required
            class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
            placeholder="tu@email.com"
            autocomplete="email"
          />
        </div>
        <div>
          <label
            for="password"
            class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
          >
            Contraseña
          </label>
          <div class="relative">
            <input
              id="password"
              type="password"
              required
              minlength={6}
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 pr-11 text-sm transition outline-none focus:ring-2"
              placeholder="Mínimo 6 caracteres"
              autocomplete="new-password"
            />
            <button
              type="button"
              data-password-toggle="#password"
              class="text-muted-foreground hover:text-foreground hover:bg-hover-muted absolute top-1/2 right-2 inline-flex min-h-8 min-w-8 -translate-y-1/2 items-center justify-center rounded-lg transition-colors"
              aria-label="Mostrar contraseña"
            >
              <svg
                data-eye-open
                class="h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"
                ></path><circle cx="12" cy="12" r="3"></circle></svg
              >
              <svg
                data-eye-closed
                class="hidden h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path
                  d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"
                ></path><path
                  d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"
                ></path><line x1="2" x2="22" y1="2" y2="22"></line></svg
              >
            </button>
          </div>
        </div>
        <div>
          <label
            for="confirm-password"
            class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
          >
            Confirmar contraseña
          </label>
          <div class="relative">
            <input
              id="confirm-password"
              type="password"
              required
              minlength={6}
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 pr-11 text-sm transition outline-none focus:ring-2"
              placeholder="Repite tu contraseña"
              autocomplete="new-password"
            />
            <button
              type="button"
              data-password-toggle="#confirm-password"
              class="text-muted-foreground hover:text-foreground hover:bg-hover-muted absolute top-1/2 right-2 inline-flex min-h-8 min-w-8 -translate-y-1/2 items-center justify-center rounded-lg transition-colors"
              aria-label="Mostrar contraseña"
            >
              <svg
                data-eye-open
                class="h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"
                ></path><circle cx="12" cy="12" r="3"></circle></svg
              >
              <svg
                data-eye-closed
                class="hidden h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path
                  d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"
                ></path><path
                  d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"
                ></path><line x1="2" x2="22" y1="2" y2="22"></line></svg
              >
            </button>
          </div>
        </div>
        <button
          type="submit"
          id="sign-up-submit"
          class="bg-accent-600 hover:bg-accent-700 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-bold text-white transition-colors"
        >
          Crear cuenta
        </button>
      </form>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="border-border w-full border-t"></div>
        </div>
        <div class="relative flex justify-center text-xs uppercase">
          <span class="bg-card text-muted-foreground px-3">o</span>
        </div>
      </div>

      <button
        type="button"
        id="google-sign-up-btn"
        class="border-border bg-card text-muted-foreground hover:bg-background inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border px-5 py-3 text-sm font-bold transition-colors"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24">
          <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
            fill="#4285F4"></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            fill="#FBBC05"></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            fill="#EA4335"></path>
        </svg>
        <span data-google-label>Continuar con Google</span>
      </button>

      <p class="text-muted-foreground mt-6 text-center text-sm">
        ¿Ya tienes cuenta?
        <a
          href="/sign-in"
          class="text-accent-600 hover:text-accent-700 font-bold"
          >Inicia sesión</a
        >
      </p>
    </div>
  </div>
</LandingLayout>

<script>
  import { signUpWithEmail, signInWithGoogle } from "@/lib/sign-in";

  function setupSignUp() {
    const form = document.getElementById("sign-up-form");
    const emailInput = document.getElementById("email");
    const passwordInput = document.getElementById("password");
    const confirmPasswordInput = document.getElementById("confirm-password");
    const errorEl = document.getElementById("sign-up-error");
    const submitBtn = document.getElementById(
      "sign-up-submit",
    ) as HTMLButtonElement | null;
    const googleBtn = document.getElementById("google-sign-up-btn");

    function showError(msg: string) {
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.classList.remove("hidden");
      }
    }

    function hideError() {
      if (errorEl) errorEl.classList.add("hidden");
    }

    if (
      form &&
      emailInput &&
      passwordInput &&
      confirmPasswordInput &&
      submitBtn
    ) {
      if (form.dataset.bound === "1") return;
      form.dataset.bound = "1";

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        hideError();

        const email = (emailInput as HTMLInputElement).value.trim();
        const password = (passwordInput as HTMLInputElement).value;
        const confirmPassword = (confirmPasswordInput as HTMLInputElement)
          .value;

        if (password.length < 6) {
          showError("La contraseña debe tener al menos 6 caracteres.");
          return;
        }

        if (password !== confirmPassword) {
          showError("Las contraseñas no coinciden.");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Creando cuenta...";
        if (googleBtn) (googleBtn as HTMLButtonElement).disabled = true;

        const overlay = document.createElement("div");
        overlay.style.cssText =
          "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(2px)";
        overlay.innerHTML = `<style>@keyframes sp{to{rotate:360deg}}</style><div style="background:var(--color-card,#fff);border-radius:1rem;padding:2rem 2.5rem;display:flex;flex-direction:column;align-items:center;gap:0.75rem;box-shadow:0 20px 60px rgba(0,0,0,0.15)">
          <svg style="animation:sp 0.7s linear infinite;width:28px;height:28px;color:var(--color-accent-600,#4f46e5)" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <span style="font-size:0.875rem;font-weight:600;color:var(--color-foreground,#0f172a)">Creando cuenta\u2026</span>
          </div>`;
        document.body.appendChild(overlay);

        try {
          await signUpWithEmail(email, password);
          window.location.href = "/recipes";
        } catch (err: any) {
          overlay.remove();
          showError(err?.message || "Error al crear la cuenta.");
          submitBtn.disabled = false;
          submitBtn.textContent = "Crear cuenta";
          if (googleBtn) (googleBtn as HTMLButtonElement).disabled = false;
        }
      });
    }

    if (googleBtn) {
      if (googleBtn.dataset.bound === "1") return;
      googleBtn.dataset.bound = "1";

      googleBtn.addEventListener("click", async () => {
        const btn = googleBtn as HTMLButtonElement;
        btn.disabled = true;
        btn.classList.add("opacity-60", "pointer-events-none");
        const label = btn.querySelector("[data-google-label]");
        if (label) label.textContent = "Redirigiendo...";
        if (submitBtn) submitBtn.disabled = true;

        const overlay = document.createElement("div");
        overlay.style.cssText =
          "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(2px)";
        overlay.innerHTML = `<style>@keyframes sp{to{rotate:360deg}}</style><div style="background:var(--color-card,#fff);border-radius:1rem;padding:2rem 2.5rem;display:flex;flex-direction:column;align-items:center;gap:0.75rem;box-shadow:0 20px 60px rgba(0,0,0,0.15)">
          <svg style="animation:sp 0.7s linear infinite;width:28px;height:28px;color:var(--color-accent-600,#4f46e5)" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <span style="font-size:0.875rem;font-weight:600;color:var(--color-foreground,#0f172a)">Creando cuenta\u2026</span>
          </div>`;
        document.body.appendChild(overlay);

        try {
          await signInWithGoogle();
        } catch (err: any) {
          overlay.remove();
          btn.disabled = false;
          btn.classList.remove("opacity-60", "pointer-events-none");
          if (label) label.textContent = "Continuar con Google";
          if (submitBtn) submitBtn.disabled = false;
          showError(err?.message || "Error al iniciar sesión con Google.");
        }
      });
    }
  }

  document.addEventListener("astro:page-load", setupSignUp);
  document.addEventListener("astro:after-swap", setupSignUp);
  setupSignUp();

  document.querySelectorAll("[data-password-toggle]").forEach((btn) => {
    if (!(btn instanceof HTMLButtonElement)) return;
    if (btn.dataset.pwBound === "1") return;
    btn.dataset.pwBound = "1";
    btn.addEventListener("click", () => {
      const input = document.querySelector(btn.dataset.passwordToggle!);
      if (!(input instanceof HTMLInputElement)) return;
      const isPassword = input.type === "password";
      input.type = isPassword ? "text" : "password";
      btn
        .querySelector("[data-eye-open]")
        ?.classList.toggle("hidden", isPassword);
      btn
        .querySelector("[data-eye-closed]")
        ?.classList.toggle("hidden", !isPassword);
    });
  });
</script>
