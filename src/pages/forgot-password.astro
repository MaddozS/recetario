---
import { Icon } from "astro-icon/components";
import { Button } from "@/components/ui";
import LandingLayout from "@/layouts/LandingLayout.astro";
---

<LandingLayout>
  <nav
    class="border-border bg-background/80 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl"
  >
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
      <a href="/" class="flex shrink-0 items-center gap-2.5">
        <img src="/kitchcalc_logo.svg" alt="KitchCalc" class="h-9 w-9 rounded-xl" />
        <span class="text-foreground text-lg font-black">KitchCalc</span>
      </a>
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={18} class="block dark:hidden" />
        <Icon name="lucide:moon" size={18} class="hidden dark:block" />
      </button>
    </div>
  </nav>
  <div class="flex min-h-[80vh] items-center justify-center px-4 pt-20">
    <div
      class="bg-card shadow-accent-tint relative w-full max-w-sm rounded-2xl p-10 pt-12 shadow-lg"
    >
      <div
        aria-hidden="true"
        class="bg-accent-500 absolute top-0 right-8 left-8 h-1 rounded-full"
      ></div>
      <div class="mb-8 text-center">
        <div
          class="bg-accent-50 mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl"
        >
          <Icon name="lucide:key-round" size={28} class="text-accent-600" />
        </div>
        <h1 class="text-foreground text-2xl font-black">Restablecer contraseña</h1>
        <p class="text-muted-foreground mt-1 text-sm">
          Ingresa tu email y te enviaremos un enlace
        </p>
      </div>

      <div
        id="forgot-feedback"
        class="mb-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
      >
      </div>

      <form id="forgot-form" class="space-y-4">
        <div>
          <label
            for="email"
            class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
          >
            Email
          </label>
          <input
            id="email"
            type="email"
            required
            class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
            placeholder="tu@email.com"
            autocomplete="email"
          />
        </div>
        <Button variant="primary" type="submit" class="w-full" id="forgot-submit">
          Enviar enlace
        </Button>
      </form>

      <p class="text-muted-foreground mt-6 text-center text-sm">
        <Button variant="secondary" href="/sign-in" size="sm">Volver al inicio de sesión</Button>
      </p>
    </div>
  </div>
</LandingLayout>

<script>
  function setupForgotPassword() {
    const form = document.getElementById("forgot-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("forgot-submit") as HTMLButtonElement | null;
    const feedbackEl = document.getElementById("forgot-feedback");

    if (!form || !submitBtn || !feedbackEl) return;
    if (form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (document.getElementById("email") as HTMLInputElement).value.trim();

      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";

      try {
        const { authClient } = await import("@/lib/auth-client");
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        await (authClient as any).forgetPassword({
          email,
          redirectTo: `${window.location.origin}/reset-password`,
        });
        feedbackEl.classList.remove("hidden", "border-danger-border", "bg-danger-bg", "text-danger");
        feedbackEl.classList.add("border-success-border", "bg-success-bg", "text-success");
        feedbackEl.textContent = "Si el email existe, recibirás un enlace para restablecer tu contraseña.";
        form.reset();
      } catch {
        feedbackEl.classList.remove("hidden", "border-danger-border", "bg-danger-bg", "text-danger");
        feedbackEl.classList.add("border-success-border", "bg-success-bg", "text-success");
        feedbackEl.textContent = "Si el email existe, recibirás un enlace para restablecer tu contraseña.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar enlace";
      }
    });
  }

  document.addEventListener("astro:page-load", setupForgotPassword);
  document.addEventListener("astro:after-swap", setupForgotPassword);
  setupForgotPassword();
</script>
