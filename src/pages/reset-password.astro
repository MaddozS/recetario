---
import { Icon } from "astro-icon/components";
import { Button, PasswordInput } from "@/components/ui";
import LandingLayout from "@/layouts/LandingLayout.astro";

const tokenParam = Astro.url.searchParams.get("token") ?? "";
const pathToken = Astro.url.pathname.match(/\/reset-password\/([^/?]+)/)?.[1] ?? "";
const token = tokenParam || pathToken;
const email = Astro.url.searchParams.get("email") ?? "";
---

<LandingLayout>
  <nav
    class="border-border bg-background/80 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl"
  >
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
      <a href="/" class="flex shrink-0 items-center gap-2.5">
        <img
          src="/kitchcalc_logo.svg"
          alt="KitchCalc"
          class="h-9 w-9 rounded-xl"
        />
        <span class="text-foreground text-lg font-black">KitchCalc</span>
      </a>
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={18} class="block dark:hidden" />
        <Icon name="lucide:moon" size={18} class="hidden dark:block" />
      </button>
    </div>
  </nav>
  <div class="flex min-h-dvh items-center justify-center px-4 py-20">
    <div
      class="bg-card shadow-accent-tint relative w-full max-w-sm rounded-2xl p-10 pt-12 shadow-lg"
    >
      <div
        aria-hidden="true"
        class="bg-accent-500 absolute top-0 right-8 left-8 h-1 rounded-full"
      >
      </div>
      <div class="mb-8 text-center">
        <div
          class="bg-accent-50 mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl"
        >
          <Icon name="lucide:lock" size={28} class="text-accent-600" />
        </div>
        <h1 class="text-foreground text-2xl font-black">Nueva contraseña</h1>
        <p class="text-muted-foreground mt-1 text-sm">
          Elige una nueva contraseña para tu cuenta
        </p>
      </div>

      <div
        id="reset-feedback"
        class="mb-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
      >
      </div>

      {
        !token ? (
          <div class="border-danger-border bg-danger-bg text-danger rounded-xl border px-4 py-3 text-center text-sm font-semibold">
            Enlace inválido o expirado.
            <div class="mt-3">
              <Button variant="secondary" href="/forgot-password" size="sm">
                Solicitar nuevo enlace
              </Button>
            </div>
          </div>
        ) : (
          <div id="token-status" class="mb-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold" />
          <div id="timer-display" class="mb-4 text-center">
            <div class="inline-flex items-center gap-2 rounded-lg bg-warning-bg px-4 py-2">
              <Icon name="lucide:clock" size={16} class="text-warning" />
              <span id="timer-value" class="font-mono text-lg font-bold text-warning" />
            </div>
          </div>
          <form id="reset-form" class="space-y-4">
            <input type="hidden" id="reset-token" value={token} />
            <input type="hidden" id="reset-email" value={email} />
            <div id="password-field">
              <PasswordInput
                id="password"
                label="Nueva contraseña"
                placeholder="Mínimo 8 caracteres"
                autocomplete="new-password"
                required
              />
              <div id="password-rules" class="mt-2 space-y-1">
                <div id="rule-min" class="flex items-center gap-2 text-xs text-muted-foreground">
                  <span class="rule-icon">○</span> Al menos 8 caracteres
                </div>
                <div id="rule-upper" class="flex items-center gap-2 text-xs text-muted-foreground">
                  <span class="rule-icon">○</span> Una letra mayúscula
                </div>
                <div id="rule-lower" class="flex items-center gap-2 text-xs text-muted-foreground">
                  <span class="rule-icon">○</span> Una letra minúscula
                </div>
                <div id="rule-digit" class="flex items-center gap-2 text-xs text-muted-foreground">
                  <span class="rule-icon">○</span> Un número
                </div>
                <div id="rule-special" class="flex items-center gap-2 text-xs text-muted-foreground">
                  <span class="rule-icon">○</span> Un carácter especial
                </div>
              </div>
            </div>
            <div id="confirm-field">
              <PasswordInput
                id="confirmPassword"
                label="Confirmar contraseña"
                placeholder="Repite tu contraseña"
                autocomplete="new-password"
                required
              />
            </div>
            <Button
              variant="primary"
              type="submit"
              class="w-full"
              id="reset-submit"
            >
              Restablecer contraseña
            </Button>
          </form>
        )
      }

      <div id="success-view" class="hidden text-center">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-success-bg">
          <Icon name="lucide:check" size={28} class="text-success" />
        </div>
        <h2 class="text-foreground text-xl font-bold">Contraseña actualizada</h2>
        <p class="text-muted-foreground mt-2 text-sm">
          Tu contraseña ha sido restablecida correctamente.
        </p>
        <div class="mt-6">
          <a
            href="/sign-in"
            class="inline-flex items-center justify-center rounded-lg bg-accent-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-700"
          >
            Iniciar sesión
          </a>
        </div>
      </div>

      <div id="expired-view" class="hidden text-center">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-danger-bg">
          <Icon name="lucide:clock" size={28} class="text-danger" />
        </div>
        <h2 class="text-foreground text-xl font-bold">Enlace expirado</h2>
        <p class="text-muted-foreground mt-2 text-sm">
          Este enlace ha expirado. Solicita uno nuevo para continuar.
        </p>
        <div class="mt-6">
          <Button variant="primary" href="/forgot-password" class="w-full">
            Solicitar nuevo enlace
          </Button>
        </div>
        {email && (
          <p class="text-muted-foreground mt-4 text-xs">
            Te redirijimos al formulario con tu email prellenado.
          </p>
        )}
      </div>
    </div>
  </div>
</LandingLayout>

<script>
  import { setupPasswordToggles } from "@/lib/password-toggle";

  const PASSWORD_RULES = [
    { id: "rule-min", pattern: /.{8,}/ },
    { id: "rule-upper", pattern: /[A-Z]/ },
    { id: "rule-lower", pattern: /[a-z]/ },
    { id: "rule-digit", pattern: /\d/ },
    { id: "rule-special", pattern: /[^A-Za-z0-9]/ },
  ];

  function updateRuleDisplay(ruleId: string, passed: boolean) {
    const el = document.getElementById(ruleId);
    if (!el) return;
    const icon = el.querySelector(".rule-icon");
    if (passed) {
      el.classList.remove("text-muted-foreground");
      el.classList.add("text-success");
      if (icon) icon.textContent = "●";
    } else {
      el.classList.remove("text-success");
      el.classList.add("text-muted-foreground");
      if (icon) icon.textContent = "○";
    }
  }

  function validatePassword(password: string): boolean {
    return PASSWORD_RULES.every((rule) => rule.pattern.test(password));
  }

  async function validateToken(token: string): Promise<{ valid: boolean; error?: string; remainingSeconds?: number }> {
    try {
      const response = await fetch(`/api/auth/reset-password?token=${encodeURIComponent(token)}`);
      const data = await response.json();
      return data;
    } catch {
      return { valid: false, error: "Error al validar el enlace" };
    }
  }

  function startCountdown(remainingSeconds: number, onExpire: () => void) {
    const timerEl = document.getElementById("timer-value") as HTMLSpanElement | null;
    const timerDisplay = document.getElementById("timer-display");
    if (!timerEl || !timerDisplay) return;

    timerDisplay.classList.remove("hidden");

    const timerElement = timerEl;
    let seconds = remainingSeconds;

    function updateTimer() {
      if (seconds <= 0) {
        timerElement.textContent = "00:00";
        onExpire();
        return;
      }

      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      timerElement.textContent = `${mins.toString().padStart(2, "0")}:${secs.toString().padStart(2, "0")}`;
      seconds--;
      setTimeout(updateTimer, 1000);
    }

    updateTimer();
  }

  function showExpiredView() {
    const form = document.getElementById("reset-form");
    const passwordField = document.getElementById("password-field");
    const confirmField = document.getElementById("confirm-field");
    const timerDisplay = document.getElementById("timer-display");
    const expiredView = document.getElementById("expired-view");
    const tokenStatus = document.getElementById("token-status");

    if (form) form.classList.add("hidden");
    if (passwordField) passwordField.classList.add("hidden");
    if (confirmField) confirmField.classList.add("hidden");
    if (timerDisplay) timerDisplay.classList.add("hidden");
    if (tokenStatus) {
      tokenStatus.classList.remove("hidden", "border-danger-border", "bg-danger-bg", "text-danger");
      tokenStatus.classList.add("border-warning-border", "bg-warning-bg", "text-warning");
      tokenStatus.textContent = "El enlace ha expirado";
    }
    if (expiredView) expiredView.classList.remove("hidden");
  }

  function setupResetPassword() {
    const form = document.getElementById("reset-form");
    const submitBtn = document.getElementById(
      "reset-submit",
    ) as HTMLButtonElement | null;
    const feedbackEl = document.getElementById("reset-feedback");
    const tokenEl = document.getElementById(
      "reset-token",
    ) as HTMLInputElement | null;
    const passwordInput = document.getElementById("password") as HTMLInputElement | null;

    if (!form || !submitBtn || !feedbackEl || !tokenEl) return;
    if (form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    const token = tokenEl.value;

    (async () => {
      const validation = await validateToken(token);

      if (!validation.valid) {
        showExpiredView();
        return;
      }

      if (validation.remainingSeconds) {
        startCountdown(validation.remainingSeconds, showExpiredView);
      }
    })();

    if (passwordInput) {
      passwordInput.addEventListener("input", () => {
        const password = passwordInput.value;
        PASSWORD_RULES.forEach((rule) => {
          updateRuleDisplay(rule.id, rule.pattern.test(password));
        });
      });
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const password = (document.getElementById("password") as HTMLInputElement)
        .value;
      const confirmPassword = (
        document.getElementById("confirmPassword") as HTMLInputElement
      ).value;

      if (!validatePassword(password)) {
        feedbackEl.classList.remove("hidden", "border-success-border", "bg-success-bg", "text-success");
        feedbackEl.classList.add(
          "border-danger-border",
          "bg-danger-bg",
          "text-danger",
        );
        feedbackEl.textContent =
          "La contraseña no cumple todos los requisitos.";
        return;
      }

      if (password !== confirmPassword) {
        feedbackEl.classList.remove("hidden", "border-success-border", "bg-success-bg", "text-success");
        feedbackEl.classList.add(
          "border-danger-border",
          "bg-danger-bg",
          "text-danger",
        );
        feedbackEl.textContent = "Las contraseñas no coinciden.";
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Restableciendo...";

      try {
        const response = await fetch("/api/auth/reset-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token, password }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Error al restablecer la contraseña");
        }

        const formEl = document.getElementById("reset-form");
        const passwordField = document.getElementById("password-field");
        const confirmField = document.getElementById("confirm-field");
        const timerDisplay = document.getElementById("timer-display");
        const successView = document.getElementById("success-view");

        if (formEl) formEl.classList.add("hidden");
        if (passwordField) passwordField.classList.add("hidden");
        if (confirmField) confirmField.classList.add("hidden");
        if (timerDisplay) timerDisplay.classList.add("hidden");
        if (successView) successView.classList.remove("hidden");
      } catch (error) {
        feedbackEl.classList.remove("hidden", "border-success-border", "bg-success-bg", "text-success");
        feedbackEl.classList.add(
          "border-danger-border",
          "bg-danger-bg",
          "text-danger",
        );
        feedbackEl.textContent =
          (error as { message?: string })?.message ??
          "Error al restablecer la contraseña.";
        submitBtn.disabled = false;
        submitBtn.textContent = "Restablecer contraseña";
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    setupResetPassword();
    setupPasswordToggles();
  });
  document.addEventListener("astro:after-swap", () => {
    setupResetPassword();
    setupPasswordToggles();
  });
  setupResetPassword();
  setupPasswordToggles();
</script>