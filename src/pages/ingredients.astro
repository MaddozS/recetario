---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import {
  createIngredient,
  deleteIngredient,
  getRecipeDataOwner,
  listIngredients,
  listIngredientUsage,
  updateIngredient,
} from "../lib/recipe-data";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const recipeDataOwner = getRecipeDataOwner(Astro.locals.user);

const unitOptions = [
  "kg",
  "g",
  "lt",
  "ml",
  "pza",
  "pieza",
  "cdita",
  "cda",
  "taza",
];
const defaultUnit = unitOptions[0] ?? "kg";

type IngredientFormInput = {
  name: string;
  supplier: string;
  brand: string;
  unit: string;
  price: number;
  purchaseQuantity: number;
};

type Feedback = {
  type: "success" | "error";
  message: string;
  recipes?: string[];
};

const labelClasses =
  "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500";
const inputClasses =
  "w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-indigo-300 focus:bg-white focus:ring-2 focus:ring-indigo-500/20";
const secondaryButtonClasses =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-50";
const primaryButtonClasses =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-indigo-700 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400";

const parseNumberInput = (value: FormDataEntryValue | null) => {
  const normalized = String(value ?? "")
    .trim()
    .replace(",", ".");
  if (!normalized) return Number.NaN;
  return Number(normalized);
};

const buildIngredientsUrl = (feedback?: Feedback) => {
  const params = new URLSearchParams();

  if (feedback) {
    params.set("type", feedback.type);
    params.set("message", feedback.message);

    if (feedback.recipes && feedback.recipes.length > 0) {
      params.set("recipes", JSON.stringify(feedback.recipes));
    }
  }

  const query = params.toString();
  return query ? `/ingredients?${query}` : "/ingredients";
};

const redirectWithFeedback = (feedback: Feedback) =>
  Astro.redirect(buildIngredientsUrl(feedback));

const readIngredientFormInput = (formData: FormData): IngredientFormInput => {
  const purchaseQuantityValue = String(
    formData.get("purchaseQuantity") ?? "",
  ).trim();

  return {
    name: String(formData.get("name") ?? "").trim(),
    supplier: String(formData.get("supplier") ?? "").trim(),
    brand: String(formData.get("brand") ?? "").trim(),
    unit: String(formData.get("unit") ?? "").trim(),
    price: parseNumberInput(formData.get("price")),
    purchaseQuantity: purchaseQuantityValue
      ? parseNumberInput(purchaseQuantityValue)
      : 1,
  };
};

const validateIngredientInput = (input: IngredientFormInput) => {
  if (
    !input.name ||
    !input.unit ||
    !Number.isFinite(input.price) ||
    input.price < 0
  ) {
    return "Nombre, unidad y precio empaque son obligatorios.";
  }

  if (!Number.isFinite(input.purchaseQuantity) || input.purchaseQuantity <= 0) {
    return "La cantidad de empaque debe ser mayor a 0 (puedes usar decimales).";
  }

  return null;
};

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") || "");

  if (action === "create" || action === "update") {
    const ingredientInput = readIngredientFormInput(formData);
    const validationMessage = validateIngredientInput(ingredientInput);

    if (validationMessage) {
      return redirectWithFeedback({
        type: "error",
        message: validationMessage,
      });
    }

    if (action === "create") {
      await createIngredient(
        {
          name: ingredientInput.name,
          unit: ingredientInput.unit,
          price: ingredientInput.price,
          purchaseQuantity: ingredientInput.purchaseQuantity,
          brand: ingredientInput.brand || undefined,
          supplier: ingredientInput.supplier || undefined,
        },
        recipeDataOwner,
      );

      return redirectWithFeedback({
        type: "success",
        message: "Ingrediente agregado correctamente.",
      });
    }

    const ingredientId = Number(String(formData.get("ingredientId") || ""));
    if (!Number.isFinite(ingredientId)) {
      return redirectWithFeedback({
        type: "error",
        message: "No se pudo identificar el ingrediente a editar.",
      });
    }

    try {
      const updatedIngredient = await updateIngredient(
        ingredientId,
        {
          name: ingredientInput.name,
          unit: ingredientInput.unit,
          price: ingredientInput.price,
          purchaseQuantity: ingredientInput.purchaseQuantity,
          brand: ingredientInput.brand,
          supplier: ingredientInput.supplier,
        },
        recipeDataOwner,
      );

      if (!updatedIngredient) {
        return redirectWithFeedback({
          type: "error",
          message: "El ingrediente ya no existe.",
        });
      }
    } catch (error) {
      const message =
        error instanceof Error && error.message
          ? error.message
          : "No se pudo actualizar el ingrediente.";

      return redirectWithFeedback({
        type: "error",
        message,
      });
    }

    return redirectWithFeedback({
      type: "success",
      message: "Ingrediente actualizado correctamente.",
    });
  }

  if (action === "delete") {
    const ingredientId = Number(String(formData.get("ingredientId") || ""));
    if (!Number.isFinite(ingredientId)) {
      return redirectWithFeedback({
        type: "error",
        message: "No se pudo identificar el ingrediente a eliminar.",
      });
    }

    const result = await deleteIngredient(ingredientId, recipeDataOwner);

    if (result.status === "not-found") {
      return redirectWithFeedback({
        type: "error",
        message: "El ingrediente ya no existe.",
      });
    }

    if (result.status === "blocked") {
      return redirectWithFeedback({
        type: "error",
        message: "No se puede eliminar porque el ingrediente está en uso.",
        recipes: result.recipes.map((recipe) => recipe.name),
      });
    }

    return redirectWithFeedback({
      type: "success",
      message: "Ingrediente eliminado correctamente.",
    });
  }
}

const feedbackType = Astro.url.searchParams.get("type");
const feedbackMessage = Astro.url.searchParams.get("message");
const blockedRecipes = (() => {
  const raw = Astro.url.searchParams.get("recipes");
  if (!raw) return [] as string[];
  try {
    const parsed = JSON.parse(raw) as unknown;
    if (!Array.isArray(parsed)) return [];
    return parsed.filter(
      (item): item is string =>
        typeof item === "string" && item.trim().length > 0,
    );
  } catch {
    return [] as string[];
  }
})();

const ingredients = await listIngredients(recipeDataOwner);
const ingredientUsage = await listIngredientUsage(recipeDataOwner);
---

<Layout currentPage="ingredients" showSideBar={false}>
  {
    feedbackType && feedbackMessage && (
      <div
        class:list={[
          "mb-4 rounded-2xl border px-4 py-3 text-sm",
          feedbackType === "success"
            ? "border-emerald-200 bg-emerald-50 text-emerald-700"
            : "border-rose-200 bg-rose-50 text-rose-700",
        ]}
      >
        <p class="font-semibold">{feedbackMessage}</p>
        {blockedRecipes.length > 0 && (
          <p class="mt-2 text-xs">
            Recetas que lo usan: {blockedRecipes.join(", ")}
          </p>
        )}
      </div>
    )
  }

  <section
    class="mb-6 hidden rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm lg:block"
    transition:animate="slide"
  >
    <div
      class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between"
    >
      <div>
        <h2 class="text-2xl font-black text-slate-900">Agregar Insumo</h2>
        <p class="mt-1 text-sm text-slate-500">
          Captura la información de tus ingredientes y empaques.
        </p>
      </div>

      <div class="text-left text-xs text-slate-500 xl:text-right">
        <p>
          <span class="font-bold text-rose-500">*</span> Campos obligatorios
        </p>
        <p>Usa punto (.) o coma (,) para decimales</p>
      </div>
    </div>

    <form method="post" class="mt-6" data-ingredient-form data-astro-reload>
      <input type="hidden" name="action" value="create" />

      <div
        class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-[minmax(0,2.3fr)_minmax(0,1.5fr)_minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1.5fr)]"
      >
        <div>
          <label class={labelClasses} for="desktop-name">
            Nombre <span class="text-rose-500">*</span>
          </label>
          <input
            id="desktop-name"
            name="name"
            type="text"
            placeholder="Ej. Harina de trigo extra fina"
            class={inputClasses}
            autocomplete="off"
          />
        </div>

        <div>
          <label class={labelClasses} for="desktop-supplier">Proveedor</label>
          <input
            id="desktop-supplier"
            name="supplier"
            type="text"
            placeholder="Ej. Casa Santos Lugo"
            class={inputClasses}
            autocomplete="off"
          />
        </div>

        <div>
          <label class={labelClasses} for="desktop-brand">Marca</label>
          <input
            id="desktop-brand"
            name="brand"
            type="text"
            placeholder="Opcional"
            class={inputClasses}
            autocomplete="off"
          />
        </div>

        <div>
          <label class={labelClasses} for="desktop-price">
            Precio empaque <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <span
              class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm font-bold text-slate-400"
            >
              $
            </span>
            <input
              id="desktop-price"
              name="price"
              type="text"
              inputmode="decimal"
              placeholder="0.00"
              class={`${inputClasses} pl-8`}
              autocomplete="off"
            />
          </div>
        </div>

        <div>
          <label class={labelClasses} for="desktop-purchase-quantity">
            Cant. empaque <span class="text-rose-500">*</span>
          </label>
          <div
            class="grid grid-cols-[minmax(0,1fr)_5.5rem] overflow-hidden rounded-xl border border-slate-200 bg-slate-50 transition focus-within:border-indigo-300 focus-within:bg-white focus-within:ring-2 focus-within:ring-indigo-500/20"
          >
            <input
              id="desktop-purchase-quantity"
              name="purchaseQuantity"
              type="text"
              inputmode="decimal"
              value="1"
              class="border-0 bg-transparent px-4 py-3 text-sm text-slate-800 outline-none placeholder:text-slate-400"
              autocomplete="off"
            />
            <select
              name="unit"
              class="border-0 border-l border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-slate-700 outline-none"
            >
              {
                unitOptions.map((option) => (
                  <option value={option} selected={option === defaultUnit}>
                    {option}
                  </option>
                ))
              }
            </select>
          </div>
        </div>
      </div>

      <div
        class="mt-5 flex flex-col gap-4 rounded-2xl border border-indigo-100 bg-indigo-50/70 p-4 xl:flex-row xl:items-center xl:justify-between"
      >
        <div class="flex items-start gap-3">
          <div
            class="mt-0.5 flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-indigo-600 shadow-sm shadow-indigo-100"
          >
            <Icon name="lucide:info" size={18} />
          </div>

          <div>
            <p
              class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500"
            >
              Costo unitario calculado:
            </p>
            <div class="mt-1 flex items-end gap-2">
              <span
                class="text-3xl font-black tabular-nums text-indigo-700"
                data-unit-cost-value
              >
                $0.00
              </span>
              <span class="pb-1 text-sm font-semibold text-indigo-400">
                / <span data-unit-cost-unit>{defaultUnit}</span>
              </span>
            </div>
          </div>
        </div>

        <button
          type="submit"
          class={`${primaryButtonClasses} min-w-52 shadow-sm shadow-indigo-200`}
          data-submit-button
          disabled
        >
          <Icon name="lucide:plus" size={18} />
          Agregar Insumo
        </button>
      </div>
    </form>
  </section>

  <section
    class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-sm"
    transition:animate="slide"
  >
    <div class="border-b border-slate-200 px-4 py-4 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
      >
        <div>
          <div class="flex items-baseline gap-2">
            <h2 class="text-xl font-black text-slate-900">Tus Ingredientes</h2>
            <span class="text-sm font-semibold text-slate-400">
              ({ingredients.length})
            </span>
          </div>
          <p class="mt-1 text-sm text-slate-500">
            Busca por ingrediente, proveedor o marca.
          </p>
        </div>

        <div
          class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end"
        >
          <button
            type="button"
            class={`${primaryButtonClasses} lg:hidden`}
            data-open-create-modal
          >
            <Icon name="lucide:plus" size={18} />
            Agregar Insumo
          </button>

          <label class="relative block w-full sm:w-80">
            <span
              class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-400"
            >
              <Icon name="lucide:search" size={16} />
            </span>
            <input
              type="search"
              placeholder="Buscar ingrediente o proveedor..."
              class={`${inputClasses} pl-11 pr-4`}
              data-ingredient-search
            />
          </label>
        </div>
      </div>
    </div>

    {
      ingredients.length > 0 ? (
        <>
          <div class="overflow-x-auto">
            <table class="min-w-full text-left">
              <thead class="bg-slate-50 text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500">
                <tr>
                  <th class="px-6 py-4">Insumo</th>
                  <th class="px-6 py-4">Proveedor</th>
                  <th class="px-6 py-4">Precio Empaque</th>
                  <th class="px-6 py-4">Contenido</th>
                  <th class="px-6 py-4">Costo x Unidad</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {ingredients.map((ingredient) => {
                  const usedRecipes = ingredientUsage[ingredient.id] || [];
                  const usedRecipesPayload = encodeURIComponent(
                    JSON.stringify(usedRecipes),
                  );
                  const ingredientPayload = encodeURIComponent(
                    JSON.stringify({
                      id: ingredient.id,
                      name: ingredient.name,
                      supplier: ingredient.supplier ?? "",
                      brand: ingredient.brand ?? "",
                      price: ingredient.price,
                      purchaseQuantity: ingredient.purchaseQuantity,
                      unit: ingredient.unit,
                    }),
                  );
                  const searchText = [
                    ingredient.name,
                    ingredient.supplier ?? "",
                    ingredient.brand ?? "",
                  ]
                    .join(" ")
                    .toLowerCase();
                  const unitCost =
                    ingredient.price / ingredient.purchaseQuantity;

                  return (
                    <tr
                      class="transition-colors hover:bg-slate-50/70"
                      data-ingredient-row
                      data-search={searchText}
                    >
                      <td class="px-6 py-5">
                        <div class="min-w-56">
                          <p class="font-semibold text-slate-800">
                            {ingredient.name}
                          </p>
                          {ingredient.brand && (
                            <p class="mt-1 text-xs text-slate-400">
                              Marca: {ingredient.brand}
                            </p>
                          )}
                        </div>
                      </td>
                      <td class="px-6 py-5">
                        {ingredient.supplier ? (
                          <span class="text-sm font-medium text-slate-700">
                            {ingredient.supplier}
                          </span>
                        ) : (
                          <span class="text-sm italic text-slate-400">
                            Sin proveedor
                          </span>
                        )}
                      </td>
                      <td class="px-6 py-5">
                        <span class="text-sm font-semibold tabular-nums text-slate-700">
                          ${ingredient.price.toFixed(2)}
                        </span>
                      </td>
                      <td class="px-6 py-5 text-sm text-slate-600">
                        <span class="font-semibold text-slate-700">
                          {ingredient.purchaseQuantity}
                        </span>{" "}
                        <span>{ingredient.unit}</span>
                      </td>
                      <td class="px-6 py-5">
                        <span class="inline-flex items-center rounded-xl border border-indigo-100 bg-indigo-50 px-3 py-2 text-sm font-bold tabular-nums text-indigo-600">
                          ${unitCost.toFixed(2)} / {ingredient.unit}
                        </span>
                      </td>
                      <td class="px-6 py-5 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <button
                            type="button"
                            class="inline-flex h-9 w-9 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-indigo-50 hover:text-indigo-600"
                            title="Editar ingrediente"
                            aria-label="Editar ingrediente"
                            data-edit-trigger
                            data-ingredient-payload={ingredientPayload}
                          >
                            <Icon name="lucide:pencil" size={16} />
                          </button>

                          <button
                            type="button"
                            class="inline-flex h-9 w-9 items-center justify-center rounded-full text-rose-500 transition-colors hover:bg-rose-50 hover:text-rose-600"
                            title={
                              usedRecipes.length > 0
                                ? "Ingrediente en uso"
                                : "Eliminar ingrediente"
                            }
                            aria-label={
                              usedRecipes.length > 0
                                ? "Ingrediente en uso"
                                : "Eliminar ingrediente"
                            }
                            data-delete-trigger
                            data-ingredient-id={ingredient.id}
                            data-ingredient-name={ingredient.name}
                            data-used-recipes={usedRecipesPayload}
                          >
                            <Icon name="lucide:trash-2" size={16} />
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div
            hidden
            class="border-t border-slate-100 px-6 py-10 text-center"
            data-ingredient-search-empty
          >
            <div class="mx-auto flex max-w-sm flex-col items-center">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                <Icon name="lucide:search-x" size={20} />
              </div>
              <p class="mt-4 text-sm font-semibold text-slate-700">
                No encontramos resultados
              </p>
              <p class="mt-1 text-sm text-slate-500">
                Intenta con otro nombre, proveedor o marca.
              </p>
            </div>
          </div>
        </>
      ) : (
        <div class="px-6 py-14 text-center">
          <div class="mx-auto flex max-w-md flex-col items-center">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
              <Icon name="lucide:package-plus" size={24} />
            </div>
            <h3 class="mt-5 text-lg font-bold text-slate-800">
              Todavía no tienes ingredientes
            </h3>
            <p class="mt-2 text-sm text-slate-500">
              Agrega tu primer insumo para empezar a costear recetas y
              presentaciones.
            </p>
            <button
              type="button"
              class={`${primaryButtonClasses} mt-5 lg:hidden`}
              data-open-create-modal
            >
              <Icon name="lucide:plus" size={18} />
              Agregar Insumo
            </button>
          </div>
        </div>
      )
    }
  </section>

  <dialog
    id="create-ingredient-modal"
    class="fixed inset-0 m-auto w-[calc(100vw-1.5rem)] max-w-lg rounded-[28px] p-0 backdrop:bg-slate-900/55 lg:hidden"
  >
    <div
      class="max-h-[min(82vh,44rem)] overflow-y-auto rounded-[28px] border border-slate-200 bg-white p-5 pb-[calc(1.25rem+env(safe-area-inset-bottom)+4.75rem)] shadow-2xl"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-xl font-black text-slate-900">Agregar Insumo</h3>
          <p class="mt-1 text-sm text-slate-500">
            Captura la información de tu empaque sin salir del listado.
          </p>
        </div>

        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600"
          aria-label="Cerrar modal"
          data-close-create-modal
        >
          <Icon name="lucide:x" size={18} />
        </button>
      </div>

      <form method="post" class="mt-5 space-y-4" data-ingredient-form data-astro-reload>
        <input type="hidden" name="action" value="create" />

        <div>
          <label class={labelClasses} for="mobile-name">
            Nombre <span class="text-rose-500">*</span>
          </label>
          <input
            id="mobile-name"
            name="name"
            type="text"
            placeholder="Ej. Harina de trigo extra fina"
            class={inputClasses}
            autocomplete="off"
          />
        </div>

        <div>
          <label class={labelClasses} for="mobile-supplier">Proveedor</label>
          <input
            id="mobile-supplier"
            name="supplier"
            type="text"
            placeholder="Ej. Casa Santos Lugo"
            class={inputClasses}
            autocomplete="off"
          />
        </div>

        <div>
          <label class={labelClasses} for="mobile-brand">Marca</label>
          <input
            id="mobile-brand"
            name="brand"
            type="text"
            placeholder="Opcional"
            class={inputClasses}
            autocomplete="off"
          />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class={labelClasses} for="mobile-price">
              Precio empaque <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span
                class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm font-bold text-slate-400"
              >
                $
              </span>
              <input
                id="mobile-price"
                name="price"
                type="text"
                inputmode="decimal"
                placeholder="0.00"
                class={`${inputClasses} pl-8`}
                autocomplete="off"
              />
            </div>
          </div>

          <div>
            <label class={labelClasses} for="mobile-purchase-quantity">
              Cant. empaque <span class="text-rose-500">*</span>
            </label>
            <div
              class="grid grid-cols-[minmax(0,1fr)_5.5rem] overflow-hidden rounded-xl border border-slate-200 bg-slate-50 transition focus-within:border-indigo-300 focus-within:bg-white focus-within:ring-2 focus-within:ring-indigo-500/20"
            >
              <input
                id="mobile-purchase-quantity"
                name="purchaseQuantity"
                type="text"
                inputmode="decimal"
                value="1"
                class="border-0 bg-transparent px-4 py-3 text-sm text-slate-800 outline-none placeholder:text-slate-400"
                autocomplete="off"
              />
              <select
                name="unit"
                class="border-0 border-l border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-slate-700 outline-none"
              >
                {
                  unitOptions.map((option) => (
                    <option value={option} selected={option === defaultUnit}>
                      {option}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-indigo-100 bg-indigo-50/70 p-4">
          <div class="flex items-start gap-3">
            <div
              class="mt-0.5 flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-indigo-600 shadow-sm shadow-indigo-100"
            >
              <Icon name="lucide:info" size={18} />
            </div>

            <div>
              <p
                class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500"
              >
                Costo unitario calculado:
              </p>
              <div class="mt-1 flex items-end gap-2">
                <span
                  class="text-3xl font-black tabular-nums text-indigo-700"
                  data-unit-cost-value
                >
                  $0.00
                </span>
                <span class="pb-1 text-sm font-semibold text-indigo-400">
                  / <span data-unit-cost-unit>{defaultUnit}</span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <button
            type="button"
            class={secondaryButtonClasses}
            data-close-create-modal
          >
            Cancelar
          </button>
          <button
            type="submit"
            class={primaryButtonClasses}
            data-submit-button
            disabled
          >
            <Icon name="lucide:plus" size={18} />
            Agregar Insumo
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog
    id="edit-ingredient-modal"
    class="fixed inset-0 m-auto w-[calc(100vw-1.5rem)] max-w-xl rounded-[28px] p-0 backdrop:bg-slate-900/55"
  >
    <div
      class="max-h-[min(82vh,44rem)] overflow-y-auto rounded-[28px] border border-slate-200 bg-white p-6 pb-[calc(1.5rem+env(safe-area-inset-bottom)+1.5rem)] shadow-2xl"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-xl font-black text-slate-900">Editar ingrediente</h3>
          <p class="mt-1 text-sm text-slate-500">
            Ajusta todos los datos del ingrediente sin perder consistencia en el
            costeo.
          </p>
        </div>

        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600"
          aria-label="Cerrar modal"
          data-close-edit-modal
        >
          <Icon name="lucide:x" size={18} />
        </button>
      </div>

      <form method="post" class="mt-5 space-y-4" data-ingredient-form data-astro-reload>
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="ingredientId" value="" />

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="md:col-span-2">
            <label class={labelClasses} for="edit-name">
              Nombre <span class="text-rose-500">*</span>
            </label>
            <input
              id="edit-name"
              name="name"
              type="text"
              class={inputClasses}
              autocomplete="off"
            />
          </div>

          <div>
            <label class={labelClasses} for="edit-supplier">Proveedor</label>
            <input
              id="edit-supplier"
              name="supplier"
              type="text"
              class={inputClasses}
              autocomplete="off"
            />
          </div>

          <div>
            <label class={labelClasses} for="edit-brand">Marca</label>
            <input
              id="edit-brand"
              name="brand"
              type="text"
              class={inputClasses}
              autocomplete="off"
            />
          </div>

          <div>
            <label class={labelClasses} for="edit-price">
              Precio empaque <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span
                class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm font-bold text-slate-400"
              >
                $
              </span>
              <input
                id="edit-price"
                name="price"
                type="text"
                inputmode="decimal"
                class={`${inputClasses} pl-8`}
                autocomplete="off"
              />
            </div>
          </div>

          <div>
            <label class={labelClasses} for="edit-purchase-quantity">
              Cant. empaque <span class="text-rose-500">*</span>
            </label>
            <div
              class="grid grid-cols-[minmax(0,1fr)_5.5rem] overflow-hidden rounded-xl border border-slate-200 bg-slate-50 transition focus-within:border-indigo-300 focus-within:bg-white focus-within:ring-2 focus-within:ring-indigo-500/20"
            >
              <input
                id="edit-purchase-quantity"
                name="purchaseQuantity"
                type="text"
                inputmode="decimal"
                class="border-0 bg-transparent px-4 py-3 text-sm text-slate-800 outline-none placeholder:text-slate-400"
                autocomplete="off"
              />
              <select
                name="unit"
                class="border-0 border-l border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-slate-700 outline-none"
              >
                {
                  unitOptions.map((option) => (
                    <option value={option} selected={option === defaultUnit}>
                      {option}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-indigo-100 bg-indigo-50/70 p-4">
          <div class="flex items-start gap-3">
            <div
              class="mt-0.5 flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-indigo-600 shadow-sm shadow-indigo-100"
            >
              <Icon name="lucide:info" size={18} />
            </div>

            <div>
              <p
                class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500"
              >
                Costo unitario calculado:
              </p>
              <div class="mt-1 flex items-end gap-2">
                <span
                  class="text-3xl font-black tabular-nums text-indigo-700"
                  data-unit-cost-value
                >
                  $0.00
                </span>
                <span class="pb-1 text-sm font-semibold text-indigo-400">
                  / <span data-unit-cost-unit>{defaultUnit}</span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <button
            type="button"
            class={secondaryButtonClasses}
            data-close-edit-modal
          >
            Cancelar
          </button>
          <button
            type="submit"
            class={primaryButtonClasses}
            data-submit-button
            disabled
          >
            <Icon name="lucide:check" size={18} />
            Guardar cambios
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog
    id="delete-confirm-modal"
    class="fixed inset-0 m-auto w-[calc(100vw-1.5rem)] max-w-md rounded-[28px] p-0 backdrop:bg-slate-900/55"
  >
    <div class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-2xl">
      <div class="flex items-start gap-3">
        <div
          class="flex h-11 w-11 items-center justify-center rounded-2xl bg-rose-50 text-rose-600"
        >
          <Icon name="lucide:trash-2" size={18} />
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">
            Confirmar eliminación
          </h3>
          <p class="mt-2 text-sm text-slate-600">
            Vas a eliminar el ingrediente <span
              id="delete-ingredient-name"
              class="font-semibold text-slate-800"></span>.
          </p>
          <p id="delete-usage-message" class="mt-2 text-xs text-slate-500"></p>
          <ul
            id="delete-usage-list"
            class="mt-2 list-disc space-y-1 pl-5 text-xs text-amber-700"
          >
          </ul>
        </div>
      </div>

      <form
        method="post"
        class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
        data-astro-reload
      >
        <input type="hidden" name="action" value="delete" />
        <input
          type="hidden"
          name="ingredientId"
          id="delete-ingredient-id"
          value=""
        />
        <button type="button" class={secondaryButtonClasses} id="cancel-delete">
          Cancelar
        </button>
        <button
          type="submit"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-rose-600 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-rose-700 disabled:cursor-not-allowed disabled:opacity-60"
          id="confirm-delete"
        >
          Eliminar
        </button>
      </form>
    </div>
  </dialog>

  <script>
    // @ts-nocheck
    const parseIngredientNumber = (value) => {
      const normalized = String(value ?? "")
        .trim()
        .replace(",", ".");
      if (!normalized) return Number.NaN;
      return Number(normalized);
    };

    const formatIngredientCurrency = (value) => `$${value.toFixed(2)}`;

    const syncIngredientFormState = (form) => {
      const nameInput = form.querySelector('[name="name"]');
      const priceInput = form.querySelector('[name="price"]');
      const quantityInput = form.querySelector('[name="purchaseQuantity"]');
      const unitInput = form.querySelector('[name="unit"]');
      const submitButton = form.querySelector("[data-submit-button]");
      const costValue = form.querySelector("[data-unit-cost-value]");
      const costUnit = form.querySelector("[data-unit-cost-unit]");

      if (!(nameInput instanceof HTMLInputElement)) return;
      if (!(priceInput instanceof HTMLInputElement)) return;
      if (!(quantityInput instanceof HTMLInputElement)) return;
      if (!(unitInput instanceof HTMLSelectElement)) return;
      if (!(costValue instanceof HTMLElement)) return;
      if (!(costUnit instanceof HTMLElement)) return;

      const price = parseIngredientNumber(priceInput.value);
      const quantity = parseIngredientNumber(quantityInput.value);
      const hasValidPrice = Number.isFinite(price) && price >= 0;
      const hasValidQuantity = Number.isFinite(quantity) && quantity > 0;
      const unitCost = hasValidPrice && hasValidQuantity ? price / quantity : 0;

      costValue.textContent = formatIngredientCurrency(unitCost);
      costUnit.textContent = unitInput.value.trim() || "unidad";

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = !(
          nameInput.value.trim().length > 0 &&
          unitInput.value.trim().length > 0 &&
          hasValidPrice &&
          hasValidQuantity
        );
      }
    };

    const bindIngredientForm = (form) => {
      if (!(form instanceof HTMLFormElement)) return;
      if (form.dataset.ingredientBound === "1") return;

      form.dataset.ingredientBound = "1";

      const sync = () => syncIngredientFormState(form);
      form
        .querySelectorAll(
          'input[name="name"], input[name="price"], input[name="purchaseQuantity"]',
        )
        .forEach((field) => {
          if (!(field instanceof HTMLInputElement)) return;
          field.addEventListener("input", sync);
        });

      form.querySelectorAll('select[name="unit"]').forEach((field) => {
        if (!(field instanceof HTMLSelectElement)) return;
        field.addEventListener("change", sync);
      });

      sync();
    };

    const bindDialogBackdrop = (dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (dialog.dataset.backdropBound === "1") return;

      dialog.dataset.backdropBound = "1";
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });
    };

    const initIngredientCreateForm = () => {
      document.querySelectorAll("[data-ingredient-form]").forEach((form) => {
        bindIngredientForm(form);
      });
    };

    const initCreateIngredientModal = () => {
      const modal = document.getElementById("create-ingredient-modal");
      if (!(modal instanceof HTMLDialogElement)) return;

      bindDialogBackdrop(modal);

      const form = modal.querySelector("form");
      const closeButtons = modal.querySelectorAll("[data-close-create-modal]");

      closeButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (button.dataset.bound === "1") return;
        button.dataset.bound = "1";
        button.addEventListener("click", () => {
          modal.close();
        });
      });

      document
        .querySelectorAll("[data-open-create-modal]")
        .forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          if (button.dataset.bound === "1") return;
          button.dataset.bound = "1";
          button.addEventListener("click", () => {
            if (form instanceof HTMLFormElement) {
              form.reset();
              syncIngredientFormState(form);
            }
            modal.showModal();
          });
        });
    };

    const initIngredientSearch = () => {
      const searchInput = document.querySelector("[data-ingredient-search]");
      if (!(searchInput instanceof HTMLInputElement)) return;
      if (searchInput.dataset.bound === "1") return;

      const rows = Array.from(
        document.querySelectorAll("[data-ingredient-row]"),
      );
      const emptyState = document.querySelector(
        "[data-ingredient-search-empty]",
      );

      const sync = () => {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        rows.forEach((row) => {
          if (!(row instanceof HTMLTableRowElement)) return;
          const haystack = row.dataset.search || "";
          const visible = !query || haystack.includes(query);
          row.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = visibleCount > 0 || rows.length === 0;
        }
      };

      searchInput.dataset.bound = "1";
      searchInput.addEventListener("input", sync);
      sync();
    };

    const initEditIngredientModal = () => {
      const modal = document.getElementById("edit-ingredient-modal");
      if (!(modal instanceof HTMLDialogElement)) return;

      bindDialogBackdrop(modal);

      const form = modal.querySelector("form");
      if (!(form instanceof HTMLFormElement)) return;

      const idInput = form.querySelector('[name="ingredientId"]');
      const nameInput = form.querySelector('[name="name"]');
      const supplierInput = form.querySelector('[name="supplier"]');
      const brandInput = form.querySelector('[name="brand"]');
      const priceInput = form.querySelector('[name="price"]');
      const quantityInput = form.querySelector('[name="purchaseQuantity"]');
      const unitInput = form.querySelector('[name="unit"]');

      if (!(idInput instanceof HTMLInputElement)) return;
      if (!(nameInput instanceof HTMLInputElement)) return;
      if (!(supplierInput instanceof HTMLInputElement)) return;
      if (!(brandInput instanceof HTMLInputElement)) return;
      if (!(priceInput instanceof HTMLInputElement)) return;
      if (!(quantityInput instanceof HTMLInputElement)) return;
      if (!(unitInput instanceof HTMLSelectElement)) return;

      modal.querySelectorAll("[data-close-edit-modal]").forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (button.dataset.bound === "1") return;
        button.dataset.bound = "1";
        button.addEventListener("click", () => {
          modal.close();
        });
      });

      document.querySelectorAll("[data-edit-trigger]").forEach((trigger) => {
        if (!(trigger instanceof HTMLButtonElement)) return;
        if (trigger.dataset.bound === "1") return;

        trigger.dataset.bound = "1";
        trigger.addEventListener("click", () => {
          try {
            const payload = trigger.dataset.ingredientPayload;
            if (!payload) return;

            const parsed = JSON.parse(decodeURIComponent(payload));
            idInput.value = String(parsed.id ?? "");
            nameInput.value = String(parsed.name ?? "");
            supplierInput.value = String(parsed.supplier ?? "");
            brandInput.value = String(parsed.brand ?? "");

            const nextPrice = Number(parsed.price);
            priceInput.value = Number.isFinite(nextPrice)
              ? nextPrice.toFixed(2)
              : "";

            const nextQuantity = Number(parsed.purchaseQuantity);
            quantityInput.value = Number.isFinite(nextQuantity)
              ? String(nextQuantity)
              : "1";

            const nextUnit =
              typeof parsed.unit === "string" && parsed.unit.trim().length > 0
                ? parsed.unit
                : unitInput.value || "kg";
            unitInput.value = String(nextUnit);
            syncIngredientFormState(form);
            modal.showModal();
          } catch {
            window.alert("No se pudo cargar el ingrediente para editarlo.");
          }
        });
      });
    };

    const initDeleteModal = () => {
      const modal = document.getElementById("delete-confirm-modal");
      const ingredientName = document.getElementById("delete-ingredient-name");
      const ingredientIdInput = document.getElementById("delete-ingredient-id");
      const cancelButton = document.getElementById("cancel-delete");
      const confirmDeleteButton = document.getElementById("confirm-delete");
      const usageMessage = document.getElementById("delete-usage-message");
      const usageList = document.getElementById("delete-usage-list");

      if (!(modal instanceof HTMLDialogElement)) return;
      if (!(ingredientName instanceof HTMLElement)) return;
      if (!(ingredientIdInput instanceof HTMLInputElement)) return;
      if (!(cancelButton instanceof HTMLButtonElement)) return;
      if (!(confirmDeleteButton instanceof HTMLButtonElement)) return;
      if (!(usageMessage instanceof HTMLElement)) return;
      if (!(usageList instanceof HTMLElement)) return;

      bindDialogBackdrop(modal);

      if (cancelButton.dataset.bound !== "1") {
        cancelButton.dataset.bound = "1";
        cancelButton.addEventListener("click", () => {
          modal.close();
        });
      }

      document.querySelectorAll("[data-delete-trigger]").forEach((trigger) => {
        if (!(trigger instanceof HTMLButtonElement)) return;
        if (trigger.dataset.bound === "1") return;

        trigger.dataset.bound = "1";
        trigger.addEventListener("click", () => {
          let usedRecipes = [];

          try {
            const payload = trigger.dataset.usedRecipes;
            if (payload) {
              const parsed = JSON.parse(decodeURIComponent(payload));
              if (Array.isArray(parsed)) {
                usedRecipes = parsed.filter(
                  (item) => typeof item === "string" && item.trim().length > 0,
                );
              }
            }
          } catch {
            usedRecipes = [];
          }

          ingredientName.textContent = trigger.dataset.ingredientName || "";
          ingredientIdInput.value = trigger.dataset.ingredientId || "";
          usageList.innerHTML = "";

          if (usedRecipes.length > 0) {
            usageMessage.textContent =
              "Este ingrediente está en uso y no se puede eliminar. Se usa en:";
            usedRecipes.forEach((recipeName) => {
              const item = document.createElement("li");
              item.textContent = recipeName;
              usageList.appendChild(item);
            });
            confirmDeleteButton.disabled = true;
          } else {
            usageMessage.textContent =
              "No hay recetas relacionadas. Puedes continuar con la eliminación.";
            confirmDeleteButton.disabled = false;
          }

          modal.showModal();
        });
      });
    };

    const initIngredientsPage = () => {
      initIngredientCreateForm();
      initCreateIngredientModal();
      initIngredientSearch();
      initEditIngredientModal();
      initDeleteModal();
    };

    document.addEventListener("astro:page-load", initIngredientsPage);
    document.addEventListener("astro:after-swap", initIngredientsPage);
    initIngredientsPage();
  </script>
</Layout>
