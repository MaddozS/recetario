---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { Button, Card } from "@/components/ui";
import {
  createIngredient,
  deleteIngredient,
  listIngredients,
  listIngredientUsage,
  updateIngredient,
} from "@/lib/db/ingredients";
import { countUserIngredients } from "@/lib/db/billing";
import { canCreateIngredient } from "@/lib/subscription";
import { parseNumberInput } from "@/lib/form-utils";
import { UNIT_OPTIONS, DEFAULT_UNIT } from "@/lib/constants";
import FeedbackAlert from "@/components/FeedbackAlert.astro";
import UnitCostDisplay from "@/components/UnitCostDisplay.astro";
import IngredientFormFields from "@/components/IngredientFormFields.astro";
import EmptyState from "@/components/EmptyState.astro";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const ownerId = Astro.locals.user!.id;

type IngredientFormInput = {
  name: string;
  supplier: string;
  brand: string;
  unit: string;
  price: number;
  purchaseQuantity: number;
};

type Feedback = {
  type: "success" | "error";
  message: string;
  recipes?: string[];
};

const labelClasses =
  "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.18em] text-muted-foreground";
const inputClasses =
  "w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none transition placeholder:text-subtle-foreground focus:border-accent-300 focus:bg-card focus:ring-2 focus:ring-accent-500/20";

const buildIngredientsUrl = (feedback?: Feedback) => {
  const params = new URLSearchParams();

  if (feedback) {
    params.set("type", feedback.type);
    params.set("message", feedback.message);

    if (feedback.recipes && feedback.recipes.length > 0) {
      params.set("recipes", JSON.stringify(feedback.recipes));
    }
  }

  const query = params.toString();
  return query ? `/ingredients?${query}` : "/ingredients";
};

const redirectWithFeedback = (feedback: Feedback) =>
  Astro.redirect(buildIngredientsUrl(feedback));

const readIngredientFormInput = (formData: FormData): IngredientFormInput => {
  const purchaseQuantityValue = String(
    formData.get("purchaseQuantity") ?? "",
  ).trim();

  return {
    name: String(formData.get("name") ?? "").trim(),
    supplier: String(formData.get("supplier") ?? "").trim(),
    brand: String(formData.get("brand") ?? "").trim(),
    unit: String(formData.get("unit") ?? "").trim(),
    price: parseNumberInput(formData.get("price")),
    purchaseQuantity: purchaseQuantityValue
      ? parseNumberInput(purchaseQuantityValue)
      : 1,
  };
};

const validateIngredientInput = (input: IngredientFormInput) => {
  if (
    !input.name ||
    !input.unit ||
    !Number.isFinite(input.price) ||
    input.price < 0
  ) {
    return "Nombre, unidad y precio empaque son obligatorios.";
  }

  if (!Number.isFinite(input.purchaseQuantity) || input.purchaseQuantity <= 0) {
    return "La cantidad de empaque debe ser mayor a 0 (puedes usar decimales).";
  }

  return null;
};

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") || "");

  if (action === "create" || action === "update") {
    const ingredientInput = readIngredientFormInput(formData);
    const validationMessage = validateIngredientInput(ingredientInput);

    if (validationMessage) {
      return redirectWithFeedback({
        type: "error",
        message: validationMessage,
      });
    }

    if (action === "create") {
      const ingredientCount = await countUserIngredients(ownerId);
      if (!canCreateIngredient(Astro.locals.subscription, ingredientCount)) {
        return redirectWithFeedback({
          type: "error",
          message: `Has alcanzado el limite de ${Astro.locals.subscription.ingredientsLimit} ingredientes de tu plan Free. Actualiza tu plan para crear mas.`,
        });
      }

      await createIngredient(
        {
          name: ingredientInput.name,
          unit: ingredientInput.unit,
          price: ingredientInput.price,
          purchaseQuantity: ingredientInput.purchaseQuantity,
          brand: ingredientInput.brand || undefined,
          supplier: ingredientInput.supplier || undefined,
        },
        ownerId,
      );

      return redirectWithFeedback({
        type: "success",
        message: "Ingrediente agregado correctamente.",
      });
    }

    const ingredientId = Number(String(formData.get("ingredientId") || ""));
    if (!Number.isFinite(ingredientId)) {
      return redirectWithFeedback({
        type: "error",
        message: "No se pudo identificar el ingrediente a editar.",
      });
    }

    try {
      const updatedIngredient = await updateIngredient(
        ingredientId,
        {
          name: ingredientInput.name,
          unit: ingredientInput.unit,
          price: ingredientInput.price,
          purchaseQuantity: ingredientInput.purchaseQuantity,
          brand: ingredientInput.brand,
          supplier: ingredientInput.supplier,
        },
        ownerId,
      );

      if (!updatedIngredient) {
        return redirectWithFeedback({
          type: "error",
          message: "El ingrediente ya no existe.",
        });
      }
    } catch (error) {
      const message =
        error instanceof Error && error.message
          ? error.message
          : "No se pudo actualizar el ingrediente.";
      void message;

      return redirectWithFeedback({
        type: "error",
        message,
      });
    }

    return redirectWithFeedback({
      type: "success",
      message: "Ingrediente actualizado correctamente.",
    });
  }

  if (action === "delete") {
    const ingredientId = Number(String(formData.get("ingredientId") || ""));
    if (!Number.isFinite(ingredientId)) {
      return redirectWithFeedback({
        type: "error",
        message: "No se pudo identificar el ingrediente a eliminar.",
      });
    }

    const result = await deleteIngredient(ingredientId, ownerId);

    if (result.status === "not-found") {
      return redirectWithFeedback({
        type: "error",
        message: "El ingrediente ya no existe.",
      });
    }

    if (result.status === "blocked") {
      return redirectWithFeedback({
        type: "error",
        message: "No se puede eliminar porque el ingrediente está en uso.",
        recipes: result.recipes.map((recipe) => recipe.name),
      });
    }

    return redirectWithFeedback({
      type: "success",
      message: "Ingrediente eliminado correctamente.",
    });
  }
}

const feedbackTypeParam = Astro.url.searchParams.get("type");
const feedbackType: "error" | "success" | null =
  feedbackTypeParam === "error" || feedbackTypeParam === "success"
    ? feedbackTypeParam
    : null;
const feedbackMessage = Astro.url.searchParams.get("message");
const blockedRecipes = (() => {
  const raw = Astro.url.searchParams.get("recipes");
  if (!raw) return [] as string[];
  try {
    const parsed = JSON.parse(raw) as unknown;
    if (!Array.isArray(parsed)) return [];
    return parsed.filter(
      (item): item is string =>
        typeof item === "string" && item.trim().length > 0,
    );
  } catch {
    return [] as string[];
  }
})();

const ingredients = await listIngredients(ownerId);
const ingredientUsage = await listIngredientUsage(ownerId);

void redirectWithFeedback;
---

<Layout currentPage="ingredients" showSideBar={true}>
  {
    feedbackType && feedbackMessage && (
      <FeedbackAlert
        type={feedbackType}
        message={feedbackMessage}
        recipes={blockedRecipes}
      />
    )
  }

  <Card padding="lg" class="mb-6 hidden lg:block" transition:animate="slide">
    <div
      class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between"
    >
      <div>
        <h2 class="text-foreground text-2xl font-black">Agregar Insumo</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Captura la información de tus ingredientes y empaques.
        </p>
      </div>

      <div class="text-muted-foreground text-left text-xs xl:text-right">
        <p>
          <span class="text-danger font-bold">*</span> Campos obligatorios
        </p>
        <p>Usa punto (.) o coma (,) para decimales</p>
      </div>
    </div>

    <form method="post" class="mt-6" data-ingredient-form data-astro-reload>
      <input type="hidden" name="action" value="create" />

      <div
        class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-[minmax(0,2.3fr)_minmax(0,1.5fr)_minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1.5fr)]"
      >
        <IngredientFormFields idPrefix="desktop" />
      </div>

      <div
        class="border-accent-100 bg-accent-50/70 mt-5 flex flex-col gap-4 rounded-2xl border p-4 xl:flex-row xl:items-center xl:justify-between"
      >
        <UnitCostDisplay defaultUnit={DEFAULT_UNIT} />

        <Button
          variant="primary"
          icon="plus"
          type="submit"
          data-submit-button
          disabled
          class="shadow-accent-200 min-w-52 shadow-sm"
        >
          Agregar Insumo
        </Button>
      </div>
    </form>
  </Card>

  <Card class="overflow-hidden !p-0" transition:animate="slide">
    <div class="border-border border-b px-4 py-4 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
      >
        <div>
          <div class="flex items-baseline gap-2">
            <h2 class="text-foreground text-xl font-black">Tus Ingredientes</h2>
            <span class="text-subtle-foreground text-sm font-semibold">
              ({ingredients.length})
            </span>
          </div>
          <p class="text-muted-foreground mt-1 text-sm">
            Busca por ingrediente, proveedor o marca.
          </p>
        </div>

        <div
          class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end"
        >
          <Button
            variant="primary"
            icon="plus"
            data-open-create-modal
            class="lg:hidden"
          >
            Agregar Insumo
          </Button>

          <label class="relative block w-full sm:w-80">
            <span class="sr-only">Buscar ingrediente</span>
            <span
              class="text-subtle-foreground pointer-events-none absolute inset-y-0 left-4 flex items-center"
            >
              <Icon name="lucide:search" size={16} />
            </span>
            <input
              type="search"
              placeholder="Buscar ingrediente o proveedor..."
              class={`${inputClasses} pl-11 pr-4`}
              data-ingredient-search
            />
          </label>
        </div>
      </div>
    </div>

    {
      ingredients.length > 0 ? (
        <>
          <div class="overflow-x-auto">
            <table class="min-w-full text-left">
              <thead class="bg-background text-muted-foreground text-[11px] font-bold tracking-[0.16em] uppercase">
                <tr>
                  <th class="px-6 py-4">Insumo</th>
                  <th class="px-6 py-4">Proveedor</th>
                  <th class="px-6 py-4">Precio Empaque</th>
                  <th class="px-6 py-4">Contenido</th>
                  <th class="px-6 py-4">Costo x Unidad</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-border-light divide-y">
                {ingredients.map((ingredient) => {
                  const usedRecipes = ingredientUsage[ingredient.id] || [];
                  const usedRecipesPayload = encodeURIComponent(
                    JSON.stringify(usedRecipes),
                  );
                  const ingredientPayload = encodeURIComponent(
                    JSON.stringify({
                      id: ingredient.id,
                      name: ingredient.name,
                      supplier: ingredient.supplier ?? "",
                      brand: ingredient.brand ?? "",
                      price: ingredient.price,
                      purchaseQuantity: ingredient.purchaseQuantity,
                      unit: ingredient.unit,
                    }),
                  );
                  const searchText = [
                    ingredient.name,
                    ingredient.supplier ?? "",
                    ingredient.brand ?? "",
                  ]
                    .join(" ")
                    .toLowerCase();
                  const unitCost =
                    ingredient.price / ingredient.purchaseQuantity;

                  return (
                    <tr
                      class="hover:bg-hover-muted dark:hover:bg-hover-muted transition-colors"
                      data-ingredient-row
                      data-search={searchText}
                    >
                      <td class="px-6 py-5">
                        <div class="min-w-56">
                          <p class="text-foreground font-semibold">
                            {ingredient.name}
                          </p>
                          {ingredient.brand && (
                            <p class="text-subtle-foreground mt-1 text-xs">
                              Marca: {ingredient.brand}
                            </p>
                          )}
                        </div>
                      </td>
                      <td class="px-6 py-5">
                        {ingredient.supplier ? (
                          <span class="text-secondary-foreground text-sm font-medium">
                            {ingredient.supplier}
                          </span>
                        ) : (
                          <span class="text-subtle-foreground text-sm italic">
                            Sin proveedor
                          </span>
                        )}
                      </td>
                      <td class="px-6 py-5">
                        <span class="text-secondary-foreground font-mono text-sm font-semibold tabular-nums">
                          ${ingredient.price.toFixed(2)}
                        </span>
                      </td>
                      <td class="text-muted-foreground px-6 py-5 text-sm">
                        <span class="text-secondary-foreground font-mono font-semibold">
                          {ingredient.purchaseQuantity}
                        </span>{" "}
                        <span>{ingredient.unit}</span>
                      </td>
                      <td class="px-6 py-5">
                        <span class="border-accent-100 bg-accent-50 text-accent-600 inline-flex items-center rounded-xl border px-3 py-2 font-mono text-sm font-semibold tabular-nums">
                          ${unitCost.toFixed(2)} / {ingredient.unit}
                        </span>
                      </td>
                      <td class="px-6 py-5 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <Button
                            variant="ghost"
                            icon="pencil"
                            size="sm"
                            class="text-subtle-foreground hover:bg-accent-50 hover:text-accent-600 min-h-11 min-w-11 rounded-full"
                            data-edit-trigger
                            data-ingredient-payload={ingredientPayload}
                            aria-label="Editar ingrediente"
                          />

                          <Button
                            variant="ghost"
                            icon="trash-2"
                            size="sm"
                            class="text-danger hover:bg-danger-bg hover:text-danger min-h-11 min-w-11 rounded-full"
                            title={
                              usedRecipes.length > 0
                                ? "Ingrediente en uso"
                                : "Eliminar ingrediente"
                            }
                            aria-label={
                              usedRecipes.length > 0
                                ? "Ingrediente en uso"
                                : "Eliminar ingrediente"
                            }
                            data-delete-trigger
                            data-ingredient-id={ingredient.id}
                            data-ingredient-name={ingredient.name}
                            data-used-recipes={usedRecipesPayload}
                          />
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div
            hidden
            class="border-border-light border-t px-6 py-10 text-center"
            data-ingredient-search-empty
          >
            <div class="mx-auto flex max-w-sm flex-col items-center">
              <div class="bg-muted text-subtle-foreground flex h-12 w-12 items-center justify-center rounded-2xl">
                <Icon name="lucide:search-x" size={20} />
              </div>
              <p class="text-secondary-foreground mt-4 text-sm font-semibold">
                No encontramos resultados
              </p>
              <p class="text-muted-foreground mt-1 text-sm">
                Intenta con otro nombre, proveedor o marca.
              </p>
            </div>
          </div>
        </>
      ) : (
        <div class="px-6 py-14 text-center">
          <EmptyState
            icon="lucide:package-plus"
            title="Todavía no tienes ingredientes"
            description="Agrega tu primer insumo para empezar a costear recetas y
              presentaciones."
            actionLabel="Agregar Insumo"
          />
        </div>
      )
    }
  </Card>

  <dialog
    data-animated
    id="create-ingredient-modal"
    class="fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-lg rounded-3xl p-0 backdrop:bg-backdrop/50 lg:hidden"
  >
    <div
      class="border-border bg-card max-h-[min(82vh,44rem)] overflow-y-auto rounded-3xl border p-5 pb-[calc(1.25rem+env(safe-area-inset-bottom)+4.75rem)] shadow-2xl"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-foreground text-xl font-black">Agregar Insumo</h3>
          <p class="text-muted-foreground mt-1 text-sm">
            Captura la información de tu empaque sin salir del listado.
          </p>
        </div>

        <button
          type="button"
          class="border-border text-muted-foreground hover:bg-background hover:text-secondary-foreground inline-flex h-10 w-10 items-center justify-center rounded-xl border transition-colors"
          aria-label="Cerrar modal"
          data-close-create-modal
        >
          <Icon name="lucide:x" size={18} />
        </button>
      </div>

      <form
        method="post"
        class="mt-5 space-y-4"
        data-ingredient-form
        data-astro-reload
      >
        <input type="hidden" name="action" value="create" />

        <IngredientFormFields idPrefix="mobile" />

        <div class="border-accent-100 bg-accent-50/70 rounded-2xl border p-4">
          <UnitCostDisplay defaultUnit={DEFAULT_UNIT} />
        </div>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <Button variant="secondary" data-close-create-modal>Cancelar</Button>
          <Button variant="primary" icon="plus" type="submit" data-submit-button disabled>
            Agregar Insumo
          </Button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog
    data-animated
    id="edit-ingredient-modal"
    class="fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-xl rounded-3xl p-0 backdrop:bg-backdrop/50"
  >
    <div
      class="border-border bg-card max-h-[min(82vh,44rem)] overflow-y-auto rounded-3xl border p-6 pb-[calc(1.5rem+env(safe-area-inset-bottom)+1.5rem)] shadow-2xl"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-foreground text-xl font-black">Editar ingrediente</h3>
          <p class="text-muted-foreground mt-1 text-sm">
            Ajusta todos los datos del ingrediente sin perder consistencia en el
            costeo.
          </p>
          <p
            id="edit-modal-error"
            class="text-danger mt-2 hidden text-xs font-semibold"
          >
          </p>
        </div>

        <button
          type="button"
          class="border-border text-muted-foreground hover:bg-background hover:text-secondary-foreground inline-flex h-10 w-10 items-center justify-center rounded-xl border transition-colors"
          aria-label="Cerrar modal"
          data-close-edit-modal
        >
          <Icon name="lucide:x" size={18} />
        </button>
      </div>

      <form
        method="post"
        class="mt-5 space-y-4"
        data-ingredient-form
        data-astro-reload
      >
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="ingredientId" value="" />

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="md:col-span-2">
            <label class={labelClasses} for="edit-name">
              Nombre <span class="text-danger">*</span>
            </label>
            <input
              id="edit-name"
              name="name"
              type="text"
              class={inputClasses}
              autocomplete="off"
            />
          </div>

          <div>
            <label class={labelClasses} for="edit-supplier">Proveedor</label>
            <input
              id="edit-supplier"
              name="supplier"
              type="text"
              class={inputClasses}
              autocomplete="off"
            />
          </div>

          <div>
            <label class={labelClasses} for="edit-brand">Marca</label>
            <input
              id="edit-brand"
              name="brand"
              type="text"
              class={inputClasses}
              autocomplete="off"
            />
          </div>

          <div>
            <label class={labelClasses} for="edit-price">
              Precio empaque <span class="text-danger">*</span>
            </label>
            <div class="relative">
              <span
                class="text-subtle-foreground pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm font-bold"
              >
                $
              </span>
              <input
                id="edit-price"
                name="price"
                type="text"
                inputmode="decimal"
                class={`${inputClasses} pl-8 font-mono`}
                autocomplete="off"
              />
            </div>
          </div>

          <div>
            <label class={labelClasses} for="edit-purchase-quantity">
              Cant. empaque <span class="text-danger">*</span>
            </label>
            <div
              class="border-border bg-background focus-within:border-accent-300 focus-within:bg-card focus-within:ring-accent-500/20 grid grid-cols-[minmax(0,1fr)_5.5rem] overflow-hidden rounded-xl border transition focus-within:ring-2"
            >
              <input
                id="edit-purchase-quantity"
                name="purchaseQuantity"
                type="text"
                inputmode="decimal"
                class="text-foreground placeholder:text-subtle-foreground border-0 bg-transparent px-4 py-3 font-mono text-sm outline-none"
                autocomplete="off"
              />
              <select
                name="unit"
                class="border-border bg-card text-secondary-foreground border-0 border-l px-3 py-3 text-sm font-semibold outline-none"
              >
                {
                  UNIT_OPTIONS.map((option) => (
                    <option value={option} selected={option === DEFAULT_UNIT}>
                      {option}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>
        </div>

        <div class="border-accent-100 bg-accent-50/70 rounded-2xl border p-4">
          <UnitCostDisplay defaultUnit={DEFAULT_UNIT} />
        </div>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <Button variant="secondary" data-close-edit-modal> Cancelar </Button>
          <Button
            variant="primary"
            icon="check"
            type="submit"
            data-submit-button
            disabled
          >
            Guardar cambios
          </Button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog
    data-animated
    id="delete-confirm-modal"
    class="fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0 backdrop:bg-backdrop/50"
  >
    <div class="border-border bg-card rounded-3xl border p-6 shadow-2xl">
      <div class="flex items-start gap-3">
        <div
          class="bg-danger-bg text-danger flex h-11 w-11 items-center justify-center rounded-2xl"
        >
          <Icon name="lucide:trash-2" size={18} />
        </div>
        <div>
          <h3 class="text-foreground text-lg font-bold">
            Confirmar eliminación
          </h3>
          <p class="text-muted-foreground mt-2 text-sm">
            Vas a eliminar el ingrediente <span
              id="delete-ingredient-name"
              class="text-foreground font-semibold"></span>.
          </p>
          <p
            id="delete-usage-message"
            class="text-muted-foreground mt-2 text-xs"
          >
          </p>
          <ul
            id="delete-usage-list"
            class="text-warning mt-2 list-disc space-y-1 pl-5 text-xs"
          >
          </ul>
        </div>
      </div>

      <form
        method="post"
        class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
        data-astro-reload
      >
        <input type="hidden" name="action" value="delete" />
        <input
          type="hidden"
          name="ingredientId"
          id="delete-ingredient-id"
          value=""
        />
        <Button variant="secondary" id="cancel-delete"> Cancelar </Button>
        <Button variant="danger" type="submit" id="confirm-delete">
          Eliminar
        </Button>
      </form>
    </div>
  </dialog>

  <script>
    const parseIngredientNumber = (value: unknown) => {
      const normalized = String(value ?? "")
        .trim()
        .replace(",", ".");
      if (!normalized) return Number.NaN;
      return Number(normalized);
    };

    import { formatCurrency } from "@/lib/formatters";
    import { bindDialogBackdrop } from "@/lib/dialog";

    const syncIngredientFormState = (form: HTMLElement) => {
      const nameInput = form.querySelector('[name="name"]');
      const priceInput = form.querySelector('[name="price"]');
      const quantityInput = form.querySelector('[name="purchaseQuantity"]');
      const unitInput = form.querySelector('[name="unit"]');
      const submitButton = form.querySelector("[data-submit-button]");
      const costValue = form.querySelector("[data-unit-cost-value]");
      const costUnit = form.querySelector("[data-unit-cost-unit]");

      if (!(nameInput instanceof HTMLInputElement)) return;
      if (!(priceInput instanceof HTMLInputElement)) return;
      if (!(quantityInput instanceof HTMLInputElement)) return;
      if (!(unitInput instanceof HTMLSelectElement)) return;
      if (!(costValue instanceof HTMLElement)) return;
      if (!(costUnit instanceof HTMLElement)) return;

      const price = parseIngredientNumber(priceInput.value);
      const quantity = parseIngredientNumber(quantityInput.value);
      const hasValidPrice = Number.isFinite(price) && price >= 0;
      const hasValidQuantity = Number.isFinite(quantity) && quantity > 0;
      const unitCost = hasValidPrice && hasValidQuantity ? price / quantity : 0;

      costValue.textContent = formatCurrency(unitCost);
      costUnit.textContent = unitInput.value.trim() || "unidad";

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = !(
          nameInput.value.trim().length > 0 &&
          unitInput.value.trim().length > 0 &&
          hasValidPrice &&
          hasValidQuantity
        );
      }
    };

    const bindIngredientForm = (form: Element) => {
      if (!(form instanceof HTMLFormElement)) return;
      if (form.dataset.ingredientBound === "1") return;

      form.dataset.ingredientBound = "1";

      const sync = () => syncIngredientFormState(form);
      form
        .querySelectorAll(
          'input[name="name"], input[name="price"], input[name="purchaseQuantity"]',
        )
        .forEach((field) => {
          if (!(field instanceof HTMLInputElement)) return;
          field.addEventListener("input", sync);
        });

      form.querySelectorAll('select[name="unit"]').forEach((field) => {
        if (!(field instanceof HTMLSelectElement)) return;
        field.addEventListener("change", sync);
      });

      sync();
    };

    const initIngredientCreateForm = () => {
      document.querySelectorAll("[data-ingredient-form]").forEach((form) => {
        bindIngredientForm(form);
      });
    };

    const initCreateIngredientModal = () => {
      const modal = document.getElementById("create-ingredient-modal");
      if (!(modal instanceof HTMLDialogElement)) return;

      bindDialogBackdrop(modal);

      const form = modal.querySelector("form");
      const closeButtons = modal.querySelectorAll("[data-close-create-modal]");

      closeButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (button.dataset.bound === "1") return;
        button.dataset.bound = "1";
        button.addEventListener("click", () => {
          modal.close();
        });
      });

      document
        .querySelectorAll("[data-open-create-modal]")
        .forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          if (button.dataset.bound === "1") return;
          button.dataset.bound = "1";
          button.addEventListener("click", () => {
            if (form instanceof HTMLFormElement) {
              form.reset();
              syncIngredientFormState(form);
            }
            modal.showModal();
          });
        });
    };

    const initIngredientSearch = () => {
      const searchInput = document.querySelector("[data-ingredient-search]");
      if (!(searchInput instanceof HTMLInputElement)) return;
      if (searchInput.dataset.bound === "1") return;

      const rows = Array.from(
        document.querySelectorAll("[data-ingredient-row]"),
      );
      const emptyState = document.querySelector(
        "[data-ingredient-search-empty]",
      );

      const sync = () => {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        rows.forEach((row) => {
          if (!(row instanceof HTMLTableRowElement)) return;
          const haystack = row.dataset.search || "";
          const visible = !query || haystack.includes(query);
          row.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = visibleCount > 0 || rows.length === 0;
        }
      };

      searchInput.dataset.bound = "1";
      searchInput.addEventListener("input", sync);
      sync();
    };

    const initEditIngredientModal = () => {
      const modal = document.getElementById("edit-ingredient-modal");
      if (!(modal instanceof HTMLDialogElement)) return;

      bindDialogBackdrop(modal);

      const form = modal.querySelector("form");
      if (!(form instanceof HTMLFormElement)) return;

      const idInput = form.querySelector('[name="ingredientId"]');
      const nameInput = form.querySelector('[name="name"]');
      const supplierInput = form.querySelector('[name="supplier"]');
      const brandInput = form.querySelector('[name="brand"]');
      const priceInput = form.querySelector('[name="price"]');
      const quantityInput = form.querySelector('[name="purchaseQuantity"]');
      const unitInput = form.querySelector('[name="unit"]');

      if (!(idInput instanceof HTMLInputElement)) return;
      if (!(nameInput instanceof HTMLInputElement)) return;
      if (!(supplierInput instanceof HTMLInputElement)) return;
      if (!(brandInput instanceof HTMLInputElement)) return;
      if (!(priceInput instanceof HTMLInputElement)) return;
      if (!(quantityInput instanceof HTMLInputElement)) return;
      if (!(unitInput instanceof HTMLSelectElement)) return;

      modal.querySelectorAll("[data-close-edit-modal]").forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (button.dataset.bound === "1") return;
        button.dataset.bound = "1";
        button.addEventListener("click", () => {
          modal.close();
        });
      });

      document.querySelectorAll("[data-edit-trigger]").forEach((trigger) => {
        if (!(trigger instanceof HTMLButtonElement)) return;
        if (trigger.dataset.bound === "1") return;

        trigger.dataset.bound = "1";
        trigger.addEventListener("click", () => {
          try {
            const payload = trigger.dataset.ingredientPayload;
            if (!payload) return;

            const parsed = JSON.parse(decodeURIComponent(payload));
            idInput.value = String(parsed.id ?? "");
            nameInput.value = String(parsed.name ?? "");
            supplierInput.value = String(parsed.supplier ?? "");
            brandInput.value = String(parsed.brand ?? "");

            const nextPrice = Number(parsed.price);
            priceInput.value = Number.isFinite(nextPrice)
              ? nextPrice.toFixed(2)
              : "";

            const nextQuantity = Number(parsed.purchaseQuantity);
            quantityInput.value = Number.isFinite(nextQuantity)
              ? String(nextQuantity)
              : "1";

            const nextUnit =
              typeof parsed.unit === "string" && parsed.unit.trim().length > 0
                ? parsed.unit
                : unitInput.value || "kg";
            unitInput.value = String(nextUnit);
            syncIngredientFormState(form);
            modal.showModal();
          } catch {
            const errorEl = document.getElementById("edit-modal-error");
            if (errorEl) {
              errorEl.textContent =
                "No se pudo cargar el ingrediente para editarlo.";
              errorEl.classList.remove("hidden");
              setTimeout(() => errorEl.classList.add("hidden"), 4000);
            }
            modal.showModal();
          }
        });
      });
    };

    const initDeleteModal = () => {
      const modal = document.getElementById("delete-confirm-modal");
      const ingredientName = document.getElementById("delete-ingredient-name");
      const ingredientIdInput = document.getElementById("delete-ingredient-id");
      const cancelButton = document.getElementById("cancel-delete");
      const confirmDeleteButton = document.getElementById("confirm-delete");
      const usageMessage = document.getElementById("delete-usage-message");
      const usageList = document.getElementById("delete-usage-list");

      if (!(modal instanceof HTMLDialogElement)) return;
      if (!(ingredientName instanceof HTMLElement)) return;
      if (!(ingredientIdInput instanceof HTMLInputElement)) return;
      if (!(cancelButton instanceof HTMLButtonElement)) return;
      if (!(confirmDeleteButton instanceof HTMLButtonElement)) return;
      if (!(usageMessage instanceof HTMLElement)) return;
      if (!(usageList instanceof HTMLElement)) return;

      bindDialogBackdrop(modal);

      if (cancelButton.dataset.bound !== "1") {
        cancelButton.dataset.bound = "1";
        cancelButton.addEventListener("click", () => {
          modal.close();
        });
      }

      document.querySelectorAll("[data-delete-trigger]").forEach((trigger) => {
        if (!(trigger instanceof HTMLButtonElement)) return;
        if (trigger.dataset.bound === "1") return;

        trigger.dataset.bound = "1";
        trigger.addEventListener("click", () => {
          let usedRecipes = [];

          try {
            const payload = trigger.dataset.usedRecipes;
            if (payload) {
              const parsed = JSON.parse(decodeURIComponent(payload));
              if (Array.isArray(parsed)) {
                usedRecipes = parsed.filter(
                  (item) => typeof item === "string" && item.trim().length > 0,
                );
              }
            }
          } catch {
            usedRecipes = [];
          }

          ingredientName.textContent = trigger.dataset.ingredientName || "";
          ingredientIdInput.value = trigger.dataset.ingredientId || "";
          usageList.innerHTML = "";

          if (usedRecipes.length > 0) {
            usageMessage.textContent =
              "Este ingrediente está en uso y no se puede eliminar. Se usa en:";
            usedRecipes.forEach((recipeName) => {
              const item = document.createElement("li");
              item.textContent = recipeName;
              usageList.appendChild(item);
            });
            confirmDeleteButton.disabled = true;
          } else {
            usageMessage.textContent =
              "No hay recetas relacionadas. Puedes continuar con la eliminación.";
            confirmDeleteButton.disabled = false;
          }

          modal.showModal();
        });
      });
    };

    const initIngredientsPage = () => {
      initIngredientCreateForm();
      initCreateIngredientModal();
      initIngredientSearch();
      initEditIngredientModal();
      initDeleteModal();
    };

    document.querySelectorAll("form").forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;
      const btn = form.querySelector<HTMLButtonElement>("[data-submit-button]");
      if (!btn) return;
      if (form.dataset.submitBound === "1") return;
      form.dataset.submitBound = "1";
      form.addEventListener("submit", () => {
        btn.disabled = true;
        btn.classList.add("opacity-60", "pointer-events-none");

        const overlay = document.createElement("div");
        overlay.style.cssText =
          "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(2px)";
        overlay.innerHTML = `<div style="background:var(--color-card,#fff);border-radius:1rem;padding:2rem 2.5rem;display:flex;flex-direction:column;align-items:center;gap:0.75rem;box-shadow:0 20px 60px rgba(0,0,0,0.15)">
          <svg style="animation:sp 0.7s linear infinite;width:28px;height:28px;color:var(--color-accent-600,#4f46e5)" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <span style="font-size:0.875rem;font-weight:600;color:var(--color-foreground,#0f172a)">Guardando\u2026</span>
          </div>`;
        document.body.appendChild(overlay);
        document.body.style.overflow = "hidden";
      });
    });

    document.addEventListener("astro:page-load", initIngredientsPage);
    document.addEventListener("astro:after-swap", initIngredientsPage);
    initIngredientsPage();
  </script>
</Layout>
