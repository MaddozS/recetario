---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import {
  createRecipe,
  getRecipeById,
  listRecipeSummaries,
} from "@/lib/db/recipes";
import { listIngredientUsage } from "@/lib/db/ingredients";
import { countUserRecipes } from "@/lib/db/billing";
import { canCreateRecipe } from "@/lib/subscription";
import { timeAgo } from "@/lib/formatters";
import EmptyState from "@/components/EmptyState.astro";
import RecipeMiniCard from "@/components/RecipeMiniCard.astro";
import RecipeGridCard from "@/components/RecipeGridCard.astro";
import RecipeStats from "@/components/RecipeStats.astro";

if (!Astro.locals.session || !Astro.locals.user) {
  Astro.redirect("/sign-in");
}

const ownerId = Astro.locals.user?.id;

if (!ownerId) {
  Astro.redirect("/sign-in");
}

const subscription = Astro.locals.subscription;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") || "");
  let createdRecipeId: number | null = null;

  if (action === "create_recipe") {
    const recipeCount = await countUserRecipes(ownerId as string);
    if (!canCreateRecipe(subscription, recipeCount)) {
      const errorUrl = new URL(Astro.url);
      errorUrl.searchParams.set("type", "error");
      errorUrl.searchParams.set("message", `Has alcanzado el limite de ${subscription.recipesLimit} recetas de tu plan Free. Actualiza tu plan para crear mas.`);
      errorUrl.searchParams.set("upgrade", "1");
      return Astro.redirect(errorUrl.toString());
    }

    createdRecipeId = (
      await createRecipe(
        ownerId,
        { name: String(formData.get("recipeName") || "") },
      )
    ).id;
  }

  if (createdRecipeId !== null) {
    return Astro.redirect(`/recipes/${createdRecipeId}?edit=true`);
  }
}

const recipes = await listRecipeSummaries(ownerId);

if (recipes.length === 1) {
  const recipe = await getRecipeById(recipes[0].id, ownerId);
  if (recipe) {
    return Astro.redirect(`/recipes/${recipes[0].id}`);
  }
}

const ingredientUsage = recipes.length > 0 ? await listIngredientUsage(ownerId) : {};
const categoryCount = new Set(recipes.filter((r) => r.category).map((r) => r.category)).size;
const usedIngredientCount = Object.keys(ingredientUsage).length;

const selectedCategory = Astro.url.searchParams.get("category") ?? null;
const filteredRecipes = selectedCategory !== null
  ? recipes.filter((r) => (r.category ?? null) === (selectedCategory || null))
  : null;
const recipesJson = JSON.stringify(recipes);

const incompleteRecipes = recipes.filter((r) => r.ingredientCount === 0).length;
const noCategoryRecipes = recipes.filter((r) => !r.category).length;

const lastUpdated = recipes.reduce<string | null>((latest, r) => {
  if (!r.updatedAt) return latest;
  return !latest || r.updatedAt > latest ? r.updatedAt : latest;
}, null);
const lastUpdatedLabel = lastUpdated ? timeAgo(lastUpdated) : "Sin actividad";

const recentRecipes = recipes
  .filter((r) => r.updatedAt)
  .sort((a, b) => new Date(b.updatedAt!).getTime() - new Date(a.updatedAt!).getTime())
  .slice(0, 5)
  .map((r) => ({ id: r.id, name: r.name, category: r.category, timeAgo: timeAgo(r.updatedAt!) }));

const feedbackType = Astro.url.searchParams.get("type");
const feedbackMessage = Astro.url.searchParams.get("message");
const showUpgradeModal = Astro.url.searchParams.get("upgrade") === "1";
---

<Layout currentPage="recipes" showSideBar={true}>
  {
    feedbackType === "error" && feedbackMessage && (
      <div class="mx-auto mb-6 max-w-3xl rounded-2xl border border-danger-border bg-danger-bg px-4 py-3 text-sm font-semibold text-danger">
        {feedbackMessage}
        <a href="/pricing" class="ml-2 font-bold underline">Actualizar plan</a>
      </div>
    )
  }

  {
    recipes.length === 0 ? (
      <section
        class="mx-auto max-w-3xl rounded-2xl border border-border bg-card p-8 shadow-md"
      >
        <EmptyState
          icon="lucide:book-plus"
          iconSize={28}
          title="Todavia no tienes recetas"
          description="Entra por primera vez al recetario desde aqui y crea tu primera receta. El
          boton del sidebar ya funciona tambien para este estado vacio."
          titleTag="h1"
          titleClasses="mt-6 text-3xl font-black text-foreground"
          descClasses="mt-3 text-base text-muted-foreground"
        />

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <button
            type="button"
            data-open-create-recipe-dialog="create-recipe-dialog"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-accent-600 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-700"
          >
            <Icon name="lucide:plus" size={16} />
            Crear primera receta
          </button>
          <a
            href="/ingredients"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-border px-5 py-3 text-sm font-bold text-muted-foreground transition-colors hover:bg-background"
          >
            <Icon name="lucide:package-search" size={16} />
            Ver ingredientes
          </a>
        </div>
      </section>
    ) : (
      <div class="space-y-8">
        <RecipeStats
          recipeCount={recipes.length}
          categoryCount={categoryCount}
          ingredientCount={usedIngredientCount}
        />

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:alert-triangle" size={14} />
              Recetas por completar
            </div>
            {
              incompleteRecipes > 0 ? (
                <div class="mt-2">
                  <p class="font-bold text-foreground">{incompleteRecipes} recetas</p>
                  <p class="text-sm text-muted-foreground">sin ingredientes asignados</p>
                </div>
              ) : (
                <p class="mt-2 text-sm font-medium text-success">Todas tienen ingredientes</p>
              )
            }
          </div>

          <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:tag" size={14} />
              Sin categoría
            </div>
            {
              noCategoryRecipes > 0 ? (
                <div class="mt-2">
                  <p class="font-bold text-foreground">{noCategoryRecipes} recetas</p>
                  <p class="text-sm text-muted-foreground">sin categoría asignada</p>
                </div>
              ) : (
                <p class="mt-2 text-sm font-medium text-success">Todas están categorizadas</p>
              )
            }
          </div>

          <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:clock" size={14} />
              Última modificación
            </div>
            <p class="mt-2 font-bold text-foreground">
              {lastUpdatedLabel}
            </p>
          </div>
        </div>

        {
          recentRecipes.length > 0 && (
            <div>
              <h2 class="mb-3 text-sm font-bold uppercase tracking-[0.12em] text-muted-foreground">
                Recientemente actualizadas
              </h2>
              <div class="flex gap-3 overflow-x-auto pb-3">
                {
                  recentRecipes.map((r) => (
                    <div class="w-48 flex-none">
                      <RecipeMiniCard
                        id={r.id}
                        name={r.name}
                        category={r.category}
                        timeAgo={r.timeAgo}
                      />
                    </div>
                  ))
                }
              </div>
            </div>
          )
        }

        <div id="categories-container">
          <script type="application/json" id="recipes-data" is:inline set:html={recipesJson}></script>

          <h2 class="mb-3 text-sm font-bold uppercase tracking-[0.12em] text-muted-foreground">
            Categorías
          </h2>
          <div class="flex flex-wrap items-center gap-2">
            {
              [...new Set(recipes.filter((r) => r.category).map((r) => r.category!))].map(
                (cat) => {
                  const count = recipes.filter((r) => r.category === cat).length;
                  const active = selectedCategory !== null && selectedCategory === cat;
                  return (
                    <button
                      type="button"
                      data-category={cat}
                      class={`filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold transition-colors ${active ? "bg-accent-600 text-white" : "bg-accent-50 text-accent-600 hover:bg-accent-100 border border-accent-200"}`}
                    >
                      {cat}
                      <span class={`inline-flex min-w-5 items-center justify-center rounded-full px-1 text-[11px] font-bold ${active ? "bg-accent-500 text-white" : "bg-accent-200/50 text-accent-700"}`}>
                        {count}
                      </span>
                    </button>
                  );
                },
              )
            }
            {
              noCategoryRecipes > 0 && (
                <button
                  type="button"
                  data-category=""
                  class={`filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold transition-colors ${selectedCategory === "" ? "bg-accent-600 text-white" : "bg-muted text-muted-foreground hover:bg-border border border-border"}`}
                >
                  Sin categoría
                  <span class={`inline-flex min-w-5 items-center justify-center rounded-full px-1 text-[11px] font-bold ${selectedCategory === "" ? "bg-accent-500 text-white" : "bg-border text-subtle-foreground"}`}>
                    {noCategoryRecipes}
                  </span>
                </button>
              )
            }
            <button
              type="button"
              id="clear-filter-btn"
              style={`display:${selectedCategory !== null ? "" : "none"}`}
              class="inline-flex items-center gap-1 rounded-full border border-border bg-card px-3 py-1.5 text-sm font-semibold text-muted-foreground transition-colors hover:bg-background"
            >
              <Icon name="lucide:x" size={12} />
              Limpiar filtro
            </button>
          </div>
          {
            selectedCategory !== null && (
              <div id="filtered-grid-wrapper" class="mt-4">
                {
                  filteredRecipes && filteredRecipes.length > 0 ? (
                    <div id="filtered-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                      {filteredRecipes.map((r, i) => (
                        <div style={`--stagger-index:${i}`}>
                          <RecipeGridCard
                            id={r.id}
                            name={r.name}
                            category={r.category}
                            ingredientCount={r.ingredientCount}
                          />
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div id="filtered-empty" class="rounded-2xl border border-border bg-card p-8 text-center shadow-sm">
                      <p class="text-muted-foreground">No hay recetas en esta categoría</p>
                    </div>
                  )
                }
              </div>
            )
          }
        </div>
      </div>
    )
  }

  <dialog data-animated id="upgrade-modal" class="fixed inset-0 m-auto w-[92vw] max-w-md rounded-3xl border border-border p-0 shadow-2xl backdrop:bg-slate-900/40">
    <div class="rounded-3xl bg-card p-6">
      <div class="flex items-start gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
          <Icon name="lucide:zap" size={18} />
        </div>
        <div>
          <h2 class="text-lg font-bold text-foreground">Limite alcanzado</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Has alcanzado el limite de {subscription.recipesLimit} recetas en tu plan {subscription.tier === 'free' ? 'Free' : subscription.tier}.
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            Actualiza a Basic o Pro para crear recetas ilimitadas.
          </p>
        </div>
      </div>
      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" data-close-upgrade-modal class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border bg-card px-5 py-3 text-sm font-bold text-muted-foreground transition-colors hover:bg-background">
          Entendido
        </button>
        <a href="/pricing" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-accent-600 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-700">
          <Icon name="lucide:arrow-up-circle" size={16} />
          Ver planes
        </a>
      </div>
    </div>
  </dialog>

  <script>

    function setupCategoryFilter() {
      const dataEl = document.getElementById("recipes-data");
      const container = document.getElementById("categories-container");
      if (!dataEl || !dataEl.textContent || !container) return;
      const recipesData = JSON.parse(dataEl.textContent);
      const pills = document.querySelectorAll(".filter-btn");
      const clearBtn = document.getElementById("clear-filter-btn");
      let gridWrapper = document.getElementById("filtered-grid-wrapper");

      function getOrCreateWrapper() {
        if (gridWrapper) return gridWrapper;
        const w = document.createElement("div");
        w.id = "filtered-grid-wrapper";
        w.className = "mt-4";
        container.appendChild(w);
        gridWrapper = w;
        return w;
      }

      function removeWrapper() {
        if (gridWrapper) {
          gridWrapper.remove();
          gridWrapper = null;
        }
      }

      const activeClasses =
        ["bg-accent-600", "text-white"];
      const inactiveClasses = {
        normal: ["bg-accent-50", "text-accent-600", "hover:bg-accent-100"],
        uncategorized: ["bg-muted", "text-muted-foreground", "hover:bg-border"],
      };

      function escapeHtml(str) {
        const d = document.createElement("div");
        d.textContent = str;
        return d.innerHTML;
      }

      function createCard(r) {
        const a = document.createElement("a");
        a.href = `/recipes/${r.id}`;
        a.className =
          "recipe-grid-card group block rounded-2xl border border-border bg-card p-5 shadow-sm hover:border-accent-300 hover:bg-accent-50/30 hover:shadow-md active:scale-[0.98]";
        a.style.transition =
          "transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out), border-color 160ms var(--ease-out), background-color 160ms var(--ease-out)";
        a.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="truncate font-bold text-secondary-foreground transition-colors group-hover:text-accent-700">${escapeHtml(r.name)}</h3>
              <div class="mt-2 flex flex-wrap items-center gap-2">
                ${r.category ? `<span class="inline-flex items-center rounded-full bg-accent-50 px-2.5 py-0.5 text-[11px] font-semibold text-accent-600 border border-accent-200">${escapeHtml(r.category)}</span>` : ""}
                <span class="text-xs text-muted-foreground">${r.ingredientCount} ${r.ingredientCount === 1 ? "ingrediente" : "ingredientes"}</span>
              </div>
            </div>
            <svg class="mt-1 flex-none text-subtle-foreground transition-colors group-hover:text-accent-500" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>`;
        return a;
      }

      function renderGrid(category) {
        if (category === null) {
          removeWrapper();
          return;
        }

        const catKey = category || "";
        const recipes = recipesData.filter((r) => (r.category || "") === catKey);

        const wrapper = getOrCreateWrapper();

        if (recipes.length === 0) {
          wrapper.innerHTML = `<div class="rounded-2xl border border-border bg-card p-8 text-center shadow-sm"><p class="text-muted-foreground">No hay recetas en esta categor\u00eda</p></div>`;
          return;
        }

        const grid = document.createElement("div");
        grid.id = "filtered-grid";
        grid.className = "grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3";
        recipes.forEach((r, i) => {
          const card = createCard(r);
          card.style.setProperty("--stagger-index", String(i));
          grid.appendChild(card);
        });
        wrapper.innerHTML = "";
        wrapper.appendChild(grid);
      }

      function setActive(index) {
        pills.forEach((pill) => {
          const pillCat = pill.dataset.category ?? null;
          const isActive = pillCat === index;

          if (isActive) {
            pill.classList.remove(
              ...inactiveClasses.normal,
              ...inactiveClasses.uncategorized,
            );
            pill.classList.add(...activeClasses);
            const span = pill.querySelector("span");
            if (span) {
              span.classList.remove(
                "bg-accent-200/50",
                "text-accent-700",
                "bg-border",
                "text-subtle-foreground",
                "bg-accent-500",
                "text-white",
              );
              span.classList.add("bg-accent-500", "text-white");
            }
          } else {
            pill.classList.remove(...activeClasses);
            const useUncategorized = pillCat === "";
            if (useUncategorized) {
              pill.classList.add(...inactiveClasses.uncategorized);
            } else {
              pill.classList.add(...inactiveClasses.normal);
            }
            const span = pill.querySelector("span");
            if (span) {
              span.classList.remove("bg-accent-500", "text-white");
              if (useUncategorized) {
                span.classList.add("bg-border", "text-subtle-foreground");
              } else {
                span.classList.add("bg-accent-200/50", "text-accent-700");
              }
            }
          }
        });

        if (clearBtn) {
          clearBtn.style.display = index === null ? "none" : "";
        }
      }

      pills.forEach((pill) => {
        if (pill.dataset.filterBound === "1") return;
        pill.dataset.filterBound = "1";
        pill.addEventListener("click", () => {
          const cat = pill.dataset.category ?? "";
          renderGrid(cat);
          setActive(cat);
          const url = `/recipes?category=${encodeURIComponent(cat)}`;
          history.pushState({}, "", url);
        });
      });

      if (clearBtn && clearBtn.dataset.filterBound !== "1") {
        clearBtn.dataset.filterBound = "1";
        clearBtn.addEventListener("click", () => {
          renderGrid(null);
          setActive(null);
          history.pushState({}, "", "/recipes");
        });
      }
    }

    document.addEventListener("astro:page-load", setupCategoryFilter);
    document.addEventListener("astro:after-swap", setupCategoryFilter);
    setupCategoryFilter();
  </script>
</Layout>

{
  showUpgradeModal && (
    <script>
      requestAnimationFrame(() => {
        const modal = document.getElementById('upgrade-modal');
        if (modal instanceof HTMLDialogElement) {
          modal.showModal();
        }

        document.querySelectorAll('[data-close-upgrade-modal]').forEach(btn => {
          if (btn instanceof HTMLButtonElement && btn.dataset.bound !== '1') {
            btn.dataset.bound = '1';
            btn.addEventListener('click', () => {
              (document.getElementById('upgrade-modal') as HTMLDialogElement | null)?.close();
            });
          }
        });
      });
    </script>
  )
}
