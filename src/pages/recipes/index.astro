---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import {
  createRecipe,
  getRecipeById,
  getRecipeDataOwner,
  listRecipeSummaries,
} from "../../lib/recipe-data";
import EmptyState from "../../components/EmptyState.astro";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const recipeDataOwner = getRecipeDataOwner(Astro.locals.user);

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") || "");
  let createdRecipeId: number | null = null;

  if (action === "create_recipe") {
    createdRecipeId = (
      await createRecipe(
        { name: String(formData.get("recipeName") || "") },
        recipeDataOwner,
      )
    ).id;
  }

  if (createdRecipeId !== null) {
    return Astro.redirect(`/recipes/${createdRecipeId}?edit=true`);
  }
}

const recipes = await listRecipeSummaries(recipeDataOwner);

for (const recipeSummary of recipes) {
  const recipe = await getRecipeById(recipeSummary.id, recipeDataOwner);

  if (recipe) {
    return Astro.redirect(`/recipes/${recipeSummary.id}`);
  }
}
---

<Layout currentPage="recipes" showSideBar={true}>
  <section
    class="mx-auto max-w-3xl rounded-3xl border border-slate-200 bg-white p-8 shadow-sm"
  >
    <EmptyState
      icon="lucide:book-plus"
      iconSize={28}
      title="Todavia no tienes recetas"
      description="Entra por primera vez al recetario desde aqui y crea tu primera receta. El
      boton del sidebar ya funciona tambien para este estado vacio."
      titleTag="h1"
      titleClasses="mt-6 text-3xl font-black text-slate-900"
      descClasses="mt-3 text-base text-slate-600"
    />

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <button
        type="button"
        data-open-create-recipe-dialog="create-recipe-dialog"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-indigo-700"
      >
        <Icon name="lucide:plus" size={16} />
        Crear primera receta
      </button>
      <a
        href="/ingredients"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-50"
      >
        <Icon name="lucide:package-search" size={16} />
        Ver ingredientes
      </a>
    </div>
  </section>
</Layout>
