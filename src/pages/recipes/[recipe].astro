---
import type { Ingredient, RecipeIngredientWithData, RecipeIngredient } from '@/lib/db/types';
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PresentationCard from "../../components/PresentationCard.astro";
import {
  getRecipeById,
  deleteRecipe,
  duplicateRecipe,
  updateRecipe,
} from '@/lib/db/recipes';
import { listIngredients } from '@/lib/db/ingredients';
import {
  createPresentation,
  updatePresentation,
  deletePresentation,
} from '@/lib/db/presentations';
import { hasFeature } from '@/lib/subscription';
import { parseNumberInput } from '@/lib/form-utils';
import { sanitizeHtml } from '@/lib/html-sanitizer';
import { UNIT_OPTIONS } from '@/lib/constants';
import FeedbackAlert from '../../components/FeedbackAlert.astro';
import InstructionsEditor from '../../components/InstructionsEditor.astro';
import RecipeInstructions from '../../components/RecipeInstructions.astro';

const recipeIdParam = Astro.params.recipe;
const recipeIdNumber = Number(recipeIdParam);

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect('/sign-in');
}

const ownerId = Astro.locals.user!.id;
const subscription = Astro.locals.subscription;

const expectsJsonResponse = Astro.request.headers.get('accept')?.includes('application/json') ?? false;

const buildPresentationSectionUrl = (feedback?: { type: 'success' | 'error'; message: string }) => {
  const nextUrl = new URL(Astro.url);

  if (feedback) {
    nextUrl.searchParams.set('type', feedback.type);
    nextUrl.searchParams.set('message', feedback.message);
  } else {
    nextUrl.searchParams.delete('type');
    nextUrl.searchParams.delete('message');
  }

  nextUrl.hash = '#presentaciones';
  return `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`;
};

const redirectToPresentationSection = (feedback?: { type: 'success' | 'error'; message: string }) => (
  Astro.redirect(buildPresentationSectionUrl(feedback))
);

const buildRecipePageUrl = (feedback?: { type: 'success' | 'error'; message: string }) => {
  const nextUrl = new URL(Astro.url);

  if (feedback) {
    nextUrl.searchParams.set('type', feedback.type);
    nextUrl.searchParams.set('message', feedback.message);
  } else {
    nextUrl.searchParams.delete('type');
    nextUrl.searchParams.delete('message');
  }

  nextUrl.hash = '';
  return `${nextUrl.pathname}${nextUrl.search}`;
};

const redirectToRecipePage = (feedback?: { type: 'success' | 'error'; message: string }) => (
  Astro.redirect(buildRecipePageUrl(feedback))
);

const jsonResponse = (body: unknown, status = 200) => new Response(JSON.stringify(body), {
  status,
  headers: {
    'Content-Type': 'application/json',
  },
});

const respondPresentationError = (message: string, status = 400) => {
  if (expectsJsonResponse) {
    return new Response(message, { status });
  }
  return redirectToPresentationSection({ type: 'error', message });
};

const respondRecipeError = (message: string, status = 500) => {
  if (expectsJsonResponse) {
    return jsonResponse({ error: message }, status);
  }
  return redirectToRecipePage({ type: 'error', message });
};

const getPresentationFormErrorMessage = (error: unknown, fallback: string) => {
  if (!(error instanceof Error) || !error.message) {
    return fallback;
  }

  switch (error.message) {
    case 'Invalid presentation name':
      return 'El nombre de la presentación es obligatorio.';
    case 'Invalid presentation units':
      return 'Las piezas por mezcla deben ser mayores a 0.';
    case 'Invalid presentation sale price':
      return 'El precio de venta debe ser 0 o mayor.';
    case 'Recipe not found':
      return 'No se encontró la receta.';
    default:
      return fallback;
  }
};

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') || '');

  if (action === 'update_presentation') {
    const presId = Number(formData.get('presentationId'));
    const presentationName = String(formData.get('presentationName') || '');
    const unitsPerBatch = parseNumberInput(formData.get('unitsPerBatch'));
    const rawSalePrice = String(formData.get('salePrice') ?? '').trim();
    const salePrice = parseNumberInput(formData.get('salePrice'));
    const nextSalePrice = formData.has('salePrice')
      ? rawSalePrice === ''
        ? null
        : salePrice
      : undefined;

    if (!Number.isFinite(recipeIdNumber) || !Number.isFinite(presId)) {
      return respondPresentationError('No se pudo actualizar la presentación.');
    }

    try {
      const presentation = await updatePresentation(recipeIdNumber, presId, {
        name: presentationName,
        unitsPerBatch,
        salePrice: nextSalePrice,
      }, ownerId);

      if (!presentation) {
        return respondPresentationError('No se encontró la presentación.', 404);
      }

      if (expectsJsonResponse) {
        return jsonResponse({ presentation });
      }

      return redirectToPresentationSection();
    } catch (error) {
      return respondPresentationError(
        getPresentationFormErrorMessage(error, 'No se pudo actualizar la presentación.'),
      );
    }
  } else if (action === 'delete_presentation') {
    const presId = Number(formData.get('presentationId'));

    if (!Number.isFinite(recipeIdNumber) || !Number.isFinite(presId)) {
      return respondPresentationError('No se pudo eliminar la presentación.');
    }

    try {
      const result = await deletePresentation(recipeIdNumber, presId, ownerId);

      if (result.status === 'not-found') {
        return respondPresentationError('No se encontró la presentación.', 404);
      }

      if (expectsJsonResponse) {
        return jsonResponse({ deleted: true, presentationId: presId });
      }

      return redirectToPresentationSection({ type: 'success', message: 'Presentación eliminada correctamente.' });
    } catch {
      return respondPresentationError('No se pudo eliminar la presentación.');
    }
  } else if (action === 'create_presentation') {
    const presentationName = String(formData.get('presentationName') || '').trim();
    const unitsPerBatch = parseNumberInput(formData.get('unitsPerBatch'));
    const salePriceValue = String(formData.get('salePrice') || '').trim();
    const salePrice = parseNumberInput(formData.get('salePrice'));

    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    if (!presentationName) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'El nombre de la presentación es obligatorio.',
      });
    }

    if (!Number.isFinite(unitsPerBatch) || unitsPerBatch <= 0) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'Las piezas por mezcla deben ser mayores a 0.',
      });
    }

    if (salePriceValue && (!Number.isFinite(salePrice) || salePrice < 0)) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'El precio de venta debe ser 0 o mayor.',
      });
    }

    try {
      await createPresentation(recipeIdNumber, {
        name: presentationName,
        unitsPerBatch,
        salePrice: salePriceValue ? salePrice : undefined,
      }, ownerId);
      return redirectToPresentationSection();
    } catch (error) {
      return redirectToPresentationSection({
        type: 'error',
        message: getPresentationFormErrorMessage(error, 'No se pudo crear la presentación.'),
      });
    }
  } else if (action === 'delete_recipe') {
    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    try {
      const result = await deleteRecipe(recipeIdNumber, ownerId);

      if (result.status === 'not-found') {
        return Astro.redirect('/recipes');
      }

      return Astro.redirect('/recipes');
    } catch {
      return redirectToRecipePage({
        type: 'error',
        message: 'No se pudo eliminar la receta.',
      });
    }
  } else if (action === 'duplicate_recipe') {
    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    if (!hasFeature(subscription, 'recipe_duplicate')) {
      if (expectsJsonResponse) {
        return jsonResponse({ error: 'Funcionalidad no disponible en tu plan.' }, 403);
      }
      return redirectToRecipePage({ type: 'error', message: 'Funcionalidad no disponible en tu plan.' });
    }

    try {
      const duplicated = await duplicateRecipe(recipeIdNumber, ownerId);
      const redirectUrl = new URL(Astro.url);
      redirectUrl.pathname = `/recipes/${duplicated.id}`;
      redirectUrl.searchParams.set('edit', 'true');
      redirectUrl.searchParams.set('type', 'success');
      redirectUrl.searchParams.set('message', `Receta "${duplicated.name}" creada exitosamente.`);
      return Astro.redirect(redirectUrl.toString());
    } catch (error) {
      return respondRecipeError(
        error instanceof Error && error.message === 'Recipe not found'
          ? 'No se encontró la receta original.'
          : 'Error al duplicar la receta.',
        500,
      );
    }
  } else if (action === 'update_recipe') {
    if (Number.isFinite(recipeIdNumber)) {
      const name = String(formData.get('recipeName') || '');
      const ingredientIds = formData.getAll('ingredientId').map(String);
      const quantities = formData.getAll('quantity').map(String);
      const units = formData.getAll('unit').map(String);
      const comments = formData.getAll('comment').map(String);

      const ingredientsToSave = [];
      for (let i = 0; i < ingredientIds.length; i++) {
        const id = Number(ingredientIds[i]);
        const q = Number(quantities[i]);
        if (Number.isFinite(id) && Number.isFinite(q)) {
          ingredientsToSave.push({
            ingredientId: id,
            quantity: q,
            unit: units[i] || '',
            comment: comments[i] || null,
          });
        }
      }

      const desiredMargin = Number(formData.get('desiredMargin')) || 0;
      const fixedCostsPercentage = Number(formData.get('fixedCostsPercentage')) || 0;
      const category = String(formData.get('category') || '').trim() || null;
      const rawInstructions = String(formData.get('instructions') || '').trim();
      const instructions = rawInstructions ? sanitizeHtml(rawInstructions) : undefined;

      await updateRecipe(recipeIdNumber, {
        name,
        category,
        instructions,
        desiredMargin,
        fixedCostsPercentage,
        ingredients: ingredientsToSave,
      }, ownerId);
      return Astro.redirect(Astro.url.pathname);
    }
  }
}

// Obtener el ID de la receta desde los parámetros
if (!recipeIdParam) {
  return Astro.redirect('/recipes');
}

// Obtener la receta desde la base de datos
const recipe = await getRecipeById(recipeIdParam, ownerId);
if (!recipe) {
  return Astro.redirect('/recipes');
}

const { ingredients: recipeIngredients, name, category, instructions, id, desiredMargin, fixedCostsPercentage, presentations, updatedAt } = recipe;
const ingredients = recipeIngredients.map((ri) => ({ id: ri.ingredient.id, name: ri.ingredient.name }));
const recipeIngredientIds = recipeIngredients.map((ri) => ri.ingredient.id);
const hasCookingMode = hasFeature(Astro.locals.subscription, "cooking_mode");

const isEditMode = Astro.url.searchParams.get('edit') === 'true';
const allIngredients = isEditMode ? await listIngredients(ownerId) : [];
const discoveredUnitOptions = [
  ...allIngredients.map((ingredient) => ingredient.unit),
  ...recipeIngredients.map((ingredient) => ingredient.unit),
]
  .map((unit) => unit.trim())
  .filter((unit) => unit.length > 0);
const unitOptions = Array.from(new Set([...UNIT_OPTIONS, ...discoveredUnitOptions]));
const getUnitOptionsForValue = (currentUnit: string) => {
  if (unitOptions.includes(currentUnit)) {
    return unitOptions.map((unit) => ({ value: unit, label: unit }));
  }

  return [
    {
      value: currentUnit,
      label: currentUnit.trim().length > 0 ? currentUnit : 'Sin unidad',
    },
    ...unitOptions.map((unit) => ({ value: unit, label: unit })),
  ];
};

let lastUpdatedText = '';
if (updatedAt) {
  const d = new Date(updatedAt);
  const now = new Date();
  const isToday = d.getDate() === now.getDate() && d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
  
  const timeOpts: Intl.DateTimeFormatOptions = { hour: 'numeric', minute: '2-digit', hour12: true };
  const timeStr = d.toLocaleTimeString('es-MX', timeOpts);
  
  if (isToday) {
    lastUpdatedText = `Hoy, ${timeStr}`;
  } else {
    lastUpdatedText = `${d.toLocaleDateString('es-MX')} ${timeStr}`;
  }
}

// Multiplicador de batch (ej. 2 = doble receta)
const multiplierParam = Astro.url.searchParams.get('multiplier');
const multiplier = Math.max(parseFloat(multiplierParam ?? '1') || 1, 0.01);
const showAdjustedQuantity = Math.abs(multiplier - 1) > 0.0001;
const multiplierStep = multiplier >= 2 ? 1 : 0.5;
const normalizeMultiplier = (value: number) => Math.round(value * 10000) / 10000;
const decrementMultiplier = normalizeMultiplier(Math.max(multiplier - multiplierStep, 0.01));
const incrementMultiplier = normalizeMultiplier(multiplier + multiplierStep);
const multiplierDownHref = `${Astro.url.pathname}?multiplier=${decrementMultiplier}`;
const multiplierUpHref = `${Astro.url.pathname}?multiplier=${incrementMultiplier}`;
const recipeEditFormId = 'recipe-edit-form';
const recipeDeleteFormId = 'recipe-delete-form';
const recipeDeleteDialogId = 'recipe-delete-dialog';
const createPresentationDialogId = 'create-presentation-dialog';
const recipeDuplicateDialogId = 'recipe-duplicate-dialog';
const recipeDeleteButtonClasses = 'col-span-2 inline-flex w-full min-h-11 items-center justify-center gap-2 rounded-xl border border-danger-border bg-card px-5 py-3 text-sm font-bold text-danger transition-colors hover:bg-danger-bg hover:text-danger sm:col-auto sm:w-auto';
const ingredientRemoveButtonClasses = 'remove-ingredient-btn inline-flex h-9 w-9 items-center justify-center rounded-full text-danger transition-colors hover:bg-danger-bg hover:text-danger';

const clampPercentageValue = (value: number, max = Number.POSITIVE_INFINITY) => {
  if (!Number.isFinite(value)) return 0;
  return Math.min(max, Math.max(0, value));
};

const desiredMarginValue = clampPercentageValue(desiredMargin, 99.99);
const fixedCostsPercentageValue = clampPercentageValue(fixedCostsPercentage);
const feedbackTypeParam = Astro.url.searchParams.get('type');
const feedbackType = (feedbackTypeParam === 'error' || feedbackTypeParam === 'success') ? feedbackTypeParam : null;
const feedbackMessage = Astro.url.searchParams.get('message');

// Redondeo contable para unidades pequeñas (g/ml)
const roundHalfUp = (value: number) => {
  return value >= 0 ? Math.floor(value + 0.5) : Math.ceil(value - 0.5);
};

const aplicarRedondeoUnidadPequena = (cantidad: number, unidad: string) => {
  const u = unidad.toLowerCase();
  if (u === 'g' || u === 'ml') {
    return roundHalfUp(cantidad);
  }
  return cantidad;
};

const formatCantidad = (cantidad: number, unidad: string) => {
  const ajustada = aplicarRedondeoUnidadPequena(cantidad, unidad);
  const u = unidad.toLowerCase();
  return (u === 'g' || u === 'ml') ? ajustada.toString() : ajustada.toFixed(2);
};

// --- Helpers de Cálculo ---
  
const getCostoBaseCompra = (insumo: Ingredient) => {
  if (insumo.purchaseQuantity === 0) return 0;
  return insumo.price / insumo.purchaseQuantity;
};

const calcularSubtotalIngrediente = (ri: RecipeIngredient, insumo: Ingredient) => {
  if (!insumo) return 0;
  
  let cantidadAjustada = aplicarRedondeoUnidadPequena(ri.quantity * multiplier, ri.unit);
  const unidadInsumo = insumo.unit.toLowerCase();
  const unidadReceta = ri.unit.toLowerCase();

  // Conversión inteligente: si el insumo es kg/lt y la receta usa g/ml
  if ((unidadInsumo === 'kg' || unidadInsumo === 'lt') && 
      (unidadReceta === 'g' || unidadReceta === 'ml')) {
    cantidadAjustada = cantidadAjustada / 1000;
  }
  
  return getCostoBaseCompra(insumo) * cantidadAjustada;
};

const calcularCostoDirecto = (ingredients: RecipeIngredientWithData[]) => {
  return ingredients.reduce((total, ri) => {
    return total + calcularSubtotalIngrediente(ri, ri.ingredient!);
  }, 0);
};

const costoDirectoTotal = calcularCostoDirecto(recipeIngredients);
const costoOperativo = costoDirectoTotal * (fixedCostsPercentageValue / 100);
const costoProduccionRealBatch = costoDirectoTotal + costoOperativo;
const precioVentaSugeridoBatch = costoProduccionRealBatch / (1 - (desiredMarginValue / 100));

void redirectToPresentationSection;
void redirectToRecipePage;
void jsonResponse;
void respondPresentationError;
void respondRecipeError;
void getPresentationFormErrorMessage;

---

<Layout currentRecipe={id} showSideBar={true} currentPage="recipes">
  <div transition:animate="slide" class="w-full">
    <div class="px-1 sm:px-2 lg:px-8 py-4">
      {feedbackType && feedbackMessage && (
        <FeedbackAlert type={feedbackType} message={feedbackMessage} />
      )}

      {isEditMode && (
        <form id={recipeEditFormId} method="POST" action={Astro.url.pathname} class="hidden" data-astro-reload>
          <input type="hidden" name="action" value="update_recipe" />
          <input type="hidden" name="instructions" value={instructions || ""} data-hidden-ta />
        </form>
      )}

      <form id={recipeDeleteFormId} method="POST" action={Astro.url.pathname} class="hidden" data-astro-reload>
        <input type="hidden" name="action" value="delete_recipe" />
      </form>

      {isEditMode && (
        <dialog
          id={recipeDeleteDialogId}
          class="fixed inset-0 m-auto w-[calc(100vw-1.5rem)] max-w-md rounded-3xl p-0 backdrop:bg-slate-900/55"
        >
          <div class="rounded-3xl border border-border bg-card p-6 shadow-2xl">
            <div class="flex items-start gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-danger-bg text-danger">
                <Icon name="lucide:trash-2" size={18} />
              </div>
              <div>
                <h2 class="text-lg font-bold text-foreground">Confirmar eliminación</h2>
                <p class="mt-2 text-sm text-muted-foreground">
                  ¿Eliminar esta receta? Esta acción no se puede deshacer.
                </p>
              </div>
            </div>

            <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
              <button
                type="button"
                data-close-recipe-delete-dialog={recipeDeleteDialogId}
                class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border bg-card px-5 py-3 text-sm font-bold text-muted-foreground transition-colors hover:bg-background"
              >
                Cancelar
              </button>
              <button
                type="submit"
                form={recipeDeleteFormId}
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-danger-solid px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-danger-solid"
              >
                <Icon name="lucide:trash-2" size={16} /> Eliminar
              </button>
            </div>
          </div>
        </dialog>
      )}

      {hasFeature(subscription, 'recipe_duplicate') && (
        <dialog
          id={recipeDuplicateDialogId}
          class="fixed inset-0 m-auto w-[calc(100vw-1.5rem)] max-w-md rounded-3xl p-0 backdrop:bg-slate-900/55"
        >
          <div class="rounded-3xl border border-border bg-card p-6 shadow-2xl">
            <div class="flex items-start gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
                <Icon name="lucide:copy" size={18} />
              </div>
              <div>
                <h2 class="text-lg font-bold text-foreground">Duplicar receta</h2>
                <p class="mt-2 text-sm text-muted-foreground">
                  Se creará una copia de esta receta con todos sus ingredientes y presentaciones.
                </p>
              </div>
            </div>

            <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
              <button
                type="button"
                data-close-recipe-duplicate-dialog={recipeDuplicateDialogId}
                class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border bg-card px-5 py-3 text-sm font-bold text-muted-foreground transition-colors hover:bg-background"
              >
                Cancelar
              </button>
              <button
                type="submit"
                form="recipe-duplicate-form"
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-accent-600 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-700"
              >
                <Icon name="lucide:copy" size={16} /> Duplicar
              </button>
            </div>
          </div>
        </dialog>
      )}

      <!-- Tag and Last Updated -->
      <div class="flex items-center gap-3 text-sm font-medium text-muted-foreground px-1">
        <span class="flex items-center gap-1.5 bg-accent-50 text-accent-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border border-accent-200">
          <Icon name="lucide:tag" size={12} /> {category || "Sin categoría"}
        </span>
        {lastUpdatedText && (
          <span class="text-xs text-subtle-foreground font-semibold">
            Actualizado {lastUpdatedText.toLowerCase().replace('hoy, ', 'hoy ')}
          </span>
        )}
      </div>

      <!-- Title and Actions Row -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 px-1">
        <div class="flex-1">
          {isEditMode ? (
            <>
              <input 
                id="recipe-name-input"
                name="recipeName"
                form={recipeEditFormId}
                type="text" 
                class="w-full text-3xl sm:text-4xl leading-tight font-black bg-background border border-border rounded-xl p-2 text-foreground focus:ring-2 focus:ring-accent-500/20"
                value={name}
              />
              <div class="mt-2">
                <input
                  type="text"
                  name="category"
                  form={recipeEditFormId}
                  class="w-full max-w-xs bg-background border border-border rounded-xl p-2 text-sm text-secondary-foreground focus:ring-2 focus:ring-accent-500/20"
                  value={category || ''}
                  placeholder="Categoría (ej. Panes, Galletas, Pasteles)"
                />
              </div>
            </>
          ) : (
            <h1 class="text-3xl sm:text-4xl leading-tight font-black text-foreground">{name}</h1>
          )}
        </div>

        <div class="flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center">
          {!isEditMode && (
            <form method="get" data-astro-reload class="flex w-full items-center justify-between gap-2 rounded-xl border border-border bg-card px-2 py-1.5 shadow-sm sm:w-auto sm:justify-start">
              <span class="text-[10px] font-black uppercase tracking-widest text-subtle-foreground px-2">Mezclas</span>
              <div class="flex items-center gap-1 bg-background rounded-full p-1 border border-border-light dark:border-gray-950">
                <a href={multiplierDownHref} data-astro-reload class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-hover-muted text-muted-foreground font-bold transition-colors active:scale-95">-</a>
                <input type="number" name="multiplier" value={multiplier} step="0.0001" min="0.0001" class="w-10 bg-transparent text-center font-mono font-semibold text-foreground focus:outline-none focus:ring-0 p-0 border-none text-sm tabular-nums" onchange="this.form.submit()" aria-label="Multiplicador" />
                <a href={multiplierUpHref} data-astro-reload class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-hover-muted text-muted-foreground font-bold transition-colors active:scale-95">+</a>
              </div>
            </form>
          )}
          
          {isEditMode ? (
            <div class="grid w-full grid-cols-2 gap-2 sm:flex sm:w-auto">
              <button type="submit" form={recipeEditFormId} class="inline-flex w-full min-h-11 items-center justify-center gap-2 rounded-xl bg-accent-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-accent-700 sm:w-auto">
                <Icon name="lucide:save" size={16} /> Guardar
              </button>
              <a href={Astro.url.pathname} data-astro-reload class="inline-flex w-full min-h-11 items-center justify-center rounded-xl border border-border bg-card px-5 py-3 text-sm font-bold text-muted-foreground transition-colors hover:bg-background sm:w-auto">
                Cancelar
              </a>
              <button
                type="button"
                data-open-recipe-delete-dialog={recipeDeleteDialogId}
                class={recipeDeleteButtonClasses}
              >
                <Icon name="lucide:trash-2" size={16} /> Eliminar
              </button>
            </div>
