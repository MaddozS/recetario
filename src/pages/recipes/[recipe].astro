---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PresentationCard from "../../components/PresentationCard.astro";
import { getRecipeById, getRecipeDataOwner, updatePresentation, updateRecipe, listIngredients, type Ingredient, type RecipeIngredientWithData, type RecipeIngredient } from '../../lib/recipe-data';

const recipeIdParam = Astro.params.recipe;
const recipeIdNumber = Number(recipeIdParam);

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect('/sign-in');
}

const recipeDataOwner = getRecipeDataOwner(Astro.locals.user);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = String(formData.get('action') || '');

  if (action === 'update_presentation') {
    const presId = Number(formData.get('presentationId'));
    const unitsPerBatch = Number(formData.get('unitsPerBatch'));
    const salePrice = Number(formData.get('salePrice'));

    if (Number.isFinite(recipeIdNumber) && Number.isFinite(presId)) {
      await updatePresentation(recipeIdNumber, presId, {
        unitsPerBatch: Number.isFinite(unitsPerBatch) ? unitsPerBatch : undefined,
        salePrice: Number.isFinite(salePrice) ? salePrice : undefined,
      }, recipeDataOwner);
      return Astro.redirect(Astro.url.pathname + Astro.url.search);
    }
  } else if (action === 'update_recipe') {
    if (Number.isFinite(recipeIdNumber)) {
      const name = String(formData.get('recipeName') || '');
      const ingredientIds = formData.getAll('ingredientId').map(String);
      const quantities = formData.getAll('quantity').map(String);
      const units = formData.getAll('unit').map(String);
      const comments = formData.getAll('comment').map(String);

      const ingredientsToSave = [];
      for (let i = 0; i < ingredientIds.length; i++) {
        const id = Number(ingredientIds[i]);
        const q = Number(quantities[i]);
        if (Number.isFinite(id) && Number.isFinite(q)) {
          ingredientsToSave.push({
            ingredientId: id,
            quantity: q,
            unit: units[i] || '',
            comment: comments[i] || null,
          });
        }
      }

      const desiredMargin = Number(formData.get('desiredMargin')) || 0;
      const fixedCostsPercentage = Number(formData.get('fixedCostsPercentage')) || 0;

      await updateRecipe(recipeIdNumber, {
        name,
        desiredMargin,
        fixedCostsPercentage,
        ingredients: ingredientsToSave,
      }, recipeDataOwner);
      return Astro.redirect(Astro.url.pathname);
    }
  }
}

// Obtener el ID de la receta desde los parámetros
if (!recipeIdParam) {
  return Astro.redirect('/recipes');
}

// Obtener la receta desde la base de datos
const recipe = await getRecipeById(recipeIdParam, recipeDataOwner);
if (!recipe) {
  return Astro.redirect('/recipes');
}

const { ingredients: recipeIngredients, name, id, desiredMargin, fixedCostsPercentage, presentations, updatedAt } = recipe;

const isEditMode = Astro.url.searchParams.get('edit') === 'true';
const allIngredients = isEditMode ? await listIngredients(recipeDataOwner) : [];
const standardUnitOptions = ['kg', 'g', 'lt', 'ml', 'pza', 'pieza', 'cdita', 'cda', 'taza'];
const discoveredUnitOptions = [
  ...allIngredients.map((ingredient) => ingredient.unit),
  ...recipeIngredients.map((ingredient) => ingredient.unit),
]
  .map((unit) => unit.trim())
  .filter((unit) => unit.length > 0);
const unitOptions = Array.from(new Set([...standardUnitOptions, ...discoveredUnitOptions]));

let lastUpdatedText = '';
if (updatedAt) {
  const d = new Date(updatedAt);
  const now = new Date();
  const isToday = d.getDate() === now.getDate() && d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
  
  const timeOpts: Intl.DateTimeFormatOptions = { hour: 'numeric', minute: '2-digit', hour12: true };
  const timeStr = d.toLocaleTimeString('es-MX', timeOpts);
  
  if (isToday) {
    lastUpdatedText = `Hoy, ${timeStr}`;
  } else {
    lastUpdatedText = `${d.toLocaleDateString('es-MX')} ${timeStr}`;
  }
}

// Multiplicador de batch (ej. 2 = doble receta)
const multiplierParam = Astro.url.searchParams.get('multiplier');
const multiplier = Math.max(parseFloat(multiplierParam ?? '1') || 1, 0.01);
const showAdjustedQuantity = Math.abs(multiplier - 1) > 0.0001;
const multiplierStep = multiplier >= 2 ? 1 : 0.5;
const normalizeMultiplier = (value: number) => Math.round(value * 10000) / 10000;
const decrementMultiplier = normalizeMultiplier(Math.max(multiplier - multiplierStep, 0.01));
const incrementMultiplier = normalizeMultiplier(multiplier + multiplierStep);
const multiplierDownHref = `${Astro.url.pathname}?multiplier=${decrementMultiplier}`;
const multiplierUpHref = `${Astro.url.pathname}?multiplier=${incrementMultiplier}`;
const recipeEditFormId = 'recipe-edit-form';

const clampPercentageValue = (value: number, max = Number.POSITIVE_INFINITY) => {
  if (!Number.isFinite(value)) return 0;
  return Math.min(max, Math.max(0, value));
};

const desiredMarginValue = clampPercentageValue(desiredMargin, 99.99);
const fixedCostsPercentageValue = clampPercentageValue(fixedCostsPercentage);

// Redondeo contable para unidades pequeñas (g/ml)
const roundHalfUp = (value: number) => {
  return value >= 0 ? Math.floor(value + 0.5) : Math.ceil(value - 0.5);
};

const aplicarRedondeoUnidadPequena = (cantidad: number, unidad: string) => {
  const u = unidad.toLowerCase();
  if (u === 'g' || u === 'ml') {
    return roundHalfUp(cantidad);
  }
  return cantidad;
};

const formatCantidad = (cantidad: number, unidad: string) => {
  const ajustada = aplicarRedondeoUnidadPequena(cantidad, unidad);
  const u = unidad.toLowerCase();
  return (u === 'g' || u === 'ml') ? ajustada.toString() : ajustada.toFixed(2);
};

// --- Helpers de Cálculo ---
  
const getCostoBaseCompra = (insumo: Ingredient) => {
  if (insumo.purchaseQuantity === 0) return 0;
  return insumo.price / insumo.purchaseQuantity;
};

const calcularSubtotalIngrediente = (ri: RecipeIngredient, insumo: Ingredient) => {
  if (!insumo) return 0;
  
  let cantidadAjustada = aplicarRedondeoUnidadPequena(ri.quantity * multiplier, ri.unit);
  const unidadInsumo = insumo.unit.toLowerCase();
  const unidadReceta = ri.unit.toLowerCase();

  // Conversión inteligente: si el insumo es kg/lt y la receta usa g/ml
  if ((unidadInsumo === 'kg' || unidadInsumo === 'lt') && 
      (unidadReceta === 'g' || unidadReceta === 'ml')) {
    cantidadAjustada = cantidadAjustada / 1000;
  }
  
  return getCostoBaseCompra(insumo) * cantidadAjustada;
};

const calcularCostoDirecto = (ingredients: RecipeIngredientWithData[]) => {
  return ingredients.reduce((total, ri) => {
    return total + calcularSubtotalIngrediente(ri, ri.ingredient!);
  }, 0);
};

const costoDirectoTotal = calcularCostoDirecto(recipeIngredients);
const costoOperativo = costoDirectoTotal * (fixedCostsPercentageValue / 100);
const costoProduccionRealBatch = costoDirectoTotal + costoOperativo;
const precioVentaSugeridoBatch = costoProduccionRealBatch / (1 - (desiredMarginValue / 100));

---

<Layout currentRecipe={id} showSideBar={true} currentPage="recipes">
  <div transition:animate="slide" class="w-full">
    <div class="px-4 sm:px-6 lg:px-8 py-4">
      {isEditMode && (
        <form id={recipeEditFormId} method="POST" action={Astro.url.pathname} class="hidden">
          <input type="hidden" name="action" value="update_recipe" />
        </form>
      )}

      <!-- Tag and Last Updated -->
      <div class="flex items-center gap-3 text-sm font-medium text-slate-500 px-1">
        <span class="flex items-center gap-1.5 bg-indigo-50 text-indigo-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider">
          <Icon name="lucide:tag" size={12} /> [Categoría]
        </span>
        {lastUpdatedText && (
          <span class="text-xs text-slate-400 font-semibold">
            Actualizado {lastUpdatedText.toLowerCase().replace('hoy, ', 'hoy ')}
          </span>
        )}
      </div>

      <!-- Title and Actions Row -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 px-1">
        <div class="flex-1">
          {isEditMode ? (
            <input 
              id="recipe-name-input"
              name="recipeName"
              form={recipeEditFormId}
              type="text" 
              class="w-full text-3xl sm:text-4xl leading-tight font-black bg-slate-50 border border-slate-200 rounded-lg p-2 text-slate-900 focus:ring-2 focus:ring-indigo-500/20"
              value={name}
            />
          ) : (
            <h1 class="text-3xl sm:text-4xl leading-tight font-black text-slate-900">{name}</h1>
          )}
        </div>

        <div class="flex flex-wrap items-center gap-3">
          {!isEditMode && (
            <form method="get" data-astro-reload class="flex items-center gap-2 bg-white px-2 py-1.5 rounded-xl border border-slate-200 shadow-sm">
              <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 px-2">Mezclas</span>
              <div class="flex items-center gap-1 bg-slate-50 rounded-full p-1 border border-slate-100">
                <a href={multiplierDownHref} data-astro-reload class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-slate-200 text-slate-600 font-bold transition-colors active:scale-95">-</a>
                <input type="number" name="multiplier" value={multiplier} step="0.0001" min="0.0001" class="w-10 bg-transparent text-center font-black text-slate-800 focus:outline-none focus:ring-0 p-0 border-none text-sm tabular-nums" onchange="this.form.submit()" aria-label="Multiplicador" />
                <a href={multiplierUpHref} data-astro-reload class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-slate-200 text-slate-600 font-bold transition-colors active:scale-95">+</a>
              </div>
            </form>
          )}
          
          {isEditMode ? (
            <div class="flex gap-2 w-auto">
              <button type="submit" form={recipeEditFormId} class="flex-1 md:flex-none min-h-11 px-6 py-2 bg-indigo-600 text-white rounded-xl text-sm font-bold shadow-sm hover:bg-indigo-700 transition-colors flex items-center justify-center gap-2">
                <Icon name="lucide:save" size={16} /> Guardar
              </button>
              <a href={Astro.url.pathname} class="flex-1 md:flex-none min-h-11 px-6 py-2 bg-white text-slate-600 border border-slate-200 rounded-xl text-sm font-bold hover:bg-slate-50 transition-colors flex items-center justify-center">
                Cancelar
              </a>
            </div>
          ) : (
            <a href={`${Astro.url.pathname}?edit=true`} class="w-auto min-h-11 px-6 py-2 bg-white text-slate-700 border border-slate-200 rounded-xl text-sm font-bold hover:bg-slate-50 transition-colors flex items-center justify-center gap-2">
              <Icon name="lucide:pencil" size={16} /> Editar
            </a>
          )}
        </div>
      </div>

      <!-- Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <!-- COSTO INSUMOS -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <p class="flex items-center gap-2 text-[10px] font-black uppercase tracking-wider text-slate-400 mb-4">
            <span class="w-7 h-7 rounded-lg bg-red-50 text-red-500 flex items-center justify-center"><Icon name="lucide:trending-down" size={16}/></span>
            Costo Insumos
          </p>
          <div>
            <p class="text-2xl 2xl:text-3xl font-black text-slate-900 tabular-nums leading-none truncate" title={`$${costoDirectoTotal.toFixed(2)}`}>${costoDirectoTotal.toFixed(2)}</p>
            <p class="text-[11px] font-semibold text-slate-400 mt-2 line-clamp-1">Costo base de materiales</p>
          </div>
        </div>

        <!-- GASTOS OPERATIVOS -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <p class="flex items-center gap-2 text-[10px] font-black uppercase tracking-wider text-slate-400 mb-4">
            <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center"><Icon name="lucide:pie-chart" size={16}/></span>
            Gastos Operativos
          </p>
          <div>
            {isEditMode ? (
              <div class="flex items-baseline gap-1">
                <input type="number" id="edit-fixed-costs" name="fixedCostsPercentage" form={recipeEditFormId} class="w-16 bg-slate-50 border border-slate-200 rounded-lg p-1 text-xl 2xl:text-2xl font-black text-slate-900 focus:ring-2 focus:ring-indigo-500/20" value={fixedCostsPercentageValue} />
                <span class="text-lg font-bold text-slate-400">%</span>
              </div>
            ) : (
              <p class="text-2xl 2xl:text-3xl font-black text-slate-900 tabular-nums leading-none truncate">{fixedCostsPercentageValue}<span class="text-lg 2xl:text-xl font-bold text-slate-400">%</span></p>
            )}
            <div class="flex flex-wrap items-center justify-between gap-1 mt-2">
              <p class="text-[11px] font-semibold text-slate-400">Servicios, labor, etc.</p>
              <p class="text-[11px] font-bold text-slate-400">+{costoOperativo.toFixed(2)}</p>
            </div>
          </div>
        </div>

        <!-- COSTO TOTAL REAL -->
        <div class="bg-white p-5 rounded-2xl border border-indigo-100 shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-6 -top-6 w-24 h-24 bg-indigo-50 rounded-full opacity-50 pointer-events-none"></div>
          <p class="flex items-center gap-2 text-[10px] font-black uppercase tracking-wider text-indigo-500 mb-4 relative z-10">
            <span class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-500 flex items-center justify-center"><Icon name="lucide:dollar-sign" size={16}/></span>
            Costo Total Real
          </p>
          <div class="relative z-10">
            <p class="text-2xl 2xl:text-3xl font-black text-indigo-600 tabular-nums leading-none truncate" title={`$${costoProduccionRealBatch.toFixed(2)}`}>${costoProduccionRealBatch.toFixed(2)}</p>
            <p class="text-[11px] font-semibold text-indigo-400 mt-2 line-clamp-1">Insumos + Operativos</p>
          </div>
        </div>

        <!-- MARGEN UTILIDAD -->
        <div class="bg-[#10b981] p-5 rounded-2xl shadow-md flex flex-col justify-between text-white relative overflow-hidden">
          <div class="absolute right-0 top-0 opacity-20 pointer-events-none">
            <Icon name="lucide:trending-up" size={120} class="transform translate-x-6 -translate-y-6" />
          </div>
          <p class="flex items-center gap-2 text-[10px] font-black uppercase tracking-wider text-emerald-100 mb-4 relative z-10">
            <span class="w-7 h-7 rounded-lg bg-emerald-400/50 text-white flex items-center justify-center"><Icon name="lucide:trending-up" size={16}/></span>
            Margen Utilidad
          </p>
          <div class="relative z-10">
            {isEditMode ? (
              <div class="flex items-baseline gap-1">
                <input type="number" id="edit-desired-margin" name="desiredMargin" form={recipeEditFormId} class="w-16 bg-emerald-600/50 border border-emerald-400/50 rounded-lg p-1 text-xl 2xl:text-2xl font-black text-white focus:ring-2 focus:ring-emerald-300/50 placeholder-emerald-300" value={desiredMarginValue} />
                <span class="text-lg font-bold text-emerald-200">%</span>
              </div>
            ) : (
              <p class="text-2xl 2xl:text-3xl font-black tabular-nums leading-none truncate">{desiredMarginValue}<span class="text-lg 2xl:text-xl font-bold text-emerald-200">%</span></p>
            )}
            <p class="text-[11px] font-semibold text-emerald-100 mt-2 line-clamp-1">Objetivo de ganancia</p>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mx-4 sm:mx-6 lg:mx-8">
      <div class="flex items-center justify-between px-5 sm:px-6 lg:px-8 py-5 border-b border-slate-100 bg-white">
        <h2 class="text-sm font-bold text-slate-800">Lista de Ingredientes</h2>
        <label class="flex items-center gap-2 text-xs text-slate-500 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors">
          <input id="toggle-comments" type="checkbox" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
          <span class="font-semibold text-slate-700">Ver notas</span>
        </label>
      </div>

      {isEditMode ? (
        <div class="px-5 py-5 sm:px-6 lg:px-8">
          <div class="hidden md:grid md:grid-cols-[minmax(0,2.4fr)_11rem_minmax(0,1fr)_3rem] md:gap-4 md:px-1 md:pb-3 text-[10px] uppercase font-bold text-slate-400">
            <span>Ingrediente</span>
            <span class="text-center">Cantidad</span>
            <span>Notas</span>
            <span class="sr-only">Acciones</span>
          </div>

          <div id="edit-ingredients-tbody" class="space-y-3">
            {recipeIngredients.map(ri => (
              <div class="edit-ingredient-row grid grid-cols-1 gap-3 rounded-2xl border border-slate-200 bg-slate-50/50 p-3 md:grid-cols-[minmax(0,2.4fr)_11rem_minmax(0,1fr)_3rem] md:items-center md:bg-white md:p-0 md:border-0 md:rounded-none md:border-b md:border-slate-100 md:pb-3">
                <div class="space-y-1">
                  <label class="text-[10px] uppercase font-bold text-slate-400 md:hidden">Ingrediente</label>
                  <select name="ingredientId" form={recipeEditFormId} class="ingredient-select w-full bg-white md:bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500/20">
                    {allIngredients.map(i => (
                      <option value={i.id} data-unit={i.unit} selected={i.id === ri.ingredientId}>{i.name}</option>
                    ))}
                  </select>
                </div>

                <div class="space-y-1">
                  <label class="text-[10px] uppercase font-bold text-slate-400 md:hidden">Cantidad</label>
                  <div class="flex items-center gap-2">
                    <input type="number" step="0.01" name="quantity" form={recipeEditFormId} class="quantity-input w-24 bg-white border border-slate-200 rounded-lg p-2 text-center font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500/20" value={ri.quantity} />
                    <select name="unit" form={recipeEditFormId} class="unit-select w-24 bg-white border border-slate-200 rounded-lg p-2 text-sm text-slate-600 focus:ring-2 focus:ring-indigo-500/20">
                      {unitOptions.map((unitOption) => (
                        <option value={unitOption} selected={unitOption === ri.unit}>{unitOption}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div class="space-y-1">
                  <label class="text-[10px] uppercase font-bold text-slate-400 md:hidden">Notas</label>
                  <input type="text" name="comment" form={recipeEditFormId} class="comment-input w-full bg-white border border-slate-200 rounded-lg p-2 text-sm text-slate-600 focus:ring-2 focus:ring-indigo-500/20" value={ri.comment || ''} placeholder="Opcional" />
                </div>

                <div class="flex items-center justify-end md:justify-center">
                  <button type="button" class="remove-ingredient-btn text-slate-400 hover:text-red-500 transition-colors p-2" aria-label="Eliminar ingrediente">
                    <Icon name="lucide:trash-2" size={18} />
                  </button>
                </div>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-slate-100 bg-slate-50/50 mt-4 flex justify-center">
            <button 
              type="button"
              id="add-ingredient-btn"
              class="flex items-center gap-2 px-6 py-2.5 bg-white border border-indigo-200 text-indigo-600 rounded-xl text-sm font-bold hover:bg-indigo-50 transition-colors shadow-sm"
            >
              <Icon name="lucide:plus" size={16} /> Añadir Ingrediente
            </button>
          </div>
        </div>
      ) : (
        <>
          <div class="md:hidden divide-y divide-slate-100">
            {
            recipeIngredients.map(ri => {
              return (
                <article class="px-5 py-4 space-y-3">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="font-semibold text-slate-800 leading-tight break-words">{ri.ingredient.name}</p>
                      <p class="mt-1 text-xs text-slate-500">Cantidad usada en esta mezcla</p>
                      {ri.comment ? (
                        <p class="mt-1 text-xs text-slate-400 ingredient-comment hidden break-words">{ri.comment}</p>
                      ) : null}
                    </div>
                    <div class="text-right whitespace-nowrap">
                      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Costo</p>
                      <p class="font-mono font-bold text-slate-700">
                        ${calcularSubtotalIngrediente(ri, ri.ingredient!).toFixed(2)}
                      </p>
                    </div>
                  </div>

                  <div class={`grid gap-2 ${showAdjustedQuantity ? 'grid-cols-2' : 'grid-cols-1'}`}>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Base</p>
                      <p class="mt-1 flex items-baseline gap-2 text-slate-700">
                        <span class="text-lg font-black">{formatCantidad(ri.quantity, ri.unit)}</span>
                        <span class="text-xs font-semibold uppercase text-slate-500">{ri.unit}</span>
                      </p>
                    </div>
                    {showAdjustedQuantity ? (
                      <div class="rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-2">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-indigo-600">Con x{multiplier}</p>
                        <p class="mt-1 flex items-baseline gap-2 text-indigo-700">
                          <span class="text-lg font-black">{formatCantidad(ri.quantity * multiplier, ri.unit)}</span>
                          <span class="text-xs font-semibold uppercase text-indigo-500">{ri.unit}</span>
                        </p>
                      </div>
                    ) : null}
                  </div>
                </article>
              );
            })}
          </div>

          <div class="hidden md:block overflow-x-auto">
            <table class="w-full table-auto text-left overflow-x-auto">
              <thead class="bg-slate-50 text-slate-400 text-[10px] uppercase font-bold">
                <tr>
                  <th class="px-6 lg:px-8 py-3 w-max text-left">Ingrediente</th>
                  <th class="px-6 lg:px-8 py-3 text-left">Cantidad</th>
                  <th class="px-6 lg:px-8 py-3 text-right">Subtotal</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {
                recipeIngredients.map(ri => {
                  return (
                    <tr class="group hover:bg-slate-50/50 transition-colors">
                      <td class="px-6 lg:px-8 py-4 border-r border-slate-100 w-max">
                        <div class="font-semibold text-slate-700 whitespace-nowrap inline-block">{ri.ingredient.name}</div>
                        {ri.comment ? (
                          <div class="mt-1 text-xs text-slate-400 ingredient-comment hidden max-w-[28ch] break-words">{ri.comment}</div>
                        ) : null} 
                      </td>
                      <td class="px-6 lg:px-8 py-4 border-r border-slate-100 w-auto">
                        <div class={`flex gap-2 ${showAdjustedQuantity ? 'min-w-[240px]' : 'min-w-[120px]'}`}>
                          <div class="flex-1 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Base</p>
                            <p class="mt-1 flex items-baseline gap-2 text-slate-700">
                              <span class="text-lg font-black">{formatCantidad(ri.quantity, ri.unit)}</span>
                              <span class="text-xs font-semibold uppercase text-slate-500">{ri.unit}</span>
                            </p>
                          </div>
                          {showAdjustedQuantity ? (
                            <div class="flex-1 rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-2">
                              <p class="text-[10px] font-bold uppercase tracking-wider text-indigo-600">Con x{multiplier}</p>
                              <p class="mt-1 flex items-baseline gap-2 text-indigo-700">
                                <span class="text-lg font-black">{formatCantidad(ri.quantity * multiplier, ri.unit)}</span>
                                <span class="text-xs font-semibold uppercase text-indigo-500">{ri.unit}</span>
                              </p>
                            </div>
                          ) : null}
                        </div>
                      </td>
                      <td class="px-6 lg:px-8 py-4 text-right font-mono font-bold text-slate-600">
                        ${calcularSubtotalIngrediente(ri, ri.ingredient!).toFixed(2)}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )}
    </div>

    <!-- El footer de métricas se movió al header -->
  </div>

  <div id="presentaciones" class="px-4 sm:px-6 lg:px-8 pb-10 scroll-mt-6" transition:animate="slide">
    <div class="flex items-start justify-between gap-3 py-6 px-1">
      <div>
        <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2 leading-tight">
          <Icon name="lucide:tag" class="text-indigo-600" /> Presentaciones de Venta
        </h2>
        <p class="mt-1 text-sm text-slate-500">Define cuantas piezas salen por mezcla</p>
      </div>
      <button 
        class="min-h-11 flex items-center gap-2 bg-white text-indigo-600 border border-indigo-200 px-3 sm:px-4 py-2 rounded-xl text-sm font-bold hover:bg-indigo-50 transition-all shadow-sm"
      >
        <Icon name="lucide:plus" size={16} />
        <span class="sm:hidden">Nueva</span>
        <span class="hidden sm:inline">Nueva Presentación</span>
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
      {presentations?.map(pres => (
        <PresentationCard 
          id={pres.id}
          name={pres.name}
          unitsPerBatch={pres.unitsPerBatch}
          salePrice={pres.salePrice}
          multiplier={multiplier}
          costoProduccionRealBatch={costoProduccionRealBatch}
          precioVentaSugeridoBatch={precioVentaSugeridoBatch}
        />
      ))}
    </div>
  </div>

<script>
  // @ts-nocheck
  const KEY = 'recetario.showComments';

  const updateCommentControls = (show) => {
    const checkbox = document.getElementById('toggle-comments');
    if (checkbox instanceof HTMLInputElement) {
      checkbox.checked = show;
    }
  };

  const setVisibility = (show) => {
    document.querySelectorAll('.ingredient-comment').forEach((el) => {
      el.classList.toggle('hidden', !show);
    });
    updateCommentControls(show);

    try {
      localStorage.setItem(KEY, show ? '1' : '0');
    } catch (e) {
      /* noop */
    }
  };

  const initCommentsToggle = () => {
    const checkbox = document.getElementById('toggle-comments');

    if (checkbox instanceof HTMLInputElement && checkbox.dataset.bound !== '1') {
      checkbox.dataset.bound = '1';
      checkbox.addEventListener('change', (e) => {
        const target = e.currentTarget;
        if (!(target instanceof HTMLInputElement)) return;
        setVisibility(target.checked);
      });
    }

    const stored = (typeof localStorage !== 'undefined' && localStorage.getItem(KEY)) === '1';
    setVisibility(stored);
  };

  document.addEventListener('astro:page-load', initCommentsToggle);
  document.addEventListener('astro:after-swap', initCommentsToggle);
</script>

{isEditMode && (
  <template id="ingredient-row-template">
    <div class="edit-ingredient-row grid grid-cols-1 gap-3 rounded-2xl border border-slate-200 bg-slate-50/50 p-3 md:grid-cols-[minmax(0,2.4fr)_11rem_minmax(0,1fr)_3rem] md:items-center md:bg-white md:p-0 md:border-0 md:rounded-none md:border-b md:border-slate-100 md:pb-3">
      <div class="space-y-1">
        <label class="text-[10px] uppercase font-bold text-slate-400 md:hidden">Ingrediente</label>
        <select name="ingredientId" form={recipeEditFormId} class="ingredient-select w-full bg-white md:bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500/20">
          {allIngredients.map(i => (
            <option value={i.id} data-unit={i.unit}>{i.name}</option>
          ))}
        </select>
      </div>
      <div class="space-y-1">
        <label class="text-[10px] uppercase font-bold text-slate-400 md:hidden">Cantidad</label>
        <div class="flex items-center gap-2">
          <input type="number" step="0.01" name="quantity" form={recipeEditFormId} class="quantity-input w-24 bg-white border border-slate-200 rounded-lg p-2 text-center font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500/20" value="1" />
          <select name="unit" form={recipeEditFormId} class="unit-select w-24 bg-white border border-slate-200 rounded-lg p-2 text-sm text-slate-600 focus:ring-2 focus:ring-indigo-500/20">
            {unitOptions.map((unitOption, index) => (
              <option value={unitOption} selected={index === 0}>{unitOption}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="space-y-1">
        <label class="text-[10px] uppercase font-bold text-slate-400 md:hidden">Notas</label>
        <input type="text" name="comment" form={recipeEditFormId} class="comment-input w-full bg-white border border-slate-200 rounded-lg p-2 text-sm text-slate-600 focus:ring-2 focus:ring-indigo-500/20" value="" placeholder="Opcional" />
      </div>
      <div class="flex items-center justify-end md:justify-center">
        <button type="button" class="remove-ingredient-btn text-slate-400 hover:text-red-500 transition-colors p-2" aria-label="Eliminar ingrediente">
          <Icon name="lucide:trash-2" size={18} />
        </button>
      </div>
    </div>
  </template>

  <script is:inline>
    function syncIngredientUnit(row) {
      const ingredientSelect = row.querySelector('.ingredient-select');
      const unitSelect = row.querySelector('.unit-select');

      if (!(ingredientSelect instanceof HTMLSelectElement)) return;
      if (!(unitSelect instanceof HTMLSelectElement)) return;

      const selectedOption = ingredientSelect.selectedOptions[0];
      const nextUnit = selectedOption?.dataset.unit;
      if (!nextUnit) return;

      const matchingOption = Array.from(unitSelect.options).find(
        (option) => option.value === nextUnit,
      );

      if (matchingOption) {
        unitSelect.value = nextUnit;
      }
    }

    function bindIngredientRow(row, initializeUnit = false) {
      if (!(row instanceof HTMLElement)) return;

      const ingredientSelect = row.querySelector('.ingredient-select');
      if (!(ingredientSelect instanceof HTMLSelectElement)) return;

      if (ingredientSelect.dataset.bound !== '1') {
        ingredientSelect.dataset.bound = '1';
        ingredientSelect.addEventListener('change', () => syncIngredientUnit(row));
      }

      if (initializeUnit) {
        syncIngredientUnit(row);
      }
    }

    function setupRecipeEditor() {
      const addBtn = document.getElementById('add-ingredient-btn');
      const tbody = document.getElementById('edit-ingredients-tbody');
      const template = document.getElementById('ingredient-row-template');

      if (tbody instanceof HTMLElement) {
        tbody.querySelectorAll('.edit-ingredient-row').forEach((row) => {
          bindIngredientRow(row, false);
        });
      }

      if (addBtn && tbody && template && addBtn.dataset.bound !== '1') {
        addBtn.dataset.bound = '1';
        addBtn.addEventListener('click', () => {
          const clone = template.content.cloneNode(true);
          tbody.appendChild(clone);
          const rows = tbody.querySelectorAll('.edit-ingredient-row');
          const newRow = rows[rows.length - 1];
          if (newRow) {
            bindIngredientRow(newRow, true);
          }
        });
      }

      if (tbody && tbody.dataset.bound !== '1') {
        tbody.dataset.bound = '1';
        tbody.addEventListener('click', (e) => {
          const removeBtn = e.target.closest('.remove-ingredient-btn');
          if (removeBtn) {
            const row = removeBtn.closest('.edit-ingredient-row');
            if (row) row.remove();
          }
        });
      }

      const form = document.getElementById('recipe-edit-form');
      if (form instanceof HTMLFormElement && form.dataset.bound !== '1') {
        form.dataset.bound = '1';
        form.addEventListener('submit', (event) => {
          const rows = document.querySelectorAll(
            `[name="quantity"][form="${form.id}"]`,
          );
          const hasAtLeastOneIngredient = rows.length > 0;

          if (!hasAtLeastOneIngredient) {
            event.preventDefault();
            window.alert('Agrega al menos un ingrediente antes de guardar.');
          }
        });
      }
    }

    document.addEventListener('astro:page-load', setupRecipeEditor);
    document.addEventListener('astro:after-swap', setupRecipeEditor);
    setupRecipeEditor();
  </script>
)}

</Layout>
