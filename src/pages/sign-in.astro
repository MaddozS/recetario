---
import LandingLayout from "../layouts/LandingLayout.astro";

const returnUrl = Astro.url.searchParams.get("return_url") || "/recipes";
const isAuthenticated = Boolean(Astro.locals.user && Astro.locals.session);
if (isAuthenticated) {
  return Astro.redirect(returnUrl);
}
---

<LandingLayout>
  <div class="h-screen flex items-center justify-center bg-linear-to-br from-background to-muted">
    <div class="w-full max-w-md px-6">
      <div class="bg-card rounded-2xl shadow-lg p-8 space-y-8">
        <div class="text-center space-y-3">
          <img
            src="/kitchcalc_logo.svg"
            alt="KitchCalc"
            class="w-20 h-20 mx-auto rounded-2xl shadow-lg"
          />
          <h1 class="text-3xl font-bold text-foreground">Bienvenido</h1>
          <p class="text-muted-foreground">
            Inicia sesión para acceder a tus recetas
          </p>
        </div>

        <button
          id="google-sign-in"
          type="button"
          class="w-full flex items-center justify-center gap-3 bg-card border border-border rounded-xl py-4 px-6 text-sm font-semibold text-secondary-foreground hover:border-border hover:bg-background hover:shadow-md transition-all duration-200 active:scale-95"
        >
          <img
            src="https://www.svgrepo.com/show/475656/google-color.svg"
            alt="Google"
            class="w-5 h-5"
          />
          <span>Continuar con Google</span>
        </button>

        <p
          id="sign-in-feedback"
          class="hidden rounded-xl border border-warning-border bg-warning-bg px-4 py-3 text-sm text-warning"
          role="status"
          aria-live="polite"
        >
        </p>

        <p class="text-center text-xs text-muted-foreground">
          Al iniciar sesión, aceptas nuestros términos de servicio
        </p>

        <div class="text-center">
          <a
            href="/"
            class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Volver al inicio
          </a>
        </div>
      </div>
    </div>
  </div>
</LandingLayout>

<script>
  import { signIn, SignInRateLimitError } from "../lib/sign-in";

  function setupGoogleSignIn() {
    const button = document.getElementById("google-sign-in");
    const feedback = document.getElementById("sign-in-feedback");

    if (
      !(button instanceof HTMLButtonElement) ||
      !(feedback instanceof HTMLParagraphElement)
    ) {
      return;
    }

    if (button.dataset.signInBound === "1") {
      return;
    }

    button.dataset.signInBound = "1";

    const label = button.querySelector("span");
    const defaultLabel = label?.textContent ?? "Continuar con Google";

    const urlParams = new URLSearchParams(window.location.search);
    const returnUrl = urlParams.get("return_url") || "/recipes";

    const setPendingState = (isPending: boolean) => {
      button.disabled = isPending;
      button.setAttribute("aria-busy", isPending ? "true" : "false");
      button.classList.toggle("cursor-not-allowed", isPending);
      button.classList.toggle("opacity-70", isPending);

      if (label) {
        label.textContent = isPending ? "Redirigiendo..." : defaultLabel;
      }
    };

    const showFeedback = (message: string) => {
      feedback.textContent = message;
      feedback.classList.remove("hidden");
    };

    const clearFeedback = () => {
      feedback.textContent = "";
      feedback.classList.add("hidden");
    };

    button.addEventListener("click", async () => {
      if (button.disabled) {
        return;
      }

      clearFeedback();
      setPendingState(true);

      try {
        await signIn(returnUrl);
      } catch (error) {
        if (error instanceof SignInRateLimitError) {
          const retryAfterSeconds = error.retryAfterSeconds ?? 10;
          showFeedback(
            `Demasiados intentos. Vuelve a intentarlo en ${retryAfterSeconds} segundos.`,
          );
        } else {
          showFeedback(
            "No se pudo iniciar sesión con Google. Inténtalo de nuevo.",
          );
          console.error("Google sign-in failed:", error);
        }

        setPendingState(false);
      }
    });
  }

  document.addEventListener("astro:page-load", setupGoogleSignIn);
  document.addEventListener("astro:after-swap", setupGoogleSignIn);
  setupGoogleSignIn();
</script>
