---
import Layout from "../layouts/Layout.astro";
---

<Layout currentPage="sign-in" showSideBar={false} showHeader={false}>
  <div class="h-[calc(100vh-64px)] flex items-center justify-center bg-linear-to-br from-slate-50 to-slate-100">
    <div class="w-full max-w-md">
      {/* Card Container */}
      <div class="bg-white rounded-2xl shadow-lg p-8 space-y-8">
        {/* Header */}
        <div class="text-center space-y-3">
          <h1 class="text-3xl font-bold text-slate-900">Bienvenido</h1>
          <p class="text-slate-600">Inicia sesión para acceder a tus recetas</p>
        </div>

        {/* Divider */}
        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-200"></div>
          </div>
        </div>

        {/* Google Sign In Button */}
        <button
          id="google-sign-in"
          type="button"
          class="w-full flex items-center justify-center gap-3 bg-white border-2 border-slate-200 rounded-xl py-4 px-6 text-sm font-semibold text-slate-700 hover:border-slate-300 hover:bg-slate-50 hover:shadow-md transition-all duration-200 active:scale-95"
        >
          <img
            src="https://www.svgrepo.com/show/475656/google-color.svg"
            alt="Google"
            class="w-5 h-5"
          />
          <span>Continuar con Google</span>
        </button>

        <p
          id="sign-in-feedback"
          class="hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700"
          role="status"
          aria-live="polite"
        ></p>

        {/* Footer */}
        <p class="text-center text-xs text-slate-500">
          Al iniciar sesión, aceptas nuestros términos de servicio
        </p>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { signIn, SignInRateLimitError } from "../lib/sign-in";

  function setupGoogleSignIn() {
    const button = document.getElementById("google-sign-in");
    const feedback = document.getElementById("sign-in-feedback");

    if (!(button instanceof HTMLButtonElement) || !(feedback instanceof HTMLParagraphElement)) {
      return;
    }

    if (button.dataset.signInBound === "1") {
      return;
    }

    button.dataset.signInBound = "1";

    const label = button.querySelector("span");
    const defaultLabel = label?.textContent ?? "Continuar con Google";

    const setPendingState = (isPending: boolean) => {
      button.disabled = isPending;
      button.setAttribute("aria-busy", isPending ? "true" : "false");
      button.classList.toggle("cursor-not-allowed", isPending);
      button.classList.toggle("opacity-70", isPending);

      if (label) {
        label.textContent = isPending ? "Redirigiendo..." : defaultLabel;
      }
    };

    const showFeedback = (message: string) => {
      feedback.textContent = message;
      feedback.classList.remove("hidden");
    };

    const clearFeedback = () => {
      feedback.textContent = "";
      feedback.classList.add("hidden");
    };

    button.addEventListener("click", async () => {
      if (button.disabled) {
        return;
      }

      clearFeedback();
      setPendingState(true);

      try {
        await signIn();
      } catch (error) {
        if (error instanceof SignInRateLimitError) {
          const retryAfterSeconds = error.retryAfterSeconds ?? 10;
          showFeedback(`Demasiados intentos. Vuelve a intentarlo en ${retryAfterSeconds} segundos.`);
        } else {
          showFeedback("No se pudo iniciar sesión con Google. Inténtalo de nuevo.");
          console.error("Google sign-in failed:", error);
        }

        setPendingState(false);
      }
    });
  }

  document.addEventListener("astro:page-load", setupGoogleSignIn);
  document.addEventListener("astro:after-swap", setupGoogleSignIn);
  setupGoogleSignIn();
</script>