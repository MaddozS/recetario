---
import { Icon } from "astro-icon/components";
import { Button, Card } from "@/components/ui";
import BillingSection from "@/components/BillingSection.astro";
import Layout from "@/layouts/Layout.astro";
import {
  getUserPreferences,
  upsertUserPreferences,
} from "@/lib/db/preferences";
import {
  ACCENT_FAMILIES,
  ACCENT_LABELS,
  getAccentPreviewColor,
  type AccentFamily,
} from "@/lib/accent-colors";
import {
  getRemainingRecipes,
  getRemainingIngredients,
} from "@/lib/subscription";
import { countUserRecipes, countUserIngredients, getPricingPlans } from "@/lib/db/billing";
import FeedbackAlert from "@/components/FeedbackAlert.astro";
import { validateCsrf } from "@/lib/csrf";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const user = Astro.locals.user;
const userName = user.name || "Usuario";
const userEmail = user.email || "";
const userImage = user.image || null;
const userInitial = userName.charAt(0).toUpperCase();

const subscription = Astro.locals.subscription;
const ownerId = user.id;

const [prefs, recipeCount, ingredientCount] = await Promise.all([
  getUserPreferences(user.id),
  countUserRecipes(ownerId),
  countUserIngredients(ownerId),
]);

const plans = await getPricingPlans();

const remainingRecipes = getRemainingRecipes(subscription, recipeCount);
const remainingIngredients = getRemainingIngredients(
  subscription,
  ingredientCount,
);

const currentTheme = prefs?.theme ?? "system";
const currentAccent = (prefs?.accentColor ?? "coral") as AccentFamily;

const activeTab = Astro.url.searchParams.get("tab") || "profile";

const themeOptions = [
  { value: "system", label: "Automático", icon: "lucide:monitor" },
  { value: "light", label: "Claro", icon: "lucide:sun" },
  { value: "dark", label: "Oscuro", icon: "lucide:moon" },
] as const;

type Feedback = { type: "success" | "error"; message: string };
let feedback: Feedback | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  if (!validateCsrf(Astro.request, formData)) {
    return Astro.redirect("/settings");
  }

  const theme = formData.get("theme") as string;
  const accentColor = formData.get("accentColor") as string;

  try {
    await upsertUserPreferences(user.id, {
      theme: ["system", "light", "dark"].includes(theme) ? theme : "system",
      accentColor: ACCENT_FAMILIES.includes(accentColor as AccentFamily)
        ? accentColor
        : undefined,
    });
    feedback = {
      type: "success",
      message: "Preferencias guardadas correctamente.",
    };
  } catch {
    feedback = { type: "error", message: "Error al guardar las preferencias." };
  }
}

const redirectUrl = new URL(Astro.url);
if (feedback) {
  redirectUrl.searchParams.set("type", feedback.type);
  redirectUrl.searchParams.set("message", feedback.message);
  return Astro.redirect(redirectUrl.toString());
}
---

<Layout currentPage="settings" showSideBar={true}>
  <section class="mx-auto max-w-3xl">
    {
      Astro.url.searchParams.has("type") && (
        <FeedbackAlert
          type={Astro.url.searchParams.get("type") as "success" | "error"}
          message={Astro.url.searchParams.get("message") || ""}
        />
      )
    }

    {/* Tab Navigation */}
    <nav
      class="border-border mb-8 flex gap-0 border-b"
      aria-label="Configuración"
    >
      <a
        href="/settings"
        data-tab="profile"
        class:list={[
          "-mb-[1px] inline-flex items-center gap-1.5 border-b-2 px-4 py-2.5 text-sm font-semibold transition-colors",
          activeTab === "profile"
            ? "border-accent-600 text-accent-600"
            : "text-muted-foreground hover:text-secondary-foreground hover:border-muted-foreground/30 border-transparent",
        ]}
      >
        <Icon name="lucide:user" size={16} class="hidden sm:block" />
        Perfil
      </a>
      <a
        href="/settings?tab=preferences"
        data-tab="preferences"
        class:list={[
          "-mb-[1px] inline-flex items-center gap-1.5 border-b-2 px-4 py-2.5 text-sm font-semibold transition-colors",
          activeTab === "preferences"
            ? "border-accent-600 text-accent-600"
            : "text-muted-foreground hover:text-secondary-foreground hover:border-muted-foreground/30 border-transparent",
        ]}
      >
        <Icon name="lucide:palette" size={16} class="hidden sm:block" />
        Preferencias
      </a>
      <a
        href="/settings?tab=billing"
        data-tab="billing"
        class:list={[
          "-mb-[1px] inline-flex items-center gap-1.5 border-b-2 px-4 py-2.5 text-sm font-semibold transition-colors",
          activeTab === "billing"
            ? "border-accent-600 text-accent-600"
            : "text-muted-foreground hover:text-secondary-foreground hover:border-muted-foreground/30 border-transparent",
        ]}
      >
        <Icon name="lucide:credit-card" size={16} class="hidden sm:block" />
        Facturación
      </a>
    </nav>

    {/* Profile Tab */}
    <div
      data-tab-content="profile"
      class:list={["space-y-6", activeTab !== "profile" && "hidden"]}
    >
      {/* Profile Card */}
      <Card padding="lg">
        <div class="flex items-center gap-4">
          <div
            class="bg-accent-600 shadow-accent-100 flex h-16 w-16 flex-none items-center justify-center rounded-2xl text-xl font-bold text-white shadow-md"
          >
            {
              userImage ? (
                <img
                  src={userImage}
                  alt={userName}
                  referrerpolicy="no-referrer"
                  class="h-full w-full rounded-2xl object-cover"
                />
              ) : (
                userInitial
              )
            }
          </div>
          <div class="min-w-0">
            <p
              class="text-muted-foreground text-xs font-bold tracking-[0.16em] uppercase"
            >
              Sesion de Google
            </p>
            <h2 class="text-foreground mt-1 truncate text-xl font-bold">
              {userName}
            </h2>
            {
              userEmail && (
                <p class="text-muted-foreground mt-0.5 truncate text-sm">
                  {userEmail}
                </p>
              )
            }
          </div>
        </div>
      </Card>

      {/* Change Email */}
      <Card padding="lg">
        <h2 class="text-foreground text-lg font-bold">Cambiar email</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Actualiza la dirección de correo electrónico asociada a tu cuenta.
        </p>
        <div
          id="change-email-feedback"
          class="mt-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
        ></div>
        <form id="change-email-form" class="mt-4 max-w-sm space-y-4">
          <div>
            <label
              for="new-email"
              class="text-muted-foreground mb-2 block text-xs font-bold tracking-wider uppercase"
            >
              Nuevo email
            </label>
            <input
              id="new-email"
              type="email"
              required
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              placeholder="nuevo@email.com"
              autocomplete="email"
            />
          </div>
          <div>
            <label
              for="email-current-password"
              class="text-muted-foreground mb-2 block text-xs font-bold tracking-wider uppercase"
            >
              Contraseña actual
            </label>
            <div class="relative">
              <input
                id="email-current-password"
                type="password"
                required
                class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2 pr-11"
                autocomplete="current-password"
              />
              <button
                type="button"
                data-pw-toggle="email-current-password"
                class="text-muted-foreground hover:text-foreground absolute right-3 top-1/2 -translate-y-1/2 flex cursor-pointer items-center"
                aria-label="Mostrar contraseña"
                tabindex="-1"
              >
                <svg data-pw-eye class="h-[18px] w-[18px]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-pw-eye-off class="h-[18px] w-[18px] hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
              </button>
            </div>
          </div>
          <Button variant="primary" type="submit" icon="mail" id="change-email-btn">
            Cambiar email
          </Button>
        </form>
      </Card>

      {/* Change Password */}
      <Card padding="lg">
        <h2 class="text-foreground text-lg font-bold">Cambiar contraseña</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Usa al menos 6 caracteres para tu nueva contraseña.
        </p>
        <div
          id="change-password-feedback"
          class="mt-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
        ></div>
        <form id="change-password-form" class="mt-4 max-w-sm space-y-4">
          <div>
            <label
              for="current-password"
              class="text-muted-foreground mb-2 block text-xs font-bold tracking-wider uppercase"
            >
              Contraseña actual
            </label>
            <div class="relative">
              <input
                id="current-password"
                type="password"
                required
                class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2 pr-11"
                autocomplete="current-password"
              />
              <button
                type="button"
                data-pw-toggle="current-password"
                class="text-muted-foreground hover:text-foreground absolute right-3 top-1/2 -translate-y-1/2 flex cursor-pointer items-center"
                aria-label="Mostrar contraseña"
                tabindex="-1"
              >
                <svg data-pw-eye class="h-[18px] w-[18px]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-pw-eye-off class="h-[18px] w-[18px] hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
              </button>
            </div>
          </div>
          <div>
            <label
              for="new-password"
              class="text-muted-foreground mb-2 block text-xs font-bold tracking-wider uppercase"
            >
              Nueva contraseña
            </label>
            <div class="relative">
              <input
                id="new-password"
                type="password"
                required
                minlength={6}
                class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2 pr-11"
                placeholder="Mínimo 6 caracteres"
                autocomplete="new-password"
              />
              <button
                type="button"
                data-pw-toggle="new-password"
                class="text-muted-foreground hover:text-foreground absolute right-3 top-1/2 -translate-y-1/2 flex cursor-pointer items-center"
                aria-label="Mostrar contraseña"
                tabindex="-1"
              >
                <svg data-pw-eye class="h-[18px] w-[18px]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-pw-eye-off class="h-[18px] w-[18px] hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
              </button>
            </div>
          </div>
          <div>
            <label
              for="confirm-new-password"
              class="text-muted-foreground mb-2 block text-xs font-bold tracking-wider uppercase"
            >
              Confirmar contraseña
            </label>
            <div class="relative">
              <input
                id="confirm-new-password"
                type="password"
                required
                minlength={6}
                class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2 pr-11"
                placeholder="Repite tu contraseña"
                autocomplete="new-password"
              />
              <button
                type="button"
                data-pw-toggle="confirm-new-password"
                class="text-muted-foreground hover:text-foreground absolute right-3 top-1/2 -translate-y-1/2 flex cursor-pointer items-center"
                aria-label="Mostrar contraseña"
                tabindex="-1"
              >
                <svg data-pw-eye class="h-[18px] w-[18px]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-pw-eye-off class="h-[18px] w-[18px] hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
              </button>
            </div>
          </div>
          <Button variant="primary" type="submit" icon="lock" id="change-password-btn">
            Cambiar contraseña
          </Button>
        </form>
      </Card>
    </div>

      {/* Preferences Tab */}
      <div
        data-tab-content="preferences"
        class:list={[activeTab !== "preferences" && "hidden"]}
      >
        <div
          id="preferences-feedback"
          class="hidden mb-4 rounded-2xl border px-4 py-3 text-sm"
          role="alert"
          aria-atomic="true"
          aria-live="assertive"
          tabindex="-1"
        >
          <p id="preferences-feedback-message" class="font-semibold"></p>
        </div>
        <form id="preferences-form" method="POST" action="/settings?tab=preferences">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" id="theme-input" name="theme" value={currentTheme} />
          <input type="hidden" id="accent-input" name="accentColor" value={currentAccent} />

          <div class="space-y-6">
          <Card padding="lg">
            <h2 class="text-foreground text-lg font-bold">Tema</h2>
            <p class="text-muted-foreground mt-1 text-sm">
              Selecciona cómo quieres que se vea la aplicación.
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {themeOptions.map((opt) => {
                const isActive = currentTheme === opt.value;
                return (
                  <Button
                    variant={isActive ? "primary" : "secondary"}
                    size="md"
                    icon={opt.icon.replace("lucide:", "")}
                    data-theme-option={opt.value}
                    data-theme-active={isActive ? "1" : "0"}
                    aria-pressed={isActive ? "true" : "false"}
                  >
                    {opt.label}
                  </Button>
                );
              })}
            </div>
          </Card>

          <Card padding="lg">
            <h2 class="text-foreground text-lg font-bold">Color de acento</h2>
            <p class="text-muted-foreground mt-1 text-sm">
              Personaliza el color principal de la aplicación.
            </p>
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-2">
              {ACCENT_FAMILIES.map((family) => {
                const isActive = currentAccent === family;
                return (
                  <button
                    type="button"
                    data-accent-option={family}
                    data-accent-active={isActive ? "1" : "0"}
                    aria-pressed={isActive ? "true" : "false"}
                    class:list={[
                      "inline-flex items-center justify-center gap-2 font-semibold transition-colors rounded-xl min-h-10 px-3 py-2 text-sm focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:outline-none",
                      isActive
                        ? "ring-2 ring-accent-500 ring-offset-1 bg-accent-50"
                        : "border border-border bg-card text-muted-foreground hover:bg-background",
                    ]}
                  >
                    <span
                      class="block h-5 w-5 flex-none rounded-full border"
                      style={`background-color: ${getAccentPreviewColor(family)}`}
                      class:list={[
                        isActive ? "border-accent-400" : "border-border",
                      ]}
                    />
                    <span
                      class:list={[
                        isActive
                          ? "text-accent-700"
                          : "text-muted-foreground",
                      ]}
                    >
                      {ACCENT_LABELS[family]}
                    </span>
                  </button>
                );
              })}
            </div>
          </Card>

          <div id="save-btn-wrapper" class="hidden">
            <Button variant="primary" type="submit" icon="save">
              Guardar cambios
            </Button>
          </div>
          </div>
        </form>
      </div>

      {/* Billing Tab */}
      <div
        data-tab-content="billing"
        class:list={["space-y-6", activeTab !== "billing" && "hidden"]}
      >
        <BillingSection
          {subscription}
          {plans}
          {recipeCount}
          {ingredientCount}
          {remainingRecipes}
          {remainingIngredients}
        />
      </div>
  </section>

  <script>
    import { getAccentCssVars } from "@/lib/accent-colors";

    function getEffectiveTheme(pref: string): string {
      if (pref === "system") {
        if (typeof window.matchMedia === "function") {
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        return "light";
      }
      return pref;
    }

    function setupSettings() {
      const themeInput = document.getElementById("theme-input");
      const accentInput = document.getElementById("accent-input");
      const prefsForm = document.getElementById("preferences-form");
      const html = document.documentElement;

      // Track saved values for optimistic revert
      let savedTheme: string | null = null;
      let savedAccent: string | null = null;

      function updateLivePreview(theme: string, accent: string) {
        const effective = getEffectiveTheme(theme);
        html.dataset.theme = theme;
        html.dataset.accent = accent;
        html.dataset.appTheme = theme;
        html.dataset.appAccent = accent;

        if (effective === "dark") {
          html.classList.add("dark");
        } else {
          html.classList.remove("dark");
        }

        try {
          html.style.cssText = getAccentCssVars(accent, effective);
        } catch {
          // Ignore if function not available
        }
      }

      function updateThemeOptions(selected: string) {
        document
          .querySelectorAll<HTMLElement>("[data-theme-option]")
          .forEach((el) => {
            const value = el.dataset.themeOption;
            const isActive = value === selected;
            el.dataset.themeActive = isActive ? "1" : "0";
            el.setAttribute("aria-pressed", isActive ? "true" : "false");

            const selectedClasses = [
              "bg-accent-600",
              "text-white",
              "shadow-sm",
              "hover:bg-accent-700",
            ];
            const unselectedClasses = [
              "border",
              "border-border",
              "bg-card",
              "text-muted-foreground",
              "hover:bg-background",
            ];

            if (isActive) {
              el.classList.add(...selectedClasses);
              el.classList.remove(...unselectedClasses);
            } else {
              el.classList.remove(...selectedClasses);
              el.classList.add(...unselectedClasses);
            }
          });
      }

      function updateAccentOptions(selected: string) {
        document
          .querySelectorAll<HTMLElement>("[data-accent-option]")
          .forEach((el) => {
            const value = el.dataset.accentOption;
            const isActive = value === selected;
            el.dataset.accentActive = isActive ? "1" : "0";
            el.setAttribute("aria-pressed", isActive ? "true" : "false");

            const swatch = el.querySelector<HTMLElement>("span:first-child");
            const label = el.querySelector<HTMLElement>("span:last-child");

            if (isActive) {
              el.classList.add(
                "ring-2",
                "ring-accent-500",
                "ring-offset-1",
                "bg-accent-50",
              );
              el.classList.remove(
                "hover:bg-background",
                "border",
                "border-border",
              );
              if (swatch) {
                swatch.classList.add("border-accent-400");
                swatch.classList.remove("border-border");
              }
              if (label) {
                label.classList.add("text-accent-700");
                label.classList.remove("text-muted-foreground");
              }
            } else {
              el.classList.remove(
                "ring-2",
                "ring-accent-500",
                "ring-offset-1",
                "bg-accent-50",
              );
              el.classList.add(
                "hover:bg-background",
                "border",
                "border-border",
              );
              if (swatch) {
                swatch.classList.remove("border-accent-400");
                swatch.classList.add("border-border");
              }
              if (label) {
                label.classList.remove("text-accent-700");
                label.classList.add("text-muted-foreground");
              }
            }
          });
      }

      // Theme toggle buttons
      document
        .querySelectorAll<HTMLButtonElement>("[data-theme-option]")
        .forEach((btn) => {
          if (btn.dataset.themeToggleBound === "1") return;
          btn.dataset.themeToggleBound = "1";

          btn.addEventListener("click", () => {
            const value = btn.dataset.themeOption;
            if (!value) return;

            const currentAccent =
              accentInput instanceof HTMLInputElement
                ? accentInput.value
                : "coral";
            updateLivePreview(value, currentAccent);
            updateThemeOptions(value);

            if (themeInput instanceof HTMLInputElement) {
              themeInput.value = value;
            }

            checkIfChanged();
          });
        });

      // Accent color buttons
      document
        .querySelectorAll<HTMLButtonElement>("[data-accent-option]")
        .forEach((btn) => {
          if (btn.dataset.accentToggleBound === "1") return;
          btn.dataset.accentToggleBound = "1";

          btn.addEventListener("click", () => {
            const value = btn.dataset.accentOption;
            if (!value) return;

            const currentTheme =
              themeInput instanceof HTMLInputElement
                ? themeInput.value
                : "system";
            updateLivePreview(currentTheme, value);
            updateAccentOptions(value);

            if (accentInput instanceof HTMLInputElement) {
              accentInput.value = value;
            }

            checkIfChanged();
          });
        });

      // Show save button only when preferences have changed
      let originalTheme =
        themeInput instanceof HTMLInputElement ? themeInput.value : "system";
      let originalAccent =
        accentInput instanceof HTMLInputElement ? accentInput.value : "coral";
      const saveBtnWrapper = document.getElementById("save-btn-wrapper");
      const saveBtn = document.querySelector<HTMLButtonElement>("#save-btn-wrapper button");
      const saveBtnIcon = saveBtn?.querySelector<HTMLElement>("svg");
      const prefsFeedback = document.getElementById("preferences-feedback");
      const prefsFeedbackMsg = document.getElementById("preferences-feedback-message");

      function setSaveBtnLoading(loading: boolean) {
        if (!saveBtn) return;
        saveBtn.disabled = loading;
        saveBtn.setAttribute("aria-busy", loading ? "true" : "false");
        if (loading && saveBtnIcon) {
          saveBtnIcon.style.display = "none";
          const spinner = document.createElementNS("http://www.w3.org/2000/svg", "svg");
          spinner.setAttribute("class", "h-4 w-4 animate-[sp_0.7s_linear_infinite]");
          spinner.setAttribute("width", "24");
          spinner.setAttribute("height", "24");
          spinner.setAttribute("viewBox", "0 0 24 24");
          spinner.setAttribute("fill", "none");
          spinner.setAttribute("stroke", "currentColor");
          spinner.setAttribute("stroke-width", "2.5");
          spinner.setAttribute("stroke-linecap", "round");
          spinner.setAttribute("stroke-linejoin", "round");
          spinner.innerHTML = '<path d="M21 12a9 9 0 1 1-6.219-8.56" />';
          spinner.dataset.spinner = "1";
          saveBtn.insertBefore(spinner, saveBtn.firstChild);
        } else if (!loading && saveBtnIcon) {
          saveBtnIcon.style.display = "";
          const spinner = saveBtn.querySelector<SVGElement>("[data-spinner]");
          if (spinner) spinner.remove();
        }
      }

      function showPrefsFeedback(type: "success" | "error", msg: string) {
        if (!prefsFeedback || !prefsFeedbackMsg) return;
        prefsFeedbackMsg.textContent = msg;
        prefsFeedback.className =
          "mb-4 rounded-2xl border px-4 py-3 text-sm " +
          (type === "success"
            ? "border-success-border bg-success-bg text-success"
            : "border-danger-border bg-danger-bg text-danger");
        prefsFeedback.classList.remove("hidden");
        prefsFeedback.focus();
      }

      function hidePrefsFeedback() {
        if (!prefsFeedback) return;
        prefsFeedback.classList.add("hidden");
      }

      function checkIfChanged() {
        const currentTheme =
          themeInput instanceof HTMLInputElement ? themeInput.value : "system";
        const currentAccent =
          accentInput instanceof HTMLInputElement
            ? accentInput.value
            : "coral";
        const changed =
          currentTheme !== originalTheme || currentAccent !== originalAccent;
        if (saveBtnWrapper) {
          saveBtnWrapper.classList.toggle("hidden", !changed);
        }
        if (saveBtn) {
          saveBtn.disabled = !changed;
        }
        if (!changed) hidePrefsFeedback();
      }

      // Optimistic save: intercept form submit, use fetch
      if (prefsForm && !prefsForm.dataset.optimisticBound) {
        prefsForm.dataset.optimisticBound = "1";

        prefsForm.addEventListener("submit", async (e) => {
          e.preventDefault();

          const formData = new FormData(prefsForm as HTMLFormElement);
          const newTheme = formData.get("theme") as string;
          const newAccent = formData.get("accentColor") as string;

          setSaveBtnLoading(true);

          try {
            const params = new URLSearchParams();
            formData.forEach((value, key) => params.append(key, value as string));

            const res = await fetch("/settings?tab=preferences", {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: params,
            });

            if (res.ok) {
              savedTheme = newTheme;
              savedAccent = newAccent;
              originalTheme = newTheme;
              originalAccent = newAccent;
              if (saveBtnWrapper) saveBtnWrapper.classList.add("hidden");
              showPrefsFeedback("success", "Preferencias guardadas correctamente.");
            } else {
              const fallbackTheme = savedTheme || originalTheme;
              const fallbackAccent = savedAccent || originalAccent;
              updateLivePreview(fallbackTheme, fallbackAccent);
              updateThemeOptions(fallbackTheme);
              updateAccentOptions(fallbackAccent);
              if (themeInput instanceof HTMLInputElement) themeInput.value = fallbackTheme;
              if (accentInput instanceof HTMLInputElement) accentInput.value = fallbackAccent;
              checkIfChanged();
              let text = "";
              try { text = await res.text(); } catch { text = ""; }
              showPrefsFeedback("error", text || "Error al guardar las preferencias. Se ha revertido el cambio.");
            }
          } catch {
            const fallbackTheme = savedTheme || originalTheme;
            const fallbackAccent = savedAccent || originalAccent;
            updateLivePreview(fallbackTheme, fallbackAccent);
            updateThemeOptions(fallbackTheme);
            updateAccentOptions(fallbackAccent);
            if (themeInput instanceof HTMLInputElement) themeInput.value = fallbackTheme;
            if (accentInput instanceof HTMLInputElement) accentInput.value = fallbackAccent;
            checkIfChanged();
            showPrefsFeedback("error", "Error de conexión. Se ha revertido el cambio.");
          } finally {
            setSaveBtnLoading(false);
          }
        });
      }
    }

    document.addEventListener("astro:page-load", setupSettings);
    document.addEventListener("astro:after-swap", setupSettings);
    setupSettings();
  </script>

  <script>
    function setupSettingsTabs() {
      const tabLinks =
        document.querySelectorAll<HTMLAnchorElement>("[data-tab]");
      const tabContents =
        document.querySelectorAll<HTMLElement>("[data-tab-content]");

      tabLinks.forEach((link) => {
        if (link.dataset.settingsTabBound === "1") return;
        link.dataset.settingsTabBound = "1";

        link.addEventListener("click", (e) => {
          e.preventDefault();
          const tab = link.dataset.tab;
          if (!tab) return;

          const url = new URL(window.location.href);
          if (tab === "profile") {
            url.searchParams.delete("tab");
          } else {
            url.searchParams.set("tab", tab);
          }
          history.pushState({}, "", url.toString());

          tabContents.forEach((el) => {
            el.classList.toggle("hidden", el.dataset.tabContent !== tab);
          });

          tabLinks.forEach((el) => {
            const active = el.dataset.tab === tab;
            el.classList.toggle("border-accent-600", active);
            el.classList.toggle("text-accent-600", active);
            el.classList.toggle("border-transparent", !active);
            el.classList.toggle("text-muted-foreground", !active);
            el.classList.toggle("hover:text-secondary-foreground", !active);
            el.classList.toggle("hover:border-muted-foreground/30", !active);
          });
        });
      });
    }

    document.addEventListener("astro:page-load", setupSettingsTabs);
    document.addEventListener("astro:after-swap", setupSettingsTabs);
    setupSettingsTabs();
  </script>

  <script>
    function setupAccountForms() {
      function setupPasswordToggles() {
        document.querySelectorAll<HTMLButtonElement>("[data-pw-toggle]").forEach((btn) => {
          if (btn.dataset.pwToggleBound === "1") return;
          btn.dataset.pwToggleBound = "1";
          btn.addEventListener("click", () => {
            const inputId = btn.dataset.pwToggle;
            if (!inputId) return;
            const input = document.getElementById(inputId) as HTMLInputElement | null;
            if (!input) return;
            const isPassword = input.type === "password";
            input.type = isPassword ? "text" : "password";
            btn.querySelector<HTMLElement>("[data-pw-eye]")?.classList.toggle("hidden", !isPassword);
            btn.querySelector<HTMLElement>("[data-pw-eye-off]")?.classList.toggle("hidden", isPassword);
            btn.setAttribute("aria-label", isPassword ? "Ocultar contraseña" : "Mostrar contraseña");
          });
        });
      }

      setupPasswordToggles();

      function showFeedback(
        el: HTMLElement | null,
        type: "success" | "error",
        msg: string,
      ) {
        if (!el) return;
        el.textContent = msg;
        el.classList.remove("hidden");
        el.className = el.className.replace(
          /border-(success|danger)-(border|bg)/g,
          "",
        );
        const fbClasses = (
          type === "success"
            ? "border-success-border bg-success-bg text-success"
            : "border-danger-border bg-danger-bg text-danger"
        ).split(" ");
        el.classList.add(...fbClasses);
        el.setAttribute("tabindex", "-1");
        el.focus();
      }

      function setBtnLoading(btn: HTMLButtonElement | null, loading: boolean) {
        if (!btn) return;
        btn.disabled = loading;
        btn.setAttribute("aria-busy", loading ? "true" : "false");
        const icon = btn.querySelector<HTMLElement>("svg:not([data-spinner])");
        if (loading && icon) {
          icon.style.display = "none";
          const spinner = document.createElementNS("http://www.w3.org/2000/svg", "svg");
          spinner.setAttribute("class", "h-4 w-4 animate-[sp_0.7s_linear_infinite]");
          spinner.setAttribute("width", "24");
          spinner.setAttribute("height", "24");
          spinner.setAttribute("viewBox", "0 0 24 24");
          spinner.setAttribute("fill", "none");
          spinner.setAttribute("stroke", "currentColor");
          spinner.setAttribute("stroke-width", "2.5");
          spinner.setAttribute("stroke-linecap", "round");
          spinner.setAttribute("stroke-linejoin", "round");
          spinner.innerHTML = '<path d="M21 12a9 9 0 1 1-6.219-8.56" />';
          spinner.dataset.spinner = "1";
          btn.insertBefore(spinner, btn.firstChild);
        } else if (!loading && icon) {
          icon.style.display = "";
          const spinner = btn.querySelector<SVGElement>("[data-spinner]");
          if (spinner) spinner.remove();
        }
      }

      function mapServerError(text: string, fallback: string): string {
        const err = text.toLowerCase();
        if (err.includes("unauthorized") || err.includes("incorrect") || err.includes("wrong")) return "Contraseña actual incorrecta.";
        if (err.includes("too many requests") || err.includes("rate limit")) return "Demasiados intentos. Intenta de nuevo más tarde.";
        return text || fallback;
      }

      function updateEmailBtnState() {
        const btn = document.getElementById("change-email-btn") as HTMLButtonElement | null;
        const email = (document.getElementById("new-email") as HTMLInputElement)?.value.trim();
        const pwd = (document.getElementById("email-current-password") as HTMLInputElement)?.value;
        if (btn) btn.disabled = !email || !pwd;
      }

      function updatePasswordBtnState() {
        const btn = document.getElementById("change-password-btn") as HTMLButtonElement | null;
        const current = (document.getElementById("current-password") as HTMLInputElement)?.value;
        const newPwd = (document.getElementById("new-password") as HTMLInputElement)?.value;
        const confirmPwd = (document.getElementById("confirm-new-password") as HTMLInputElement)?.value;
        if (btn) btn.disabled = !current || !newPwd || !confirmPwd;
      }

      const emailForm = document.getElementById(
        "change-email-form",
      ) as HTMLFormElement | null;
      if (emailForm && !emailForm.dataset.bound) {
        emailForm.dataset.bound = "1";
        const emailInput = document.getElementById("new-email") as HTMLInputElement | null;
        const pwdInput = document.getElementById("email-current-password") as HTMLInputElement | null;
        emailInput?.addEventListener("input", updateEmailBtnState);
        pwdInput?.addEventListener("input", updateEmailBtnState);
        updateEmailBtnState();

        emailForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const newEmail = emailInput?.value.trim() || "";
          const password = pwdInput?.value || "";
          const fb = document.getElementById("change-email-feedback");
          const btn = document.getElementById("change-email-btn") as HTMLButtonElement | null;

          setBtnLoading(btn, true);
          try {
            const res = await fetch("/api/account/change-email", {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: new URLSearchParams({ newEmail, currentPassword: password }),
            });
            if (res.ok) {
              showFeedback(fb, "success", "Email actualizado correctamente.");
              emailForm.reset();
              updateEmailBtnState();
            } else if (res.status === 401) {
              showFeedback(fb, "error", "Sesión expirada. Vuelve a iniciar sesión.");
            } else {
              let text = "";
              try { text = await res.text(); } catch { text = ""; }
              showFeedback(fb, "error", mapServerError(text, "Error al cambiar el email."));
            }
          } catch (err) {
            console.error("[change-password] fetch error:", err);
            showFeedback(fb, "error", "Error de conexión.");
          } finally {
            setBtnLoading(btn, false);
          }
        });
      }

      const pwdForm = document.getElementById(
        "change-password-form",
      ) as HTMLFormElement | null;
      if (pwdForm && !pwdForm.dataset.bound) {
        pwdForm.dataset.bound = "1";
        const currentInput = document.getElementById("current-password") as HTMLInputElement | null;
        const newPwdInput = document.getElementById("new-password") as HTMLInputElement | null;
        const confirmPwdInput = document.getElementById("confirm-new-password") as HTMLInputElement | null;
        currentInput?.addEventListener("input", updatePasswordBtnState);
        newPwdInput?.addEventListener("input", updatePasswordBtnState);
        confirmPwdInput?.addEventListener("input", updatePasswordBtnState);
        updatePasswordBtnState();

        pwdForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const currentPassword = currentInput?.value || "";
          const newPassword = newPwdInput?.value || "";
          const confirmPassword = confirmPwdInput?.value || "";
          const fb = document.getElementById("change-password-feedback");
          const btn = document.getElementById("change-password-btn") as HTMLButtonElement | null;

          if (newPassword.length < 6) {
            showFeedback(fb, "error", "La contraseña debe tener al menos 6 caracteres.");
            return;
          }
          if (newPassword !== confirmPassword) {
            showFeedback(fb, "error", "Las contraseñas no coinciden.");
            return;
          }

          setBtnLoading(btn, true);
          try {
            const res = await fetch("/api/account/change-password", {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: new URLSearchParams({ currentPassword, newPassword }),
            });
            if (res.ok) {
              showFeedback(fb, "success", "Contraseña actualizada correctamente.");
              pwdForm.reset();
              updatePasswordBtnState();
            } else if (res.status === 401) {
              showFeedback(fb, "error", "Sesión expirada. Vuelve a iniciar sesión.");
            } else {
              let text = "";
              try { text = await res.text(); } catch { text = ""; }
              showFeedback(fb, "error", mapServerError(text, "Error al cambiar la contraseña."));
            }
          } catch (err) {
            console.error("[change-password] fetch error:", err);
            showFeedback(fb, "error", "Error de conexión.");
          } finally {
            setBtnLoading(btn, false);
          }
        });
      }
    }

    document.addEventListener("astro:page-load", setupAccountForms);
    document.addEventListener("astro:after-swap", setupAccountForms);
    setupAccountForms();
  </script>

</Layout>
