---
import { Icon } from "astro-icon/components";
import { Button, Card } from "@/components/ui";
import BillingSection from "@/components/BillingSection.astro";
import Layout from "@/layouts/Layout.astro";
import {
  getUserPreferences,
  upsertUserPreferences,
} from "@/lib/db/preferences";
import {
  ACCENT_FAMILIES,
  ACCENT_LABELS,
  getAccentPreviewColor,
  type AccentFamily,
} from "@/lib/accent-colors";
import {
  getRemainingRecipes,
  getRemainingIngredients,
} from "@/lib/subscription";
import { countUserRecipes, countUserIngredients, getPricingPlans } from "@/lib/db/billing";
import FeedbackAlert from "@/components/FeedbackAlert.astro";
import { validateCsrf } from "@/lib/csrf";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const user = Astro.locals.user;
const userName = user.name || "Usuario";
const userEmail = user.email || "";
const userImage = user.image || null;
const userInitial = userName.charAt(0).toUpperCase();

const subscription = Astro.locals.subscription;
const ownerId = user.id;

const [prefs, recipeCount, ingredientCount] = await Promise.all([
  getUserPreferences(user.id),
  countUserRecipes(ownerId),
  countUserIngredients(ownerId),
]);

const plans = await getPricingPlans();

const remainingRecipes = getRemainingRecipes(subscription, recipeCount);
const remainingIngredients = getRemainingIngredients(
  subscription,
  ingredientCount,
);

const currentTheme = prefs?.theme ?? "light";
const currentAccent = (prefs?.accentColor ?? "indigo") as AccentFamily;

const activeTab = Astro.url.searchParams.get("tab") || "profile";

type Feedback = { type: "success" | "error"; message: string };
let feedback: Feedback | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  if (!validateCsrf(Astro.request, formData)) {
    return Astro.redirect("/settings");
  }

  const theme = formData.get("theme") as string;
  const accentColor = formData.get("accentColor") as string;

  try {
    await upsertUserPreferences(user.id, {
      theme: theme === "dark" ? "dark" : "light",
      accentColor: ACCENT_FAMILIES.includes(accentColor as AccentFamily)
        ? accentColor
        : undefined,
    });
    feedback = {
      type: "success",
      message: "Preferencias guardadas correctamente.",
    };
  } catch {
    feedback = { type: "error", message: "Error al guardar las preferencias." };
  }
}

const redirectUrl = new URL(Astro.url);
if (feedback) {
  redirectUrl.searchParams.set("type", feedback.type);
  redirectUrl.searchParams.set("message", feedback.message);
  return Astro.redirect(redirectUrl.toString());
}
---

<Layout currentPage="settings" showSideBar={true}>
  <section class="mx-auto max-w-3xl">
    {
      Astro.url.searchParams.has("type") && (
        <FeedbackAlert
          type={Astro.url.searchParams.get("type") as "success" | "error"}
          message={Astro.url.searchParams.get("message") || ""}
        />
      )
    }

    {/* Tab Navigation */}
    <nav
      class="border-border mb-8 flex gap-0 border-b"
      aria-label="Configuración"
    >
      <a
        href="/settings"
        data-tab="profile"
        class:list={[
          "-mb-[1px] inline-flex items-center gap-1.5 border-b-2 px-4 py-2.5 text-sm font-semibold transition-colors",
          activeTab === "profile"
            ? "border-accent-600 text-accent-600"
            : "text-muted-foreground hover:text-secondary-foreground hover:border-muted-foreground/30 border-transparent",
        ]}
      >
        <Icon name="lucide:user" size={16} class="hidden sm:block" />
        Perfil
      </a>
      <a
        href="/settings?tab=preferences"
        data-tab="preferences"
        class:list={[
          "-mb-[1px] inline-flex items-center gap-1.5 border-b-2 px-4 py-2.5 text-sm font-semibold transition-colors",
          activeTab === "preferences"
            ? "border-accent-600 text-accent-600"
            : "text-muted-foreground hover:text-secondary-foreground hover:border-muted-foreground/30 border-transparent",
        ]}
      >
        <Icon name="lucide:palette" size={16} class="hidden sm:block" />
        Preferencias
      </a>
      <a
        href="/settings?tab=billing"
        data-tab="billing"
        class:list={[
          "-mb-[1px] inline-flex items-center gap-1.5 border-b-2 px-4 py-2.5 text-sm font-semibold transition-colors",
          activeTab === "billing"
            ? "border-accent-600 text-accent-600"
            : "text-muted-foreground hover:text-secondary-foreground hover:border-muted-foreground/30 border-transparent",
        ]}
      >
        <Icon name="lucide:credit-card" size={16} class="hidden sm:block" />
        Facturación
      </a>
    </nav>

    {/* Profile Tab */}
    <div
      data-tab-content="profile"
      class:list={["space-y-8", activeTab !== "profile" && "hidden"]}
    >
      {/* Profile Card */}
      <Card padding="lg">
        <div class="flex items-center gap-4">
          <div
            class="bg-accent-600 shadow-accent-100 flex h-16 w-16 flex-none items-center justify-center rounded-2xl text-xl font-bold text-white shadow-md"
          >
            {
              userImage ? (
                <img
                  src={userImage}
                  alt={userName}
                  referrerpolicy="no-referrer"
                  class="h-full w-full rounded-2xl object-cover"
                />
              ) : (
                userInitial
              )
            }
          </div>
          <div class="min-w-0">
            <p
              class="text-muted-foreground text-xs font-bold tracking-[0.15em] uppercase"
            >
              Sesion de Google
            </p>
            <h2 class="text-foreground mt-1 truncate text-xl font-bold">
              {userName}
            </h2>
            {
              userEmail && (
                <p class="text-muted-foreground mt-0.5 truncate text-sm">
                  {userEmail}
                </p>
              )
            }
          </div>
        </div>
      </Card>

      {/* Change Email */}
      <Card padding="lg">
        <h2 class="text-foreground text-lg font-bold">Cambiar email</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Actualiza la dirección de correo electrónico asociada a tu cuenta.
        </p>
        <div
          id="change-email-feedback"
          class="mt-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
        ></div>
        <form id="change-email-form" class="mt-4 max-w-sm space-y-4">
          <div>
            <label
              for="new-email"
              class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
            >
              Nuevo email
            </label>
            <input
              id="new-email"
              type="email"
              required
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              placeholder="nuevo@email.com"
              autocomplete="email"
            />
          </div>
          <div>
            <label
              for="email-current-password"
              class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
            >
              Contraseña actual
            </label>
            <input
              id="email-current-password"
              type="password"
              required
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              autocomplete="current-password"
            />
          </div>
          <Button variant="primary" type="submit" icon="mail">
            Cambiar email
          </Button>
        </form>
      </Card>

      {/* Change Password */}
      <Card padding="lg">
        <h2 class="text-foreground text-lg font-bold">Cambiar contraseña</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Usa al menos 6 caracteres para tu nueva contraseña.
        </p>
        <div
          id="change-password-feedback"
          class="mt-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
        ></div>
        <form id="change-password-form" class="mt-4 max-w-sm space-y-4">
          <div>
            <label
              for="current-password"
              class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
            >
              Contraseña actual
            </label>
            <input
              id="current-password"
              type="password"
              required
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              autocomplete="current-password"
            />
          </div>
          <div>
            <label
              for="new-password"
              class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
            >
              Nueva contraseña
            </label>
            <input
              id="new-password"
              type="password"
              required
              minlength={6}
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              placeholder="Mínimo 6 caracteres"
              autocomplete="new-password"
            />
          </div>
          <div>
            <label
              for="confirm-new-password"
              class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
            >
              Confirmar contraseña
            </label>
            <input
              id="confirm-new-password"
              type="password"
              required
              minlength={6}
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              placeholder="Repite tu contraseña"
              autocomplete="new-password"
            />
          </div>
          <Button variant="primary" type="submit" icon="lock">
            Cambiar contraseña
          </Button>
        </form>
      </Card>
    </div>

      {/* Billing Tab */}
      <div
        data-tab-content="billing"
        class:list={["space-y-6", activeTab !== "billing" && "hidden"]}
      >
        <BillingSection
          {subscription}
          {plans}
          {recipeCount}
          {ingredientCount}
          {remainingRecipes}
          {remainingIngredients}
        />
      </div>
  </section>

  <script>
    import { getAccentCssVars } from "@/lib/accent-colors";

    function setupSettings() {
      const themeInput = document.getElementById("theme-input");
      const accentInput = document.getElementById("accent-input");
      const html = document.documentElement;

      function updateLivePreview(theme: string, accent: string) {
        html.dataset.theme = theme;
        html.dataset.accent = accent;
        html.dataset.appTheme = theme;
        html.dataset.appAccent = accent;

        if (theme === "dark") {
          html.classList.add("dark");
        } else {
          html.classList.remove("dark");
        }

        try {
          html.style.cssText = getAccentCssVars(accent, theme);
        } catch {
          // Ignore if function not available
        }
      }

      function updateThemeOptions(selected: string) {
        document
          .querySelectorAll<HTMLElement>("[data-theme-option]")
          .forEach((el) => {
            const value = el.dataset.themeOption;
            const isActive = value === selected;
            el.dataset.themeActive = isActive ? "1" : "0";

            const selectedClasses = [
              "bg-accent-600",
              "text-white",
              "shadow-sm",
            ];
            const unselectedClasses = [
              "text-muted-foreground",
              "hover:text-secondary-foreground",
              "hover:bg-muted",
            ];

            if (isActive) {
              el.classList.add(...selectedClasses);
              el.classList.remove(...unselectedClasses);
            } else {
              el.classList.remove(...selectedClasses);
              el.classList.add(...unselectedClasses);
            }
          });
      }

      function updateAccentOptions(selected: string) {
        document
          .querySelectorAll<HTMLElement>("[data-accent-option]")
          .forEach((el) => {
            const value = el.dataset.accentOption;
            const isActive = value === selected;
            el.dataset.accentActive = isActive ? "1" : "0";

            const swatch = el.querySelector<HTMLElement>("span:first-child");
            const label = el.querySelector<HTMLElement>("span:last-child");

            if (isActive) {
              el.classList.add(
                "ring-2",
                "ring-accent-500",
                "ring-offset-1",
                "bg-accent-50",
              );
              el.classList.remove(
                "hover:bg-background",
                "border",
                "border-border",
              );
              if (swatch) {
                swatch.classList.add("border-accent-400");
                swatch.classList.remove("border-border");
              }
              if (label) {
                label.classList.add("text-accent-700");
                label.classList.remove("text-muted-foreground");
              }
            } else {
              el.classList.remove(
                "ring-2",
                "ring-accent-500",
                "ring-offset-1",
                "bg-accent-50",
              );
              el.classList.add(
                "hover:bg-background",
                "border",
                "border-border",
              );
              if (swatch) {
                swatch.classList.remove("border-accent-400");
                swatch.classList.add("border-border");
              }
              if (label) {
                label.classList.remove("text-accent-700");
                label.classList.add("text-muted-foreground");
              }
            }
          });
      }

      // Theme toggle buttons
      document
        .querySelectorAll<HTMLButtonElement>("[data-theme-option]")
        .forEach((btn) => {
          if (btn.dataset.themeToggleBound === "1") return;
          btn.dataset.themeToggleBound = "1";

          btn.addEventListener("click", () => {
            const value = btn.dataset.themeOption;
            if (!value) return;

            updateLivePreview(
              value,
              accentInput instanceof HTMLInputElement
                ? accentInput.value
                : "indigo",
            );
            updateThemeOptions(value);

            if (themeInput instanceof HTMLInputElement) {
              themeInput.value = value;
            }

            checkIfChanged();
          });
        });

      // Accent color buttons
      document
        .querySelectorAll<HTMLButtonElement>("[data-accent-option]")
        .forEach((btn) => {
          if (btn.dataset.accentToggleBound === "1") return;
          btn.dataset.accentToggleBound = "1";

          btn.addEventListener("click", () => {
            const value = btn.dataset.accentOption;
            if (!value) return;

            const currentTheme =
              html.dataset.appTheme || html.dataset.theme || "light";
            updateLivePreview(currentTheme, value);
            updateAccentOptions(value);

            if (accentInput instanceof HTMLInputElement) {
              accentInput.value = value;
            }

            checkIfChanged();
          });
        });

      // Show save button only when preferences have changed
      const originalTheme =
        themeInput instanceof HTMLInputElement ? themeInput.value : "light";
      const originalAccent =
        accentInput instanceof HTMLInputElement ? accentInput.value : "indigo";
      const saveBtnWrapper = document.getElementById("save-btn-wrapper");

      function checkIfChanged() {
        const currentTheme =
          themeInput instanceof HTMLInputElement ? themeInput.value : "light";
        const currentAccent =
          accentInput instanceof HTMLInputElement
            ? accentInput.value
            : "indigo";
        const changed =
          currentTheme !== originalTheme || currentAccent !== originalAccent;
        if (saveBtnWrapper) {
          saveBtnWrapper.classList.toggle("hidden", !changed);
        }
      }
    }

    document.addEventListener("astro:page-load", setupSettings);
    document.addEventListener("astro:after-swap", setupSettings);
    setupSettings();
  </script>

  <script>
    function setupSettingsTabs() {
      const tabLinks =
        document.querySelectorAll<HTMLAnchorElement>("[data-tab]");
      const tabContents =
        document.querySelectorAll<HTMLElement>("[data-tab-content]");

      tabLinks.forEach((link) => {
        if (link.dataset.settingsTabBound === "1") return;
        link.dataset.settingsTabBound = "1";

        link.addEventListener("click", (e) => {
          e.preventDefault();
          const tab = link.dataset.tab;
          if (!tab) return;

          const url = new URL(window.location.href);
          if (tab === "profile") {
            url.searchParams.delete("tab");
          } else {
            url.searchParams.set("tab", tab);
          }
          history.pushState({}, "", url.toString());

          tabContents.forEach((el) => {
            el.classList.toggle("hidden", el.dataset.tabContent !== tab);
          });

          tabLinks.forEach((el) => {
            const active = el.dataset.tab === tab;
            el.classList.toggle("border-accent-600", active);
            el.classList.toggle("text-accent-600", active);
            el.classList.toggle("border-transparent", !active);
            el.classList.toggle("text-muted-foreground", !active);
            el.classList.toggle("hover:text-secondary-foreground", !active);
            el.classList.toggle("hover:border-muted-foreground/30", !active);
          });
        });
      });
    }

    document.addEventListener("astro:page-load", setupSettingsTabs);
    document.addEventListener("astro:after-swap", setupSettingsTabs);
    setupSettingsTabs();
  </script>

  <script>
    function setupAccountForms() {
      function showFeedback(
        el: HTMLElement | null,
        type: "success" | "error",
        msg: string,
      ) {
        if (!el) return;
        el.textContent = msg;
        el.classList.remove("hidden");
        el.className = el.className.replace(
          /border-(success|danger)-(border|bg)/g,
          "",
        );
        el.classList.add(
          type === "success" ? "border-success-border bg-success-bg text-success" : "border-danger-border bg-danger-bg text-danger",
        );
      }

      const emailForm = document.getElementById(
        "change-email-form",
      ) as HTMLFormElement | null;
      if (emailForm && !emailForm.dataset.bound) {
        emailForm.dataset.bound = "1";
        emailForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const newEmail = (
            document.getElementById("new-email") as HTMLInputElement
          ).value.trim();
          const password = (
            document.getElementById(
              "email-current-password",
            ) as HTMLInputElement
          ).value;
          const fb = document.getElementById("change-email-feedback");
          try {
            const res = await fetch("/api/account/change-email", {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: new URLSearchParams({
                newEmail,
                currentPassword: password,
              }),
            });
            if (res.ok) {
              showFeedback(fb, "success", "Email actualizado correctamente.");
              emailForm.reset();
            } else {
              const text = await res.text();
              showFeedback(fb, "error", text || "Error al cambiar el email.");
            }
          } catch {
            showFeedback(fb, "error", "Error de conexión.");
          }
        });
      }

      const pwdForm = document.getElementById(
        "change-password-form",
      ) as HTMLFormElement | null;
      if (pwdForm && !pwdForm.dataset.bound) {
        pwdForm.dataset.bound = "1";
        pwdForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const currentPassword = (
            document.getElementById("current-password") as HTMLInputElement
          ).value;
          const newPassword = (
            document.getElementById("new-password") as HTMLInputElement
          ).value;
          const confirmPassword = (
            document.getElementById("confirm-new-password") as HTMLInputElement
          ).value;
          const fb = document.getElementById("change-password-feedback");

          if (newPassword.length < 6) {
            showFeedback(
              fb,
              "error",
              "La contraseña debe tener al menos 6 caracteres.",
            );
            return;
          }
          if (newPassword !== confirmPassword) {
            showFeedback(fb, "error", "Las contraseñas no coinciden.");
            return;
          }

          try {
            const res = await fetch("/api/account/change-password", {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: new URLSearchParams({ currentPassword, newPassword }),
            });
            if (res.ok) {
              showFeedback(
                fb,
                "success",
                "Contraseña actualizada correctamente.",
              );
              pwdForm.reset();
            } else {
              const text = await res.text();
              showFeedback(fb, "error", text || "Error al cambiar la contraseña.");
            }
          } catch {
            showFeedback(fb, "error", "Error de conexión.");
          }
        });
      }
    }

    document.addEventListener("astro:page-load", setupAccountForms);
    document.addEventListener("astro:after-swap", setupAccountForms);
    setupAccountForms();
  </script>

</Layout>
