---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import { getUserPreferences, upsertUserPreferences } from "../lib/recipe-data";
import { ACCENT_FAMILIES, ACCENT_LABELS, getAccentPreviewColor, type AccentFamily } from "../lib/accent-colors";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const user = Astro.locals.user;
const userName = user.name || "Usuario";
const userEmail = user.email || "";
const userImage = user.image || null;
const userInitial = userName.charAt(0).toUpperCase();

const prefs = await getUserPreferences(user.id);
const currentTheme = prefs?.theme ?? "light";
const currentAccent = (prefs?.accentColor ?? "indigo") as AccentFamily;

type Feedback = { type: "success" | "error"; message: string };
let feedback: Feedback | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const theme = formData.get("theme") as string;
  const accentColor = formData.get("accentColor") as string;

  try {
    await upsertUserPreferences(user.id, {
      theme: theme === "dark" ? "dark" : "light",
      accentColor: ACCENT_FAMILIES.includes(accentColor as AccentFamily) ? accentColor : undefined,
    });
    feedback = { type: "success", message: "Preferencias guardadas correctamente." };
  } catch {
    feedback = { type: "error", message: "Error al guardar las preferencias." };
  }
}

const redirectUrl = new URL(Astro.url);
if (feedback) {
  redirectUrl.searchParams.set("type", feedback.type);
  redirectUrl.searchParams.set("message", feedback.message);
  return Astro.redirect(redirectUrl.toString());
}
---

<Layout currentPage="settings" showSideBar={false}>
  <section class="mx-auto max-w-2xl space-y-8">
    {
      Astro.url.searchParams.has("type") && (
        <div
          class:list={[
            "rounded-2xl border px-4 py-3 text-sm font-semibold",
            Astro.url.searchParams.get("type") === "success"
              ? "border-emerald-200 bg-emerald-50 text-emerald-700"
              : "border-rose-200 bg-rose-50 text-rose-700",
          ]}
        >
          {Astro.url.searchParams.get("message")}
        </div>
      )
    }

    {/* Profile Card */}
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-4">
        <div class="flex h-16 w-16 flex-none items-center justify-center rounded-2xl bg-accent-600 text-xl font-bold text-white shadow-md shadow-accent-100">
          {userImage ? (
            <img
              src={userImage}
              alt={userName}
              referrerpolicy="no-referrer"
              class="h-full w-full rounded-2xl object-cover"
            />
          ) : (
            userInitial
          )}
        </div>
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.15em] text-slate-500">
            Sesion de Google
          </p>
          <h2 class="mt-1 truncate text-xl font-bold text-slate-900">
            {userName}
          </h2>
          {userEmail && (
            <p class="mt-0.5 truncate text-sm text-slate-500">{userEmail}</p>
          )}
        </div>
      </div>
    </div>

    {/* Preferences Form */}
    <form method="post" action="/settings">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-8">
        {/* Theme Toggle */}
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 mb-3">
            Tema
          </p>
          <div class="flex gap-2 rounded-xl bg-slate-100/50 p-1.5 border border-slate-200 max-w-xs">
            <button
              type="button"
              data-theme-option="light"
              data-theme-active={currentTheme === "light" ? "1" : "0"}
              class:list={[
                "flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-all",
                currentTheme === "light"
                  ? "bg-accent-600 text-white shadow-sm"
                  : "text-slate-500 hover:text-slate-700 hover:bg-slate-100",
              ]}
            >
              <Icon name="lucide:sun" size={16} />
              Claro
            </button>
            <button
              type="button"
              data-theme-option="dark"
              data-theme-active={currentTheme === "dark" ? "1" : "0"}
              class:list={[
                "flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold transition-all",
                currentTheme === "dark"
                  ? "bg-accent-600 text-white shadow-sm"
                  : "text-slate-500 hover:text-slate-700 hover:bg-slate-100",
              ]}
            >
              <Icon name="lucide:moon" size={16} />
              Oscuro
            </button>
          </div>
          <input type="hidden" name="theme" id="theme-input" value={currentTheme} />
        </div>

        {/* Accent Color Picker */}
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 mb-3">
            Color de acento
          </p>
          <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 max-w-xl">
            {
              ACCENT_FAMILIES.map((family) => {
                const isSelected = currentAccent === family;
                const previewColor = getAccentPreviewColor(family);
                return (
                  <button
                    type="button"
                    data-accent-option={family}
                    data-accent-active={isSelected ? "1" : "0"}
                    class:list={[
                      "flex flex-col items-center gap-2 rounded-xl p-3 transition-all",
                      isSelected
                        ? "ring-2 ring-accent-500 ring-offset-1 bg-accent-50"
                        : "hover:bg-slate-50 border border-slate-200",
                    ]}
                  >
                    <span
                      class:list={[
                        "h-8 w-8 rounded-lg border",
                        isSelected ? "border-accent-400" : "border-slate-200",
                      ]}
                      style={`background-color:${previewColor}`}
                    ></span>
                    <span
                      class:list={[
                        "text-[11px] font-semibold",
                        isSelected ? "text-accent-700" : "text-slate-600",
                      ]}
                    >
                      {ACCENT_LABELS[family]}
                    </span>
                  </button>
                );
              })
            }
          </div>
          <input type="hidden" name="accentColor" id="accent-input" value={currentAccent} />
        </div>
      </div>

      {/* Save Button */}
      <div class="mt-6 flex justify-end">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-accent-600 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-700"
        >
          <Icon name="lucide:check" size={16} />
          Guardar preferencias
        </button>
      </div>
    </form>
  </section>
</Layout>

<script>
  import { getAccentCssVars } from "../lib/accent-colors";

  function setupSettings() {
    const themeInput = document.getElementById("theme-input");
    const accentInput = document.getElementById("accent-input");
    const html = document.documentElement;

    function updateLivePreview(theme: string, accent: string) {
      html.dataset.theme = theme;
      html.dataset.accent = accent;

      if (theme === "dark") {
        html.classList.add("dark");
      } else {
        html.classList.remove("dark");
      }

      try {
        html.style.cssText = getAccentCssVars(accent, theme);
      } catch {
        // Ignore if function not available
      }
    }

    function updateThemeOptions(selected: string) {
      document.querySelectorAll<HTMLElement>("[data-theme-option]").forEach((el) => {
        const value = el.dataset.themeOption;
        const isActive = value === selected;
        el.dataset.themeActive = isActive ? "1" : "0";

        const selectedClasses = ["bg-accent-600", "text-white", "shadow-sm"];
        const unselectedClasses = ["text-slate-500", "hover:text-slate-700", "hover:bg-slate-100"];

        if (isActive) {
          el.classList.add(...selectedClasses);
          el.classList.remove(...unselectedClasses);
        } else {
          el.classList.remove(...selectedClasses);
          el.classList.add(...unselectedClasses);
        }
      });
    }

    function updateAccentOptions(selected: string) {
      document.querySelectorAll<HTMLElement>("[data-accent-option]").forEach((el) => {
        const value = el.dataset.accentOption;
        const isActive = value === selected;
        el.dataset.accentActive = isActive ? "1" : "0";

        const swatch = el.querySelector<HTMLElement>("span:first-child");
        const label = el.querySelector<HTMLElement>("span:last-child");

        if (isActive) {
          el.classList.add("ring-2", "ring-accent-500", "ring-offset-1", "bg-accent-50");
          el.classList.remove("hover:bg-slate-50", "border", "border-slate-200");
          if (swatch) {
            swatch.classList.add("border-accent-400");
            swatch.classList.remove("border-slate-200");
          }
          if (label) {
            label.classList.add("text-accent-700");
            label.classList.remove("text-slate-600");
          }
        } else {
          el.classList.remove("ring-2", "ring-accent-500", "ring-offset-1", "bg-accent-50");
          el.classList.add("hover:bg-slate-50", "border", "border-slate-200");
          if (swatch) {
            swatch.classList.remove("border-accent-400");
            swatch.classList.add("border-slate-200");
          }
          if (label) {
            label.classList.remove("text-accent-700");
            label.classList.add("text-slate-600");
          }
        }
      });
    }

    // Theme toggle buttons
    document.querySelectorAll<HTMLButtonElement>("[data-theme-option]").forEach((btn) => {
      if (btn.dataset.themeToggleBound === "1") return;
      btn.dataset.themeToggleBound = "1";

      btn.addEventListener("click", () => {
        const value = btn.dataset.themeOption;
        if (!value) return;

        updateLivePreview(value, accentInput instanceof HTMLInputElement ? accentInput.value : "indigo");
        updateThemeOptions(value);

        if (themeInput instanceof HTMLInputElement) {
          themeInput.value = value;
        }
      });
    });

    // Accent color buttons
    document.querySelectorAll<HTMLButtonElement>("[data-accent-option]").forEach((btn) => {
      if (btn.dataset.accentToggleBound === "1") return;
      btn.dataset.accentToggleBound = "1";

      btn.addEventListener("click", () => {
        const value = btn.dataset.accentOption;
        if (!value) return;

        const currentTheme = html.dataset.theme || "light";
        updateLivePreview(currentTheme, value);
        updateAccentOptions(value);

        if (accentInput instanceof HTMLInputElement) {
          accentInput.value = value;
        }
      });
    });
  }

  document.addEventListener("astro:page-load", setupSettings);
  document.addEventListener("astro:after-swap", setupSettings);
  setupSettings();
</script>
