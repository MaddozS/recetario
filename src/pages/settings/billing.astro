---
import Layout from "@/layouts/Layout.astro";
import {
  getRemainingRecipes,
  getRemainingIngredients,
} from "@/lib/subscription";
import {
  countUserRecipes,
  countUserIngredients,
  getPricingPlans,
} from "@/lib/db/billing";
import BillingSection from "@/components/BillingSection.astro";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const ownerId = Astro.locals.user!.id;
const subscription = Astro.locals.subscription;

const recipeCount = await countUserRecipes(ownerId);
const ingredientCount = await countUserIngredients(ownerId);
const plans = await getPricingPlans();

const remainingRecipes = getRemainingRecipes(subscription, recipeCount);
const remainingIngredients = getRemainingIngredients(
  subscription,
  ingredientCount,
);

const isSuccess = Astro.url.searchParams.get("success") === "1";
const isCanceled = Astro.url.searchParams.get("canceled") === "1";
---

<Layout currentPage="settings" showSideBar={true}>
  <section class="mx-auto max-w-3xl space-y-6">
    <BillingSection
      {subscription}
      {plans}
      {recipeCount}
      {ingredientCount}
      {remainingRecipes}
      {remainingIngredients}
      showBackButton={true}
      {isSuccess}
      {isCanceled}
    />
  </section>
</Layout>
