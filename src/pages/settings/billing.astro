---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import {
  isPaid,
  getRemainingRecipes,
  getRemainingIngredients,
} from "../../lib/subscription";
import {
  countUserRecipes,
  countUserIngredients,
  getRecipeDataOwner,
} from "../../lib/recipe-data";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const user = Astro.locals.user;
const subscription = Astro.locals.subscription;
const recipeDataOwner = getRecipeDataOwner(user);

const recipeCount = await countUserRecipes(recipeDataOwner);
const ingredientCount = await countUserIngredients(recipeDataOwner);

const remainingRecipes = getRemainingRecipes(subscription, recipeCount);
const remainingIngredients = getRemainingIngredients(
  subscription,
  ingredientCount,
);

const isSuccess = Astro.url.searchParams.get("success") === "1";
const isCanceled = Astro.url.searchParams.get("canceled") === "1";
---

<Layout currentPage="settings" showSideBar={false}>
  <section class="mx-auto max-w-2xl space-y-6" transition:animate="slide">
    <nav class="flex items-center gap-2 text-sm">
      <a
        href="/settings"
        class="text-muted-foreground hover:text-secondary-foreground font-medium"
        >Ajustes</a
      >
      <Icon
        name="lucide:chevron-right"
        size={14}
        class="text-subtle-foreground"
      />
      <span class="text-foreground font-semibold"
        >Facturacion y Suscripcion</span
      >
    </nav>

    {
      isSuccess && (
        <div class="rounded-2xl border border-success-border bg-success-bg p-4">
          <div class="flex items-center gap-3">
            <Icon name="lucide:check-circle" size={20} class="text-success" />
            <div>
              <p class="text-success font-semibold">Pago exitoso</p>
              <p class="text-success text-sm">
                Tu suscripcion ha sido activada.
              </p>
            </div>
          </div>
        </div>
      )
    }

    {
      isCanceled && (
        <div class="rounded-2xl border border-warning-border bg-warning-bg p-4">
          <div class="flex items-center gap-3">
            <Icon name="lucide:alert-triangle" size={20} class="text-warning" />
            <div>
              <p class="text-warning font-semibold">Pago cancelado</p>
              <p class="text-warning text-sm">No se realizo ningun cargo.</p>
            </div>
          </div>
        </div>
      )
    }

    {
      subscription.isTrial && subscription.currentPeriodEnd && (
        <div class="rounded-2xl border border-accent-200 bg-accent-50 p-4">
          <div class="flex items-center gap-3">
            <Icon name="lucide:clock" size={20} class="text-accent-600" />
            <div>
              <p class="text-accent-700 font-semibold">
                Periodo de prueba activo
              </p>
              <p class="text-accent-600 text-sm">
                Tu trial termina el{" "}
                {subscription.currentPeriodEnd.toLocaleDateString("es-MX")}.
              </p>
            </div>
          </div>
        </div>
      )
    }

    {
      subscription.cancelAtPeriodEnd && subscription.currentPeriodEnd && (
        <div class="rounded-2xl border border-warning-border bg-warning-bg p-4">
          <div class="flex items-center gap-3">
            <Icon name="lucide:alert-triangle" size={20} class="text-warning" />
            <div>
              <p class="text-warning font-semibold">Suscripcion cancelada</p>
              <p class="text-warning text-sm">
                Tu plan seguira activo hasta el{" "}
                {subscription.currentPeriodEnd.toLocaleDateString("es-MX")}.
              </p>
            </div>
          </div>
        </div>
      )
    }

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p
            class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground"
          >
            Plan actual
          </p>
          <h2 class="mt-1 text-2xl font-black text-foreground">
            KitchCalc {
              subscription.tier === "free"
                ? "Free"
                : subscription.tier === "basic"
                  ? "Basic"
                  : "Pro"
            }
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            {
              subscription.tier === "free"
                ? "Gratis para siempre"
                : subscription.isTrial
                  ? "En periodo de prueba de 14 dias"
                  : "Renovacion recurrente"
            }
          </p>
        </div>

        <div class="text-right">
          {
            subscription.tier !== "free" && (
              <p class="text-2xl font-black text-foreground">
                ${subscription.tier === "basic" ? "5" : "10"}
                <span class="text-sm font-semibold text-subtle-foreground">
                  /mes
                </span>
              </p>
            )
          }
          {
            subscription.cancelAtPeriodEnd && (
              <span class="mt-1 inline-flex items-center rounded-full bg-warning-bg px-2.5 py-1 text-xs font-bold text-warning">
                Cancelado
              </span>
            )
          }
          {
            subscription.status === "trialing" && (
              <span class="mt-1 inline-flex items-center rounded-full bg-accent-100 px-2.5 py-1 text-xs font-bold text-accent-700">
                Trial
              </span>
            )
          }
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          subscription.tier !== "pro" && (
            <a
              href="/pricing"
              class="inline-flex items-center gap-2 rounded-xl bg-accent-600 px-5 py-3 text-sm font-bold text-white hover:bg-accent-700 transition-colors"
            >
              <Icon name="lucide:arrow-up-circle" size={16} />
              {subscription.tier === "free"
                ? "Suscribirse"
                : "Actualizar a Pro"}
            </a>
          )
        }

        {
          isPaid(subscription) && !subscription.cancelAtPeriodEnd && (
            <button
              type="button"
              id="manage-subscription-btn"
              class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-5 py-3 text-sm font-bold text-muted-foreground hover:bg-background transition-colors"
            >
              <Icon name="lucide:credit-card" size={16} />
              Gestionar suscripcion
            </button>
          )
        }
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <p class="text-sm font-bold text-secondary-foreground">Recetas</p>
          <span class="text-xs font-bold text-subtle-foreground"
            >{recipeCount} / {
              remainingRecipes === null ? "∞" : subscription.recipesLimit
            }</span
          >
        </div>
        <div class="h-2 bg-muted rounded-full overflow-hidden">
          <div
            class="h-full bg-accent-500 rounded-full transition-all"
            style={`width: ${remainingRecipes === null ? 0 : Math.min(100, (recipeCount / (subscription.recipesLimit ?? 1)) * 100)}%`}
          >
          </div>
        </div>
        {
          remainingRecipes !== null && !(remainingRecipes > 3) && (
            <p class="mt-2 text-xs text-warning font-semibold">
              Te quedan {remainingRecipes} recetas.{" "}
              <a href="/pricing" class="underline">
                Actualizar plan
              </a>
            </p>
          )
        }
      </div>

      <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <p class="text-sm font-bold text-secondary-foreground">
            Ingredientes
          </p>
          <span class="text-xs font-bold text-subtle-foreground"
            >{ingredientCount} / {
              remainingIngredients === null
                ? "∞"
                : subscription.ingredientsLimit
            }</span
          >
        </div>
        <div class="h-2 bg-muted rounded-full overflow-hidden">
          <div
            class="h-full bg-accent-500 rounded-full transition-all"
            style={`width: ${remainingIngredients === null ? 0 : Math.min(100, (ingredientCount / (subscription.ingredientsLimit ?? 1)) * 100)}%`}
          >
          </div>
        </div>
        {
          remainingIngredients !== null && !(remainingIngredients > 5) && (
            <p class="mt-2 text-xs text-warning font-semibold">
              Te quedan {remainingIngredients} ingredientes.{" "}
              <a href="/pricing" class="underline">
                Actualizar plan
              </a>
            </p>
          )
        }
      </div>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <h3 class="text-sm font-bold text-secondary-foreground mb-4">
        Funciones incluidas
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {
          (
            [
              { key: "recipe_duplicate", label: "Duplicar recetas" },
              { key: "recipe_photos", label: "Fotos de recetas" },
              { key: "stock_tracking", label: "Stock de ingredientes" },
              {
                key: "production_planner",
                label: "Planificador de produccion",
              },
              { key: "pdf_export", label: "Exportar a PDF" },
              { key: "advanced_costs", label: "Costos fijos avanzados" },
              { key: "change_history", label: "Historial de cambios" },
              { key: "data_import_export", label: "Importar/Exportar datos" },
            ] as const
          ).map((feature) => {
            const hasIt = subscription.features[feature.key] === true;
            return (
              <div
                class={`flex items-center gap-2 text-sm ${hasIt ? "text-secondary-foreground" : "text-subtle-foreground"}`}
              >
                <Icon
                  name={hasIt ? "lucide:check" : "lucide:x"}
                  size={16}
                  class={hasIt ? "text-success" : "text-subtle-foreground"}
                />
                {feature.label}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupBilling() {
    const manageBtn = document.getElementById("manage-subscription-btn");
    if (!(manageBtn instanceof HTMLButtonElement)) return;
    if (manageBtn.dataset.bound === "1") return;
    manageBtn.dataset.bound = "1";

    manageBtn.addEventListener("click", async () => {
      manageBtn.disabled = true;
      const originalHTML = manageBtn.innerHTML;
      manageBtn.innerHTML =
        '<span class="flex items-center gap-2"><svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> Cargando...</span>';

      try {
        const res = await fetch("/api/stripe/portal", { method: "POST" });
        const data = await res.json();

        if (data.url) {
          window.location.href = data.url;
        } else {
          throw new Error(data.error || "Error al abrir el portal");
        }
      } catch (err) {
        manageBtn.disabled = false;
        manageBtn.innerHTML = originalHTML;
        alert(
          "Error: " +
            (err instanceof Error ? err.message : "No se pudo abrir el portal"),
        );
      }
    });
  }

  document.addEventListener("astro:page-load", setupBilling);
  document.addEventListener("astro:after-swap", setupBilling);
  setupBilling();
</script>
