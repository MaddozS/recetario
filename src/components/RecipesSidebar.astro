---
import { Icon } from "astro-icon/components";
import type { RecipeSummary } from "../lib/recipe-data";

const {
  recipes = [],
  currentRecipe,
  isAuthenticated = false,
  userName = null,
} = Astro.props as {
  recipes?: RecipeSummary[];
  currentRecipe?: number | string;
  isAuthenticated?: boolean;
  userName?: string | null;
};
const normalizedUserName =
  typeof userName === "string" && userName.trim().length > 0
    ? userName.trim()
    : null;
const userInitial = normalizedUserName
  ? normalizedUserName.charAt(0).toUpperCase()
  : "U";
const createRecipeDialogId = "create-recipe-dialog";
---

<div class="flex flex-col h-full bg-white relative">
  <!-- Mobile Sidebar Header -->
  <div
    class="lg:hidden p-4 border-b border-slate-100 flex items-center gap-3 flex-none"
  >
    <button
      id="close-sidebar-btn"
      class="text-slate-500 hover:text-slate-700 border border-slate-200 hover:bg-slate-50 p-2 rounded-xl transition-colors"
      aria-label="Cerrar menú"
    >
      <Icon name="lucide:x" size={20} />
    </button>
    {
      isAuthenticated && normalizedUserName ? (
        <div class="flex min-w-0 items-center gap-3">
          <div class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-indigo-600 text-sm font-bold text-white shadow-md shadow-indigo-100">
            {userInitial}
          </div>
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">
              Sesion activa
            </p>
            <p class="truncate text-base font-bold text-slate-800">
              {normalizedUserName}
            </p>
          </div>
        </div>
      ) : (
        <>
          <div class="bg-indigo-600 p-2 rounded-xl text-white shadow-md shadow-indigo-100">
            <Icon name="lucide:chef-hat" size={20} />
          </div>
          <div>
            <h1 class="text-base font-bold text-slate-800 leading-tight">
              KitchCalc
            </h1>
            <p class="text-slate-500 text-[10px] font-medium">
              Costeo Inteligente
            </p>
          </div>
        </>
      )
    }
  </div>

  <!-- Sidebar Search -->
  <div
    class="p-4 lg:p-6 lg:pb-4 border-b border-slate-100 flex-none sticky top-0 bg-white z-10"
  >
    <div class="relative">
      <Icon
        name="lucide:search"
        size={18}
        class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"
      />
      <input
        type="search"
        id="recipeSearch"
        placeholder="Buscar receta..."
        class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-colors placeholder-slate-400"
      />
    </div>
  </div>

  <!-- Recipe List (Desktop & Mobile) -->
  <div class="flex-1 overflow-y-auto px-3 py-4 space-y-1 recipe-list">
    {
      recipes.map((recipe) => {
        const isActive = currentRecipe?.toString() === recipe.id.toString();
        // Fallback category text since it's not in the model yet
        const category = "Sin categoría";
        return (
          <a
            href={`/recipes/${recipe.id}`}
            class={`recipe-item block w-full p-3 rounded-xl transition-colors ${isActive ? "bg-indigo-50" : "hover:bg-slate-50"}`}
            data-name={recipe.name.toLowerCase()}
          >
            <div class="flex items-center justify-between">
              <div>
                <p
                  class={`font-semibold text-sm ${isActive ? "text-indigo-700" : "text-slate-700"}`}
                >
                  {recipe.name}
                </p>
                <div class="flex items-center gap-1.5 mt-1 text-[11px]">
                  <span
                    class={
                      isActive
                        ? "text-indigo-500 font-medium"
                        : "text-slate-500"
                    }
                  >
                    {recipe.ingredientCount} ingredientes
                  </span>
                  <span class={isActive ? "text-indigo-300" : "text-slate-300"}>
                    &bull;
                  </span>
                  <span class={isActive ? "text-indigo-400" : "text-slate-400"}>
                    {category}
                  </span>
                </div>
              </div>
              {isActive && (
                <Icon
                  name="lucide:chevron-right"
                  size={16}
                  class="text-indigo-500 flex-none"
                />
              )}
            </div>
          </a>
        );
      })
    }

    <div id="noResults" class="hidden py-8 text-center text-slate-500 text-sm">
      No se encontraron recetas
    </div>
  </div>

  <!-- Sticky Bottom Action -->
  <div
    class="p-6 border-t border-slate-100 flex-none sticky bottom-0 bg-white/95 backdrop-blur z-10"
  >
    <button
      type="button"
      data-open-create-recipe-dialog={createRecipeDialogId}
      class="w-full py-2.5 px-4 bg-white border border-dashed border-slate-300 rounded-xl text-slate-600 font-semibold text-sm hover:border-indigo-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors flex items-center justify-center gap-2"
    >
      <Icon name="lucide:plus" size={16} />
      Nueva Receta
    </button>
  </div>

  <dialog
    id={createRecipeDialogId}
    class="w-[92vw] max-w-md rounded-3xl border border-slate-200 p-0 shadow-2xl backdrop:bg-slate-900/40"
  >
    <form method="post" action="/recipes" class="rounded-3xl bg-white p-6">
      <input type="hidden" name="action" value="create_recipe" />

      <div class="flex items-start justify-between gap-4">
        <div>
          <p
            class="text-xs font-black uppercase tracking-[0.18em] text-indigo-500"
          >
            Nueva receta
          </p>
          <h2 class="mt-2 text-xl font-black text-slate-900">
            Escribe el nombre inicial
          </h2>
          <p class="mt-2 text-sm text-slate-500">
            Puedes cambiarlo despues desde la vista de edicion.
          </p>
        </div>
        <button
          type="button"
          data-close-create-recipe-dialog={createRecipeDialogId}
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-500 transition-colors hover:bg-slate-50 hover:text-slate-700"
          aria-label="Cerrar modal"
        >
          <Icon name="lucide:x" size={18} />
        </button>
      </div>

      <label
        class="mt-6 block text-sm font-semibold text-slate-700"
        for="create-recipe-name"
      >
        Nombre de la receta
      </label>
      <input
        id="create-recipe-name"
        name="recipeName"
        type="text"
        required
        maxlength="120"
        placeholder="Ej. Brownie clasico"
        class="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition-colors placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20"
      />

      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button
          type="button"
          data-close-create-recipe-dialog={createRecipeDialogId}
          class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-50"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-indigo-700"
        >
          <Icon name="lucide:plus" size={16} />
          Crear receta
        </button>
      </div>
    </form>
  </dialog>
</div>

<script>
  function setupRecipesSidebar() {
    const searchInput = document.getElementById("recipeSearch");
    const recipeItems = document.querySelectorAll(".recipe-item");
    const noResults = document.getElementById("noResults");
    const dialogId = "create-recipe-dialog";
    const dialog = document.getElementById(dialogId);
    const nameInput = document.getElementById("create-recipe-name");
    const openButtons = document.querySelectorAll(
      `[data-open-create-recipe-dialog="${dialogId}"]`,
    );
    const closeButtons = document.querySelectorAll(
      `[data-close-create-recipe-dialog="${dialogId}"]`,
    );

    if (
      searchInput instanceof HTMLInputElement &&
      searchInput.dataset.recipeSearchBound !== "1"
    ) {
      searchInput.dataset.recipeSearchBound = "1";
      searchInput.addEventListener("input", (e) => {
        const target = e.target;
        if (!(target instanceof HTMLInputElement)) return;

        const searchTerm = target.value
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "");
        let visibleCount = 0;

        recipeItems.forEach((item) => {
          const name = item.getAttribute("data-name") || "";
          const normalizedName = name
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
          if (!(item instanceof HTMLElement)) return;

          const element = item;
          if (normalizedName.includes(searchTerm)) {
            element.style.display = "block";
            visibleCount++;
          } else {
            element.style.display = "none";
          }
        });

        if (noResults instanceof HTMLElement) {
          if (visibleCount === 0 && searchTerm.length > 0) {
            noResults.classList.remove("hidden");
          } else {
            noResults.classList.add("hidden");
          }
        }
      });
    }

    if (!(dialog instanceof HTMLDialogElement)) {
      return;
    }

    const openDialog = () => {
      const form = dialog.querySelector("form");

      if (form instanceof HTMLFormElement) {
        form.reset();
      }

      if (!dialog.open) {
        dialog.showModal();
      }

      if (nameInput instanceof HTMLInputElement) {
        requestAnimationFrame(() => nameInput.focus());
      }
    };

    const closeDialog = () => {
      if (dialog.open) {
        dialog.close();
      }
    };

    openButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.dataset.createRecipeDialogBound === "1") return;

      button.dataset.createRecipeDialogBound = "1";
      button.addEventListener("click", openDialog);
    });

    closeButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.dataset.createRecipeDialogBound === "1") return;

      button.dataset.createRecipeDialogBound = "1";
      button.addEventListener("click", closeDialog);
    });

    if (dialog.dataset.createRecipeDialogBound === "1") {
      return;
    }

    dialog.dataset.createRecipeDialogBound = "1";
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        closeDialog();
      }
    });
  }

  document.addEventListener("astro:page-load", setupRecipesSidebar);
  document.addEventListener("astro:after-swap", setupRecipesSidebar);
  setupRecipesSidebar();
</script>
