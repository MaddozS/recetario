---
import { Icon } from "astro-icon/components";
import type { RecipeSummary } from "../lib/recipe-data";
import type { UserSubscriptionInfo } from "../lib/subscription";

const {
  recipes = [],
  currentRecipe,
  isAuthenticated = false,
  userName = null,
  subscription = null,
} = Astro.props as {
  recipes?: RecipeSummary[];
  currentRecipe?: number | string;
  isAuthenticated?: boolean;
  userName?: string | null;
  subscription?: UserSubscriptionInfo | null;
};
const normalizedUserName =
  typeof userName === "string" && userName.trim().length > 0
    ? userName.trim()
    : null;
const userInitial = normalizedUserName
  ? normalizedUserName.charAt(0).toUpperCase()
  : "U";
const createRecipeDialogId = "create-recipe-dialog";
---

<div class="flex flex-col h-full bg-card relative">
  <!-- Mobile Sidebar Header -->
  <div
    class="lg:hidden p-4 border-b border-border flex items-center gap-3 flex-none"
  >
    <button
      id="close-sidebar-btn"
      class="text-muted-foreground hover:text-secondary-foreground border border-border hover:bg-background p-2 rounded-xl transition-colors"
      aria-label="Cerrar menú"
    >
      <Icon name="lucide:x" size={20} />
    </button>
    {
      isAuthenticated && normalizedUserName ? (
        <div class="flex min-w-0 items-center gap-3">
          <div class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-accent-600 text-sm font-bold text-white shadow-md shadow-accent-100">
            {userInitial}
          </div>
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-subtle-foreground">
              Sesion activa
            </p>
            <p class="truncate text-base font-bold text-foreground">
              {normalizedUserName}
            </p>
            {subscription && (
              <span class="inline-flex items-center rounded-full bg-accent-100 px-2 py-0.5 text-[10px] font-bold text-accent-700 mt-0.5">
                {subscription.tier === "free"
                  ? "Free"
                  : subscription.tier === "basic"
                    ? "Basic"
                    : "Pro"}
              </span>
            )}
          </div>
        </div>
      ) : (
        <>
          <div class="bg-accent-600 p-2 rounded-xl text-white shadow-md shadow-accent-100">
            <Icon name="lucide:chef-hat" size={20} />
          </div>
          <div>
            <h1 class="text-base font-bold text-foreground leading-tight">
              KitchCalc
            </h1>
            <p class="text-muted-foreground text-[10px] font-medium">
              Costeo Inteligente
            </p>
          </div>
        </>
      )
    }
  </div>

  <!-- Sidebar Search -->
  <div
    class="p-4 lg:p-6 lg:pb-4 border-b border-border flex-none sticky top-0 bg-card z-10"
  >
    <div class="relative">
      <Icon
        name="lucide:search"
        size={18}
        class="absolute left-3.5 top-1/2 -translate-y-1/2 text-subtle-foreground"
      />
      <input
        type="search"
        id="recipeSearch"
        placeholder="Buscar receta..."
        class="w-full pl-10 pr-4 py-2.5 bg-background border border-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-500/20 focus:border-accent-500 transition-colors placeholder:text-subtle-foreground"
      />
    </div>
    <div class="relative mt-2">
      <Icon
        name="lucide:tag"
        size={18}
        class="absolute left-3.5 top-1/2 -translate-y-1/2 text-subtle-foreground pointer-events-none"
      />
      <select
        id="categoryFilter"
        class="w-full pl-10 pr-4 py-2.5 bg-background border border-border rounded-xl text-sm text-secondary-foreground focus:outline-none focus:ring-2 focus:ring-accent-500/20 focus:border-accent-500 transition-colors appearance-none"
      >
        <option value="">Todas las categorías</option>
        {
          [...new Set(recipes.map((r) => r.category).filter(Boolean))].map(
            (cat) => <option value={cat}>{cat}</option>,
          )
        }
      </select>
    </div>
  </div>

  <!-- Recipe List (Desktop & Mobile) -->
  <div class="flex-1 overflow-y-auto px-3 py-4 space-y-1 recipe-list">
    {
      recipes.map((recipe) => {
        const isActive = currentRecipe?.toString() === recipe.id.toString();
        const category = recipe.category || "Sin categoría";
        return (
          <a
            href={`/recipes/${recipe.id}`}
            data-astro-reload
            class={`recipe-item block w-full p-3 rounded-xl transition-colors ${isActive ? "bg-accent-50" : "hover:bg-background"}`}
            data-name={recipe.name.toLowerCase()}
            data-category={recipe.category || ""}
          >
            <div class="flex items-center justify-between">
              <div>
                <p
                  class={`font-semibold text-sm ${isActive ? "text-accent-700" : "text-secondary-foreground"}`}
                >
                  {recipe.name}
                </p>
                <div class="flex items-center gap-1.5 mt-1 text-[11px]">
                  <span
                    class={
                      isActive
                        ? "text-accent-500 font-medium"
                        : "text-muted-foreground"
                    }
                  >
                    {recipe.ingredientCount} ingredientes
                  </span>
                  <span
                    class={
                      isActive ? "text-accent-300" : "text-subtle-foreground"
                    }
                  >
                    &bull;
                  </span>
                  <span
                    class={
                      isActive ? "text-accent-400" : "text-subtle-foreground"
                    }
                  >
                    {category}
                  </span>
                </div>
              </div>
              {isActive && (
                <Icon
                  name="lucide:chevron-right"
                  size={16}
                  class="text-accent-500 flex-none"
                />
              )}
            </div>
          </a>
        );
      })
    }

    <div
      id="noResults"
      class="hidden py-8 text-center text-muted-foreground text-sm"
    >
      No se encontraron recetas
    </div>
  </div>

  <!-- Sticky Bottom Action -->
  <div
    class="p-6 border-t border-border flex-none sticky bottom-0 bg-card/95 backdrop-blur z-10"
  >
    <button
      type="button"
      data-open-create-recipe-dialog={createRecipeDialogId}
      class="w-full inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-accent-600 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-700"
    >
      <Icon name="lucide:plus" size={16} />
      Nueva Receta
    </button>
  </div>

  <dialog
    id={createRecipeDialogId}
    class="fixed inset-0 m-auto w-[92vw] max-w-md max-h-[calc(100dvh-2rem)] rounded-3xl border border-border p-0 shadow-2xl backdrop:bg-slate-900/40"
  >
    <form
      method="post"
      action="/recipes"
      data-astro-reload
      class="max-h-[calc(100dvh-2rem)] overflow-auto rounded-3xl bg-card p-6"
    >
      <input type="hidden" name="action" value="create_recipe" />

      <div class="flex items-start justify-between gap-4">
        <div>
          <p
            class="text-xs font-black uppercase tracking-[0.18em] text-accent-500"
          >
            Nueva receta
          </p>
          <h2 class="mt-2 text-xl font-black text-foreground">
            Escribe el nombre inicial
          </h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Puedes cambiarlo despues desde la vista de edicion.
          </p>
        </div>
        <button
          type="button"
          data-close-create-recipe-dialog={createRecipeDialogId}
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-border text-muted-foreground transition-colors hover:bg-background hover:text-secondary-foreground"
          aria-label="Cerrar modal"
        >
          <Icon name="lucide:x" size={18} />
        </button>
      </div>

      <label
        class="mt-6 block text-sm font-semibold text-secondary-foreground"
        for="create-recipe-name"
      >
        Nombre de la receta
      </label>
      <input
        id="create-recipe-name"
        name="recipeName"
        type="text"
        required
        maxlength="120"
        placeholder="Ej. Brownie clasico"
        class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
      />

      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button
          type="button"
          data-close-create-recipe-dialog={createRecipeDialogId}
          class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border bg-card px-5 py-3 text-sm font-bold text-muted-foreground transition-colors hover:bg-background"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-accent-600 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-700"
        >
          <Icon name="lucide:plus" size={16} />
          Crear receta
        </button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { bindDialogBackdrop } from "../lib/dialog";

  function setupRecipesSidebar() {
    const searchInput = document.getElementById("recipeSearch");
    const recipeItems = document.querySelectorAll(".recipe-item");
    const noResults = document.getElementById("noResults");
    const dialogId = "create-recipe-dialog";
    const dialog = document.getElementById(dialogId);
    const nameInput = document.getElementById("create-recipe-name");
    const openButtons = document.querySelectorAll(
      `[data-open-create-recipe-dialog="${dialogId}"]`,
    );
    const closeButtons = document.querySelectorAll(
      `[data-close-create-recipe-dialog="${dialogId}"]`,
    );

    function filterRecipes() {
      const categoryFilter = document.getElementById("categoryFilter");
      const searchTerm = (
        searchInput instanceof HTMLInputElement ? searchInput.value : ""
      )
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
      const catValue =
        categoryFilter instanceof HTMLSelectElement ? categoryFilter.value : "";
      let visibleCount = 0;

      recipeItems.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;

        const name = item.getAttribute("data-name") || "";
        const normalizedName = name
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "");
        const itemCat = item.getAttribute("data-category") || "";

        const matchesSearch = normalizedName.includes(searchTerm);
        const matchesCat = !catValue || itemCat === catValue;

        if (matchesSearch && matchesCat) {
          item.style.display = "block";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      if (noResults instanceof HTMLElement) {
        if (visibleCount === 0 && searchTerm.length > 0) {
          noResults.classList.remove("hidden");
        } else {
          noResults.classList.add("hidden");
        }
      }
    }

    if (
      searchInput instanceof HTMLInputElement &&
      searchInput.dataset.recipeSearchBound !== "1"
    ) {
      searchInput.dataset.recipeSearchBound = "1";
      searchInput.addEventListener("input", filterRecipes);
    }

    const categoryFilter = document.getElementById("categoryFilter");
    if (
      categoryFilter instanceof HTMLSelectElement &&
      categoryFilter.dataset.categoryFilterBound !== "1"
    ) {
      categoryFilter.dataset.categoryFilterBound = "1";
      categoryFilter.addEventListener("change", filterRecipes);
    }

    if (!(dialog instanceof HTMLDialogElement)) {
      return;
    }

    const openDialog = () => {
      const form = dialog.querySelector("form");

      if (form instanceof HTMLFormElement) {
        form.reset();
      }

      if (!dialog.open) {
        dialog.showModal();
      }

      if (nameInput instanceof HTMLInputElement) {
        requestAnimationFrame(() => nameInput.focus());
      }
    };

    const closeDialog = () => {
      if (dialog.open) {
        dialog.close();
      }
    };

    openButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.dataset.createRecipeDialogBound === "1") return;

      button.dataset.createRecipeDialogBound = "1";
      button.addEventListener("click", openDialog);
    });

    closeButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.dataset.createRecipeDialogBound === "1") return;

      button.dataset.createRecipeDialogBound = "1";
      button.addEventListener("click", closeDialog);
    });

    if (dialog.dataset.createRecipeDialogBound === "1") {
      return;
    }

    dialog.dataset.createRecipeDialogBound = "1";
    bindDialogBackdrop(dialog);
  }

  document.addEventListener("astro:page-load", setupRecipesSidebar);
  document.addEventListener("astro:after-swap", setupRecipesSidebar);
  setupRecipesSidebar();
</script>
