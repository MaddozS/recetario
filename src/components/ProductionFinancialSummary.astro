---
import { Icon } from "astro-icon/components";
import type { ProductionSummary } from "@/lib/production-types";
import { formatCurrency } from "@/lib/formatters";

interface Props {
  summary: ProductionSummary;
}

const { summary } = Astro.props;

const noRevenue = summary.projectedRevenue <= 0;
---

<div class="production-sheet financial-summary">
  <div class="relative -mx-4 px-5 sm:hidden">
    <div
      class="text-subtle-foreground mb-3 flex items-center justify-between px-1 text-[11px] font-semibold"
    >
      <span>Resumen financiero</span>
      <span
        class="bg-muted text-muted-foreground inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[10px] font-black tracking-[0.14em] uppercase"
      >
        <Icon name="lucide:move-horizontal" size={12} /> Desliza
      </span>
    </div>
    <div
      class="from-background/80 pointer-events-none absolute inset-y-0 left-0 z-10 w-3 bg-gradient-to-r to-transparent"
    >
    </div>
    <div
      class="from-background/85 via-background/35 pointer-events-none absolute inset-y-0 right-0 z-10 w-6 bg-gradient-to-l to-transparent"
    >
    </div>
    <div
      class="-mx-1 flex snap-x snap-mandatory [scrollbar-width:auto] gap-3 overflow-x-auto px-1 pb-3 [-webkit-overflow-scrolling:touch]"
    >
      <!-- COSTO INSUMOS -->
      <div
        class="bg-card border-border flex w-[min(68vw,19rem)] min-w-[15.5rem] snap-start flex-col justify-between rounded-2xl border p-5 shadow-sm"
      >
        <p
          class="text-subtle-foreground mb-4 flex items-center gap-2 text-[10px] font-black tracking-wider uppercase"
        >
          <span
            class="flex h-7 w-7 items-center justify-center rounded-lg bg-red-50 text-red-500"
            ><Icon name="lucide:trending-down" size={16} /></span
          >
          Costo Insumos
        </p>
        <div>
          <p
            class="text-foreground truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl"
          >
            {formatCurrency(summary.totalIngredientsCost)}
          </p>
          <p
            class="text-subtle-foreground mt-2 line-clamp-1 text-[11px] font-semibold"
          >
            Insumos de todas las recetas
          </p>
        </div>
      </div>

      <!-- COSTO OPERATIVO -->
      <div
        class="bg-card border-border flex w-[min(68vw,19rem)] min-w-[15.5rem] snap-start flex-col justify-between rounded-2xl border p-5 shadow-sm"
      >
        <p
          class="text-subtle-foreground mb-4 flex items-center gap-2 text-[10px] font-black tracking-wider uppercase"
        >
          <span
            class="bg-muted text-muted-foreground flex h-7 w-7 items-center justify-center rounded-lg"
            ><Icon name="lucide:pie-chart" size={16} /></span
          >
          Costo Operativo
        </p>
        <div>
          <p
            class="text-foreground truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl"
          >
            {formatCurrency(summary.totalOperationalCost)}
          </p>
          <p
            class="text-subtle-foreground mt-2 line-clamp-1 text-[11px] font-semibold"
          >
            Servicios, labor, etc.
          </p>
        </div>
      </div>

      <!-- INGRESOS PROYECTADOS -->
      <div
        class="bg-card border-accent-100 relative flex w-[min(68vw,19rem)] min-w-[15.5rem] snap-start flex-col justify-between overflow-hidden rounded-2xl border p-5 shadow-sm"
      >
        <div
          class="bg-accent-50 pointer-events-none absolute -top-6 -right-6 h-24 w-24 rounded-full opacity-50"
        >
        </div>
        <p
          class="text-accent-500 relative z-10 mb-4 flex items-center gap-2 text-[10px] font-black tracking-wider uppercase"
        >
          <span
            class="bg-accent-50 text-accent-500 flex h-7 w-7 items-center justify-center rounded-lg"
            ><Icon name="lucide:trending-up" size={16} /></span
          >
          Ingresos Proyectados
        </p>
        <div class="relative z-10">
          {
            noRevenue ? (
              <p class="text-muted-foreground text-lg font-semibold">N/A</p>
            ) : (
              <p class="text-accent-600 truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl">
                {formatCurrency(summary.projectedRevenue)}
              </p>
            )
          }
          <p
            class="text-accent-400 mt-2 line-clamp-1 text-[11px] font-semibold"
          >
            {
              noRevenue
                ? "Sin precios de venta configurados"
                : "Ventas totales proyectadas"
            }
          </p>
        </div>
      </div>

      <!-- GANANCIA ESTIMADA -->
      <div
        class:list={[
          "relative flex w-[min(68vw,19rem)] min-w-[15.5rem] snap-start flex-col justify-between overflow-hidden rounded-2xl p-5 text-white shadow-md",
          noRevenue ? "bg-muted" : "bg-[#10b981] dark:bg-emerald-700",
        ]}
      >
        {
          !noRevenue && (
            <div class="pointer-events-none absolute top-0 right-0 opacity-15">
              <Icon
                name="lucide:trending-up"
                size={120}
                class="translate-x-6 -translate-y-6 transform"
              />
            </div>
          )
        }
        <p
          class:list={[
            "relative z-10 mb-4 flex items-center gap-2 text-[10px] font-black tracking-wider uppercase",
            noRevenue ? "text-muted-foreground" : "text-emerald-100",
          ]}
        >
          <span
            class:list={[
              "flex h-7 w-7 items-center justify-center rounded-lg",
              noRevenue
                ? "bg-muted text-muted-foreground"
                : "bg-emerald-400/50 text-white",
            ]}
          >
            <Icon name="lucide:dollar-sign" size={16} />
          </span>
          Ganancia Estimada
        </p>
        <div class="relative z-10">
          {
            noRevenue ? (
              <p class="text-muted-foreground text-lg font-semibold">
                Sin datos
              </p>
            ) : (
              <>
                <p class="truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl">
                  {formatCurrency(summary.estimatedProfit)}
                  <span class="text-lg font-bold text-emerald-200 2xl:text-xl">
                    {" "}
                    ({summary.effectiveMargin.toFixed(1)}%)
                  </span>
                </p>
                <p class="mt-2 line-clamp-1 text-[11px] font-semibold text-emerald-100">
                  Margen de ganancia estimado
                </p>
              </>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <div class="hidden grid-cols-2 gap-4 sm:grid xl:grid-cols-4">
    <!-- COSTO INSUMOS -->
    <div
      class="bg-card border-border flex flex-col justify-between rounded-2xl border p-5 shadow-sm"
    >
      <p
        class="text-subtle-foreground mb-4 flex items-center gap-2 text-[10px] font-black tracking-wider uppercase"
      >
        <span
          class="flex h-7 w-7 items-center justify-center rounded-lg bg-red-50 text-red-500"
          ><Icon name="lucide:trending-down" size={16} /></span
        >
        Costo Insumos
      </p>
      <div>
        <p
          class="text-foreground truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl"
        >
          {formatCurrency(summary.totalIngredientsCost)}
        </p>
        <p
          class="text-subtle-foreground mt-2 line-clamp-1 text-[11px] font-semibold"
        >
          Insumos de todas las recetas
        </p>
      </div>
    </div>

    <!-- COSTO OPERATIVO -->
    <div
      class="bg-card border-border flex flex-col justify-between rounded-2xl border p-5 shadow-sm"
    >
      <p
        class="text-subtle-foreground mb-4 flex items-center gap-2 text-[10px] font-black tracking-wider uppercase"
      >
        <span
          class="bg-muted text-muted-foreground flex h-7 w-7 items-center justify-center rounded-lg"
          ><Icon name="lucide:pie-chart" size={16} /></span
        >
        Costo Operativo
      </p>
      <div>
        <p
          class="text-foreground truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl"
        >
          {formatCurrency(summary.totalOperationalCost)}
        </p>
        <p
          class="text-subtle-foreground mt-2 line-clamp-1 text-[11px] font-semibold"
        >
          Servicios, labor, etc.
        </p>
      </div>
    </div>

    <!-- INGRESOS PROYECTADOS -->
    <div
      class="bg-card border-accent-100 relative flex flex-col justify-between overflow-hidden rounded-2xl border p-5 shadow-sm"
    >
      <div
        class="bg-accent-50 pointer-events-none absolute -top-6 -right-6 h-24 w-24 rounded-full opacity-50"
      >
      </div>
      <p
        class="text-accent-500 relative z-10 mb-4 flex items-center gap-2 text-[10px] font-black tracking-wider uppercase"
      >
        <span
          class="bg-accent-50 text-accent-500 flex h-7 w-7 items-center justify-center rounded-lg"
          ><Icon name="lucide:trending-up" size={16} /></span
        >
        Ingresos Proyectados
      </p>
      <div class="relative z-10">
        {
          noRevenue ? (
            <p class="text-muted-foreground text-lg font-semibold">N/A</p>
          ) : (
            <p class="text-accent-600 truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl">
              {formatCurrency(summary.projectedRevenue)}
            </p>
          )
        }
        <p class="text-accent-400 mt-2 line-clamp-1 text-[11px] font-semibold">
          {
            noRevenue
              ? "Sin precios de venta configurados"
              : "Ventas totales proyectadas"
          }
        </p>
      </div>
    </div>

    <!-- GANANCIA ESTIMADA -->
    <div
      class:list={[
        "relative flex flex-col justify-between overflow-hidden rounded-2xl p-5 text-white shadow-md",
        noRevenue
          ? "bg-card border-border text-muted-foreground border shadow-sm"
          : "bg-[#10b981] dark:bg-emerald-700",
      ]}
    >
      {
        !noRevenue && (
          <div class="pointer-events-none absolute top-0 right-0 opacity-15">
            <Icon
              name="lucide:trending-up"
              size={120}
              class="translate-x-6 -translate-y-6 transform"
            />
          </div>
        )
      }
      <p
        class:list={[
          "relative z-10 mb-4 flex items-center gap-2 text-[10px] font-black tracking-wider uppercase",
          noRevenue ? "text-subtle-foreground" : "text-emerald-100",
        ]}
      >
        <span
          class:list={[
            "flex h-7 w-7 items-center justify-center rounded-lg",
            noRevenue
              ? "bg-muted text-muted-foreground"
              : "bg-emerald-400/50 text-white",
          ]}
        >
          <Icon name="lucide:dollar-sign" size={16} />
        </span>
        Ganancia Estimada
      </p>
      <div class="relative z-10">
        {
          noRevenue ? (
            <p class="text-muted-foreground text-lg font-semibold">Sin datos</p>
          ) : (
            <>
              <p class="truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl">
                {formatCurrency(summary.estimatedProfit)}
                <span class="text-lg font-bold text-emerald-200 2xl:text-xl">
                  {" "}
                  ({summary.effectiveMargin.toFixed(1)}%)
                </span>
              </p>
              <p class="mt-2 line-clamp-1 text-[11px] font-semibold text-emerald-100">
                Margen de ganancia estimado
              </p>
            </>
          )
        }
      </div>
    </div>
  </div>
</div>
