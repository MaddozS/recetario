---
import { Icon } from "astro-icon/components";

const { isAuthenticated = false } = Astro.props;

const plans = [
  {
    id: "free",
    name: "Free",
    priceMonthly: 0,
    priceYearly: 0,
    priceYearlyPerMonth: 0,
    description: "Para empezar a costear",
    badge: null,
    cta: "Comenzar gratis",
    href: isAuthenticated ? "/recipes" : "/sign-in?return_url=/recipes",
    features: [
      { text: "Hasta 10 recetas", included: true },
      { text: "Hasta 30 ingredientes", included: true },
      { text: "Costeo básico con márgenes", included: true },
      { text: "Categorías e instrucciones", included: true },
      { text: "Duplicar recetas", included: false },
      { text: "Fotos de recetas", included: false },
      { text: "Stock de ingredientes", included: false },
      { text: "Planificador de producción", included: false },
      { text: "Exportar a PDF", included: false },
    ],
  },
  {
    id: "basic",
    name: "Basic",
    priceMonthly: 5,
    priceYearly: 48,
    priceYearlyPerMonth: 4,
    description: "Para negocios en crecimiento",
    badge: { text: "Recomendado", class: "bg-success-bg text-success" },
    cta: "Elegir Basic",
    href: isAuthenticated ? "/pricing" : "/sign-in?return_url=/pricing",
    features: [
      { text: "Hasta 75 recetas", included: true },
      { text: "Ingredientes ilimitados", included: true },
      { text: "Costeo básico con márgenes", included: true },
      { text: "Categorías e instrucciones", included: true },
      { text: "Duplicar recetas", included: true },
      { text: "Fotos de recetas", included: true },
      { text: "Stock de ingredientes", included: true },
      { text: "Planificador de producción", included: false },
      { text: "Exportar a PDF", included: false },
    ],
  },
  {
    id: "pro",
    name: "Pro",
    priceMonthly: 10,
    priceYearly: 84,
    priceYearlyPerMonth: 7,
    description: "Para profesionales",
    badge: { text: "Más popular", class: "bg-accent-600 text-white" },
    cta: "Elegir Pro",
    href: isAuthenticated ? "/pricing" : "/sign-in?return_url=/pricing",
    features: [
      { text: "Recetas ilimitadas", included: true },
      { text: "Ingredientes ilimitados", included: true },
      { text: "Costeo básico con márgenes", included: true },
      { text: "Categorías e instrucciones", included: true },
      { text: "Duplicar recetas", included: true },
      { text: "Fotos de recetas", included: true },
      { text: "Stock de ingredientes", included: true },
      { text: "Planificador de producción", included: true },
      { text: "Exportar a PDF", included: true },
    ],
  },
];
---

<section id="pricing" data-reveal class="bg-background py-24 md:py-32" style="content-visibility: auto; contain-intrinsic-size: 900px">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2
        class="landing-heading text-foreground text-3xl font-black md:text-4xl"
      >
        Planes y precios
      </h2>
      <p class="text-muted-foreground mt-4 text-lg">
        Elige el plan que mejor se adapte a tu negocio.
      </p>
    </div>

    <div class="mt-8 flex justify-center" data-reveal>
      <div
        class="bg-muted inline-flex rounded-xl p-1"
        id="pricing-toggle-landing"
        role="radiogroup"
      >
        <button
          type="button"
          data-period="monthly"
          role="radio"
          aria-checked="true"
          class="bg-card text-foreground rounded-lg px-5 min-h-11 text-sm font-semibold shadow-sm transition-all"
          >Mensual</button
        >
        <button
          type="button"
          data-period="yearly"
          role="radio"
          aria-checked="false"
          class="text-muted-foreground rounded-lg px-5 min-h-11 text-sm font-semibold transition-all"
          >Anual <span class="text-success text-xs font-bold">-20%</span
          ></button
        >
      </div>
    </div>

    <div class="relative mx-auto mt-12 max-w-5xl">
      <div
        class="pricing-scroll flex snap-x snap-mandatory gap-4 overflow-x-auto py-5 sm:gap-6 lg:overflow-visible"
      >
      {
        plans.map((plan, i) => (
          <div
            class:list={[
              "reveal-item bg-card relative flex min-w-[280px] shrink-0 snap-start flex-col rounded-2xl p-7 sm:min-w-[320px] md:p-8 lg:min-w-0 lg:flex-1",
              plan.id === "pro"
                ? "shadow-accent-tint plan-pro pricing-card-hover-pro bg-card dark:bg-accent-950/10 z-10"
                : "pricing-card-hover shadow-sm",
            ]}
            style={`--reveal-delay: ${i * 100}ms`}
          >
            {plan.badge && (
              <span
                class:list={[
                  "mb-4 inline-flex items-center self-start rounded-md px-3 py-1 text-xs font-bold",
                  plan.badge.class,
                ]}
              >
                {plan.badge.text}
              </span>
            )}

            <h3 class="text-foreground break-words text-xl font-black">{plan.name}</h3>
            <p class="text-muted-foreground mt-1 break-words text-sm">{plan.description}</p>

            <div class="mt-4">
              <div data-plan-price data-plan={plan.id}>
                <div data-price-view="monthly">
                  <p class="text-foreground text-3xl font-black md:text-4xl">
                    {plan.priceMonthly === 0
                      ? "Gratis"
                      : `$${plan.priceMonthly}`}
                    {plan.id !== "free" && (
                      <span class="text-subtle-foreground text-base font-semibold">
                        /mes
                      </span>
                    )}
                  </p>
                  {plan.id !== "free" && (
                    <p class="text-subtle-foreground mt-0.5 text-xs">
                      Facturado mensualmente
                    </p>
                  )}
                </div>
                <div data-price-view="yearly" class="hidden">
                  {plan.id !== "free" ? (
                    <>
                      <p class="text-foreground text-3xl font-black md:text-4xl">
                        ${plan.priceYearlyPerMonth}
                        <span class="text-subtle-foreground text-base font-semibold">
                          /mes
                        </span>
                      </p>
                      <p class="text-subtle-foreground mt-0.5 text-xs">
                        USD ${plan.priceYearly} facturados anualmente
                      </p>
                    </>
                  ) : (
                    <p class="text-foreground text-3xl font-black md:text-4xl">
                      Gratis
                    </p>
                  )}
                </div>
              </div>
            </div>

            <a
              href={plan.href}
              class:list={[
                "mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl px-5 min-h-11 text-center text-sm font-bold transition-all active:scale-[0.97]",
                plan.id === "pro"
                  ? "bg-accent-600 hover:bg-accent-700 shadow-accent-tint text-white"
                  : "border-border bg-card text-secondary-foreground hover:bg-background border",
              ]}
            >
              {plan.cta}
            </a>

            <div class="mt-6 min-w-0 flex-1 space-y-3">
              {plan.features.map((f) => (
                <div class="flex min-w-0 items-center gap-2.5 text-sm">
                  <Icon
                    name={f.included ? "lucide:check" : "lucide:x"}
                    size={16}
                    class:list={[
                      f.included ? "text-success" : "text-subtle-foreground",
                    ]}
                  />
                  <span
                    class:list={[
                      f.included
                        ? "text-secondary-foreground"
                        : "text-subtle-foreground",
                      "break-words",
                    ]}
                  >
                    {f.text}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-linear-to-r from-transparent to-background lg:hidden"
    >
    </div>
  </div>
</section>

<style is:global>
  .pricing-scroll::-webkit-scrollbar {
    display: none;
  }
  .pricing-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
</style>

<script>
  function setupPricingToggle() {
    const toggle = document.getElementById("pricing-toggle-landing");
    if (!toggle || toggle.dataset.bound === "1") return;
    toggle.dataset.bound = "1";

    let activePeriod = "monthly";

    const btns = toggle.querySelectorAll("[data-period]");

    function updateUI() {
      btns.forEach((btn) => {
        const period = btn.getAttribute("data-period");
        const isActive = period === activePeriod;
        btn.setAttribute("aria-checked", isActive ? "true" : "false");
        if (isActive) {
          btn.className =
            "px-5 min-h-11 rounded-lg text-sm font-semibold bg-card text-foreground shadow-sm transition-all";
        } else {
          btn.className =
            "px-5 min-h-11 rounded-lg text-sm font-semibold text-muted-foreground transition-all";
        }
      });

      document.querySelectorAll("[data-price-view]").forEach((el) => {
        const elem = el as HTMLElement;
        if (elem.dataset.priceView === activePeriod) {
          elem.classList.remove("hidden");
        } else {
          elem.classList.add("hidden");
        }
      });
    }

    function activate(period: string) {
      activePeriod = period;
      updateUI();
    }

    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activate(btn.getAttribute("data-period") || "monthly");
      });
    });

    toggle.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      e.preventDefault();
      const periods = ["monthly", "yearly"];
      const idx = periods.indexOf(activePeriod);
      const next = e.key === "ArrowRight" ? (idx + 1) % periods.length : (idx - 1 + periods.length) % periods.length;
      activate(periods[next]);
    });

    updateUI();
  }

  document.addEventListener("astro:page-load", setupPricingToggle);
  document.addEventListener("astro:after-swap", setupPricingToggle);
  setupPricingToggle();
</script>
