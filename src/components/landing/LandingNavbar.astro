---
import { Icon } from "astro-icon/components";

const { isAuthenticated = false } = Astro.props;
---

<nav
  class="border-border bg-background/80 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <img
        src="/kitchcalc_logo.svg"
        alt="KitchCalc"
        class="h-9 w-9 rounded-xl"
      />
      <span class="text-foreground text-lg font-black">KitchCalc</span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      <a
        href="#features"
        class="text-muted-foreground hover:text-foreground text-sm font-medium transition-colors"
        >Funciones</a
      >
      <a
        href="#how-it-works"
        class="text-muted-foreground hover:text-foreground text-sm font-medium transition-colors"
        >Cómo funciona</a
      >
      <a
        href="#pricing"
        class="text-muted-foreground hover:text-foreground text-sm font-medium transition-colors"
        >Precios</a
      >
    </div>

    <div class="flex items-center gap-3">
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={18} class="block dark:hidden" />
        <Icon name="lucide:moon" size={18} class="hidden dark:block" />
      </button>

      <a
        href={isAuthenticated ? "/recipes" : "/sign-in"}
        class="bg-accent-600 hover:bg-accent-700 inline-flex items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-bold text-white transition-colors"
      >
        {isAuthenticated ? "Ir a la app" : "Comenzar gratis"}
      </a>
    </div>
  </div>
</nav>
