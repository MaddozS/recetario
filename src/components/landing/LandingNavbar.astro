---
import { Icon } from "astro-icon/components";
import { Button } from "@/components/ui";

const { isAuthenticated = false } = Astro.props;
---

<nav
  class="border-border bg-background fixed inset-x-0 top-0 z-50 border-b shadow-sm"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6"
  >
    <div class="flex items-center gap-2">
      <button
        id="landing-mobile-menu-btn"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors md:hidden"
        aria-label="Abrir menú"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <a href="/" class="flex shrink-0 items-center gap-2.5">
        <img
          src="/kitchcalc_logo.svg"
          alt="KitchCalc"
          class="h-9 w-9 rounded-xl"
        />
        <span class="text-foreground hidden text-lg font-black sm:inline"
          >KitchCalc</span
        >
      </a>
    </div>

    <div class="hidden items-center gap-6 md:flex">
      <a
        href="/#features"
        class="text-muted-foreground hover:text-foreground focus-visible:ring-accent-500 text-sm font-medium transition-colors focus-visible:ring-2 rounded"
        >Funciones</a
      >
      <a
        href="/#how-it-works"
        class="text-muted-foreground hover:text-foreground focus-visible:ring-accent-500 text-sm font-medium transition-colors focus-visible:ring-2 rounded"
        >Cómo funciona</a
      >
      <a
        href="/#pricing"
        class="text-muted-foreground hover:text-foreground focus-visible:ring-accent-500 text-sm font-medium transition-colors focus-visible:ring-2 rounded"
        >Precios</a
      >
    </div>

    <div class="flex items-center gap-3">
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={18} class="block dark:hidden" />
        <Icon name="lucide:moon" size={18} class="hidden dark:block" />
      </button>

      <Button
        variant="primary"
        href={isAuthenticated ? "/recipes" : "/sign-in"}
      >
        {isAuthenticated ? "Ir a la app" : "Comenzar gratis"}
      </Button>
    </div>
  </div>
</nav>

<div
  id="landing-mobile-menu"
  class="fixed inset-0 z-10000 md:hidden"
  aria-hidden="true"
>
  <div id="landing-mobile-backdrop" class="absolute inset-0 z-0 bg-backdrop">
  </div>
  <div
    id="landing-mobile-panel"
    class="border-border bg-card absolute top-0 left-0 isolate z-10 flex h-full w-72 flex-col border-r p-6 shadow-2xl"
  >
    <div class="flex items-center justify-between">
      <span class="text-foreground text-lg font-black">Menú</span>
      <button
        id="landing-mobile-menu-close"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cerrar menú"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="mt-8 space-y-5">
      <a
        href="/#features"
        class="text-foreground hover:text-accent-600 focus-visible:ring-accent-500 block text-lg font-medium transition-colors focus-visible:ring-2 rounded"
        >Funciones</a
      >
      <a
        href="/#how-it-works"
        class="text-foreground hover:text-accent-600 focus-visible:ring-accent-500 block text-lg font-medium transition-colors focus-visible:ring-2 rounded"
        >Cómo funciona</a
      >
      <a
        href="/#pricing"
        class="text-foreground hover:text-accent-600 focus-visible:ring-accent-500 block text-lg font-medium transition-colors focus-visible:ring-2 rounded"
        >Precios</a
      >
    </nav>
    <div class="mt-8">
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={18} class="block dark:hidden" />
        <Icon name="lucide:moon" size={18} class="hidden dark:block" />
      </button>
    </div>
  </div>
</div>

<style is:global>
  #landing-mobile-menu {
    pointer-events: none;
  }
  #landing-mobile-menu[data-open="1"] {
    pointer-events: auto;
  }
  #landing-mobile-backdrop {
    opacity: 0;
    transition: opacity 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #landing-mobile-menu[data-open="1"] #landing-mobile-backdrop {
    opacity: 1;
  }
  #landing-mobile-panel {
    transform: translateX(-100%);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #landing-mobile-menu[data-open="1"] #landing-mobile-panel {
    transform: translateX(0);
  }
  a[data-spy-active] {
    color: var(--aw-accent-600);
  }

  @media (prefers-reduced-motion: reduce) {
    #landing-mobile-backdrop,
    #landing-mobile-panel {
      transition: none;
    }
    #landing-mobile-backdrop {
      opacity: 1;
    }
    #landing-mobile-panel {
      transform: translateX(0);
    }
  }
</style>

<script>
  function setupLandingMobileMenu() {
    const menuBtn = document.getElementById("landing-mobile-menu-btn");
    const menu = document.getElementById("landing-mobile-menu");
    const closeBtn = document.getElementById("landing-mobile-menu-close");
    const backdrop = document.getElementById("landing-mobile-backdrop");

    if (!menuBtn || !menu) return;
    if (menu.dataset.bound === "1") return;
    menu.dataset.bound = "1";

    function open() {
      menu!.setAttribute("data-open", "1");
      menu!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function close() {
      menu!.setAttribute("data-open", "0");
      menu!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    function onKeyDown(e: KeyboardEvent) {
      if (e.key === "Escape") close();
    }

    menuBtn.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    backdrop?.addEventListener("click", close);
    document.addEventListener("keydown", onKeyDown);

    menu.querySelectorAll("a").forEach(function (a) {
      a.addEventListener("click", close);
    });
  }

  function setupScrollSpy() {
    const sections = ["features", "how-it-works", "pricing"];
    const sectionEls = sections
      .map(function (id) {
        return document.getElementById(id);
      })
      .filter(Boolean);

    if (sectionEls.length === 0) return;

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          const links = document.querySelectorAll(
            'a[href$="#' + entry.target.id + '"]',
          );
          links.forEach(function (link) {
            if (entry.isIntersecting) {
              link.setAttribute("data-spy-active", "1");
            } else {
              link.removeAttribute("data-spy-active");
            }
          });
        });
      },
      { threshold: 0.5 },
    );

    sectionEls.forEach(function (el) {
      if (el) observer.observe(el);
    });
  }

  document.addEventListener("astro:page-load", setupLandingMobileMenu);
  document.addEventListener("astro:after-swap", setupLandingMobileMenu);
  document.addEventListener("astro:page-load", setupScrollSpy);
  document.addEventListener("astro:after-swap", setupScrollSpy);
  setupLandingMobileMenu();
  setupScrollSpy();
</script>
