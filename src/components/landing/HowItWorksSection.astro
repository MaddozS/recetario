---
const steps = [
  {
    number: "1",
    title: "Crea tus recetas",
    description:
      "Agrega tus recetas con categorías, instrucciones y todos los ingredientes que necesitas.",
  },
  {
    number: "2",
    title: "Registra tus ingredientes",
    description:
      "Carga tus ingredientes con precios de compra, unidades y proveedores. El sistema calcula los costos automáticamente.",
  },
  {
    number: "3",
    title: "Optimiza tus precios",
    description:
      "Visualiza costos, márgenes de ganancia y precios sugeridos. Ajusta y exporta tus recetas al instante.",
  },
];
---

<section id="how-it-works" data-reveal class="bg-muted py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-foreground text-3xl font-black md:text-4xl">
        Cómo funciona
      </h2>
      <p class="text-muted-foreground mt-4 text-lg">
        En tres simples pasos tienes el costo real de tus recetas.
      </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3 md:gap-12">
      {
        steps.map((step, i) => (
          <div
            class="reveal-item text-center"
            style={`--reveal-delay: ${i * 120}ms`}
          >
            {i < steps.length - 1 && (
              <div class="border-border absolute top-12 left-[60%] hidden h-px w-[80%] border-t-2 border-dashed md:block" />
            )}
            <div class="bg-accent-600 shadow-accent-600/20 mx-auto flex h-24 w-24 items-center justify-center rounded-2xl shadow-lg">
              <span class="text-3xl font-black text-white">{step.number}</span>
            </div>
            <h3 class="text-foreground mt-6 text-xl font-bold">{step.title}</h3>
            <p class="text-muted-foreground mx-auto mt-3 max-w-xs text-sm leading-relaxed">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
