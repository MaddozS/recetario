---
import { Icon } from 'astro-icon/components'
---

<footer data-reveal class="border-t border-border bg-card">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/kitchcalc_logo.svg" alt="KitchCalc" class="w-8 h-8 rounded-lg" />
          <span class="text-base font-black text-foreground">KitchCalc</span>
        </a>
        <p class="mt-3 text-sm text-muted-foreground leading-relaxed max-w-xs">
          La forma más simple de calcular costos, márgenes y precios para tu negocio de alimentos.
        </p>
      </div>

      <div>
        <h4 class="text-sm font-bold text-foreground uppercase tracking-wider">Producto</h4>
        <ul class="mt-4 space-y-3">
          <li><a href="#features" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Funciones</a></li>
          <li><a href="#pricing" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Precios</a></li>
          <li><a href="/sign-in" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Iniciar sesión</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold text-foreground uppercase tracking-wider">Recursos</h4>
        <ul class="mt-4 space-y-3">
          <li><a href="/sign-in" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Comenzar</a></li>
          <li><a href="#pricing" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Planes</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold text-foreground uppercase tracking-wider">Legal</h4>
        <ul class="mt-4 space-y-3">
          <li><span class="text-sm text-muted-foreground">Privacidad</span></li>
          <li><span class="text-sm text-muted-foreground">Términos</span></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} KitchCalc. Todos los derechos reservados.
      </p>
      <button
        onclick="toggleLandingTheme()"
        class="min-h-10 min-w-10 rounded-xl inline-flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-hover-muted transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={16} class="block dark:hidden" />
        <Icon name="lucide:moon" size={16} class="hidden dark:block" />
      </button>
    </div>
  </div>
</footer>
