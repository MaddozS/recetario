---
import { Icon } from "astro-icon/components";
---

<footer data-reveal class="border-border bg-card border-t">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/kitchcalc_logo.svg"
            alt="KitchCalc"
            class="h-8 w-8 rounded-lg"
          />
          <span class="text-foreground text-base font-black">KitchCalc</span>
        </a>
        <p class="text-muted-foreground mt-3 max-w-xs text-sm leading-relaxed">
          La forma más simple de calcular costos, márgenes y precios para tu
          negocio de alimentos.
        </p>
      </div>

      <div>
        <h4 class="text-foreground text-sm font-bold tracking-wider uppercase">
          Producto
        </h4>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href="#features"
              class="text-muted-foreground hover:text-foreground text-sm transition-colors"
              >Funciones</a
            >
          </li>
          <li>
            <a
              href="#pricing"
              class="text-muted-foreground hover:text-foreground text-sm transition-colors"
              >Precios</a
            >
          </li>
          <li>
            <a
              href="/sign-in"
              class="text-muted-foreground hover:text-foreground text-sm transition-colors"
              >Iniciar sesión</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-foreground text-sm font-bold tracking-wider uppercase">
          Recursos
        </h4>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href="/sign-in"
              class="text-muted-foreground hover:text-foreground text-sm transition-colors"
              >Comenzar</a
            >
          </li>
          <li>
            <a
              href="#pricing"
              class="text-muted-foreground hover:text-foreground text-sm transition-colors"
              >Planes</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-foreground text-sm font-bold tracking-wider uppercase">
          Legal
        </h4>
        <ul class="mt-4 space-y-3">
          <li><span class="text-muted-foreground text-sm">Privacidad</span></li>
          <li><span class="text-muted-foreground text-sm">Términos</span></li>
        </ul>
      </div>
    </div>

    <div
      class="border-border mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 sm:flex-row"
    >
      <p class="text-muted-foreground text-sm">
        &copy; {new Date().getFullYear()} KitchCalc. Todos los derechos reservados.
      </p>
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-10 min-w-10 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={16} class="block dark:hidden" />
        <Icon name="lucide:moon" size={16} class="hidden dark:block" />
      </button>
    </div>
  </div>
</footer>
