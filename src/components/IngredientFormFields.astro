---
import { UNIT_OPTIONS, DEFAULT_UNIT } from "@/lib/constants";

/**
 * Campos de formulario reutilizables para ingredientes.
 *
 * Renderiza cinco campos: nombre, proveedor, marca, precio empaque
 * y cantidad+unidad con un `<select>` de unidades. Cada campo recibe
 * un `id` compuesto de `{idPrefix}-{campo}` (ej. `desktop-name`).
 *
 * El componente no incluye el `<form>`, el botón de submit ni el
 * display de costo unitario. El padre debe envolverlo según el layout
 * deseado (grid en escritorio, stack en mobile).
 *
 * @prop {string} idPrefix - Prefijo para los `id` de cada campo.
 *                           Usar "desktop", "mobile" o "edit".
 *
 * @example
 * // Escritorio (dentro de un grid de 5 columnas)
 * <div class="grid grid-cols-5 gap-4">
 *   <IngredientFormFields idPrefix="desktop" />
 * </div>
 *
 * // Mobile (stack vertical)
 * <form class="space-y-4">
 *   <IngredientFormFields idPrefix="mobile" />
 * </form>
 */
interface Props {
  idPrefix: string;
}

const { idPrefix } = Astro.props;

const labelClasses =
  "mb-1.5 block text-[11px] font-bold uppercase tracking-[0.18em] text-muted-foreground";
const inputClasses =
  "w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none transition placeholder:text-subtle-foreground focus:border-accent-300 focus:bg-card focus:ring-2 focus:ring-accent-500/20";
---

<div>
  <label class={labelClasses} for={`${idPrefix}-name`}>
    Nombre <span class="text-danger">*</span>
  </label>
  <input
    id={`${idPrefix}-name`}
    name="name"
    type="text"
    placeholder="Ej. Harina de trigo extra fina"
    class={inputClasses}
    autocomplete="off"
  />
</div>

<div>
  <label class={labelClasses} for={`${idPrefix}-supplier`}>Proveedor</label>
  <input
    id={`${idPrefix}-supplier`}
    name="supplier"
    type="text"
    placeholder="Ej. Casa Santos Lugo"
    class={inputClasses}
    autocomplete="off"
  />
</div>

<div>
  <label class={labelClasses} for={`${idPrefix}-brand`}>Marca</label>
  <input
    id={`${idPrefix}-brand`}
    name="brand"
    type="text"
    placeholder="Opcional"
    class={inputClasses}
    autocomplete="off"
  />
</div>

<div>
  <label class={labelClasses} for={`${idPrefix}-price`}>
    Precio empaque <span class="text-danger">*</span>
  </label>
  <div class="relative">
    <span
      class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm font-bold text-subtle-foreground"
    >
      $
    </span>
    <input
      id={`${idPrefix}-price`}
      name="price"
      type="text"
      inputmode="decimal"
      placeholder="0.00"
      class={`${inputClasses} pl-8 font-mono`}
      autocomplete="off"
    />
  </div>
</div>

<div>
  <label class={labelClasses} for={`${idPrefix}-purchase-quantity`}>
    Cant. empaque <span class="text-danger">*</span>
  </label>
  <div
    class="grid grid-cols-[minmax(0,1fr)_5.5rem] overflow-hidden rounded-xl border border-border bg-background transition focus-within:border-accent-300 focus-within:bg-card focus-within:ring-2 focus-within:ring-accent-500/20"
  >
    <input
      id={`${idPrefix}-purchase-quantity`}
      name="purchaseQuantity"
      type="text"
      inputmode="decimal"
      value="1"
      class="border-0 bg-transparent px-4 py-3 text-sm text-foreground outline-none placeholder:text-subtle-foreground font-mono"
      autocomplete="off"
    />
    <select
      name="unit"
      class="border-0 border-l border-border bg-card px-3 py-3 text-sm font-semibold text-secondary-foreground outline-none"
    >
      {
        UNIT_OPTIONS.map((option) => (
          <option value={option} selected={option === DEFAULT_UNIT}>
            {option}
          </option>
        ))
      }
    </select>
  </div>
</div>
