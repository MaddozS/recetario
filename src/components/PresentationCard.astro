---
import { Icon } from "astro-icon/components";
import { Button } from "@/components/ui";

interface Props {
  id: number;
  name: string;
  unitsPerBatch: number;
  salePrice?: number;
  multiplier: number;
  costoProduccionRealBatch: number;
  precioVentaSugeridoBatch: number;
}

const {
  id,
  name,
  unitsPerBatch,
  salePrice,
  multiplier,
  costoProduccionRealBatch,
  precioVentaSugeridoBatch,
} = Astro.props;

const totalUnits = unitsPerBatch * multiplier;
const hasUnits = totalUnits > 0;
const unitCost = hasUnits ? costoProduccionRealBatch / totalUnits : 0;
const unitPriceRecommended = hasUnits
  ? precioVentaSugeridoBatch / totalUnits
  : 0;

// Default sale price to saved salePrice or recommended price
const defaultSalePrice =
  typeof salePrice === "number" ? salePrice : unitPriceRecommended;
const unitProfit = defaultSalePrice - unitCost;
---

<presentation-card
  class="bg-card border-border flex h-full flex-col rounded-2xl border p-5 shadow-sm transition-all"
  data-id={id}
  data-multiplier={multiplier}
  data-cost={costoProduccionRealBatch}
  data-recommended={precioVentaSugeridoBatch}
  data-units={unitsPerBatch}
  data-price={defaultSalePrice}
>
  <form method="post" class="flex h-full grow flex-col">
    <input type="hidden" name="action" value="update_presentation" />
    <input type="hidden" name="presentationId" value={id} />
    <input type="hidden" name="_csrf" value={Astro.locals.csrfToken || ""} />

    <div class="mb-2 flex items-start justify-between gap-3">
      <input
        name="presentationName"
        type="text"
        class="presentation-name focus:ring-accent-500/20 text-foreground -ml-1 w-full min-w-0 rounded-lg border-none bg-transparent p-1 font-[family-name:var(--font-display)] text-lg font-bold focus:ring-2"
        value={name}
        required
        readonly
      />
      <div class="flex shrink-0 items-center gap-1">
        <Button
          variant="iconDanger"
          iconOnly
          icon="trash-2"
          class="delete-btn hidden"
          ariaLabel="Eliminar presentación"
          title="Eliminar"
        />
        <Button
          variant="iconAccent"
          iconOnly
          icon="pencil"
          class="edit-btn"
          ariaLabel="Editar presentación"
          aria-pressed="false"
          title="Editar"
        />
      </div>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-2">
      <div
        class="border-border bg-background text-muted-foreground focus-within:ring-accent-500/20 focus-within:border-accent-300 inline-flex items-center gap-1 rounded-md border px-2.5 py-1 text-xs transition-all focus-within:ring-2"
      >
        <span>Rinde:</span>
        <input
          name="unitsPerBatch"
          type="number"
          step="any"
          min="0.01"
          class="presentation-units text-foreground w-8 border-none bg-transparent p-0 text-center font-mono text-xs font-semibold read-only:pointer-events-none focus:ring-0"
          value={unitsPerBatch}
          readonly
        />
        <span>piezas</span>
      </div>

      {
        Math.abs(multiplier - 1) > 0.0001 && (
          <div class="border-accent-200 bg-accent-50 text-accent-700 inline-flex items-center gap-1 rounded-md border px-2.5 py-1 text-xs transition-all">
            <span class="font-semibold">Con x{multiplier}:</span>
            <span class="yield-value font-mono font-semibold">
              {Math.round(totalUnits * 100) / 100}
            </span>
            <span>piezas</span>
          </div>
        )
      }
    </div>

    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <div class="shrink-0 space-y-0.5">
        <p
          class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase"
        >
          Costo unitario
        </p>
        <p
          class="unit-cost-display text-foreground font-mono text-lg font-semibold tabular-nums"
        >
          ${unitCost.toFixed(2)}
        </p>
      </div>

      <div
        class="bg-accent-50/50 border-accent-100 flex max-w-65 grow flex-wrap items-center justify-between gap-y-1 rounded-xl border px-2.5 py-2 sm:px-3 sm:py-2.5"
      >
        <div class="flex min-w-0 shrink-0 flex-col">
          <p
            class="text-accent-700 mb-0.5 text-[11px] font-bold tracking-[0.16em] uppercase"
          >
            Precio Venta
          </p>
          <p class="text-muted-foreground text-[10px]">
            Sugerido: <span
              class="recommended-price-display font-mono font-semibold"
              >${unitPriceRecommended.toFixed(2)}</span
            >
          </p>
        </div>
        <div
          class="focus-within:bg-card focus-within:ring-accent-500/20 focus-within:border-accent-300 relative -mr-1 flex shrink-0 items-center justify-end rounded-md border border-transparent px-1 transition-all focus-within:ring-2"
        >
          <span
            class="text-accent-600 pointer-events-none mr-0.5 font-mono text-[20px] font-semibold"
            >$</span
          >
          <input
            name="salePrice"
            type="text"
            inputmode="decimal"
            class="presentation-price text-accent-600 max-w-full min-w-[3ch] border-none bg-transparent p-0 text-left font-mono text-[20px] font-semibold tabular-nums read-only:pointer-events-none focus:ring-0"
            style={`width: ${Math.max(defaultSalePrice.toFixed(2).length + 1, 4)}ch;`}
            value={defaultSalePrice.toFixed(2)}
            readonly
          />
          <span
            aria-hidden="true"
            class="presentation-price-measure pointer-events-none invisible absolute top-0 left-0 font-mono text-[20px] font-semibold whitespace-pre tabular-nums"
          >
            {defaultSalePrice.toFixed(2)}
          </span>
        </div>
      </div>
    </div>

    <hr class="border-border-light my-1 mb-5" />

    <div class="mt-auto flex items-end justify-between gap-4">
      <div class="space-y-0.5">
        <p
          class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase"
        >
          Ganancia / Pz
        </p>
        <p
          class="text-success profit-display font-mono text-lg font-semibold tabular-nums"
        >
          ${unitProfit.toFixed(2)}
        </p>
      </div>
      <div class="w-[60%] max-w-60 pb-1">
        <div class="mb-2 flex items-center justify-between text-xs">
          <span
            class="margin-label text-success"
            title="Margen sobre precio: (precio - costo) / precio"
            >Saludable</span
          >
          <span
            class="margin-percent-display text-foreground font-mono font-semibold"
            >0.0%</span
          >
        </div>
        <div class="bg-muted h-2.5 overflow-hidden rounded-full">
          <div
            class="margin-bar h-full rounded-full transition-all duration-500"
          >
          </div>
        </div>
      </div>
    </div>

    <div class="save-bar border-border-light mt-5 hidden border-t pt-4">
      <button
        type="submit"
        class="save-btn bg-accent-600 hover:bg-accent-700 shadow-accent-200 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-bold text-white shadow-sm transition-colors"
      >
        <Icon name="lucide:check" size={18} />
        Guardar Cambios
      </button>
      <p
        class="text-danger presentation-error mt-2 hidden text-xs font-semibold"
      >
      </p>
    </div>
  </form>

  <dialog
    data-animated
    class="delete-dialog fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0 backdrop:bg-backdrop/50"
  >
    <div class="border-border bg-card rounded-3xl border p-6 shadow-2xl">
      <div class="flex items-start gap-3">
        <div
          class="bg-danger-bg text-danger flex h-11 w-11 items-center justify-center rounded-2xl"
        >
          <Icon name="lucide:trash-2" size={18} />
        </div>
        <div>
          <h2 class="text-foreground text-lg font-bold">
            Confirmar eliminación
          </h2>
          <p class="text-muted-foreground mt-2 text-sm">
            ¿Eliminar esta presentación? Esta acción no se puede deshacer.
          </p>
        </div>
      </div>

      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button
          type="button"
          class="delete-cancel-btn border-border bg-card text-muted-foreground hover:bg-background inline-flex min-h-11 items-center justify-center rounded-xl border px-5 py-3 text-sm font-bold transition-colors"
        >
          Cancelar
        </button>
        <button
          type="button"
          class="delete-confirm-btn bg-danger-solid hover:bg-danger-hover inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-bold text-white transition-colors"
        >
          <Icon name="lucide:trash-2" size={16} /> Eliminar
        </button>
      </div>
    </div>
  </dialog>
</presentation-card>

<script>
  import { bindDialogBackdrop } from "@/lib/dialog";

  class PresentationCard extends HTMLElement {
    isEditing: boolean = false;
    btnDelete: HTMLButtonElement | null = null;
    btnEdit: HTMLButtonElement | null = null;
    inputName: HTMLInputElement | null = null;
    inputUnits: HTMLInputElement | null = null;
    inputPrice: HTMLInputElement | null = null;
    priceMeasure: HTMLSpanElement | null = null;
    yieldValue: HTMLSpanElement | null = null;
    unitCostDisplay: HTMLParagraphElement | null = null;
    recommendedPriceDisplay: HTMLSpanElement | null = null;
    profitDisplay: HTMLParagraphElement | null = null;
    marginLabel: HTMLSpanElement | null = null;
    marginPercentDisplay: HTMLSpanElement | null = null;
    marginBar: HTMLDivElement | null = null;
    saveBar: HTMLDivElement | null = null;
    btnSave: HTMLButtonElement | null = null;
    deleteDialog: HTMLDialogElement | null = null;
    btnDeleteCancel: HTMLButtonElement | null = null;
    btnDeleteConfirm: HTMLButtonElement | null = null;
    form: HTMLFormElement | null = null;
    presentationError: HTMLParagraphElement | null = null;
    saveBtnOriginalText: string = "";
    saveBtnOriginalIconHTML: string = "";
    multiplier: number = 1;
    costoBatch: number = 0;
    precioRecBatch: number = 0;
    originalName: string = "";
    originalUnits: string = "0";
    originalPrice: string = "0";
    salePriceDirty: boolean = false;
    errorDismissTimeout: number | undefined = undefined;
    escHandler: ((e: KeyboardEvent) => void) | null = null;

    connectedCallback() {
      if (this.dataset.bound === "1") return;
      this.dataset.bound = "1";

      this.btnEdit = this.querySelector(".edit-btn");
      this.btnDelete = this.querySelector(".delete-btn");
      this.inputName = this.querySelector(".presentation-name");
      this.inputUnits = this.querySelector(".presentation-units");
      this.inputPrice = this.querySelector(".presentation-price");
      this.priceMeasure = this.querySelector(".presentation-price-measure");
      this.yieldValue = this.querySelector(".yield-value");
      this.unitCostDisplay = this.querySelector(".unit-cost-display");
      this.recommendedPriceDisplay = this.querySelector(
        ".recommended-price-display",
      );
      this.profitDisplay = this.querySelector(".profit-display");
      this.marginLabel = this.querySelector(".margin-label");
      this.marginPercentDisplay = this.querySelector(".margin-percent-display");
      this.marginBar = this.querySelector(".margin-bar");
      this.saveBar = this.querySelector(".save-bar");
      this.btnSave = this.querySelector(".save-btn");
      this.deleteDialog = this.querySelector(".delete-dialog");
      this.btnDeleteCancel = this.querySelector(".delete-cancel-btn");
      this.btnDeleteConfirm = this.querySelector(".delete-confirm-btn");
      this.presentationError = this.querySelector(".presentation-error");
      this.form = this.querySelector("form");

      this.multiplier = parseFloat(this.dataset.multiplier || "1");
      this.costoBatch = parseFloat(this.dataset.cost || "0");
      this.precioRecBatch = parseFloat(this.dataset.recommended || "0");

      this.btnEdit?.addEventListener("click", () => this.toggleEdit());
      this.btnDelete?.addEventListener("click", () => this.openDeleteDialog());
      this.btnDeleteCancel?.addEventListener("click", () =>
        this.closeDeleteDialog(),
      );
      this.btnDeleteConfirm?.addEventListener("click", () =>
        this.deletePresentation(),
      );
      this.inputUnits?.addEventListener("input", () => this.calculate());
      this.inputPrice?.addEventListener("input", () => {
        this.salePriceDirty = true;
        this.calculate();
      });

      this.escHandler = (e) => {
        if (e.key === "Escape" && this.isEditing) {
          this.toggleEdit(false);
        }
      };
      document.addEventListener("keydown", this.escHandler);

      if (this.btnSave) {
        this.saveBtnOriginalText = (this.btnSave.textContent || "").trim();
        this.saveBtnOriginalIconHTML =
          this.btnSave.querySelector("svg")?.outerHTML || "";
      }

      if (this.deleteDialog) {
        bindDialogBackdrop(this.deleteDialog);
      }

      this.form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!this.form) return;

        if (!this.form.checkValidity()) {
          this.form.reportValidity();
          return;
        }

        const parsedPrice = parseFloat(this.inputPrice?.value || "");
        if (
          this.inputPrice?.value.trim() !== "" &&
          (!Number.isFinite(parsedPrice) || parsedPrice < 0)
        ) {
          this.showError(
            "El precio de venta debe ser un número mayor o igual a 0.",
          );
          return;
        }

        if (this.btnSave) {
          this.btnSave.disabled = true;
          this.btnSave.classList.add("opacity-75", "cursor-not-allowed");
          this.btnSave.innerHTML = `<svg class="animate-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="32"><animate attributeName="stroke-dashoffset" values="32;0" dur="0.8s" repeatCount="indefinite" /></circle></svg> Guardando...`;
        }

        try {
          const formData = new FormData(this.form);
          if (!this.salePriceDirty) {
            formData.delete("salePrice");
          }

          const response = await fetch(window.location.href, {
            method: "POST",
            headers: {
              Accept: "application/json",
            },
            body: formData,
          });

          if (response.redirected) {
            throw new Error(
              "Tu sesión expiró. Recarga la página e inicia sesión nuevamente.",
            );
          }

          if (!response.ok) {
            const message = (await response.text()).trim();
            throw new Error(message || "Hubo un error al guardar los cambios.");
          }

          const contentType = response.headers.get("content-type") || "";
          if (!contentType.includes("application/json")) {
            throw new Error("La respuesta del servidor no fue válida.");
          }

          const payload = await response.json().catch(() => null);
          if (!payload?.presentation) {
            throw new Error("La respuesta del servidor no fue válida.");
          }

          this.applyPresentation(payload.presentation);

          this.toggleEdit(true); // true = save changes
        } catch (error) {
          console.error(error);
          const message =
            error instanceof Error && error.message
              ? error.message
              : "Hubo un error al guardar los cambios.";
          this.showError(message);
        } finally {
          if (this.btnSave) {
            this.btnSave.disabled = false;
            this.btnSave.classList.remove("opacity-75", "cursor-not-allowed");
            this.btnSave.innerHTML =
              this.saveBtnOriginalIconHTML + " " + this.saveBtnOriginalText;
          }
        }
      });

      // Initial calculate
      this.calculate();
    }

    showError(message: string) {
      if (!this.presentationError) return;
      if (this.errorDismissTimeout) {
        clearTimeout(this.errorDismissTimeout);
      }
      this.presentationError.textContent = message;
      this.presentationError.classList.remove("hidden");
      let dismissBtn =
        this.presentationError.querySelector(".error-dismiss-btn");
      if (!dismissBtn) {
        dismissBtn = document.createElement("button");
        (dismissBtn as HTMLButtonElement).type = "button";
        dismissBtn.setAttribute("aria-label", "Cerrar mensaje");
        dismissBtn.className =
          "error-dismiss-btn ml-2 inline-flex items-center justify-center rounded-full hover:bg-danger-bg transition-colors w-5 h-5 text-xs font-bold";
        dismissBtn.textContent = "\u00D7";
        dismissBtn.addEventListener("click", () => this.clearError());
        this.presentationError.appendChild(dismissBtn);
      }
    }

    clearError() {
      if (!this.presentationError) return;
      this.presentationError.classList.add("hidden");
      if (this.errorDismissTimeout) {
        clearTimeout(this.errorDismissTimeout);
        this.errorDismissTimeout = undefined;
      }
    }

    openDeleteDialog() {
      if (!(this.deleteDialog instanceof HTMLDialogElement)) return;

      if (!this.deleteDialog.open) {
        this.deleteDialog.showModal();
      }
    }

    disconnectedCallback() {
      if (this.escHandler) {
        document.removeEventListener("keydown", this.escHandler);
        this.escHandler = null;
      }
    }

    closeDeleteDialog() {
      if (!(this.deleteDialog instanceof HTMLDialogElement)) return;

      if (this.deleteDialog.open) {
        this.deleteDialog.close();
      }
    }

    async deletePresentation() {
      if (!this.form) return;

      if (this.btnDelete) {
        this.btnDelete.disabled = true;
        this.btnDelete.classList.add("opacity-75", "cursor-not-allowed");
      }

      if (this.btnDeleteConfirm) {
        this.btnDeleteConfirm.disabled = true;
        this.btnDeleteConfirm.classList.add("opacity-75", "cursor-not-allowed");
      }

      try {
        const formData = new FormData(this.form);
        formData.set("action", "delete_presentation");

        const response = await fetch(window.location.href, {
          method: "POST",
          headers: {
            Accept: "application/json",
          },
          body: formData,
        });

        if (response.redirected) {
          throw new Error(
            "Tu sesión expiró. Recarga la página e inicia sesión nuevamente.",
          );
        }

        if (!response.ok) {
          const message = (await response.text()).trim();
          throw new Error(
            message || "Hubo un error al eliminar la presentación.",
          );
        }

        const contentType = response.headers.get("content-type") || "";
        if (!contentType.includes("application/json")) {
          throw new Error("La respuesta del servidor no fue válida.");
        }

        const payload = await response.json().catch(() => null);
        if (!payload?.deleted) {
          throw new Error("La respuesta del servidor no fue válida.");
        }

        this.closeDeleteDialog();
        this.remove();
      } catch (error) {
        console.error(error);
        const message =
          error instanceof Error && error.message
            ? error.message
            : "Hubo un error al eliminar la presentación.";
        this.showError(message);
      } finally {
        if (this.btnDelete) {
          this.btnDelete.disabled = false;
          this.btnDelete.classList.remove("opacity-75", "cursor-not-allowed");
        }

        if (this.btnDeleteConfirm) {
          this.btnDeleteConfirm.disabled = false;
          this.btnDeleteConfirm.classList.remove(
            "opacity-75",
            "cursor-not-allowed",
          );
        }
      }
    }

    applyPresentation(presentation: {
      name?: string;
      unitsPerBatch?: number;
      salePrice?: number | null;
    }) {
      const unitsPerBatch = Number(presentation?.unitsPerBatch ?? 0);
      const totalUnits = unitsPerBatch * this.multiplier;
      const hasUnits = totalUnits > 0;
      const recommendedPrice = hasUnits ? this.precioRecBatch / totalUnits : 0;
      const nextPrice =
        typeof presentation?.salePrice === "number"
          ? presentation.salePrice
          : recommendedPrice;

      if (this.inputName) this.inputName.value = presentation?.name || "";
      if (this.inputUnits)
        this.inputUnits.value = Number.isFinite(unitsPerBatch)
          ? String(unitsPerBatch)
          : "0";
      if (this.inputPrice) this.inputPrice.value = nextPrice.toFixed(2);
      this.syncPriceWidth(nextPrice.toFixed(2));

      this.dataset.units = Number.isFinite(unitsPerBatch)
        ? String(unitsPerBatch)
        : "0";
      this.dataset.price = nextPrice.toFixed(2);
      this.salePriceDirty = false;
      this.calculate();
    }

    toggleEdit(save = false) {
      this.isEditing = !this.isEditing;
      const inputs = [this.inputName, this.inputUnits, this.inputPrice];

      if (this.isEditing) {
        this.clearError();
        this.salePriceDirty = false;
        this.originalName = this.inputName?.value || "";
        this.originalUnits = this.inputUnits?.value || "0";
        this.originalPrice = this.inputPrice?.value || "0";

        inputs.forEach((input) => {
          if (input) {
            input.removeAttribute("readonly");
            input.classList.remove("border-transparent", "bg-transparent");
          }
        });

        if (this.btnEdit) {
          this.btnEdit.classList.add("bg-muted");
          this.btnEdit.setAttribute("title", "Cancelar");
          this.btnEdit.setAttribute("aria-label", "Cancelar edición");
          this.btnEdit.setAttribute("aria-pressed", "true");
        }

        if (this.btnDelete) {
          this.btnDelete.classList.remove("hidden");
          this.btnDelete.classList.add("inline-flex");
        }

        if (this.saveBar) {
          this.saveBar.classList.remove("hidden");
        }

        this.inputPrice?.focus();
      } else {
        if (!save) {
          // Revert to original values if cancelled
          if (this.inputName) this.inputName.value = this.originalName;
          if (this.inputUnits) this.inputUnits.value = this.originalUnits;
          if (this.inputPrice) this.inputPrice.value = this.originalPrice;
          this.calculate();
        } else {
          // Commit changes
          this.originalName = this.inputName?.value || "";
          this.originalUnits = this.inputUnits?.value || "0";
          this.originalPrice = this.inputPrice?.value || "0";
        }

        inputs.forEach((input) => {
          if (input) {
            input.setAttribute("readonly", "true");
          }
        });

        if (this.btnEdit) {
          this.btnEdit.classList.remove("bg-muted");
          this.btnEdit.setAttribute("title", "Editar");
          this.btnEdit.setAttribute("aria-label", "Editar presentación");
          this.btnEdit.setAttribute("aria-pressed", "false");
        }

        if (this.btnDelete) {
          this.btnDelete.classList.add("hidden");
          this.btnDelete.classList.remove("inline-flex");
        }

        if (this.saveBar) {
          this.saveBar.classList.add("hidden");
        }

        this.closeDeleteDialog();

        this.salePriceDirty = false;

        // Format price on blur
        if (this.inputPrice && this.inputPrice.value) {
          this.inputPrice.value = parseFloat(this.inputPrice.value).toFixed(2);
          this.syncPriceWidth(this.inputPrice.value);
        }
      }
    }

    syncPriceWidth(value = this.inputPrice?.value ?? "") {
      if (!this.inputPrice || !this.priceMeasure) {
        return;
      }

      const measuredValue = value.trim().length > 0 ? value.trim() : "0.00";

      requestAnimationFrame(() => {
        if (!this.priceMeasure || !this.inputPrice) return;
        this.priceMeasure.textContent = measuredValue;
        const measuredWidth = this.priceMeasure.scrollWidth;
        const nextWidth = Math.max(Math.ceil(measuredWidth + 4), 28);
        this.inputPrice.style.width = `${nextWidth}px`;
      });
    }

    calculate() {
      const unitsPerBatch = parseFloat(this.inputUnits?.value || "0");
      const salePriceValue = this.inputPrice?.value ?? "";

      const totalUnits = unitsPerBatch * this.multiplier;
      const hasUnits = totalUnits > 0;

      const unitCost = hasUnits ? this.costoBatch / totalUnits : 0;
      const unitPriceRecommended = hasUnits
        ? this.precioRecBatch / totalUnits
        : 0;
      const parsedSalePrice = parseFloat(salePriceValue || "0");
      const salePrice =
        salePriceValue.trim() === ""
          ? unitPriceRecommended
          : Number.isFinite(parsedSalePrice)
            ? parsedSalePrice
            : 0;

      this.syncPriceWidth(salePriceValue);

      const unitProfit = salePrice - unitCost;
      const marginPercent = salePrice > 0 ? (unitProfit / salePrice) * 100 : 0;
      const marginWidth = Math.min(Math.max(marginPercent, 0), 100);

      let marginLabel = "Bajo";
      let marginColor = "bg-danger-solid";
      let marginTextColor = "text-danger";

      if (marginPercent >= 35) {
        marginLabel = "Saludable";
        marginColor = "bg-success-solid";
        marginTextColor = "text-success";
      } else if (marginPercent >= 20) {
        marginLabel = "Medio";
        marginColor = "bg-warning-solid";
        marginTextColor = "text-warning";
      }

      if (this.yieldValue)
        this.yieldValue.textContent = (
          Math.round(totalUnits * 100) / 100
        ).toString();
      if (this.unitCostDisplay)
        this.unitCostDisplay.textContent = "$" + unitCost.toFixed(2);
      if (this.recommendedPriceDisplay)
        this.recommendedPriceDisplay.textContent =
          "$" + unitPriceRecommended.toFixed(2);
      if (this.profitDisplay) {
        this.profitDisplay.textContent = "$" + unitProfit.toFixed(2);
        this.profitDisplay.className = `text-lg font-mono font-semibold tabular-nums profit-display ${marginTextColor}`;
      }
      if (this.marginPercentDisplay)
        this.marginPercentDisplay.textContent = marginPercent.toFixed(1) + "%";
      if (this.marginLabel) {
        this.marginLabel.textContent = marginLabel;
        this.marginLabel.className = `margin-label ${marginTextColor}`;
      }

      if (this.marginBar) {
        this.marginBar.style.width = marginWidth + "%";
        this.marginBar.className = `margin-bar h-full rounded-full transition-all duration-500 ${marginColor}`;
      }
    }
  }

  if (!customElements.get("presentation-card")) {
    customElements.define("presentation-card", PresentationCard);
  }
</script>
