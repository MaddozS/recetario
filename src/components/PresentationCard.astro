---
import { Icon } from "astro-icon/components";

interface Props {
  id: number;
  name: string;
  unitsPerBatch: number;
  salePrice?: number;
  multiplier: number;
  costoProduccionRealBatch: number;
  precioVentaSugeridoBatch: number;
}

const {
  id,
  name,
  unitsPerBatch,
  salePrice,
  multiplier,
  costoProduccionRealBatch,
  precioVentaSugeridoBatch,
} = Astro.props;

const totalUnits = unitsPerBatch * multiplier;
const hasUnits = totalUnits > 0;
const unitCost = hasUnits ? costoProduccionRealBatch / totalUnits : 0;
const unitPriceRecommended = hasUnits
  ? precioVentaSugeridoBatch / totalUnits
  : 0;

// Default sale price to saved salePrice or recommended price
const defaultSalePrice =
  typeof salePrice === "number" ? salePrice : unitPriceRecommended;
const unitProfit = defaultSalePrice - unitCost;
---

<presentation-card
  class="bg-card p-5 rounded-2xl border border-border shadow-sm hover:border-border dark:hover:border-slate-600 transition-all group flex flex-col h-full"
  data-id={id}
  data-multiplier={multiplier}
  data-cost={costoProduccionRealBatch}
  data-recommended={precioVentaSugeridoBatch}
  data-units={unitsPerBatch}
  data-price={defaultSalePrice}
>
  <form method="post" class="flex flex-col h-full grow">
    <input type="hidden" name="action" value="update_presentation" />
    <input type="hidden" name="presentationId" value={id} />

    <div class="flex justify-between items-start gap-3 mb-2">
      <input
        name="presentationName"
        type="text"
        class="presentation-name min-w-0 font-bold text-xl bg-transparent border-none focus:ring-2 focus:ring-accent-500/20 p-1 -ml-1 rounded-lg text-foreground w-full"
        value={name}
        readonly
      />
      <div class="flex items-center gap-1 shrink-0">
        <button
          type="button"
          class="delete-btn hidden h-8 w-8 rounded-full bg-transparent text-danger hover:text-danger hover:bg-danger-bg transition-colors items-center justify-center"
          aria-label="Eliminar presentación"
          title="Eliminar"
        >
          <Icon name="lucide:trash-2" size={16} />
        </button>
        <button
          type="button"
          class="edit-btn h-8 w-8 rounded-full bg-transparent text-subtle-foreground hover:text-accent-600 hover:bg-accent-50 transition-colors flex items-center justify-center"
          aria-label="Editar presentación"
          aria-pressed="false"
          title="Editar"
        >
          <Icon
            name="lucide:pencil"
            size={16}
            class="edit-icon edit-icon-pencil"
          />
          <Icon
            name="lucide:x"
            size={16}
            class="edit-icon edit-icon-cancel hidden"
          />
        </button>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 mb-6">
      <div
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-border bg-background text-xs text-muted-foreground focus-within:ring-2 focus-within:ring-accent-500/20 focus-within:border-accent-300 transition-all"
      >
        <span>Rinde:</span>
        <input
          name="unitsPerBatch"
          type="number"
          step="any"
          class="presentation-units w-8 bg-transparent border-none p-0 text-center text-xs text-foreground font-mono font-semibold focus:ring-0 read-only:pointer-events-none"
          value={unitsPerBatch}
          readonly
        />
        <span>piezas</span>
      </div>

      {
        Math.abs(multiplier - 1) > 0.0001 && (
          <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-accent-200 bg-accent-50 text-xs text-accent-700 transition-all">
            <span class="font-semibold">Con x{multiplier}:</span>
            <span class="font-mono font-semibold yield-value">
              {Math.round(totalUnits * 100) / 100}
            </span>
            <span>piezas</span>
          </div>
        )
      }
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <div class="space-y-0.5 shrink-0">
        <p
          class="text-[10px] font-bold text-subtle-foreground uppercase tracking-widest"
        >
          Costo unitario
        </p>
        <p
          class="unit-cost-display text-[20px] font-mono font-semibold text-foreground tabular-nums"
        >
          ${unitCost.toFixed(2)}
        </p>
      </div>

      <div
        class="bg-accent-50/50 border border-accent-100 rounded-xl px-2.5 py-2 sm:px-3 sm:py-2.5 grow flex flex-wrap items-center justify-between gap-y-1 max-w-65"
      >
        <div class="flex flex-col shrink-0 min-w-0">
          <p
            class="text-[10px] font-bold text-accent-700 uppercase tracking-widest mb-0.5"
          >
            Precio Venta
          </p>
          <p class="text-[10px] text-accent-400/80">
            Sugerido: <span
              class="recommended-price-display font-mono font-semibold"
              >${unitPriceRecommended.toFixed(2)}</span
            >
          </p>
        </div>
        <div
          class="relative flex items-center justify-end focus-within:bg-card focus-within:ring-2 focus-within:ring-accent-500/20 focus-within:border-accent-300 rounded-md border border-transparent transition-all px-1 -mr-1 shrink-0"
        >
          <span
            class="text-[20px] font-mono font-semibold text-accent-600 mr-0.5 pointer-events-none"
            >$</span
          >
          <input
            name="salePrice"
            type="text"
            inputmode="decimal"
            class="presentation-price bg-transparent border-none p-0 text-[20px] font-mono font-semibold text-accent-600 text-left tabular-nums focus:ring-0 read-only:pointer-events-none min-w-[3ch] max-w-full"
            style={`width: ${Math.max(defaultSalePrice.toFixed(2).length + 1, 4)}ch;`}
            value={defaultSalePrice.toFixed(2)}
            readonly
          />
          <span
            aria-hidden="true"
            class="presentation-price-measure pointer-events-none absolute left-0 top-0 invisible whitespace-pre text-[20px] font-mono font-semibold tabular-nums"
          >
            {defaultSalePrice.toFixed(2)}
          </span>
        </div>
      </div>
    </div>

    <hr class="border-border-light my-1 mb-5" />

    <div class="flex items-end justify-between gap-4 mt-auto">
      <div class="space-y-0.5">
        <p
          class="text-[10px] font-bold text-subtle-foreground uppercase tracking-widest"
        >
          Ganancia / Pz
        </p>
        <p
          class="text-[20px] font-mono font-semibold text-success tabular-nums profit-display"
        >
          ${unitProfit.toFixed(2)}
        </p>
      </div>
      <div class="pb-1 w-[60%] max-w-60">
        <div class="flex items-center justify-between text-xs mb-2">
          <span class="margin-label text-success">Saludable</span>
          <span
            class="margin-percent-display font-mono font-semibold text-foreground"
            >0.0%</span
          >
        </div>
        <div class="h-2.5 rounded-full bg-muted overflow-hidden">
          <div
            class="margin-bar h-full rounded-full transition-all duration-500"
          >
          </div>
        </div>
      </div>
    </div>

    <div class="save-bar hidden mt-5 pt-4 border-t border-border-light">
      <button
        type="submit"
        class="save-btn w-full inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-accent-600 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-700 shadow-sm shadow-accent-200"
      >
        <Icon name="lucide:check" size={18} />
        Guardar Cambios
      </button>
    </div>
  </form>

  <dialog
    class="delete-dialog fixed inset-0 m-auto w-[calc(100vw-1.5rem)] max-w-md rounded-3xl p-0 backdrop:bg-slate-900/55"
  >
    <div class="rounded-3xl border border-border bg-card p-6 shadow-2xl">
      <div class="flex items-start gap-3">
        <div
          class="flex h-11 w-11 items-center justify-center rounded-2xl bg-danger-bg text-danger"
        >
          <Icon name="lucide:trash-2" size={18} />
        </div>
        <div>
          <h3 class="text-lg font-bold text-foreground">
            Confirmar eliminación
          </h3>
          <p class="mt-2 text-sm text-muted-foreground">
            ¿Eliminar esta presentación? Esta acción no se puede deshacer.
          </p>
        </div>
      </div>

      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button
          type="button"
          class="delete-cancel-btn inline-flex min-h-11 items-center justify-center rounded-xl border border-border bg-card px-5 py-3 text-sm font-bold text-muted-foreground transition-colors hover:bg-background"
        >
          Cancelar
        </button>
        <button
          type="button"
          class="delete-confirm-btn inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-danger-solid px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-danger-solid"
        >
          <Icon name="lucide:trash-2" size={16} /> Eliminar
        </button>
      </div>
    </div>
  </dialog>
</presentation-card>

<script>
  // @ts-nocheck
  import { bindDialogBackdrop } from "@/lib/dialog";

  class PresentationCard extends HTMLElement {
    isEditing = false;
    btnDelete = null;
    btnEdit = null;
    inputName = null;
    inputUnits = null;
    inputPrice = null;
    priceMeasure = null;
    yieldValue = null;
    unitCostDisplay = null;
    recommendedPriceDisplay = null;
    profitDisplay = null;
    marginLabel = null;
    marginPercentDisplay = null;
    marginBar = null;
    saveBar = null;
    btnSave = null;
    deleteDialog = null;
    btnDeleteCancel = null;
    btnDeleteConfirm = null;
    form = null;
    multiplier = 1;
    costoBatch = 0;
    precioRecBatch = 0;
    originalName = "";
    originalUnits = "0";
    originalPrice = "0";
    salePriceDirty = false;

    connectedCallback() {
      if (this.dataset.bound === "1") return;
      this.dataset.bound = "1";

      this.btnEdit = this.querySelector(".edit-btn");
      this.btnDelete = this.querySelector(".delete-btn");
      this.inputName = this.querySelector(".presentation-name");
      this.inputUnits = this.querySelector(".presentation-units");
      this.inputPrice = this.querySelector(".presentation-price");
      this.priceMeasure = this.querySelector(".presentation-price-measure");
      this.yieldValue = this.querySelector(".yield-value");
      this.unitCostDisplay = this.querySelector(".unit-cost-display");
      this.recommendedPriceDisplay = this.querySelector(
        ".recommended-price-display",
      );
      this.profitDisplay = this.querySelector(".profit-display");
      this.marginLabel = this.querySelector(".margin-label");
      this.marginPercentDisplay = this.querySelector(".margin-percent-display");
      this.marginBar = this.querySelector(".margin-bar");
      this.saveBar = this.querySelector(".save-bar");
      this.btnSave = this.querySelector(".save-btn");
      this.deleteDialog = this.querySelector(".delete-dialog");
      this.btnDeleteCancel = this.querySelector(".delete-cancel-btn");
      this.btnDeleteConfirm = this.querySelector(".delete-confirm-btn");
      this.form = this.querySelector("form");

      this.multiplier = parseFloat(this.dataset.multiplier || "1");
      this.costoBatch = parseFloat(this.dataset.cost || "0");
      this.precioRecBatch = parseFloat(this.dataset.recommended || "0");

      this.btnEdit?.addEventListener("click", () => this.toggleEdit());
      this.btnDelete?.addEventListener("click", () => this.openDeleteDialog());
      this.btnDeleteCancel?.addEventListener("click", () =>
        this.closeDeleteDialog(),
      );
      this.btnDeleteConfirm?.addEventListener("click", () =>
        this.deletePresentation(),
      );
      this.inputUnits?.addEventListener("input", () => this.calculate());
      this.inputPrice?.addEventListener("input", () => {
        this.salePriceDirty = true;
        this.calculate();
      });

      if (this.deleteDialog) {
        bindDialogBackdrop(this.deleteDialog);
      }

      this.form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (this.btnSave) {
          this.btnSave.disabled = true;
          this.btnSave.classList.add("opacity-75", "cursor-not-allowed");
        }

        try {
          if (!this.form) return;

          const formData = new FormData(this.form);
          if (!this.salePriceDirty) {
            formData.delete("salePrice");
          }

          const response = await fetch(window.location.href, {
            method: "POST",
            headers: {
              Accept: "application/json",
            },
            body: formData,
          });

          if (response.redirected) {
            throw new Error(
              "Tu sesion expiro. Recarga la pagina e inicia sesion nuevamente.",
            );
          }

          if (!response.ok) {
            const message = (await response.text()).trim();
            throw new Error(message || "Hubo un error al guardar los cambios.");
          }

          const contentType = response.headers.get("content-type") || "";
          if (!contentType.includes("application/json")) {
            throw new Error("La respuesta del servidor no fue valida.");
          }

          const payload = await response.json().catch(() => null);
          if (!payload?.presentation) {
            throw new Error("La respuesta del servidor no fue valida.");
          }

          this.applyPresentation(payload.presentation);

          this.toggleEdit(true); // true = save changes
        } catch (error) {
          console.error(error);
          const message =
            error instanceof Error && error.message
              ? error.message
              : "Hubo un error al guardar los cambios.";
          alert(message);
        } finally {
          if (this.btnSave) {
            this.btnSave.disabled = false;
            this.btnSave.classList.remove("opacity-75", "cursor-not-allowed");
          }
        }
      });

      // Initial calculate
      this.calculate();
    }

    openDeleteDialog() {
      if (!(this.deleteDialog instanceof HTMLDialogElement)) return;

      if (!this.deleteDialog.open) {
        this.deleteDialog.showModal();
      }
    }

    closeDeleteDialog() {
      if (!(this.deleteDialog instanceof HTMLDialogElement)) return;

      if (this.deleteDialog.open) {
        this.deleteDialog.close();
      }
    }

    async deletePresentation() {
      if (!this.form) return;

      if (this.btnDelete) {
        this.btnDelete.disabled = true;
        this.btnDelete.classList.add("opacity-75", "cursor-not-allowed");
      }

      if (this.btnDeleteConfirm) {
        this.btnDeleteConfirm.disabled = true;
        this.btnDeleteConfirm.classList.add("opacity-75", "cursor-not-allowed");
      }

      try {
        const formData = new FormData(this.form);
        formData.set("action", "delete_presentation");

        const response = await fetch(window.location.href, {
          method: "POST",
          headers: {
            Accept: "application/json",
          },
          body: formData,
        });

        if (response.redirected) {
          throw new Error(
            "Tu sesion expiro. Recarga la pagina e inicia sesion nuevamente.",
          );
        }

        if (!response.ok) {
          const message = (await response.text()).trim();
          throw new Error(
            message || "Hubo un error al eliminar la presentación.",
          );
        }

        const contentType = response.headers.get("content-type") || "";
        if (!contentType.includes("application/json")) {
          throw new Error("La respuesta del servidor no fue valida.");
        }

        const payload = await response.json().catch(() => null);
        if (!payload?.deleted) {
          throw new Error("La respuesta del servidor no fue valida.");
        }

        this.closeDeleteDialog();
        this.remove();
      } catch (error) {
        console.error(error);
        const message =
          error instanceof Error && error.message
            ? error.message
            : "Hubo un error al eliminar la presentación.";
        alert(message);
      } finally {
        if (this.btnDelete) {
          this.btnDelete.disabled = false;
          this.btnDelete.classList.remove("opacity-75", "cursor-not-allowed");
        }

        if (this.btnDeleteConfirm) {
          this.btnDeleteConfirm.disabled = false;
          this.btnDeleteConfirm.classList.remove(
            "opacity-75",
            "cursor-not-allowed",
          );
        }
      }
    }

    applyPresentation(presentation) {
      const unitsPerBatch = Number(presentation?.unitsPerBatch ?? 0);
      const totalUnits = unitsPerBatch * this.multiplier;
      const hasUnits = totalUnits > 0;
      const recommendedPrice = hasUnits ? this.precioRecBatch / totalUnits : 0;
      const nextPrice =
        typeof presentation?.salePrice === "number"
          ? presentation.salePrice
          : recommendedPrice;

      if (this.inputName) this.inputName.value = presentation?.name || "";
      if (this.inputUnits)
        this.inputUnits.value = Number.isFinite(unitsPerBatch)
          ? String(unitsPerBatch)
          : "0";
      if (this.inputPrice) this.inputPrice.value = nextPrice.toFixed(2);
      this.syncPriceWidth(nextPrice.toFixed(2));

      this.dataset.units = Number.isFinite(unitsPerBatch)
        ? String(unitsPerBatch)
        : "0";
      this.dataset.price = nextPrice.toFixed(2);
      this.salePriceDirty = false;
      this.calculate();
    }

    toggleEdit(save = false) {
      this.isEditing = !this.isEditing;
      const inputs = [this.inputName, this.inputUnits, this.inputPrice];

      if (this.isEditing) {
        this.salePriceDirty = false;
        this.originalName = this.inputName?.value || "";
        this.originalUnits = this.inputUnits?.value || "0";
        this.originalPrice = this.inputPrice?.value || "0";

        inputs.forEach((input) => {
          if (input) {
            input.removeAttribute("readonly");
            input.classList.remove("border-transparent", "bg-transparent");
          }
        });

        if (this.btnEdit) {
          this.btnEdit.classList.add("bg-muted");
          this.btnEdit.setAttribute("title", "Cancelar");
          this.btnEdit.setAttribute("aria-label", "Cancelar edición");
          this.btnEdit.setAttribute("aria-pressed", "true");

          const pencilIcon = this.btnEdit.querySelector(".edit-icon-pencil");
          const cancelIcon = this.btnEdit.querySelector(".edit-icon-cancel");
          pencilIcon?.classList.add("hidden");
          cancelIcon?.classList.remove("hidden");
        }

        if (this.btnDelete) {
          this.btnDelete.classList.remove("hidden");
          this.btnDelete.classList.add("inline-flex");
        }

        if (this.saveBar) {
          this.saveBar.classList.remove("hidden");
        }

        this.inputPrice?.focus();
      } else {
        if (!save) {
          // Revert to original values if cancelled
          if (this.inputName) this.inputName.value = this.originalName;
          if (this.inputUnits) this.inputUnits.value = this.originalUnits;
          if (this.inputPrice) this.inputPrice.value = this.originalPrice;
          this.calculate();
        } else {
          // Commit changes
          this.originalName = this.inputName?.value || "";
          this.originalUnits = this.inputUnits?.value || "0";
          this.originalPrice = this.inputPrice?.value || "0";
        }

        inputs.forEach((input) => {
          if (input) {
            input.setAttribute("readonly", "true");
          }
        });

        if (this.btnEdit) {
          this.btnEdit.classList.remove("bg-muted");
          this.btnEdit.setAttribute("title", "Editar");
          this.btnEdit.setAttribute("aria-label", "Editar presentación");
          this.btnEdit.setAttribute("aria-pressed", "false");

          const pencilIcon = this.btnEdit.querySelector(".edit-icon-pencil");
          const cancelIcon = this.btnEdit.querySelector(".edit-icon-cancel");
          pencilIcon?.classList.remove("hidden");
          cancelIcon?.classList.add("hidden");
        }

        if (this.btnDelete) {
          this.btnDelete.classList.add("hidden");
          this.btnDelete.classList.remove("inline-flex");
        }

        if (this.saveBar) {
          this.saveBar.classList.add("hidden");
        }

        this.closeDeleteDialog();

        this.salePriceDirty = false;

        // Format price on blur
        if (this.inputPrice && this.inputPrice.value) {
          this.inputPrice.value = parseFloat(this.inputPrice.value).toFixed(2);
          this.syncPriceWidth(this.inputPrice.value);
        }
      }
    }

    syncPriceWidth(value = this.inputPrice?.value ?? "") {
      if (!this.inputPrice || !this.priceMeasure) {
        return;
      }

      const measuredValue = value.trim().length > 0 ? value.trim() : "0.00";
      this.priceMeasure.textContent = measuredValue;

      const measuredWidth = this.priceMeasure.getBoundingClientRect().width;
      const nextWidth = Math.max(Math.ceil(measuredWidth + 4), 28);

      this.inputPrice.style.width = `${nextWidth}px`;
    }

    calculate() {
      const unitsPerBatch = parseFloat(this.inputUnits?.value || "0");
      const salePriceValue = this.inputPrice?.value ?? "";

      const totalUnits = unitsPerBatch * this.multiplier;
      const hasUnits = totalUnits > 0;

      const unitCost = hasUnits ? this.costoBatch / totalUnits : 0;
      const unitPriceRecommended = hasUnits
        ? this.precioRecBatch / totalUnits
        : 0;
      const parsedSalePrice = parseFloat(salePriceValue || "0");
      const salePrice =
        salePriceValue.trim() === ""
          ? unitPriceRecommended
          : Number.isFinite(parsedSalePrice)
            ? parsedSalePrice
            : 0;

      this.syncPriceWidth(salePriceValue);

      const unitProfit = salePrice - unitCost;
      const marginPercent = salePrice > 0 ? (unitProfit / salePrice) * 100 : 0;
      const marginWidth = Math.min(Math.max(marginPercent, 0), 100);

      let marginLabel = "Margen negativo";
      let marginColor = "bg-danger-solid";
      let marginTextColor = "text-danger";

      if (marginPercent >= 35) {
        marginLabel = "Saludable";
        marginColor = "bg-success-solid";
        marginTextColor = "text-success";
      } else if (marginPercent >= 20) {
        marginLabel = "Medio";
        marginColor = "bg-warning-solid";
        marginTextColor = "text-warning";
      } else if (marginPercent >= 0) {
        marginLabel = "Bajo";
        marginColor = "bg-danger-solid";
        marginTextColor = "text-danger";
      }

      if (this.yieldValue)
        this.yieldValue.textContent = (
          Math.round(totalUnits * 100) / 100
        ).toString();
      if (this.unitCostDisplay)
        this.unitCostDisplay.textContent = "$" + unitCost.toFixed(2);
      if (this.recommendedPriceDisplay)
        this.recommendedPriceDisplay.textContent =
          "$" + unitPriceRecommended.toFixed(2);
      if (this.profitDisplay) {
        this.profitDisplay.textContent = "$" + unitProfit.toFixed(2);
        this.profitDisplay.className = `text-[22px] font-mono font-semibold tabular-nums profit-display ${marginTextColor}`;
      }
      if (this.marginPercentDisplay)
        this.marginPercentDisplay.textContent = marginPercent.toFixed(1) + "%";
      if (this.marginLabel) {
        this.marginLabel.textContent = marginLabel;
        this.marginLabel.className = `margin-label ${marginTextColor}`;
      }

      if (this.marginBar) {
        this.marginBar.style.width = marginWidth + "%";
        this.marginBar.className = `margin-bar h-full rounded-full transition-all duration-500 ${marginColor}`;
      }
    }
  }

  if (!customElements.get("presentation-card")) {
    customElements.define("presentation-card", PresentationCard);
  }
</script>
