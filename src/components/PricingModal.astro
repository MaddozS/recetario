---
import { Icon } from "astro-icon/components";
import { Badge, Button, Card } from "@/components/ui";
import type { PricingPlan } from "@/lib/db/billing";
import type { UserSubscriptionInfo } from "@/lib/subscription";

interface Props {
  plans: PricingPlan[];
  subscription: UserSubscriptionInfo;
}

const { plans, subscription } = Astro.props;
const currentTier = subscription.tier;
---

<dialog
  data-animated
  id="pricing-modal"
  class="backdrop:bg-backdrop/50 fixed inset-0 m-auto max-h-[90dvh] w-[calc(100vw-2rem)] max-w-5xl rounded-3xl p-0 shadow-2xl"
>
  <div class="bg-card max-h-[90dvh] overflow-auto rounded-3xl border border-border p-6 md:p-8">
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-foreground text-2xl font-black">Planes y precios</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Elige el plan que mejor se adapte a tu negocio.
        </p>
      </div>
      <Button
        variant="ghost"
        icon="x"
        data-close-pricing-modal
        ariaLabel="Cerrar"
      />
    </div>

    <div class="mb-6 flex justify-center">
      <div class="bg-muted inline-flex rounded-xl p-1" id="pricing-modal-toggle">
        <button
          type="button"
          data-modal-period="monthly"
          class="bg-card text-foreground rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition-all"
        >Mensual</button>
        <button
          type="button"
          data-modal-period="yearly"
          class="text-muted-foreground rounded-lg px-4 py-2 text-sm font-semibold transition-all"
        >Anual <span class="text-success text-xs font-bold">-20%</span></button>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        plans.map((plan) => {
          const isCurrent = plan.id === currentTier;
          const isFree = plan.id === "free";

          let buttonLabel = "Suscribirse";
          if (isCurrent) buttonLabel = "Plan actual";
          else if (plan.id === "pro" && currentTier === "basic") buttonLabel = "Actualizar a Pro";
          else if (plan.id === "free") buttonLabel = "Plan actual";

          return (
            <Card
              padding="md"
              class:list={[
                "flex flex-col",
                plan.id === "pro"
                  ? "border-accent-300 ring-accent-200 ring-1"
                  : "",
              ]}
            >
              {plan.badge && (
                <Badge
                  variant="tier"
                  color={plan.id === "pro" ? "accent" : "success"}
                  class="mb-3 self-start"
                >
                  {plan.badge.text}
                </Badge>
              )}

              <h3 class="text-foreground text-lg font-black">{plan.name}</h3>
              <p class="text-muted-foreground mt-1 text-sm">{plan.description}</p>

              <div class="mt-3">
                <div data-modal-price data-plan={plan.id}>
                  <div data-modal-price-view="monthly">
                    {isFree ? (
                      <p class="text-foreground text-2xl font-black">Gratis</p>
                    ) : (
                      <>
                        <p class="text-foreground text-2xl font-black whitespace-nowrap">
                          {plan.currency} <span class="font-mono tabular-nums">{plan.monthlyDisplay}</span>
                          <span class="text-subtle-foreground text-sm font-semibold">/mes</span>
                        </p>
                        <p class="text-subtle-foreground mt-0.5 text-xs">Facturado mensualmente</p>
                      </>
                    )}
                  </div>
                  <div data-modal-price-view="yearly" class="hidden">
                    {!isFree ? (
                      <>
                        <p class="text-foreground text-2xl font-black whitespace-nowrap">
                          {plan.currency} <span class="font-mono tabular-nums">{plan.yearlyPerMonthDisplay}</span>
                          <span class="text-subtle-foreground text-sm font-semibold">/mes</span>
                        </p>
                        <p class="text-subtle-foreground mt-0.5 text-xs">
                          {plan.currency} <span class="font-mono tabular-nums">{plan.yearlyDisplay}</span> facturados anualmente
                        </p>
                      </>
                    ) : (
                      <p class="text-foreground text-2xl font-black">Gratis</p>
                    )}
                  </div>
                </div>
              </div>

              <div class="mt-4">
                <Button
                  variant={plan.id === "pro" ? "primary" : "secondary"}
                  size="sm"
                  data-subscribe-btn
                  data-plan={plan.id}
                  data-price-id-monthly={plan.monthlyPriceId ?? ""}
                  data-price-id-yearly={plan.yearlyPriceId ?? ""}
                  disabled={isCurrent || isFree}
                  class="w-full"
                >
                  {buttonLabel}
                </Button>
              </div>

              <div class="mt-4 flex-1 space-y-2">
                {plan.features.map((feature) => {
                  const isComingSoon = feature.status === "coming_soon";
                  const icon = isComingSoon
                    ? "lucide:clock"
                    : feature.included
                      ? "lucide:check"
                      : "lucide:x";
                  const iconClass = isComingSoon
                    ? "text-subtle-foreground"
                    : feature.included
                      ? "text-success"
                      : "text-subtle-foreground";
                  const textClass = isComingSoon
                    ? "text-subtle-foreground"
                    : feature.included
                      ? "text-secondary-foreground"
                      : "text-subtle-foreground";
                  return (
                  <div class="flex items-center gap-2 text-sm">
                    <Icon
                      name={icon}
                      size={14}
                      class:list={[iconClass]}
                    />
                    <span
                      class:list={[textClass]}
                    >
                      {feature.text}
                    </span>
                  </div>
                  );
                })}
              </div>
            </Card>
          );
        })
      }
    </div>

    <div
      id="pricing-modal-error"
      class="border-danger-border bg-danger-bg text-danger mt-4 hidden rounded-xl border p-3 text-sm font-semibold"
      role="alert"
    >
      <p id="pricing-modal-error-msg"></p>
    </div>
  </div>
</dialog>

<script>
  function setupPricingModal() {
    const modal = document.getElementById("pricing-modal");
    const openBtns = document.querySelectorAll("[data-open-pricing-modal]");
    const closeBtns = document.querySelectorAll("[data-close-pricing-modal]");

    if (!(modal instanceof HTMLDialogElement)) return;

    let activePeriod: "monthly" | "yearly" = "monthly";

    const toggle = document.getElementById("pricing-modal-toggle");

    function updateToggleUI() {
      if (!toggle) return;
      const monthlyBtn = toggle.querySelector('[data-modal-period="monthly"]');
      const yearlyBtn = toggle.querySelector('[data-modal-period="yearly"]');
      if (!(monthlyBtn instanceof HTMLButtonElement) || !(yearlyBtn instanceof HTMLButtonElement)) return;

      if (activePeriod === "monthly") {
        monthlyBtn.className = "px-4 py-2 rounded-lg text-sm font-semibold bg-card text-foreground shadow-sm transition-all";
        yearlyBtn.className = "px-4 py-2 rounded-lg text-sm font-semibold text-muted-foreground transition-all";
      } else {
        yearlyBtn.className = "px-4 py-2 rounded-lg text-sm font-semibold bg-card text-foreground shadow-sm transition-all";
        monthlyBtn.className = "px-4 py-2 rounded-lg text-sm font-semibold text-muted-foreground transition-all";
      }

      document.querySelectorAll("[data-modal-price-view]").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        if (el.dataset.modalPriceView === activePeriod) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      });
    }

    toggle?.querySelector('[data-modal-period="monthly"]')?.addEventListener("click", () => {
      activePeriod = "monthly";
      updateToggleUI();
    });

    toggle?.querySelector('[data-modal-period="yearly"]')?.addEventListener("click", () => {
      activePeriod = "yearly";
      updateToggleUI();
    });

    openBtns.forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.pricingModalBound === "1") return;
      btn.dataset.pricingModalBound = "1";
      btn.addEventListener("click", () => {
        activePeriod = "monthly";
        updateToggleUI();
        if (!modal.open) modal.showModal();
      });
    });

    closeBtns.forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.pricingModalCloseBound === "1") return;
      btn.dataset.pricingModalCloseBound = "1";
      btn.addEventListener("click", () => {
        if (modal.open) modal.close();
      });
    });

    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    document.querySelectorAll("#pricing-modal [data-subscribe-btn]").forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.subscribeBound === "1") return;
      btn.dataset.subscribeBound = "1";

      btn.addEventListener("click", async () => {
        if (btn.disabled) return;

        const plan = btn.dataset.plan;
        if (plan === "free") return;

        const priceId = activePeriod === "monthly"
          ? btn.dataset.priceIdMonthly
          : btn.dataset.priceIdYearly;

        if (!priceId) {
          alert("Precio no configurado para este plan.");
          return;
        }

        const successUrl = `${window.location.origin}/settings/billing?success=1`;
        const cancelUrl = `${window.location.origin}/settings/billing?canceled=1`;

        btn.disabled = true;
        const originalText = btn.textContent;
        btn.textContent = "Redirigiendo...";

        try {
          const csrfToken = document.cookie
            .split("; ")
            .find((row) => row.startsWith("csrf_token="))
            ?.split("=")[1];

          const headers: Record<string, string> = {
            "Content-Type": "application/json",
          };
          if (csrfToken) headers["x-csrf-token"] = csrfToken;

          const res = await fetch("/api/stripe/checkout", {
            method: "POST",
            headers,
            body: JSON.stringify({ priceId, successUrl, cancelUrl }),
          });

          const data = await res.json();
          if (data.url) {
            window.location.href = data.url;
          } else {
            throw new Error(data.error || "Error desconocido");
          }
        } catch (err) {
          btn.disabled = false;
          btn.textContent = originalText;
          const errorEl = document.getElementById("pricing-modal-error");
          const errorMsg = document.getElementById("pricing-modal-error-msg");
          if (errorEl && errorMsg) {
            errorMsg.textContent = err instanceof Error ? err.message : "No se pudo iniciar el pago";
            errorEl.classList.remove("hidden");
            setTimeout(() => errorEl.classList.add("hidden"), 6000);
          }
        }
      });
    });
  }

  document.addEventListener("astro:page-load", setupPricingModal);
  document.addEventListener("astro:after-swap", setupPricingModal);
  setupPricingModal();
</script>
