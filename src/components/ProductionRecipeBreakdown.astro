---
import { Icon } from "astro-icon/components";
import { Badge, SectionHeading } from "@/components/ui";
import type { ProductionRecipeResult } from "@/lib/production-types";
import { formatCurrency } from "@/lib/formatters";

interface Props {
  recipes: ProductionRecipeResult[];
}

const { recipes } = Astro.props;

function marginColor(margin: number): string {
  if (margin > 30) return "text-success";
  if (margin > 15) return "text-warning";
  return "text-danger";
}

function getBestPresentationId(
  presentations: ProductionRecipeResult["presentations"],
  totalCost: number,
): number {
  return presentations.reduce(
    (best, p) => {
      if (!p.revenue || p.revenue <= 0 || totalCost <= 0) return best;
      const m = ((p.revenue - totalCost) / p.revenue) * 100;
      return m > best.margin ? { id: p.id, margin: m } : best;
    },
    { id: -1, margin: -Infinity },
  ).id;
}

function getPresentationMargin(
  p: ProductionRecipeResult["presentations"][number],
  totalCost: number,
): number | null {
  if (!p.revenue || p.revenue <= 0 || totalCost <= 0) return null;
  return ((p.revenue - totalCost) / p.revenue) * 100;
}

type ProcessedRecipe = ProductionRecipeResult & {
  bestPresentationId: number;
  processedPresentations: Array<{
    id: number;
    name: string;
    totalUnits: number;
    unitCost: number;
    salePrice?: number;
    revenue: number;
    margin: number | null;
    isSelected: boolean;
    isBest: boolean;
  }>;
};

const processedRecipes: ProcessedRecipe[] = recipes.map((recipe) => {
  const bestId = getBestPresentationId(recipe.presentations, recipe.totalCost);
  return {
    ...recipe,
    bestPresentationId: bestId,
    processedPresentations: recipe.presentations.map((p) => ({
      ...p,
      margin: getPresentationMargin(p, recipe.totalCost),
      isSelected: p.id === recipe.selectedPresentationId,
      isBest: p.id === bestId,
    })),
  };
});
---

<div class="production-sheet recipe-breakdown space-y-4">
  <SectionHeading icon="list-tree" title="Desglose por receta" />

  {
    processedRecipes.map((recipe) => (
      <details class="border-border bg-card overflow-hidden rounded-2xl border shadow-sm">
        <summary class="hover:bg-muted flex cursor-pointer items-center justify-between gap-4 px-6 py-4 transition-colors">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="text-foreground truncate text-base font-bold">
                {recipe.recipeName}
              </h3>
              {recipe.category && (
                <Badge variant="category" color="neutral" size="md">
                  {recipe.category}
                </Badge>
              )}
            </div>
            <p class="text-muted-foreground mt-0.5 text-xs">
              {recipe.batches} batch{recipe.batches !== 1 ? "es" : ""}· Insumos:{" "}
              {formatCurrency(recipe.ingredientsCost)}· Operativo:{" "}
              {formatCurrency(recipe.operationalCost)}· Total:{" "}
              {formatCurrency(recipe.totalCost)}
            </p>
          </div>
          <Icon
            name="lucide:chevron-down"
            size={18}
            class="text-subtle-foreground shrink-0"
          />
        </summary>

        <div class="space-y-6 px-6 pb-6">
          <div>
            <h4 class="text-muted-foreground mb-3 text-xs font-bold tracking-[0.16em] uppercase">
              Costos
            </h4>
            <div class="grid grid-cols-3 gap-3">
              <div class="bg-muted/40 rounded-xl p-3 border-l-[3px] border-l-danger-solid/60">
                <p class="text-muted-foreground text-[11px] font-semibold">
                  Insumos
                </p>
                <p class="text-foreground mt-1 text-lg font-bold tabular-nums">
                  {formatCurrency(recipe.ingredientsCost)}
                </p>
              </div>
              <div class="bg-muted/40 rounded-xl p-3 border-l-[3px] border-l-muted-foreground/30">
                <p class="text-muted-foreground text-[11px] font-semibold">
                  Operativo
                </p>
                <p class="text-foreground mt-1 text-lg font-bold tabular-nums">
                  {formatCurrency(recipe.operationalCost)}
                </p>
              </div>
              <div class="bg-muted/40 rounded-xl p-3 border-l-[3px] border-l-accent-400/60">
                <p class="text-muted-foreground text-[11px] font-semibold">
                  Total
                </p>
                <p class="text-foreground mt-1 text-lg font-bold tabular-nums">
                  {formatCurrency(recipe.totalCost)}
                </p>
              </div>
            </div>
          </div>

          {recipe.presentations.length > 0 ? (
            <div>
              <h4 class="text-muted-foreground mb-3 text-xs font-bold tracking-[0.16em] uppercase">
                Presentaciones
              </h4>
              <div class="border-border overflow-x-auto rounded-xl border">
                <table class="min-w-full text-left text-sm">
                  <thead class="bg-background text-muted-foreground text-[11px] font-bold tracking-[0.16em] uppercase">
                    <tr>
                      <th class="px-4 py-3">Presentación</th>
                      <th class="px-4 py-3">Unidades totales</th>
                      <th class="px-4 py-3">Costo unitario</th>
                      <th class="px-4 py-3">Precio venta</th>
                      <th class="px-4 py-3">Ingreso</th>
                      <th class="px-4 py-3">Margen</th>
                    </tr>
                  </thead>
                  <tbody class="divide-border-light divide-y">
                    {recipe.processedPresentations.map((p) => (
                      <tr
                        class:list={[
                          "hover:bg-hover-muted dark:hover:bg-hover-muted",
                          p.isSelected ? "bg-accent-50/50" : "",
                        ]}
                      >
                        <td class="text-foreground px-4 py-3 align-top font-medium">
                          <div class="text-foreground font-medium">
                            {p.name}
                          </div>
                          <div class="mt-1 flex flex-wrap gap-1">
                            {p.isSelected && (
                              <span class="bg-accent-100 text-accent-700 border-accent-200 inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold whitespace-nowrap">
                                Seleccionada
                              </span>
                            )}
                            {p.isBest && p.margin !== null && (
                              <span class="bg-success-bg text-success border-success-border inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold whitespace-nowrap">
                                Más rentable
                              </span>
                            )}
                          </div>
                        </td>
                        <td class="text-secondary-foreground px-4 py-3 font-mono tabular-nums">
                          {p.totalUnits}
                        </td>
                        <td class="text-secondary-foreground px-4 py-3 font-mono tabular-nums">
                          {formatCurrency(p.unitCost)}
                        </td>
                        <td class="px-4 py-3 font-mono tabular-nums">
                          {p.salePrice ? (
                            <span class="text-secondary-foreground">
                              {formatCurrency(p.salePrice)}
                            </span>
                          ) : (
                            <span class="text-warning">Sin precio</span>
                          )}
                        </td>
                        <td class="text-foreground px-4 py-3 font-mono font-semibold tabular-nums">
                          {p.revenue > 0 ? (
                            formatCurrency(p.revenue)
                          ) : (
                            <span class="text-warning">Sin precio</span>
                          )}
                        </td>
                        <td class="px-4 py-3 font-mono font-semibold tabular-nums">
                          {p.margin !== null ? (
                            <span class:list={[marginColor(p.margin)]}>
                              {p.margin.toFixed(1)}%
                            </span>
                          ) : (
                            <span class="text-muted-foreground">—</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ) : (
            <div class="bg-muted rounded-xl p-4 text-center">
              <p class="text-muted-foreground text-sm">
                Sin presentaciones configuradas
              </p>
            </div>
          )}
        </div>
      </details>
    ))
  }
</div>
