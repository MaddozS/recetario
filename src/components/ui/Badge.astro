---
interface Props {
  variant?: "category" | "tier" | "outline" | "status";
  color?: "accent" | "success" | "danger" | "warning" | "neutral";
  size?: "sm" | "md";
  class?: string;
}

const {
  variant = "category",
  color = "accent",
  size = "sm",
  class: extraClass = "",
} = Astro.props;

const base = "inline-flex items-center whitespace-nowrap font-bold";

const sizeClasses: Record<string, string> = {
  sm: "text-[10px] px-2 py-0.5",
  md: "text-[11px] px-2.5 py-0.5",
};

const colorTokens: Record<
  string,
  { bg: string; text: string; border: string }
> = {
  accent: {
    bg: "bg-accent-100",
    text: "text-accent-700",
    border: "border-accent-200",
  },
  success: {
    bg: "bg-success-bg",
    text: "text-success",
    border: "border-success-border",
  },
  danger: {
    bg: "bg-danger-bg",
    text: "text-danger",
    border: "border-danger-border",
  },
  warning: {
    bg: "bg-warning-bg",
    text: "text-warning",
    border: "border-warning-border",
  },
  neutral: {
    bg: "bg-muted",
    text: "text-muted-foreground",
    border: "border-border",
  },
};

const variantClasses: Record<string, string> = {
  category: "rounded-full",
  tier: "rounded-full",
  outline: "rounded-lg",
  status: "rounded-full",
};

const c = colorTokens[color];
const variantCls = variantClasses[variant];
---

<span
  class:list={[
    base,
    sizeClasses[size],
    c.bg,
    c.text,
    c.border,
    variantCls,
    extraClass,
  ]}
>
  <slot />
</span>
