---
interface Props {
  label?: string;
  name: string;
  id?: string;
  type?: "text" | "number" | "email" | "password" | "search";
  placeholder?: string;
  required?: boolean;
  error?: string;
  monospace?: boolean;
  class?: string;
}

const {
  label,
  name,
  id,
  type = "text",
  placeholder = "",
  required = false,
  error,
  monospace = false,
  class: extraClass = "",
} = Astro.props;

const inputId = id || name;
const labelClasses =
  "text-muted-foreground mb-1.5 block text-[11px] font-bold uppercase tracking-[0.18em]";
const inputBase =
  "w-full rounded-xl border border-border bg-background px-4 py-3 text-sm outline-none transition placeholder:text-subtle-foreground focus:border-accent-300 focus:bg-card focus:ring-2 focus:ring-accent-500/20";
const monoClass = monospace ? "font-mono" : "text-foreground";
const errorClass = error ? "border-danger-border bg-danger-bg/50" : "";
---

<div>
  {
    label && (
      <label class={labelClasses} for={inputId}>
        {label}
        {required && <span class="text-danger"> *</span>}
      </label>
    )
  }
  <input
    id={inputId}
    name={name}
    type={type}
    required={required}
    placeholder={placeholder}
    class:list={[inputBase, monoClass, errorClass, extraClass]}
    autocomplete="off"
  />
  {error && <p class="text-danger mt-1.5 text-xs font-semibold">{error}</p>}
</div>
