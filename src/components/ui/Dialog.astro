---
interface Props {
  id: string;
  title?: string;
  description?: string;
  class?: string;
}

const { id, title, description, class: extraClass = "" } = Astro.props;
---

<dialog
  id={id}
  data-animated
  class:list={[
    "backdrop:bg-backdrop/50 fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0",
    extraClass,
  ]}
>
  <div class="border-border bg-card rounded-3xl border p-6 shadow-2xl">
    {
      title && (
        <div class="mb-4">
          <h2 class="text-foreground text-lg font-bold">{title}</h2>
          {description && (
            <p class="text-muted-foreground mt-1 text-sm">{description}</p>
          )}
        </div>
      )
    }
    <slot />
  </div>
</dialog>
