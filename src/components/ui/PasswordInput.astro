---
interface Props {
  id: string;
  label: string;
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  minlength?: number;
  showRequired?: boolean;
}

const {
  id,
  label,
  placeholder = "",
  autocomplete = "off",
  required = false,
  minlength,
  showRequired = true,
} = Astro.props;
---

<div>
  <label
    for={id}
    class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
  >
    {label}{required && showRequired && <span class="text-danger"> *</span>}
  </label>
  <div class="relative">
    <input
      {id}
      type="password"
      {required}
      {minlength}
      class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 pr-11 text-sm transition outline-none focus:ring-2"
      {placeholder}
      {autocomplete}
    />
    <button
      type="button"
      data-pw-toggle={id}
      class="text-muted-foreground hover:text-foreground absolute top-1/2 right-3 flex -translate-y-1/2 cursor-pointer items-center"
      aria-label="Mostrar contraseña"
      tabindex="-1"
    >
      <svg
        data-pw-eye
        class="h-[18px] w-[18px]"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg
      >
      <svg
        data-pw-eye-off
        class="hidden h-[18px] w-[18px]"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path
          d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"
        ></path><path
          d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"
        ></path><line x1="2" x2="22" y1="2" y2="22"></line></svg
      >
    </button>
  </div>
</div>
