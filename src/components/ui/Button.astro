---
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "primary" | "secondary" | "danger" | "ghost";
  size?: "sm" | "md" | "lg";
  href?: string;
  icon?: string;
  type?: "button" | "submit";
  disabled?: boolean;
  loading?: boolean;
  id?: string;
  ariaLabel?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  href,
  icon,
  type = "button",
  disabled = false,
  loading = false,
  id,
  ariaLabel,
  class: extraClass = "",
  ...attrs
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-bold transition-colors focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-70 cursor-pointer";

const variantClasses: Record<string, string> = {
  primary: "bg-accent-600 text-white hover:bg-accent-700 rounded-xl shadow-sm",
  secondary:
    "border border-border bg-card text-muted-foreground hover:bg-background rounded-xl",
  danger: "bg-danger-solid text-white hover:bg-danger-hover rounded-xl",
  ghost:
    "text-muted-foreground hover:bg-muted hover:text-secondary-foreground rounded-xl",
};

const sizeClasses: Record<string, string> = {
  sm: "min-h-10 px-4 py-2 text-xs",
  md: "min-h-11 px-5 py-3 text-sm",
  lg: "min-h-12 px-6 py-3.5 text-sm",
};

const paddingOnly = variant === "ghost" ? "px-2 py-2" : "";
---

{
  href ? (
    <a
      href={href}
      id={id}
      aria-label={ariaLabel}
      class={`${base} ${variantClasses[variant]} ${sizeClasses[size]} ${paddingOnly} ${extraClass}`}
      {...attrs}
    >
      {icon && <Icon name={`lucide:${icon}`} size={size === "sm" ? 14 : 16} />}
      <slot />
    </a>
  ) : (
    <button
      type={type}
      id={id}
      aria-label={ariaLabel}
      disabled={disabled || loading}
      class={`${base} ${variantClasses[variant]} ${sizeClasses[size]} ${paddingOnly} ${extraClass}`}
      aria-busy={loading ? "true" : undefined}
      {...attrs}
    >
      {loading ? (
        <svg
          class="h-4 w-4 animate-[sp_0.7s_linear_infinite]"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12a9 9 0 1 1-6.219-8.56" />
        </svg>
      ) : icon ? (
        <Icon name={`lucide:${icon}`} size={size === "sm" ? 14 : 16} />
      ) : null}
      <slot />
    </button>
  )
}
