---
import type { ConsolidatedIngredient } from "../lib/production-types";
import { formatCurrency } from "../lib/formatters";

interface Props {
  ingredients: ConsolidatedIngredient[];
}

const { ingredients } = Astro.props;

const formatQuantity = (value: number): string => {
  if (value < 1) return value.toFixed(3);
  if (Number.isInteger(value)) return String(value);
  return value.toFixed(2);
};

const formatQuantityWithConversion = (value: number, unit: string): string => {
  const u = unit.toLowerCase();
  if (u === "kg") {
    return `${formatQuantity(value)} kg (${formatQuantity(value * 1000)} g)`;
  }
  if (u === "lt") {
    return `${formatQuantity(value)} lt (${formatQuantity(value * 1000)} ml)`;
  }
  return `${formatQuantity(value)} ${unit}`;
};
---

<div class="production-sheet ingredients-table rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
  <div class="border-b border-border px-6 py-4">
    <h2 class="text-lg font-bold text-foreground">
      Ingredientes consolidados
    </h2>
    <p class="text-sm text-muted-foreground mt-0.5">
      {ingredients.length} ingrediente{ingredients.length !== 1 ? "s" : ""} en total
    </p>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full text-left">
      <thead class="bg-background text-[11px] font-bold uppercase tracking-[0.16em] text-muted-foreground">
        <tr>
          <th class="px-6 py-4">Ingrediente</th>
          <th class="px-6 py-4" colspan="2">Cantidad total</th>
          <th class="px-6 py-4">Costo unitario</th>
          <th class="px-6 py-4">Costo total</th>
          <th class="px-6 py-4">Recetas</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border-light dark:divide-gray-950">
        {ingredients.map((ing) => (
          <tr class="transition-colors hover:bg-hover-muted dark:hover:bg-gray-950/70">
            <td class="px-6 py-4">
              <div>
                <p class="font-semibold text-foreground">{ing.name}</p>
                {ing.brand && (
                  <p class="text-xs text-subtle-foreground mt-0.5">
                    {ing.brand}{ing.supplier ? ` · ${ing.supplier}` : ""}
                  </p>
                )}
              </div>
            </td>
            <td class="px-6 py-4 font-mono font-semibold tabular-nums text-secondary-foreground whitespace-nowrap" colspan="2">
              {formatQuantityWithConversion(ing.totalQuantity, ing.unit)}
            </td>
            <td class="px-6 py-4 font-mono text-sm tabular-nums text-secondary-foreground">
              {formatCurrency(ing.unitCost)}/{ing.unit}
            </td>
            <td class="px-6 py-4 font-mono font-semibold tabular-nums text-foreground">
              {formatCurrency(ing.totalCost)}
            </td>
            <td class="px-6 py-4">
              <div class="flex flex-wrap gap-1.5">
                {ing.sourceRecipes.map((src) => (
                  <span class="inline-flex items-center gap-1 rounded-lg bg-muted px-2 py-1 text-xs font-medium text-secondary-foreground">
                    {src.recipeName}
                    <span class="text-subtle-foreground">
                      ({src.quantity < 1
                        ? src.quantity.toFixed(2)
                        : Number.isInteger(src.quantity)
                          ? src.quantity
                          : src.quantity.toFixed(1)}{" "}
                      {ing.unit})
                    </span>
                  </span>
                ))}
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
