---
import { Icon } from "astro-icon/components";
import { hasFeature } from "@/lib/subscription";

const {
  currentPage,
  showMenuButton,
  isAuthenticated = false,
  recipeHref = "/recipes",
  subscription = null,
} = Astro.props;

const showProduction =
  subscription && hasFeature(subscription, "production_planner");
---

<header
  class="bg-card border-border relative z-10 flex flex-none items-center gap-3 border-b px-4 py-3 md:gap-4 md:px-6 md:py-4"
  transition:animate="none"
>
  <div class="flex min-w-0 flex-1 items-center gap-3 md:gap-4">
    {
      showMenuButton && (
        <button
          id="mobile-menu-btn"
          class="text-muted-foreground hover:text-secondary-foreground border-border hover:bg-background rounded-xl border p-2 transition-colors lg:hidden"
          aria-label="Abrir menú"
        >
          <Icon name="lucide:menu" size={20} />
        </button>
      )
    }
    <img
      src="/kitchcalc_logo.svg"
      alt="KitchCalc"
      class="shadow-accent-100 h-9 w-9 rounded-xl shadow-md sm:h-10 sm:w-10"
    />
    <div>
      <h1 class="text-foreground text-lg leading-tight font-bold sm:text-xl">
        KitchCalc
      </h1>
      <p class="text-muted-foreground text-[10px] font-medium sm:text-xs">
        Costeo Inteligente
      </p>
    </div>
  </div>
  <div class="bg-muted/50 border-border hidden rounded-xl border p-1.5 lg:flex">
    <a
      href={recipeHref}
      class:list={[
        "flex items-center gap-2 rounded-lg px-5 py-2 text-sm font-semibold transition-all",
        currentPage === "recipes"
          ? "bg-accent-600 text-white shadow-sm"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
    >
      <Icon
        name="lucide:book-open"
        size={18}
        class={currentPage === "recipes"
          ? "text-white"
          : "text-subtle-foreground"}
      />
      Recetario
    </a>
    <a
      href="/ingredients"
      class:list={[
        "flex items-center gap-2 rounded-lg px-5 py-2 text-sm font-semibold transition-all",
        currentPage === "ingredients"
          ? "bg-accent-600 text-white shadow-sm"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
    >
      <Icon
        name="lucide:shopping-cart"
        size={18}
        class={currentPage === "ingredients"
          ? "text-white"
          : "text-subtle-foreground"}
      />
      Ingredientes
    </a>
    {
      showProduction && (
        <a
          href="/produccion"
          class:list={[
            "flex items-center gap-2 rounded-lg px-5 py-2 text-sm font-semibold transition-all",
            currentPage === "production"
              ? "bg-accent-600 text-white shadow-sm"
              : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
          ]}
        >
          <Icon
            name="lucide:factory"
            size={18}
            class={
              currentPage === "production"
                ? "text-white"
                : "text-subtle-foreground"
            }
          />
          Producción
        </a>
      )
    }
    <a
      href="/settings"
      class:list={[
        "flex items-center gap-2 rounded-lg px-5 py-2 text-sm font-semibold transition-all",
        currentPage === "settings"
          ? "bg-accent-600 text-white shadow-sm"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
    >
      <Icon
        name="lucide:settings"
        size={18}
        class={currentPage === "settings"
          ? "text-white"
          : "text-subtle-foreground"}
      />
      Ajustes
    </a>
  </div>
  {
    isAuthenticated && (
      <div class="ml-auto flex shrink-0 items-center justify-end gap-2 sm:gap-3">
        {subscription && (
          <span class="bg-accent-100 text-accent-700 border-accent-200 hidden items-center rounded-full border px-2.5 py-1 text-xs font-bold sm:inline-flex">
            {subscription.tier === "free"
              ? "Free"
              : subscription.tier === "basic"
                ? "Basic"
                : "Pro"}
          </span>
        )}
        <button
          id="sign-out-button"
          type="button"
          class="border-border bg-card text-muted-foreground hover:border-border hover:bg-background hover:text-foreground inline-flex items-center gap-2 rounded-xl border px-3 py-2 text-sm font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-70"
          aria-label="Cerrar sesión"
        >
          <Icon name="lucide:log-out" size={16} />
          <span data-sign-out-label class="hidden sm:inline">
            Cerrar sesión
          </span>
        </button>
      </div>
    )
  }
</header>

<script>
  import { signOut } from "@/lib/sign-out";

  function setupSignOut() {
    const button = document.getElementById("sign-out-button");

    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    if (button.dataset.signOutBound === "1") {
      return;
    }

    button.dataset.signOutBound = "1";

    const label = button.querySelector("[data-sign-out-label]");
    const defaultLabel = label?.textContent ?? "Cerrar sesión";

    const setPendingState = (isPending: boolean) => {
      button.disabled = isPending;
      button.setAttribute("aria-busy", isPending ? "true" : "false");

      if (label instanceof HTMLElement) {
        label.textContent = isPending ? "Cerrando..." : defaultLabel;
      }
    };

    button.addEventListener("click", async () => {
      if (button.disabled) {
        return;
      }

      setPendingState(true);

      const overlay = document.createElement("div");
      overlay.id = "sign-out-overlay";
      overlay.style.cssText =
        "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(2px)";
      overlay.innerHTML = `<style>@keyframes sp{to{rotate:360deg}}</style><div style="background:var(--color-card,#fff);border-radius:1rem;padding:2rem 2.5rem;display:flex;flex-direction:column;align-items:center;gap:0.75rem;box-shadow:0 20px 60px rgba(0,0,0,0.15)">
        <svg style="animation:sp 0.7s linear infinite;width:28px;height:28px;color:var(--color-accent-600,#4f46e5)" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <span style="font-size:0.875rem;font-weight:600;color:var(--color-foreground,#0f172a)">Cerrando sesi\u00f3n\u2026</span>
        </div>`;
      document.body.appendChild(overlay);
      document.body.style.overflow = "hidden";

      try {
        await signOut();
        window.location.assign("/sign-in");
      } catch (error) {
        overlay.remove();
        document.body.style.overflow = "";
        setPendingState(false);
        console.error("Sign-out failed:", error);
        window.alert("No se pudo cerrar sesión. Inténtalo de nuevo.");
      }
    });
  }

  document.addEventListener("astro:page-load", setupSignOut);
  document.addEventListener("astro:after-swap", setupSignOut);
  setupSignOut();
</script>
