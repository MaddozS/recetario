---
import { Icon } from "astro-icon/components";
// Check current page
const {
  currentPage,
  showMenuButton,
  isAuthenticated = false,
  recipeHref = "/recipes",
} = Astro.props;
---

<header
  class="flex-none flex items-center gap-3 md:gap-4 bg-white px-4 md:px-6 py-3 md:py-4 border-b border-slate-200 z-10 relative"
  transition:animate="none"
>
  <div class="flex min-w-0 flex-1 items-center gap-3 md:gap-4">
    {
      showMenuButton && (
        <button
          id="mobile-menu-btn"
          class="lg:hidden text-slate-500 hover:text-slate-700 border border-slate-200 hover:bg-slate-50 p-2 rounded-xl transition-colors"
          aria-label="Abrir menú"
        >
          <Icon name="lucide:menu" size={20} />
        </button>
      )
    }
    <div
      class="bg-accent-600 p-2 sm:p-2.5 rounded-xl text-white shadow-md shadow-accent-100"
    >
      <Icon name="lucide:chef-hat" class="w-6 h-6 sm:w-7 sm:h-7" />
    </div>
    <div>
      <h1 class="text-lg sm:text-xl font-bold text-slate-800 leading-tight">
        KitchCalc
      </h1>
      <p class="text-slate-500 text-[10px] sm:text-xs font-medium">
        Costeo Inteligente
      </p>
    </div>
  </div>
  <div
    class="hidden lg:flex bg-slate-100/50 rounded-xl p-1.5 border border-slate-200"
  >
    <a
      href={recipeHref}
      class:list={[
        "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all",
        currentPage === "recipes"
          ? "bg-white shadow-sm border border-slate-200/60 text-accent-700 dark:text-accent-600"
          : "text-slate-500 hover:text-slate-700 hover:bg-slate-100 dark:text-zinc-400 dark:hover:text-zinc-200 dark:hover:bg-zinc-800/60",
      ]}
    >
      <Icon
        name="lucide:book-open"
        size={18}
        class={currentPage === "recipes" ? "text-accent-600" : "text-slate-400"}
      />
      Recetario
    </a>
    <a
      href="/ingredients"
      class:list={[
        "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all",
        currentPage === "ingredients"
          ? "bg-white shadow-sm border border-slate-200/60 text-accent-700 dark:text-accent-600"
          : "text-slate-500 hover:text-slate-700 hover:bg-slate-100 dark:text-zinc-400 dark:hover:text-zinc-200 dark:hover:bg-zinc-800/60",
      ]}
    >
      <Icon
        name="lucide:shopping-cart"
        size={18}
        class={currentPage === "ingredients"
          ? "text-accent-600"
          : "text-slate-400"}
      />
      Ingredientes
    </a>
    <a
      href="/settings"
      class:list={[
        "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all",
        currentPage === "settings"
          ? "bg-white shadow-sm border border-slate-200/60 text-accent-700 dark:text-accent-600"
          : "text-slate-500 hover:text-slate-700 hover:bg-slate-100 dark:text-zinc-400 dark:hover:text-zinc-200 dark:hover:bg-zinc-800/60",
      ]}
    >
      <Icon
        name="lucide:settings"
        size={18}
        class={currentPage === "settings"
          ? "text-accent-600"
          : "text-slate-400"}
      />
      Ajustes
    </a>
  </div>
  {
    isAuthenticated && (
      <div class="ml-auto flex shrink-0 items-center justify-end gap-2 sm:gap-3">
        <button
          id="sign-out-button"
          type="button"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-800 disabled:cursor-not-allowed disabled:opacity-70 dark:hover:bg-zinc-800/60 dark:hover:text-zinc-200 dark:hover:border-zinc-600"
          aria-label="Cerrar sesión"
        >
          <Icon name="lucide:log-out" size={16} />
          <span data-sign-out-label class="hidden sm:inline">
            Cerrar sesión
          </span>
        </button>
      </div>
    )
  }
</header>

<script>
  import { signOut } from "../lib/sign-out";

  function setupSignOut() {
    const button = document.getElementById("sign-out-button");

    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    if (button.dataset.signOutBound === "1") {
      return;
    }

    button.dataset.signOutBound = "1";

    const label = button.querySelector("[data-sign-out-label]");
    const defaultLabel = label?.textContent ?? "Cerrar sesión";

    const setPendingState = (isPending: boolean) => {
      button.disabled = isPending;
      button.setAttribute("aria-busy", isPending ? "true" : "false");

      if (label instanceof HTMLElement) {
        label.textContent = isPending ? "Cerrando..." : defaultLabel;
      }
    };

    button.addEventListener("click", async () => {
      if (button.disabled) {
        return;
      }

      setPendingState(true);

      try {
        await signOut();
        window.location.assign("/sign-in");
      } catch (error) {
        setPendingState(false);
        console.error("Sign-out failed:", error);
        window.alert("No se pudo cerrar sesión. Inténtalo de nuevo.");
      }
    });
  }

  document.addEventListener("astro:page-load", setupSignOut);
  document.addEventListener("astro:after-swap", setupSignOut);
  setupSignOut();
</script>
