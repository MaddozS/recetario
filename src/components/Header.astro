---
import { Icon } from "astro-icon/components";
// Check current page
const { currentPage, showMenuButton } = Astro.props;
---

<header class="flex-none flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white px-4 md:px-6 py-3 md:py-4 border-b border-slate-200 z-10 relative" transition:animate="none">
  <div class="flex items-center gap-3 md:gap-4">
    {showMenuButton && (
      <button id="mobile-menu-btn" class="lg:hidden text-slate-500 hover:text-slate-700 border border-slate-200 hover:bg-slate-50 p-2 rounded-xl transition-colors" aria-label="Abrir menú">
        <Icon name="lucide:menu" size={20} />
      </button>
    )}
    <div class="bg-indigo-600 p-2 sm:p-2.5 rounded-xl text-white shadow-md shadow-indigo-100">
      <Icon name='lucide:chef-hat' class="w-6 h-6 sm:w-7 sm:h-7" />
    </div>
    <div>
      <h1 class="text-lg sm:text-xl font-bold text-slate-800 leading-tight">ChefCost Pro</h1>
      <p class="text-slate-500 text-[10px] sm:text-xs font-medium">Costeo Inteligente</p>
    </div>
  </div>
  <div class="hidden lg:flex bg-slate-100/50 rounded-xl p-1.5 border border-slate-200">
    <a 
      href="/recipes/101"
      class:list={[
        "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all", 
        currentPage === 'recipes' ? 'bg-white shadow-sm border border-slate-200/60 text-indigo-700' : 'text-slate-500 hover:text-slate-700 hover:bg-slate-100'
      ]}
    >
      <Icon name="lucide:book-open" size={18} class={currentPage === 'recipes' ? 'text-indigo-600' : 'text-slate-400'} />
      Recetario
    </a>
    <a 
      href="/ingredients"
      class:list={[
        "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all", 
        currentPage === 'ingredients' ? 'bg-white shadow-sm border border-slate-200/60 text-indigo-700' : 'text-slate-500 hover:text-slate-700 hover:bg-slate-100'
      ]}
    >
      <Icon name="lucide:shopping-cart" size={18} class={currentPage === 'ingredients' ? 'text-indigo-600' : 'text-slate-400'} />
      Ingredientes
    </a>
  </div>
</header>