---
import { Icon } from "astro-icon/components";
import { hasFeature } from "../lib/subscription";

const {
  currentPage,
  showMenuButton,
  isAuthenticated = false,
  recipeHref = "/recipes",
  subscription = null,
} = Astro.props;

const showProduction =
  subscription && hasFeature(subscription, "production_planner");
---

<header
  class="flex-none flex items-center gap-3 md:gap-4 bg-card px-4 md:px-6 py-3 md:py-4 border-b border-border z-10 relative"
  transition:animate="none"
>
  <div class="flex min-w-0 flex-1 items-center gap-3 md:gap-4">
    {
      showMenuButton && (
        <button
          id="mobile-menu-btn"
          class="lg:hidden text-muted-foreground hover:text-secondary-foreground border border-border hover:bg-background p-2 rounded-xl transition-colors"
          aria-label="Abrir menú"
        >
          <Icon name="lucide:menu" size={20} />
        </button>
      )
    }
    <img
      src="/kitchcalc_logo.svg"
      alt="KitchCalc"
      class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl shadow-md shadow-accent-100"
    />
    <div>
      <h1 class="text-lg sm:text-xl font-bold text-foreground leading-tight">
        KitchCalc
      </h1>
      <p class="text-muted-foreground text-[10px] sm:text-xs font-medium">
        Costeo Inteligente
      </p>
    </div>
  </div>
  <div class="hidden lg:flex bg-muted/50 rounded-xl p-1.5 border border-border">
    <a
      href={recipeHref}
      class:list={[
        "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all",
        currentPage === "recipes"
          ? "bg-accent-600 text-white shadow-sm"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
    >
      <Icon
        name="lucide:book-open"
        size={18}
        class={currentPage === "recipes"
          ? "text-white"
          : "text-subtle-foreground"}
      />
      Recetario
    </a>
    <a
      href="/ingredients"
      class:list={[
        "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all",
        currentPage === "ingredients"
          ? "bg-accent-600 text-white shadow-sm"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
    >
      <Icon
        name="lucide:shopping-cart"
        size={18}
        class={currentPage === "ingredients"
          ? "text-white"
          : "text-subtle-foreground"}
      />
      Ingredientes
    </a>
    {showProduction && (
      <a
        href="/produccion"
        class:list={[
          "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all",
          currentPage === "production"
            ? "bg-accent-600 text-white shadow-sm"
            : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
        ]}
      >
        <Icon
          name="lucide:factory"
          size={18}
          class={currentPage === "production"
            ? "text-white"
            : "text-subtle-foreground"}
        />
        Producción
      </a>
    )}
    <a
      href="/settings"
      class:list={[
        "flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-semibold transition-all",
        currentPage === "settings"
          ? "bg-accent-600 text-white shadow-sm"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
    >
      <Icon
        name="lucide:settings"
        size={18}
        class={currentPage === "settings"
          ? "text-white"
          : "text-subtle-foreground"}
      />
      Ajustes
    </a>
  </div>
  {
    isAuthenticated && (
      <div class="ml-auto flex shrink-0 items-center justify-end gap-2 sm:gap-3">
        {subscription && (
          <span class="hidden sm:inline-flex items-center rounded-full bg-accent-100 px-2.5 py-1 text-xs font-bold text-accent-700">
            {subscription.tier === "free"
              ? "Free"
              : subscription.tier === "basic"
                ? "Basic"
                : "Pro"}
          </span>
        )}
        <button
          id="sign-out-button"
          type="button"
          class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-3 py-2 text-sm font-semibold text-muted-foreground transition-colors hover:border-border hover:bg-background hover:text-foreground disabled:cursor-not-allowed disabled:opacity-70"
          aria-label="Cerrar sesión"
        >
          <Icon name="lucide:log-out" size={16} />
          <span data-sign-out-label class="hidden sm:inline">
            Cerrar sesión
          </span>
        </button>
      </div>
    )
  }
</header>

<script>
  import { signOut } from "../lib/sign-out";

  function setupSignOut() {
    const button = document.getElementById("sign-out-button");

    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    if (button.dataset.signOutBound === "1") {
      return;
    }

    button.dataset.signOutBound = "1";

    const label = button.querySelector("[data-sign-out-label]");
    const defaultLabel = label?.textContent ?? "Cerrar sesión";

    const setPendingState = (isPending: boolean) => {
      button.disabled = isPending;
      button.setAttribute("aria-busy", isPending ? "true" : "false");

      if (label instanceof HTMLElement) {
        label.textContent = isPending ? "Cerrando..." : defaultLabel;
      }
    };

    button.addEventListener("click", async () => {
      if (button.disabled) {
        return;
      }

      setPendingState(true);

      try {
        await signOut();
        window.location.assign("/sign-in");
      } catch (error) {
        setPendingState(false);
        console.error("Sign-out failed:", error);
        window.alert("No se pudo cerrar sesión. Inténtalo de nuevo.");
      }
    });
  }

  document.addEventListener("astro:page-load", setupSignOut);
  document.addEventListener("astro:after-swap", setupSignOut);
  setupSignOut();
</script>
