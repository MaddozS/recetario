---
import { Icon } from "astro-icon/components";

interface Props {
  id: number;
  name: string;
  category?: string;
  ingredientCount: number;
}

const { id, name, category, ingredientCount } = Astro.props;
---

<a
  href={`/recipes/${id}`}
  class="recipe-grid-card group border-border bg-card hover:border-accent-300 hover:bg-accent-50/30 block rounded-2xl border p-5 shadow-sm transition-all hover:shadow-md"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3
        class="text-secondary-foreground group-hover:text-accent-700 truncate font-bold transition-colors"
      >
        {name}
      </h3>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        {
          category && (
            <span class="bg-accent-50 text-accent-600 border-accent-200 inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold">
              {category}
            </span>
          )
        }
        <span class="text-muted-foreground text-xs">
          {ingredientCount}
          {ingredientCount === 1 ? "ingrediente" : "ingredientes"}
        </span>
      </div>
    </div>
    <Icon
      name="lucide:chevron-right"
      size={18}
      class="text-subtle-foreground group-hover:text-accent-500 mt-1 flex-none transition-colors"
    />
  </div>
</a>

<style define:vars={{}}>
  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .recipe-grid-card {
    animation: cardFadeIn 0.25s ease-out both;
  }
  .recipe-grid-card:nth-child(1) {
    animation-delay: 0ms;
  }
  .recipe-grid-card:nth-child(2) {
    animation-delay: 35ms;
  }
  .recipe-grid-card:nth-child(3) {
    animation-delay: 70ms;
  }
  .recipe-grid-card:nth-child(4) {
    animation-delay: 105ms;
  }
  .recipe-grid-card:nth-child(5) {
    animation-delay: 140ms;
  }
  .recipe-grid-card:nth-child(6) {
    animation-delay: 175ms;
  }
  .recipe-grid-card:nth-child(7) {
    animation-delay: 210ms;
  }
  .recipe-grid-card:nth-child(8) {
    animation-delay: 245ms;
  }
  .recipe-grid-card:nth-child(9) {
    animation-delay: 280ms;
  }
  .recipe-grid-card:nth-child(10) {
    animation-delay: 315ms;
  }
  .recipe-grid-card:nth-child(11) {
    animation-delay: 350ms;
  }
  .recipe-grid-card:nth-child(12) {
    animation-delay: 385ms;
  }
</style>
