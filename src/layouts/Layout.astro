---
import '../styles/global.css'
import Header from '../components/Header.astro'
import RecipesSidebar from '../components/RecipesSidebar.astro'
import { Icon } from 'astro-icon/components'

const { currentPage } = Astro.props;

const { currentRecipe, showSideBar, showHeader = true } = Astro.props;
const showMobileNav = currentPage === 'recipes' || currentPage === 'ingredients';
const recipeHref = currentRecipe ? `/recipes/${currentRecipe}` : '/recipes/101';

import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{`ChefCost Pro - ${currentPage === 'recipes' ? 'Recetario' : currentPage === 'ingredients' ? 'Inventario' : ''}`}</title>
    <ClientRouter />
	</head>
	<body class="bg-slate-100">
  <div class="max-w-full mx-auto pb-24 md:pb-0 md:px-16 lg:px-24 md:py-8 lg:py-12">
      { showHeader && <Header currentPage={currentPage}/> }
      <div class="grid grid-cols-12 gap-8 items-start">
        {
          showSideBar && (
            <div class="col-span-12 lg:col-span-3">
              <RecipesSidebar currentRecipe={currentRecipe} transition:animate="none" />
            </div>
          )
        }
        <main class:list={[!showSideBar ? 'col-span-12' : 'col-span-12 lg:col-span-9']}>
          <slot />
        </main>
      </div>
    </div>

    {
      showMobileNav && (
        <nav class="md:hidden fixed inset-x-0 bottom-0 z-50 px-3 pb-[calc(env(safe-area-inset-bottom)+0.45rem)]">
          <div class="rounded-2xl border border-slate-200 bg-white/95 backdrop-blur shadow-[0_-8px_24px_rgba(15,23,42,0.08)] p-1.5 grid grid-cols-2 gap-1.5">
            <a
              href={recipeHref}
              class:list={[
                'min-h-11 rounded-xl flex items-center justify-center gap-2 text-sm font-bold transition-colors',
                currentPage === 'recipes' ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-100'
              ]}
            >
              <Icon name="lucide:book-open" size={16} />
              Recetas
            </a>
            <a
              href="/ingredients"
              class:list={[
                'min-h-11 rounded-xl flex items-center justify-center gap-2 text-sm font-bold transition-colors',
                currentPage === 'ingredients' ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-100'
              ]}
            >
              <Icon name="lucide:package-search" size={16} />
              Ingredientes
            </a>
          </div>
        </nav>
      )
    }
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
    padding: 0; 
		width: 100%;
		height: 100%;
	}
</style>
