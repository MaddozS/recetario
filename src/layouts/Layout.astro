---
import '@/styles/global.css'
import { ClientRouter } from "astro:transitions";
import { Icon } from 'astro-icon/components'
import { getUserPreferences } from '@/lib/db/preferences'
import { hasFeature } from '@/lib/subscription'
import { getAccentCssVars } from '@/lib/accent-colors'
import type { AccentFamily } from '@/lib/accent-colors'
import Header from '@/components/Header.astro'
import RecipesSidebar from '@/components/RecipesSidebar.astro'

const { currentPage, title } = Astro.props;
const { showSideBar, showHeader = true, removeContentWrapper = false } = Astro.props;
const showMobileNav = currentPage === 'recipes' || currentPage === 'ingredients' || currentPage === 'settings' || currentPage === 'production';
const isAuthenticated = Boolean(Astro.locals.user && Astro.locals.session);
const authenticatedUserName = Astro.locals.user?.name || Astro.locals.user?.email || null;
const authenticatedUserImage = Astro.locals.user?.image || null;
const subscription = Astro.locals.subscription;
const showProduction = subscription ? hasFeature(subscription, 'production_planner') : false;
const userId = Astro.locals.user?.id;

const userPrefs = userId ? await getUserPreferences(userId) : null;
const recipeHref = '/recipes';
const theme = userPrefs?.theme ?? 'system';
const accent = (userPrefs?.accentColor ?? 'coral') as AccentFamily;
const accentCssVars = getAccentCssVars(accent, theme);
const sidebarCollapsed = Astro.cookies.get("kitchcalc-sidebar-collapsed")?.value === "1";
---

<!doctype html>
<html lang="en" class:list={[theme === 'dark' ? 'dark' : '']} data-theme={theme} data-accent={accent} data-app-accent={accent} data-app-theme={theme} style={accentCssVars}>
	<head>
		<script is:inline>
      (function() {
        const html = document.documentElement;
        const stored = html.dataset.appTheme || 'system';
        if (stored === 'system') {
          const mq = window.matchMedia;
          if (mq) {
            const isDark = mq('(prefers-color-scheme: dark)').matches;
            if (isDark) {
              html.classList.add('dark');
            } else {
              html.classList.remove('dark');
            }
            html.dataset.theme = isDark ? 'dark' : 'light';
          }
        }
      })();
    </script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/kitchcalc_logo.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/kitchcalc_logo.webp" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="KitchCalc | Calculadora de costo de recetas, inventario de ingredientes y planificador de produccion." />
		<meta property="og:title" content={title ?? "KitchCalc | Costeo Inteligente"} />
		<meta property="og:description" content="Calculadora de costo de recetas, inventario de ingredientes y planificador de produccion." />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<title>{title ?? `KitchCalc - ${currentPage === 'recipes' ? 'Recetario' : currentPage === 'ingredients' ? 'Inventario' : currentPage === 'settings' ? 'Configuración' : currentPage === 'production' ? 'Planificador de Producción' : ''}`}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <ClientRouter />
	</head>
	<body class="bg-background flex flex-col min-h-dvh md:h-dvh md:overflow-hidden">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent-600 focus:text-white focus:rounded-xl focus:px-4 focus:py-2 focus:outline-none">Saltar al contenido</a>
    {showHeader && (
      <Header
        currentPage={currentPage}
        showMenuButton={showSideBar}
        isAuthenticated={isAuthenticated}
        subscription={subscription}
      />
    )}
    
    <div class="flex flex-1 flex-col md:flex-row overflow-hidden relative">
      {
        showSideBar && (
          <>
            <!-- Mobile Overlay -->
            <div id="mobile-sidebar-overlay" class="fixed inset-0 bg-backdrop/40 backdrop-blur-sm z-50 hidden md:hidden opacity-0"></div>
            
            <!-- Sidebar -->
            <aside id="app-sidebar" data-collapsed={sidebarCollapsed ? "1" : "0"} class="fixed inset-y-0 left-0 z-[60] w-[85%] max-w-[320px] -translate-x-full md:translate-x-0 md:static md:w-auto md:max-w-none md:flex-none md:border-r md:border-border md:bg-card md:flex md:flex-col shadow-2xl md:shadow-none" transition:animate="none">
              <RecipesSidebar
                currentPage={currentPage}
                isAuthenticated={isAuthenticated}
                userName={authenticatedUserName}
                userImage={authenticatedUserImage}
                subscription={subscription}
                showProduction={showProduction}
              />
            </aside>
          </>
        )
      }
      <main id="main-content" class:list={[
        !removeContentWrapper ? 'p-4 md:p-8 pb-24 md:pb-8' : '',
        "flex-1 overflow-y-auto w-full bg-background"
      ]}>
        <div class="max-w-7xl mx-auto" transition:name="app-content" transition:animate="slide">
          <slot />
        </div>
      </main>
    </div>

    {
      showMobileNav && (
        <nav
          class="md:hidden fixed inset-x-0 bottom-0 z-40 px-3 pb-[calc(env(safe-area-inset-bottom)+0.45rem)]"
          transition:name="mobile-nav"
          transition:animate="none"
        >
          <div class="rounded-2xl border border-border bg-card shadow-[0_-8px_24px_var(--tw-shadow-color,rgba(0,0,0,0.08))] dark:shadow-[0_-8px_24px_rgba(0,0,0,0.4)] p-1 sm:p-1.5 gap-1"
            class:list={[showProduction ? 'grid grid-cols-4' : 'grid grid-cols-3']}
          >
            <a
              href={recipeHref}
              class:list={[
                'min-h-11 rounded-xl flex flex-col items-center justify-center gap-0.5 text-[11px] sm:text-xs font-bold transition-colors',
                currentPage === 'recipes' ? 'bg-accent-600 text-white' : 'text-muted-foreground hover:bg-muted'
              ]}
            >
              <Icon name="lucide:book-open" size={16} />
              <span>Recetas</span>
            </a>
            <a
              href="/ingredients"
              class:list={[
                'min-h-11 rounded-xl flex flex-col items-center justify-center gap-0.5 text-[11px] sm:text-xs font-bold transition-colors',
                currentPage === 'ingredients' ? 'bg-accent-600 text-white' : 'text-muted-foreground hover:bg-muted'
              ]}
            >
              <Icon name="lucide:package-search" size={16} />
              <span>Ingredientes</span>
            </a>
            {showProduction && (
              <a
                href="/produccion"
                class:list={[
                  'min-h-11 rounded-xl flex flex-col items-center justify-center gap-0.5 text-[11px] sm:text-xs font-bold transition-colors',
                  currentPage === 'production' ? 'bg-accent-600 text-white' : 'text-muted-foreground hover:bg-muted'
                ]}
              >
                <Icon name="lucide:factory" size={16} />
                <span>Producción</span>
              </a>
            )}
            <a
              href="/settings"
              class:list={[
                'min-h-11 rounded-xl flex flex-col items-center justify-center gap-0.5 text-[11px] sm:text-xs font-bold transition-colors',
                currentPage === 'settings' ? 'bg-accent-600 text-white' : 'text-muted-foreground hover:bg-muted'
              ]}
            >
              <Icon name="lucide:settings" size={16} />
              <span>Configuración</span>
            </a>
          </div>
        </nav>
      )
    }
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
    padding: 0; 
		width: 100%;
		height: 100%;
	}
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-group(root) {
      z-index: 0;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
      mix-blend-mode: normal;
    }

    ::view-transition-group(mobile-nav) {
      z-index: 80;
      animation: none;
    }

    ::view-transition-old(mobile-nav),
    ::view-transition-new(mobile-nav) {
      animation: none;
      mix-blend-mode: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-old(app-content),
    ::view-transition-new(app-content) {
      animation: none !important;
    }
  }
</style>

<script>
  import { getAccentCssVars } from "@/lib/accent-colors";

  function getEffectiveTheme(pref: string): string {
    if (pref === 'system') {
      if (typeof window.matchMedia === 'function') {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      return 'light';
    }
    return pref;
  }

  function applyTheme() {
    const html = document.documentElement;
    const stored = html.dataset.appTheme || 'system';
    const accent = html.dataset.appAccent || 'coral';
    const effective = getEffectiveTheme(stored);

    if (effective === 'dark') {
      html.classList.add('dark');
    } else {
      html.classList.remove('dark');
    }

    if (typeof getAccentCssVars === 'function') {
      html.style.cssText = getAccentCssVars(accent as string, effective);
    }
  }

  function setupOsListener() {
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', () => {
      const stored = document.documentElement.dataset.appTheme || 'system';
      if (stored === 'system') applyTheme();
    });
  }

  applyTheme();
  setupOsListener();

  document.addEventListener('astro:before-swap', (event) => {
    const currentHtml = document.documentElement;
    const newHtml = event.newDocument.documentElement;
    const currentStored = currentHtml.dataset.appTheme || 'system';
    const newStored = newHtml.dataset.appTheme || 'system';

    // If current page has an explicit (non-system) theme but the incoming
    // page says "system", a save is likely in-flight (auto-save on click).
    // Trust the current value until the cache/DB catches up.
    const stored = currentStored !== 'system' && newStored === 'system'
      ? currentStored
      : newStored;
    const accent = newHtml.dataset.appAccent || currentHtml.dataset.appAccent || 'coral';
    const effective = getEffectiveTheme(stored);

    if (effective === 'dark') {
      newHtml.classList.add('dark');
    } else {
      newHtml.classList.remove('dark');
    }
    newHtml.dataset.theme = effective;

    if (typeof getAccentCssVars === 'function') {
      newHtml.style.cssText = getAccentCssVars(accent as string, effective);
    }
  });

  document.addEventListener('astro:after-swap', applyTheme);
  document.addEventListener('astro:page-load', applyTheme);

  function setupSidebar() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-sidebar-btn');
    const sidebar = document.getElementById('app-sidebar');
    const overlay = document.getElementById('mobile-sidebar-overlay');

    function openSidebar() {
      if (sidebar && overlay) {
        overlay.classList.remove('hidden');
        // Trigger reflow
        void overlay.offsetWidth;
        overlay.classList.remove('opacity-0');
        sidebar.classList.remove('-translate-x-full');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeSidebar() {
      if (sidebar && overlay) {
        overlay.classList.add('opacity-0');
        sidebar.classList.add('-translate-x-full');
        document.body.style.overflow = '';
        setTimeout(() => {
          overlay.classList.add('hidden');
        }, 300);
      }
    }

    if (menuBtn && menuBtn.dataset.sidebarBound !== '1') {
      menuBtn.dataset.sidebarBound = '1';
      menuBtn.addEventListener('click', openSidebar);
    }
    if (closeBtn && closeBtn.dataset.sidebarBound !== '1') {
      closeBtn.dataset.sidebarBound = '1';
      closeBtn.addEventListener('click', closeSidebar);
    }
    if (overlay && overlay.dataset.sidebarBound !== '1') {
      overlay.dataset.sidebarBound = '1';
      overlay.addEventListener('click', closeSidebar);
    }
  }

  document.addEventListener('astro:page-load', setupSidebar);
  document.addEventListener('astro:after-swap', setupSidebar);
</script>
