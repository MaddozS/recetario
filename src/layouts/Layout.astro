---
import '../styles/global.css'
import { ClientRouter } from "astro:transitions";
import { Icon } from 'astro-icon/components'
import { getRecipeDataOwner, listRecipeSummaries, getUserPreferences } from '../lib/recipe-data'
import { getAccentCssVars } from '../lib/accent-colors'
import type { AccentFamily } from '../lib/accent-colors'
import Header from '../components/Header.astro'
import RecipesSidebar from '../components/RecipesSidebar.astro'

const { currentPage } = Astro.props;
const { currentRecipe, showSideBar, showHeader = true, removeContentWrapper = false } = Astro.props;
const showMobileNav = currentPage === 'recipes' || currentPage === 'ingredients' || currentPage === 'settings';
const isAuthenticated = Boolean(Astro.locals.user && Astro.locals.session);
const authenticatedUserName = Astro.locals.user?.name || Astro.locals.user?.email || null;
const recipeDataOwner = Astro.locals.user ? getRecipeDataOwner(Astro.locals.user) : null;
const subscription = Astro.locals.subscription;
const recipes = recipeDataOwner ? await listRecipeSummaries(recipeDataOwner) : [];
const recipeHref = currentRecipe ? `/recipes/${currentRecipe}` : '/recipes';

const userId = Astro.locals.user?.id;
const userPrefs = userId ? await getUserPreferences(userId) : null;
const theme = userPrefs?.theme ?? 'light';
const accent = (userPrefs?.accentColor ?? 'indigo') as AccentFamily;
const accentCssVars = getAccentCssVars(accent, theme);
---

<!doctype html>
<html lang="en" class:list={[theme === 'dark' ? 'dark' : '']} data-theme={theme} data-accent={accent} style={accentCssVars}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{`KitchCalc - ${currentPage === 'recipes' ? 'Recetario' : currentPage === 'ingredients' ? 'Inventario' : currentPage === 'settings' ? 'Configuración' : ''}`}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <ClientRouter />
	</head>
	<body class="bg-background flex flex-col min-h-dvh lg:h-dvh lg:overflow-hidden">
    {showHeader && (
      <Header
        currentPage={currentPage}
        showMenuButton={showSideBar}
        isAuthenticated={isAuthenticated}
        recipeHref={recipeHref}
        subscription={subscription}
      />
    )}
    
    <div class="flex flex-1 flex-col lg:flex-row overflow-hidden relative">
      {
        showSideBar && (
          <>
            <!-- Mobile Overlay -->
            <div id="mobile-sidebar-overlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden lg:hidden opacity-0 transition-opacity duration-300"></div>
            
            <!-- Sidebar -->
            <aside id="app-sidebar" class="fixed inset-y-0 left-0 z-50 w-[85%] max-w-[320px] -translate-x-full lg:translate-x-0 lg:static lg:w-[320px] xl:w-90 flex-none border-r border-border bg-card lg:overflow-y-auto flex flex-col transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none" transition:animate="none">
              <RecipesSidebar
                recipes={recipes}
                currentRecipe={currentRecipe}
                isAuthenticated={isAuthenticated}
                userName={authenticatedUserName}
                subscription={subscription}
              />
            </aside>
          </>
        )
      }
      <main class:list={[
        !removeContentWrapper ? 'p-4 md:p-8 pb-24 lg:pb-8' : '',
        "flex-1 overflow-y-auto w-full bg-linear-to-br from-background to-muted"
      ]}>
        <div class="max-w-7xl mx-auto" transition:name="app-content">
          <slot />
        </div>
      </main>
    </div>

    {
      showMobileNav && (
        <nav
          class="lg:hidden fixed inset-x-0 bottom-0 z-50 px-3 pb-[calc(env(safe-area-inset-bottom)+0.45rem)]"
          transition:name="mobile-nav"
          transition:animate="none"
        >
          <div class="rounded-2xl border border-border bg-card/95 backdrop-blur shadow-[0_-8px_24px_rgba(15,23,42,0.08)] dark:shadow-[0_-8px_24px_rgba(0,0,0,0.4)] p-1.5 grid grid-cols-3 gap-1.5">
            <a
              href={recipeHref}
              class:list={[
                'min-h-11 rounded-xl flex items-center justify-center gap-2 text-sm font-bold transition-colors',
                currentPage === 'recipes' ? 'bg-accent-600 text-white' : 'text-muted-foreground hover:bg-muted'
              ]}
            >
              <Icon name="lucide:book-open" size={16} />
              Recetas
            </a>
            <a
              href="/ingredients"
              class:list={[
                'min-h-11 rounded-xl flex items-center justify-center gap-2 text-sm font-bold transition-colors',
                currentPage === 'ingredients' ? 'bg-accent-600 text-white' : 'text-muted-foreground hover:bg-muted'
              ]}
            >
              <Icon name="lucide:package-search" size={16} />
              Ingredientes
            </a>
            <a
              href="/settings"
              class:list={[
                'min-h-11 rounded-xl flex items-center justify-center gap-2 text-sm font-bold transition-colors',
                currentPage === 'settings' ? 'bg-accent-600 text-white' : 'text-muted-foreground hover:bg-muted'
              ]}
            >
              <Icon name="lucide:settings" size={16} />
              Ajustes
            </a>
          </div>
        </nav>
      )
    }
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
    padding: 0; 
		width: 100%;
		height: 100%;
	}
</style>

<style is:global>
  @keyframes appContentEnter {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.994);
      filter: blur(5px);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes appContentExit {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }

    to {
      opacity: 0;
      transform: translateY(-4px) scale(0.998);
      filter: blur(2px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-group(root) {
      z-index: 0;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
      mix-blend-mode: normal;
    }

    ::view-transition-group(app-content) {
      z-index: 10;
      animation-duration: 380ms;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    ::view-transition-old(app-content),
    ::view-transition-new(app-content) {
      mix-blend-mode: normal;
      transform-origin: center top;
    }

    ::view-transition-old(app-content) {
      animation: appContentExit 220ms cubic-bezier(0.4, 0, 0.9, 1) both;
    }

    ::view-transition-new(app-content) {
      animation: appContentEnter 380ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    ::view-transition-group(mobile-nav) {
      z-index: 80;
      animation: none;
    }

    ::view-transition-old(mobile-nav),
    ::view-transition-new(mobile-nav) {
      animation: none;
      mix-blend-mode: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-old(app-content),
    ::view-transition-new(app-content) {
      animation: none !important;
    }
  }
</style>

<script>
  import { getAccentCssVars } from "../lib/accent-colors";

  function applyTheme() {
    const html = document.documentElement;
    const theme = html.dataset.theme || 'light';
    const accent = html.dataset.accent || 'indigo';

    if (theme === 'dark') {
      html.classList.add('dark');
    } else {
      html.classList.remove('dark');
    }

    if (typeof getAccentCssVars === 'function') {
      html.style.cssText = getAccentCssVars(accent as string, theme);
    }
  }

  applyTheme();

  document.addEventListener('astro:after-swap', applyTheme);

  function setupSidebar() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-sidebar-btn');
    const sidebar = document.getElementById('app-sidebar');
    const overlay = document.getElementById('mobile-sidebar-overlay');

    function openSidebar() {
      if (sidebar && overlay) {
        overlay.classList.remove('hidden');
        // Trigger reflow
        void overlay.offsetWidth;
        overlay.classList.remove('opacity-0');
        sidebar.classList.remove('-translate-x-full');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeSidebar() {
      if (sidebar && overlay) {
        overlay.classList.add('opacity-0');
        sidebar.classList.add('-translate-x-full');
        document.body.style.overflow = '';
        setTimeout(() => {
          overlay.classList.add('hidden');
        }, 300);
      }
    }

    if (menuBtn && menuBtn.dataset.sidebarBound !== '1') {
      menuBtn.dataset.sidebarBound = '1';
      menuBtn.addEventListener('click', openSidebar);
    }
    if (closeBtn && closeBtn.dataset.sidebarBound !== '1') {
      closeBtn.dataset.sidebarBound = '1';
      closeBtn.addEventListener('click', closeSidebar);
    }
    if (overlay && overlay.dataset.sidebarBound !== '1') {
      overlay.dataset.sidebarBound = '1';
      overlay.addEventListener('click', closeSidebar);
    }
  }

  document.addEventListener('astro:page-load', setupSidebar);
  document.addEventListener('astro:after-swap', setupSidebar);
</script>
