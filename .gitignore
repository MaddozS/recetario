# build output
dist/

# package compilation output
packages/*/dist/
*.tsbuildinfo

# generated types
.astro/

# generated Prisma clients
**/generated/prisma/
**/generated/prisma-sqlite/
**/prisma/generated/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.cloudflare
.dev.vars
apps/*/.dev.vars

# local databases
data/dev.db
data/dev.db-shm
data/dev.db-wal

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

.turbo/
.wrangler/
apps/*/.turbo/
apps/*/.wrangler/


# Vite optimization cache (outside node_modules to survive pnpm restructures)
.vite-cache/

# local tool state
.pnpm-store/
.commandcode/settings.local.json

# Graphify output
graphify-out/

# Code-review scratch patches (apply via `git apply` and discard)
.scratch/
