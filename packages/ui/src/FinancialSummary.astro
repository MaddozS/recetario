---
import { Card } from "@recetario/ui";

interface FinancialRow {
  label: string;
  value: string;
  subtitle?: string;
  secondaryValue?: string;
  /** Semantic color role: danger | muted | accent | success */
  color?: string;
}

interface Props {
  rows: FinancialRow[];
  highlightRow?: number;
  isEditMode?: boolean;
  editFormId?: string;
  editFields?: Array<{
    rowIndex: number;
    name: string;
    currentValue: string;
    suffix?: string;
  }>;
  class?: string;
}

const {
  rows,
  highlightRow,
  isEditMode = false,
  editFormId,
  editFields = [],
  class: extraClass = "",
} = Astro.props;

const colorAccentMap: Record<string, string> = {
  danger: "border-l-danger-solid/60",
  muted: "border-l-muted-foreground/30",
  accent: "border-l-accent-400/60",
  success: "border-l-success-solid/60",
};
---

<Card padding="lg" class:list={[extraClass]}>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      rows.map((row, i) => {
        const isHighlight = highlightRow === i;
        const editField = editFields.find((f) => f.rowIndex === i);
        const leftBorder = row.color
          ? colorAccentMap[row.color] || ""
          : "border-l-transparent";
        return (
          <div
            class:list={[
              "flex flex-col justify-between border-l-[3px] py-1 pl-3 sm:border-l-[3px] sm:px-1 sm:pl-4",
              leftBorder,
              i > 1 ? "border-border-light sm:border-t sm:pt-4" : "",
            ]}
          >
            <p
              class:list={[
                "mb-1.5 text-[10px] font-black tracking-wider uppercase",
                isHighlight ? "text-accent-500" : "text-subtle-foreground",
              ]}
            >
              {row.label}
            </p>
            <div>
              {isEditMode && editField ? (
                <div class="flex items-baseline gap-1">
                  <label for={`fs-edit-${editField.name}`} class="sr-only">
                    {row.label}
                  </label>
                  <input
                    type="number"
                    id={`fs-edit-${editField.name}`}
                    name={editField.name}
                    form={editFormId}
                    class:list={[
                      "focus:ring-accent-500/20 w-16 rounded-xl border p-1 font-mono text-xl font-semibold focus:ring-2 2xl:text-2xl",
                      isHighlight
                        ? "border-white/20 bg-white/15 text-white focus:ring-white/30"
                        : "bg-background border-border text-foreground",
                    ]}
                    value={editField.currentValue}
                  />
                  {editField.suffix && (
                    <span
                      class:list={[
                        "text-lg font-bold",
                        isHighlight
                          ? "text-white/80"
                          : "text-subtle-foreground",
                      ]}
                    >
                      {editField.suffix}
                    </span>
                  )}
                </div>
              ) : (
                <p
                  class:list={[
                    "truncate font-mono text-2xl leading-none font-semibold tabular-nums 2xl:text-3xl",
                    isHighlight ? "text-accent-600" : "text-foreground",
                  ]}
                  title={row.value}
                >
                  {row.value}
                </p>
              )}
              {row.subtitle && (
                <p
                  class:list={[
                    "mt-1.5 line-clamp-1 text-[11px] font-semibold",
                    isHighlight ? "text-accent-400" : "text-subtle-foreground",
                  ]}
                >
                  {row.subtitle}
                </p>
              )}
              {row.secondaryValue && !isEditMode && (
                <p class="text-subtle-foreground mt-0.5 font-mono text-[11px] font-semibold">
                  {row.secondaryValue}
                </p>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</Card>
