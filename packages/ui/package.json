{
  "name": "@recetario/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./Button.astro": "./src/Button.astro",
    "./Card.astro": "./src/Card.astro",
    "./Input.astro": "./src/Input.astro",
    "./Badge.astro": "./src/Badge.astro",
    "./Dialog.astro": "./src/Dialog.astro",
    "./FinancialSummary.astro": "./src/FinancialSummary.astro",
    "./SectionHeading.astro": "./src/SectionHeading.astro",
    "./PasswordInput.astro": "./src/PasswordInput.astro",
    "./tokens.css": "./src/tokens.css",
    "./accent-colors": {
      "types": "./dist/accent-colors.d.ts",
      "default": "./dist/accent-colors.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "default": "./dist/dialog.js"
    },
    "./loading-overlay": {
      "types": "./dist/loading-overlay.d.ts",
      "default": "./dist/loading-overlay.js"
    },
    "./password-toggle": {
      "types": "./dist/password-toggle.d.ts",
      "default": "./dist/password-toggle.js"
    }
  },
  "files": ["src", "dist"],
  "peerDependencies": {
    "astro": "^7.0.0",
    "astro-icon": "^1.0.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "@recetario/config": "workspace:^"
  }
}
