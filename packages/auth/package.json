{
  "name": "@recetario/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@recetario/config": "workspace:^",
    "better-auth": "^1.6.25",
    "dotenv": "17.4.2"
  },
  "peerDependencies": {
    "@recetario/db": "workspace:^"
  },
  "devDependencies": {
    "@recetario/db": "workspace:^",
    "typescript": "^6.0.0",
    "@types/node": "25.8.0",
    "vitest": "^3.1.0"
  }
}
