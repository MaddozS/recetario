{
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src", "generated/prisma"]
}
