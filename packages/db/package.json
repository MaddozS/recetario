{
  "name": "@recetario/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.ts",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma/generated/models": "./prisma/generated/models.ts",
    "./prisma/generated/enums": "./prisma/generated/enums.ts",
    "./prisma/generated/client": "./prisma/generated/client.ts",
    "./prisma/generated/commonInputTypes": "./prisma/generated/commonInputTypes.ts",
    "./prisma/generated/browser": "./prisma/generated/browser.ts",
    "./prisma/generated-node/client": "./prisma/generated-node/client.ts"
  },
  "files": [
    "dist",
    "prisma",
    "generated",
    "generated-node"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:plans": "tsx prisma/seed-plans.ts",
    "seed:test-users": "tsx prisma/seed-test-users.ts",
    "crud:demo": "tsx src/crud-demo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@recetario/config": "workspace:^",
    "@recetario/types": "workspace:^",
    "dotenv": "17.4.2",
    "pg": "8.20.0",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "prisma": "7.8.0",
    "tsx": "4.22.0",
    "vitest": "^3.1.0"
  }
}
