datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
  runtime  = "cloudflare"
}

generator nodeClient {
  provider = "prisma-client"
  output   = "./generated-node"
}


model Ingredient {
  id               Int                 @id @default(autoincrement())
  ownerId          String              @map("owner_id")
  name             String
  unit             String
  price            Float
  purchaseQuantity Float               @map("purchase_quantity")
  brand            String?
  supplier         String?
  recipeIngredients RecipeIngredient[]

  @@index([ownerId])
  @@map("ingredients")
}

model Recipe {
  id                  Int                  @id @default(autoincrement())
  ownerId             String               @map("owner_id")
  name                String
  category            String?
  instructions        String?
  desiredMargin       Float                @map("desired_margin")
  fixedCostsPercentage Float               @map("fixed_costs_percentage")
  updatedAt           DateTime?            @map("updated_at") @db.Timestamptz()
  recipeIngredients   RecipeIngredient[]
  presentations       RecipePresentation[]
  recipeFixedCosts    RecipeFixedCost[]

  @@index([ownerId])
  @@map("recipes")
}

model RecipeIngredient {
  id           Int         @id @default(autoincrement())
  recipeId     Int         @map("recipe_id")
  ingredientId Int         @map("ingredient_id")
  quantity     Float
  unit         String
  comment      String?
  recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipePresentation {
  id            Int      @id @default(autoincrement())
  recipeId      Int      @map("recipe_id")
  name          String
  unitsPerBatch Float    @map("units_per_batch")
  salePrice     Float?   @map("sale_price")
  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  fixedCosts    PresentationFixedCost[]

  @@map("recipe_presentations")
}

enum FixedCostType {
  PERCENTAGE
  AMOUNT
}

enum FixedCostBase {
  PER_BATCH
  PER_UNIT
  PER_HOUR
}

model RecipeFixedCost {
  id           Int      @id @default(autoincrement())
  recipeId     Int      @map("recipe_id")
  name         String
  type         FixedCostType
  base         FixedCostBase
  value        Float
  hours        Float?
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_fixed_costs")
}

model PresentationFixedCost {
  id              Int                 @id @default(autoincrement())
  presentationId  Int                 @map("presentation_id")
  name            String
  type            FixedCostType
  base            FixedCostBase
  value           Float
  presentation    RecipePresentation  @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@index([presentationId])
  @@map("presentation_fixed_costs")
}

enum Theme {
  system
  light
  dark
}
enum AccentColor {
  indigo
  violet
  blue
  emerald
  rose
  amber
  coral
}

model UserPreferences {
  userId      String    @id @map("user_id")
  theme       Theme
  accentColor AccentColor    @map("accent_color")
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz()

  @@map("user_preferences")
}

model SubscriptionPlan {
  id               String          @id
  stripePriceId    String          @map("stripe_price_id")
  name             String
  tier             String
  billingInterval  String          @map("billing_interval")
  priceCents       Int             @map("price_cents")
  currency         String          @default("mxn")
  recipesLimit     Int?            @map("recipes_limit")
  ingredientsLimit Int?            @map("ingredients_limit")
  featuresJson     String          @map("features_json")
  active           Boolean         @default(true)
  subscriptions    Subscription[]

  @@map("subscription_plans")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id            String    @id
  name          String
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  email         String    @unique
  emailVerified Boolean   @map("email_verified")
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model Subscription {
  id                   String           @id
  userId               String           @map("user_id")
  stripeCustomerId     String?          @map("stripe_customer_id")
  stripeSubscriptionId String?          @unique @map("stripe_subscription_id")
  planId               String           @map("plan_id")
  status               String
  currentPeriodStart   DateTime?        @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd     DateTime?        @map("current_period_end") @db.Timestamptz()
  cancelAtPeriodEnd    Boolean          @default(false) @map("cancel_at_period_end")
  trialEnd             DateTime?        @map("trial_end") @db.Timestamptz()
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

model CacheEntry {
  key       String   @id
  value     String
  expiresAt BigInt   @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cache_entries")
}

enum AuditAction {
  sign_in
  sign_up
  password_change
  password_reset
  email_change
  account_delete
  session_revoke
}

model AuditLog {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  action    AuditAction
  ipAddress String?    @map("ip_address")
  userAgent String?    @map("user_agent")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}
