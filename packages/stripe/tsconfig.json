{
  "compilerOptions": {
    "composite": true,
    "paths": { "*": ["./*"] },
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"]
}
