{
  "name": "recetario",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "packageManager": "pnpm@11.1.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.2"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@recetario/web",
    "dev:api": "turbo run dev --filter=@recetario/api",
    "build": "turbo run build",
    "preview": "turbo run preview --filter=@recetario/web",
    "deploy:web": "$npm_execpath --filter @recetario/web exec wrangler deploy",
    "deploy:api": "$npm_execpath --filter @recetario/api exec wrangler deploy",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "@types/node": "26.1.2"
  }
}
