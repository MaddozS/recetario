{
  // Config única del worker Nuxt (Task 13b): el artefacto es el output de Nitro.
  // Nitro corre con `cloudflare.deployConfig: false`, así que Wrangler siempre
  // lee este archivo (el generado en `.output/server/wrangler.json` lo pisaría y
  // descartaría los `env` y los settings del dashboard).
  "name": "recetario-web",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "NODE_ENV": "production",
  },
  "services": [
    {
      "binding": "API",
      "service": "recetario-api",
    },
  ],
  "env": {
    "staging": {
      "name": "recetario-web-staging",
      "main": ".output/server/index.mjs",
      "assets": {
        "directory": ".output/public",
        "binding": "ASSETS",
      },
      "compatibility_date": "2026-08-01",
      "compatibility_flags": ["nodejs_compat"],
      "observability": {
        "enabled": true,
      },
      "services": [
        {
          "binding": "API",
          "service": "recetario-api-staging",
        },
      ],
      "vars": {
        "NODE_ENV": "staging",
      },
    },
    "production": {
      "name": "recetario-web-production",
      "main": ".output/server/index.mjs",
      "assets": {
        "directory": ".output/public",
        "binding": "ASSETS",
      },
      "compatibility_date": "2026-08-01",
      "compatibility_flags": ["nodejs_compat"],
      "observability": {
        "enabled": true,
      },
      "services": [
        {
          "binding": "API",
          "service": "recetario-api-production",
        },
      ],
      "vars": {
        "NODE_ENV": "production",
        // Fail-closed: staging no define esta var y emite noindex + robots
        // bloqueado. Producción la activa aquí (no en el dashboard).
        "NUXT_PUBLIC_INDEXABLE": "true",
      },
    },
  },
}
