{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "recetario-web",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
  },
  "vars": {
    "NODE_ENV": "production",
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "10323f891e024ef0ad89099b717c2c79"
    }
  ],
  "services": [
    {
      "binding": "API",
      "service": "recetario-api",
    },
  ],
  "env": {
    "staging": {
      "name": "recetario-web-staging",
      "main": "dist/server/entry.mjs",
      "compatibility_date": "2026-06-10",
      "compatibility_flags": ["nodejs_compat"],
      "observability": {
        "enabled": true
      },
      "assets": {
        "binding": "ASSETS",
        "directory": "dist/client",
      },
      "services": [
        {
          "binding": "API",
          "service": "recetario-api-staging",
        },
      ],
      "vars": {
        "NODE_ENV": "staging"
      }
    },
    "production": {
      "name": "recetario-web-production",
      "main": "dist/server/entry.mjs",
      "compatibility_date": "2026-06-10",
      "compatibility_flags": ["nodejs_compat"],
      "observability": {
        "enabled": true
      },
      "assets": {
        "binding": "ASSETS",
        "directory": "dist/client",
      },
      "services": [
        {
          "binding": "API",
          "service": "recetario-api-production",
        },
      ],
      "vars": {
        "NODE_ENV": "production"
      }
    }
  }
}
