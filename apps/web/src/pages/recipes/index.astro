---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { apiFetch, ApiError } from "@/lib/api-client";
import { z } from "zod";
import {
  recipeSummarySchema,
  recipeCreateResponseSchema,
  ingredientUsageMapSchema,
  usageCountsResponseSchema,
} from "@recetario/types";
import { canCreateRecipe, hasFeature } from "@recetario/billing";
import { timeAgo } from "@recetario/billing";
import EmptyState from "@/components/EmptyState.astro";
import RecipeMiniCard from "@/components/RecipeMiniCard.astro";
import RecipeGridCard from "@/components/RecipeGridCard.astro";
import RecipeStats from "@/components/RecipeStats.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";

import FeedbackAlert from "@/components/FeedbackAlert.astro";
import { validateCsrf } from "@recetario/auth";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const subscription = Astro.locals.subscription;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  if (!validateCsrf(Astro.request, formData)) {
    return Astro.redirect("/recipes");
  }

  const action = String(formData.get("action") || "");
  let createdRecipeId: number | null = null;

  if (action === "create_recipe") {
    const { recipes: recipeCount } = await apiFetch(
      "/api/usage-counts",
      { schema: usageCountsResponseSchema },
      Astro,
    );
    if (!canCreateRecipe(subscription, recipeCount)) {
      const errorUrl = new URL(Astro.url);
      errorUrl.searchParams.set("type", "error");
      errorUrl.searchParams.set("message", `Has alcanzado el limite de ${subscription.recipesLimit} recetas de tu plan Free. Actualiza tu plan para crear mas.`);
      errorUrl.searchParams.set("upgrade", "1");
      return Astro.redirect(errorUrl.toString());
    }

    try {
      const created = await apiFetch(
        "/api/recipes",
        {
          method: "POST",
          body: { name: String(formData.get("recipeName") || "") },
          schema: recipeCreateResponseSchema,
        },
        Astro,
      );
      createdRecipeId = created.id;
    } catch (error) {
      const message =
        error instanceof ApiError
          ? error.message
          : "No se pudo crear la receta.";
      const errorUrl = new URL(Astro.url);
      errorUrl.searchParams.set("type", "error");
      errorUrl.searchParams.set("message", message);
      return Astro.redirect(errorUrl.toString());
    }
  }

  if (action === "duplicate_recipe") {
    if (!hasFeature(Astro.locals.subscription, "recipe_duplicate")) {
      const errorUrl = new URL(Astro.url);
      errorUrl.searchParams.set("type", "error");
      errorUrl.searchParams.set("message", "Funcionalidad no disponible en tu plan.");
      return Astro.redirect(errorUrl.toString());
    }

    const recipeIdToDuplicate = Number(formData.get("recipeId"));
    if (Number.isFinite(recipeIdToDuplicate)) {
      try {
        const dupResult = await apiFetch(
          `/api/recipes/${recipeIdToDuplicate}/duplicate`,
          { method: "POST", schema: recipeCreateResponseSchema },
          Astro,
        );
        void dupResult;
        return Astro.redirect(`/recipes/${dupResult.id}?edit=true`);
      } catch (error) {
        const message =
          error instanceof ApiError && error.status === 404
            ? "No se encontró la receta original."
            : "Error al duplicar la receta.";
        const errorUrl = new URL(Astro.url);
        errorUrl.searchParams.set("type", "error");
        errorUrl.searchParams.set("message", message);
        return Astro.redirect(errorUrl.toString());
      }
    }
  }

  if (createdRecipeId !== null) {
    return Astro.redirect(`/recipes/${createdRecipeId}?edit=true`);
  }
}

const recipes = await apiFetch(
  "/api/recipes",
  { schema: z.array(recipeSummarySchema) },
  Astro,
);

const ingredientUsage = recipes.length > 0
  ? await apiFetch(
      "/api/ingredients/usage",
      { schema: ingredientUsageMapSchema },
      Astro,
    )
  : {};
const categoryCount = new Set(recipes.filter((r) => r.category).map((r) => r.category)).size;
const usedIngredientCount = Object.keys(ingredientUsage).length;

const selectedCategory = Astro.url.searchParams.get("category") ?? null;
const filteredRecipes = selectedCategory !== null
  ? recipes.filter((r) => (r.category ?? null) === (selectedCategory || null))
  : recipes;
const recipesJson = JSON.stringify(recipes);

const incompleteRecipes = recipes.filter((r) => r.ingredientCount === 0).length;
const noCategoryRecipes = recipes.filter((r) => !r.category).length;

const lastUpdated = recipes.reduce<string | null>((latest, r) => {
  if (!r.updatedAt) return latest;
  return !latest || r.updatedAt > latest ? r.updatedAt : latest;
}, null);
const lastUpdatedLabel = lastUpdated ? timeAgo(lastUpdated) : "Sin actividad";

const recentRecipes = recipes
  .filter((r) => r.updatedAt)
  .sort((a, b) => new Date(b.updatedAt!).getTime() - new Date(a.updatedAt!).getTime())
  .slice(0, 5)
  .map((r) => ({ id: r.id, name: r.name, category: r.category, timeAgo: timeAgo(r.updatedAt!) }));

const feedbackType = Astro.url.searchParams.get("type");
const feedbackMessage = Astro.url.searchParams.get("message");
const showUpgradeModal = Astro.url.searchParams.get("upgrade") === "1";
---

<Layout currentPage="recipes" showSideBar={true} breadcrumbs={[{ label: "Recetas" }]}>
  {
    feedbackType === "error" && feedbackMessage && (
      <div class="relative">
        <FeedbackAlert type="error" message={feedbackMessage} />
        <a href="/pricing" class="text-danger ml-2 font-bold underline">Actualizar plan</a>
      </div>
    )
  }

  {
    recipes.length === 0 ? (
      <Card padding="lg" class="mx-auto max-w-3xl p-8 shadow-md">
        <EmptyState
          icon="lucide:book-plus"
          iconSize={28}
          title="Todavia no tienes recetas"
          description="Entra por primera vez al recetario desde aqui y crea tu primera receta. El
          boton del sidebar ya funciona tambien para este estado vacio."
          titleTag="h1"
          titleClasses="mt-6 text-3xl font-black text-foreground"
          descClasses="mt-3 text-base text-muted-foreground"
        />

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button
            variant="primary"
            icon="plus"
            data-open-create-recipe-dialog="create-recipe-dialog"
          >
            Crear primera receta
          </Button>
          <Button variant="secondary" href="/ingredients" icon="package-search">
            Ver ingredientes
          </Button>
        </div>
      </Card>
    ) : (
      <div class="space-y-8">

        <RecipeStats
          recipeCount={recipes.length}
          categoryCount={categoryCount}
          ingredientCount={usedIngredientCount}
        />

        <div class="info-cards grid grid-cols-1 gap-3 sm:grid-cols-3">
          <Card padding="sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:alert-triangle" size={14} />
              Recetas por completar
            </div>
            {
              incompleteRecipes > 0 ? (
                <div class="mt-2">
                  <p class="font-bold text-foreground">{incompleteRecipes} recetas</p>
                  <p class="text-sm text-muted-foreground">sin ingredientes asignados</p>
                </div>
              ) : (
                <p class="mt-2 text-sm font-medium text-success">Todas tienen ingredientes</p>
              )
            }
          </Card>

          <Card padding="sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:tag" size={14} />
              Sin categoría
            </div>
            {
              noCategoryRecipes > 0 ? (
                <div class="mt-2">
                  <p class="font-bold text-foreground">{noCategoryRecipes} recetas</p>
                  <p class="text-sm text-muted-foreground">sin categoría asignada</p>
                </div>
              ) : (
                <p class="mt-2 text-sm font-medium text-success">Todas están categorizadas</p>
              )
            }
          </Card>

          <Card padding="sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:clock" size={14} />
              Última modificación
            </div>
            <p class="mt-2 font-bold text-foreground">
              {lastUpdatedLabel}
            </p>
          </Card>
        </div>

        {
          recentRecipes.length > 0 && (
            <div>
              <h2 class="mb-3 text-sm font-bold uppercase tracking-[0.12em] text-muted-foreground">
                Recientemente actualizadas
              </h2>
              <div class="flex gap-3 overflow-x-auto pb-3">
                {
                  recentRecipes.map((r, i) => (
                    <div style={`--stagger-index:${i}`} class="w-48 flex-none">
                      <RecipeMiniCard
                        id={r.id}
                        name={r.name}
                        category={r.category ?? undefined}
                        timeAgo={r.timeAgo}
                      />
                    </div>
                  ))
                }
              </div>
            </div>
          )
        }

        <div id="categories-container">
          <script type="application/json" id="recipes-data" is:inline set:html={recipesJson}></script>

          <div class="flex items-end justify-between gap-3 mb-3">
            <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-muted-foreground">
              Recetas
            </h2>
          </div>

          <div class="flex items-center gap-2 mb-3">
            <div class="relative flex-1">
              <label for="recipeSearch" class="sr-only">Buscar receta</label>
              <Icon name="lucide:search" size={18} class="text-subtle-foreground absolute top-1/2 left-3.5 -translate-y-1/2" />
              <input
                type="search"
                id="recipeSearch"
                placeholder="Buscar receta..."
                class="bg-background border-border focus:ring-accent-500/20 focus:border-accent-500 placeholder:text-subtle-foreground w-full rounded-xl border py-2.5 pr-4 pl-10 text-sm transition-colors focus:ring-2 focus:outline-none"
              />
            </div>
            <Button
              variant="primary"
              icon="plus"
              data-open-create-recipe-dialog="create-recipe-dialog"
              class="shrink-0"
            >
              <span class="hidden sm:inline">Nueva Receta</span>
            </Button>
          </div>

          <div class="flex items-center gap-2 overflow-x-auto pb-3 sm:flex-wrap sm:overflow-visible scrollbar-thin [-webkit-overflow-scrolling:touch]">
            {
              [...new Set(recipes.filter((r) => r.category).map((r) => r.category!))].map(
                (cat) => {
                  const count = recipes.filter((r) => r.category === cat).length;
                  const active = selectedCategory !== null && selectedCategory === cat;
                  return (
                    <button
                      type="button"
                      data-category={cat}
                      class={`filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold transition-colors shrink-0 ${active ? "bg-accent-600 text-white" : "bg-accent-50 text-accent-600 hover:bg-accent-100 border border-accent-200"} cursor-pointer`}
                    >
                      {cat}
                      <span class={`inline-flex min-w-5 items-center justify-center rounded-full px-1 text-[11px] font-bold ${active ? "bg-accent-500 text-white" : "bg-accent-200/50 text-accent-700"}`}>
                        {count}
                      </span>
                    </button>
                  );
                },
              )
            }
            {
              noCategoryRecipes > 0 && (
                <button
                  type="button"
                  data-category=""
                  class={`filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold transition-colors shrink-0 ${selectedCategory === "" ? "bg-accent-600 text-white" : "bg-muted text-muted-foreground hover:bg-border border border-border"} cursor-pointer`}
                >
                  Sin categoría
                  <span class={`inline-flex min-w-5 items-center justify-center rounded-full px-1 text-[11px] font-bold ${selectedCategory === "" ? "bg-accent-500 text-white" : "bg-border text-subtle-foreground"}`}>
                    {noCategoryRecipes}
                  </span>
                </button>
              )
            }
            <button
              type="button"
              id="clear-filter-btn"
              style={`display:${selectedCategory !== null ? "" : "none"}`}
              class="inline-flex items-center gap-1 rounded-full border border-border bg-card px-3 py-1.5 text-sm font-semibold text-muted-foreground transition-colors hover:bg-background shrink-0 cursor-pointer"
            >
              <Icon name="lucide:x" size={12} />
              Limpiar filtro
            </button>
          </div>

          <div id="filtered-grid-wrapper" class="mt-4">
            {
              filteredRecipes && filteredRecipes.length > 0 ? (
                <div id="filtered-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {filteredRecipes.map((r, i) => (
                    <div style={`--stagger-index:${i}`}>
                      <RecipeGridCard
                        id={r.id}
                        name={r.name}
                        category={r.category ?? undefined}
                        ingredientCount={r.ingredientCount}
                        canDuplicate={hasFeature(subscription, "recipe_duplicate")}
                      />
                    </div>
                  ))}
                </div>
              ) : (
                <Card padding="lg" class="p-8 text-center">
                  <p class="text-muted-foreground">No hay recetas en esta categoría</p>
                </Card>
              )
            }
          </div>
        </div>
      </div>
    )
  }

  <dialog
    data-animated
    id="create-recipe-dialog"
    class="fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0 shadow-2xl backdrop:bg-backdrop/50"
  >
    <form
      method="post"
      action="/recipes"
      data-astro-reload
      class="bg-card max-h-[calc(100dvh-2rem)] overflow-auto rounded-3xl border border-border p-6"
    >
      <input type="hidden" name="action" value="create_recipe" />
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken || ""} />
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-accent-500 text-xs font-black tracking-[0.18em] uppercase">Nueva receta</p>
          <h2 class="text-foreground mt-2 text-xl font-black">Escribe el nombre inicial</h2>
          <p class="text-muted-foreground mt-2 text-sm">Puedes cambiarlo después desde la vista de edición.</p>
        </div>
        <button
          type="button"
          data-close-create-recipe-dialog="create-recipe-dialog"
          class="border-border text-muted-foreground hover:bg-background hover:text-secondary-foreground inline-flex h-10 w-10 items-center justify-center rounded-xl border transition-colors"
          aria-label="Cerrar modal"
        >
          <Icon name="lucide:x" size={18} />
        </button>
      </div>
      <label class="text-secondary-foreground mt-6 block text-sm font-semibold" for="create-recipe-name">Nombre de la receta</label>
      <input id="create-recipe-name" name="recipeName" type="text" required maxlength="120" placeholder="Ej. Brownie clásico" class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-accent-500/20 mt-2 w-full rounded-xl border px-4 py-3 text-sm transition-colors outline-none focus:ring-2" />
      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <Button variant="secondary" data-close-create-recipe-dialog="create-recipe-dialog">Cancelar</Button>
        <Button variant="primary" icon="plus" type="submit">Crear receta</Button>
      </div>
    </form>
  </dialog>

  <dialog data-animated id="upgrade-modal" class="fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md rounded-3xl border border-border p-0 shadow-2xl backdrop:bg-backdrop/50">
    <div class="rounded-3xl bg-card p-6">
      <div class="flex items-start gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
          <Icon name="lucide:zap" size={18} />
        </div>
        <div>
          <h2 class="text-lg font-bold text-foreground">Limite alcanzado</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Has alcanzado el limite de {subscription.recipesLimit} recetas en tu plan {subscription.tier === 'free' ? 'Free' : subscription.tier}.
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            Actualiza a Basic o Pro para crear recetas ilimitadas.
          </p>
        </div>
      </div>
      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <Button variant="secondary" data-close-upgrade-modal>Entendido</Button>
        <Button variant="primary" icon="arrow-up-circle" href="/pricing">Ver planes</Button>
      </div>
    </div>
  </dialog>

  <script>

    function setupRecipeFilters() {
      const dataEl = document.getElementById("recipes-data");
      const searchInput = document.getElementById("recipeSearch");
      const pills = document.querySelectorAll<HTMLElement>(".filter-btn");
      const clearBtn = document.getElementById("clear-filter-btn");
      const gridWrapper = document.getElementById("filtered-grid-wrapper");

      if (!dataEl || !dataEl.textContent || !gridWrapper) return;
      if (gridWrapper.dataset.filterBound === "1") return;
      gridWrapper.dataset.filterBound = "1";

      const recipesData: { id: number; name: string; category: string | null; ingredientCount: number }[] = JSON.parse(dataEl.textContent);

      let activeSearchTerm = "";
      let activeCategory: string | null = null;

      const activeClasses = ["bg-accent-600", "text-white"];
      const inactiveClasses = {
        normal: ["bg-accent-50", "text-accent-600", "hover:bg-accent-100"],
        uncategorized: ["bg-muted", "text-muted-foreground", "hover:bg-border"],
      };

      function escapeHtml(str: string) {
        const d = document.createElement("div");
        d.textContent = str;
        return d.innerHTML;
      }

      function createCard(r: typeof recipesData[0]) {
        const a = document.createElement("a");
        a.href = `/recipes/${r.id}`;
        a.className = "recipe-grid-card block rounded-2xl border border-border bg-card p-5 shadow-sm hover:border-accent-300 hover:bg-accent-50/30 hover:shadow-md active:scale-[0.98] transition-all";
        a.style.setProperty("transition", "transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out), border-color 160ms var(--ease-out), background-color 160ms var(--ease-out)");
        a.innerHTML = `<div class="flex items-start gap-3"><div class="min-w-0"><h3 class="truncate font-bold text-secondary-foreground">${escapeHtml(r.name)}</h3><div class="mt-2 flex flex-wrap items-center gap-2">${r.category ? `<span class="bg-accent-50 text-accent-600 border-accent-200 inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold">${escapeHtml(r.category)}</span>` : ""}<span class="text-xs text-muted-foreground">${r.ingredientCount} ${r.ingredientCount === 1 ? "ingrediente" : "ingredientes"}</span></div></div></div>`;
        return a;
      }

      function updateGrid() {
        let filtered = recipesData;

        if (activeCategory !== null) {
          const catKey = activeCategory || "";
          filtered = filtered.filter((r) => (r.category || "") === catKey);
        }
        if (activeSearchTerm) {
          filtered = filtered.filter((r) => {
            const name = (r.name || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
            return name.includes(activeSearchTerm);
          });
        }

        if (filtered.length === 0) {
          gridWrapper!.innerHTML = `<div class="rounded-2xl border border-border bg-card p-8 text-center shadow-sm"><p class="text-muted-foreground text-sm">No se encontraron recetas</p></div>`;
          return;
        }

        const grid = document.createElement("div");
        grid.id = "filtered-grid";
        grid.className = "grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3";
        filtered.forEach((r, i) => {
          const card = createCard(r);
          card.style.setProperty("--stagger-index", String(i));
          grid.appendChild(card);
        });
        gridWrapper!.innerHTML = "";
        gridWrapper!.appendChild(grid);
      }

      function updatePillStyles(index: string | null) {
        pills.forEach((pill) => {
          const pillCat = pill.dataset.category ?? null;
          const isActive = pillCat === index;

          if (isActive) {
            pill.classList.remove(...inactiveClasses.normal, ...inactiveClasses.uncategorized);
            pill.classList.add(...activeClasses);
            const span = pill.querySelector("span");
            if (span) {
              span.classList.remove("bg-accent-200/50", "text-accent-700", "bg-border", "text-subtle-foreground");
              span.classList.add("bg-accent-500", "text-white");
            }
          } else {
            pill.classList.remove(...activeClasses);
            const useUncategorized = pillCat === "";
            const classes = useUncategorized ? inactiveClasses.uncategorized : inactiveClasses.normal;
            pill.classList.add(...classes);
            const span = pill.querySelector("span");
            if (span) {
              span.classList.remove("bg-accent-500", "text-white");
              if (useUncategorized) {
                span.classList.add("bg-border", "text-subtle-foreground");
              } else {
                span.classList.add("bg-accent-200/50", "text-accent-700");
              }
            }
          }
        });
        if (clearBtn) clearBtn.style.display = index === null ? "none" : "";
      }

      if (searchInput instanceof HTMLInputElement && searchInput.dataset.bound !== "1") {
        searchInput.dataset.bound = "1";
        searchInput.addEventListener("input", () => {
          activeSearchTerm = searchInput.value.trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
          updateGrid();
        });
      }

      pills.forEach((pill) => {
        if (!(pill instanceof HTMLElement)) return;
        if (pill.dataset.filterBound === "1") return;
        pill.dataset.filterBound = "1";
        pill.addEventListener("click", () => {
          const cat = pill.dataset.category ?? "";
          if (activeCategory === cat) {
            activeCategory = null;
            updatePillStyles(null);
          } else {
            activeCategory = cat;
            updatePillStyles(cat);
          }
          updateGrid();
          const url = activeCategory !== null ? `/recipes?category=${encodeURIComponent(activeCategory)}` : "/recipes";
          history.pushState({}, "", url);
        });
      });

      if (clearBtn instanceof HTMLElement && clearBtn.dataset.bound !== "1") {
        clearBtn.dataset.bound = "1";
        clearBtn.addEventListener("click", () => {
          activeCategory = null;
          updatePillStyles(null);
          updateGrid();
          history.pushState({}, "", "/recipes");
        });
      }
    }

    document.addEventListener("astro:page-load", setupRecipeFilters);
    document.addEventListener("astro:after-swap", setupRecipeFilters);
    setupRecipeFilters();

    function setupCreateRecipeDialog() {
      const dialogId = "create-recipe-dialog";
      const dialog = document.getElementById(dialogId);
      const nameInput = document.getElementById("create-recipe-name");
      const openButtons = document.querySelectorAll(`[data-open-create-recipe-dialog="${dialogId}"]`);
      const closeButtons = document.querySelectorAll(`[data-close-create-recipe-dialog="${dialogId}"]`);

      if (!(dialog instanceof HTMLDialogElement)) return;

      const openDialog = () => {
        const form = dialog.querySelector("form");
        if (form instanceof HTMLFormElement) form.reset();
        if (!dialog.open) dialog.showModal();
        if (nameInput instanceof HTMLInputElement) {
          requestAnimationFrame(() => nameInput.focus());
        }
      };

      const closeDialog = () => {
        if (dialog.open) dialog.close();
      };

      openButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (button.dataset.createRecipeBound === "1") return;
        button.dataset.createRecipeBound = "1";
        button.addEventListener("click", openDialog);
      });

      closeButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (button.dataset.createRecipeBound === "1") return;
        button.dataset.createRecipeBound = "1";
        button.addEventListener("click", closeDialog);
      });

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    }

    document.addEventListener("astro:page-load", setupCreateRecipeDialog);
    document.addEventListener("astro:after-swap", setupCreateRecipeDialog);
    setupCreateRecipeDialog();
  </script>
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes bannerSlideIn {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes infoCardFadeIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .info-cards > *:nth-child(1) {
      animation: infoCardFadeIn 0.2s var(--ease-out) both;
      animation-delay: 90ms;
    }
    .info-cards > *:nth-child(2) {
      animation: infoCardFadeIn 0.2s var(--ease-out) both;
      animation-delay: 150ms;
    }
    .info-cards > *:nth-child(3) {
      animation: infoCardFadeIn 0.2s var(--ease-out) both;
      animation-delay: 210ms;
    }
  }
</style>

{
  showUpgradeModal && (

  <script>
      requestAnimationFrame(() => {
        const modal = document.getElementById('upgrade-modal');
        if (modal instanceof HTMLDialogElement) {
          modal.showModal();
        }

        document.querySelectorAll('[data-close-upgrade-modal]').forEach(btn => {
          if (btn instanceof HTMLButtonElement && btn.dataset.bound !== '1') {
            btn.dataset.bound = '1';
            btn.addEventListener('click', () => {
              (document.getElementById('upgrade-modal') as HTMLDialogElement | null)?.close();
            });
          }
        });
      });
    </script>
  )
}
