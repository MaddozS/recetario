                  multiplier={multiplier}
                  costoProduccionRealBatch={presBatchCost}
                  precioVentaSugeridoBatch={presPrecioVentaSugerido}
                />
{/* PresentationFixedCosts hidden until presentation-level FC planning is complete */}
              </div>
            );
          })}
        </div>

        <dialog
          data-animated
          id={createPresentationDialogId}
          class="fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md max-h-[calc(100dvh-2rem)] rounded-3xl border border-border p-0 shadow-2xl backdrop:bg-backdrop/50"
        >
          <form
            method="post"
            action={Astro.url.pathname + Astro.url.search}
            class="max-h-[calc(100dvh-2rem)] overflow-auto rounded-3xl bg-card p-6"
          >
            <input type="hidden" name="action" value="create_presentation" />
            <input type="hidden" name="_csrf" value={Astro.locals.csrfToken || ""} />

            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.18em] text-accent-500">
                  Nueva presentación
                </p>
                <h2 class="mt-2 text-xl font-black text-foreground">
                  Define una nueva venta por pieza
                </h2>
                <p class="mt-2 text-sm text-muted-foreground">
                  Puedes ajustar nombre, rendimiento y precio desde la tarjeta después.
                </p>
              </div>
              <button
                type="button"
                data-close-create-presentation-dialog={createPresentationDialogId}
                class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-border text-muted-foreground transition-colors hover:bg-background hover:text-secondary-foreground"
                aria-label="Cerrar modal"
              >
                <Icon name="lucide:x" size={18} />
              </button>
            </div>

            <label
              class="mt-6 block text-sm font-semibold text-secondary-foreground"
              for="create-presentation-name"
            >
              Nombre de la presentación
            </label>
            <input
              id="create-presentation-name"
              name="presentationName"
              type="text"
              required
              maxlength="120"
              placeholder="Ej. Caja de 6"
              class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
            />

            <div class="mt-4 grid grid-cols-1 gap-1 sm:grid-cols-2">
              <div>
                <label
                  class="block text-sm font-semibold text-secondary-foreground"
                  for="create-presentation-units"
                >
                  Piezas por mezcla
                </label>
                <input
                  id="create-presentation-units"
                  name="unitsPerBatch"
                  type="number"
                  min="0.01"
                  step="0.01"
                  required
                  placeholder="12"
                  class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground font-mono outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
                />
              </div>

              <div>
                <label
                  class="block text-sm font-semibold text-secondary-foreground"
                  for="create-presentation-price"
                >
                  Precio de venta
                </label>
                <input
                  id="create-presentation-price"
                  name="salePrice"
                  type="number"
                  min="0"
                  step="0.01"
                  placeholder="Opcional"
                  class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground font-mono outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
                />
              </div>
            </div>

            <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
              <Button variant="secondary" data-close-create-presentation-dialog={createPresentationDialogId}>
                Cancelar
              </Button>
              <Button variant="primary" icon="plus" type="submit">
                Crear presentación
              </Button>
            </div>
          </form>
        </dialog>
      </div>
    </div>
  </div>

<script>
  import { bindDialogBackdrop } from "../../lib/dialog";

  const KEY = 'recetario.showComments';
  const presentationDialogId = 'create-presentation-dialog';

  const initEditToggle = () => {
    const root = document.getElementById('recipe-page-root');
    if (!root || root.dataset.editToggleBound === '1') return;
    root.dataset.editToggleBound = '1';

    // Snapshot of the original edit-form state (SSR values) so Cancel restores
    // the inputs even after the user edits them client-side.
    const nameInput = document.getElementById('recipe-name-input') as HTMLInputElement | null;
    const categoryInput = document.querySelector<HTMLInputElement>('input[name="category"]');
    const tbody = document.getElementById('edit-ingredients-tbody');
    const originalName = nameInput?.value ?? '';
    const originalCategory = categoryInput?.value ?? '';
    const originalRows: Array<{ id: string; qty: string; unit: string; comment: string; label: string }> = [];
    tbody?.querySelectorAll<HTMLElement>('.edit-ingredient-row').forEach((row) => {
      const select = row.querySelector<HTMLSelectElement>('select[name="ingredientId"]');
      const qty = row.querySelector<HTMLInputElement>('.quantity-input');
      const unit = row.querySelector<HTMLSelectElement>('.unit-select');
      const comment = row.querySelector<HTMLInputElement>('.comment-input');
      const search = row.querySelector<HTMLInputElement>('.ingredient-search-input');
      originalRows.push({
        id: select?.value ?? '',
        qty: qty?.value ?? '',
        unit: unit?.value ?? '',
        comment: comment?.value ?? '',
        label: search?.value ?? '',
      });
    });

    const setEditMode = (edit: boolean) => {
      root.querySelectorAll<HTMLElement>('[data-edit-toggle]').forEach((el) => {
        const isEdit = el.dataset.editToggle === 'edit';
        el.hidden = edit ? !isEdit : isEdit;
      });
      const form = document.getElementById('recipe-edit-form');
      if (form) form.classList.toggle('hidden', !edit);
      const commentsCheckbox = document.getElementById('toggle-comments');
      if (commentsCheckbox instanceof HTMLInputElement) commentsCheckbox.disabled = edit;
      root.dataset.editState = edit ? 'edit' : 'view';
    };

    const syncUrl = (edit: boolean) => {
      const url = new URL(window.location.href);
      if (edit) url.searchParams.set('edit', 'true');
      else url.searchParams.delete('edit');
      history.pushState({}, '', url.toString());
    };

    const resetEditForm = () => {
      if (nameInput) nameInput.value = originalName;
      if (categoryInput) categoryInput.value = originalCategory;
      if (tbody) {
        // Rebuild the original rows from the template (discards added rows).
        const template = document.getElementById('ingredient-row-template');
        if (template instanceof HTMLTemplateElement) {
          tbody.innerHTML = '';
          originalRows.forEach((row) => {
            const clone = template.content.cloneNode(true) as DocumentFragment;
            const select = clone.querySelector<HTMLSelectElement>('select[name="ingredientId"]');
            const qty = clone.querySelector<HTMLInputElement>('.quantity-input');
            const unit = clone.querySelector<HTMLSelectElement>('.unit-select');
            const comment = clone.querySelector<HTMLInputElement>('.comment-input');
            const search = clone.querySelector<HTMLInputElement>('.ingredient-search-input');
            const clear = clone.querySelector<HTMLElement>('.ingredient-picker-clear');
            if (select) select.value = row.id;
            if (qty) qty.value = row.qty;
            if (unit) unit.value = row.unit;
            if (comment) comment.value = row.comment;
            if (search) search.value = row.label;
            if (clear) clear.classList.toggle('hidden', !row.id);
            tbody.appendChild(clone);
          });
        }
      }
    };

    const toggleEdit = (edit: boolean) => {
      setEditMode(edit);
      syncUrl(edit);
      if (edit) {
        nameInput?.focus();
      } else {
        resetEditForm();
      }
    };

    // Initial state from URL (deep-link / reload with ?edit=true)
    const initialEdit = new URLSearchParams(window.location.search).get('edit') === 'true';
    setEditMode(initialEdit);

    document.addEventListener('recipe:edit-toggle', () => {
      const next = root.dataset.editState !== 'edit';
      toggleEdit(next);
    });

    const cancelBtn = document.getElementById('recipe-cancel-edit');
    cancelBtn?.addEventListener('click', () => toggleEdit(false));
  };

  const updateCommentControls = (show: boolean) => {
    const checkbox = document.getElementById('toggle-comments');
    if (checkbox instanceof HTMLInputElement) {
      checkbox.checked = show;
    }
  };

  const setVisibility = (show: boolean) => {
    document.querySelectorAll('.ingredient-comment').forEach((el) => {
      el.classList.toggle('hidden', !show);
    });
    updateCommentControls(show);

    try {
      localStorage.setItem(KEY, show ? '1' : '0');
    } catch {
      /* noop */
    }
  };

  const initCommentsToggle = () => {
    const checkbox = document.getElementById('toggle-comments');

    if (checkbox instanceof HTMLInputElement && checkbox.dataset.bound !== '1') {
      checkbox.dataset.bound = '1';
      checkbox.addEventListener('change', (e) => {
        const target = e.currentTarget;
        if (!(target instanceof HTMLInputElement)) return;
        setVisibility(target.checked);
      });
    }

    const stored = (typeof localStorage !== 'undefined' && localStorage.getItem(KEY)) === '1';
    setVisibility(stored);
  };

  const setupCreatePresentationDialog = () => {
    const dialog = document.getElementById(presentationDialogId);
    const nameInput = document.getElementById('create-presentation-name');
    const openButtons = document.querySelectorAll(
      `[data-open-create-presentation-dialog="${presentationDialogId}"]`,
    );
    const closeButtons = document.querySelectorAll(
      `[data-close-create-presentation-dialog="${presentationDialogId}"]`,
    );

    if (!(dialog instanceof HTMLDialogElement)) {
      return;
    }

    const openDialog = () => {
      const form = dialog.querySelector('form');
      if (form instanceof HTMLFormElement) {
        form.reset();
      }

      if (!dialog.open) {
        dialog.showModal();
      }

      if (nameInput instanceof HTMLInputElement) {
        requestAnimationFrame(() => nameInput.focus());
      }
    };

    const closeDialog = () => {
      if (dialog.dataset.submitting === '1' || dialog.getAttribute('aria-busy') === 'true') return;
      if (dialog.open) {
        dialog.close();
      }
    };

    openButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.dataset.createPresentationDialogBound === '1') return;

      button.dataset.createPresentationDialogBound = '1';
      button.addEventListener('click', openDialog);
    });

    closeButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.dataset.createPresentationDialogBound === '1') return;

      button.dataset.createPresentationDialogBound = '1';
      button.addEventListener('click', closeDialog);
    });

    if (dialog.dataset.createPresentationDialogBound === '1') {
      return;
    }

    dialog.dataset.createPresentationDialogBound = '1';
    bindDialogBackdrop(dialog);
  };

  const setupTabs = () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    if (!tabs.length) return;

    const panels = document.querySelectorAll<HTMLDivElement>('.tab-panel');

    const activateTab = (tabId: string) => {
      // Update tabs
      tabs.forEach(t => {
        const isSelected = t.dataset.tab === tabId;
        t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        t.classList.toggle('text-accent-600', isSelected);
        t.classList.toggle('border-accent-500', isSelected);
        t.classList.toggle('text-muted-foreground', !isSelected);
        t.classList.toggle('border-transparent', !isSelected);
        t.classList.toggle('hover:border-border', !isSelected);
      });

      // Update panels
      panels.forEach(p => {
        const isSelected = p.id === `panel-${tabId}`;
        p.hidden = !isSelected;
      });

      // Update hash
      if (window.location.hash !== `#${tabId}`) {
        history.replaceState(null, '', `#${tabId}`);
      }

    };

    // Clean up _fc search param if present in URL
    const currentUrl = new URL(window.location.href);
    if (currentUrl.searchParams.has('_fc')) {
      currentUrl.searchParams.delete('_fc');
      history.replaceState(null, '', currentUrl.toString());
    }

    // Get initial tab from hash or default to ingredientes
    const initialTab = window.location.hash?.replace('#', '') || 'ingredientes';
    activateTab(initialTab);

    // Tab click handlers
    tabs.forEach(tab => {
      if (tab.dataset.tabsBound === '1') return;
      tab.dataset.tabsBound = '1';

      tab.addEventListener('click', () => {
        const tabId = tab.dataset.tab;
        if (tabId) activateTab(tabId);
      });
    });

    // Keyboard navigation
    const tabList = document.getElementById('recipe-tabs');
    if (tabList && tabList.dataset.tabsKeyboardBound !== '1') {
      tabList.dataset.tabsKeyboardBound = '1';
      tabList.addEventListener('keydown', (e) => {
        const currentTab = document.activeElement as HTMLButtonElement;
        if (!currentTab?.classList.contains('tab-btn')) return;

        const tabIds = ['ingredientes', 'costos-fijos', 'presentaciones'];
        const currentIndex = tabIds.indexOf(currentTab.dataset.tab || '');
        let nextIndex = -1;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIndex = (currentIndex + 1) % tabIds.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIndex = (currentIndex - 1 + tabIds.length) % tabIds.length;
        }

        if (nextIndex >= 0) {
          activateTab(tabIds[nextIndex]);
          const nextTab = document.querySelector<HTMLButtonElement>(`[data-tab="${tabIds[nextIndex]}"]`);
          nextTab?.focus();
        }
      });
    }

    // Hash change listener
    const handleHashChange = () => {
      const currentTabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
      if (!currentTabs.length) return;

      const hash = window.location.hash?.replace('#', '') || 'ingredientes';
      if (['ingredientes', 'costos-fijos', 'presentaciones'].includes(hash)) {
        activateTab(hash);
      }
    };

    if (tabList && !tabList.dataset.hashChangeBound) {
      window.addEventListener('hashchange', handleHashChange);
      tabList.dataset.hashChangeBound = '1';
    }
  };

  document.addEventListener('astro:page-load', initCommentsToggle);
  document.addEventListener('astro:after-swap', initCommentsToggle);
  document.addEventListener('astro:page-load', setupCreatePresentationDialog);
  document.addEventListener('astro:after-swap', setupCreatePresentationDialog);
  document.addEventListener('astro:page-load', setupTabs);
  document.addEventListener('astro:after-swap', setupTabs);
  document.addEventListener('astro:page-load', initEditToggle);
  document.addEventListener('astro:after-swap', initEditToggle);

</script>

{/* The template and editor script are always present so the client-side
    edit toggle can clone rows / initialize the picker instantly. */}
<template id="ingredient-row-template">
    <div class="edit-ingredient-row grid grid-cols-1 gap-3 rounded-2xl border border-border bg-background/50 p-3 md:grid-cols-[minmax(0,2.4fr)_minmax(0,13rem)_minmax(0,1fr)_3rem] md:items-center md:bg-card md:p-0 md:border-0 md:rounded-none md:border-b md:border-border-light md:pb-3">
      <div class="space-y-1 min-w-0">
        <label class="text-[10px] uppercase font-bold text-subtle-foreground md:hidden">Ingrediente</label>
        <div class="ingredient-picker relative" data-ingredient-picker>
          <select name="ingredientId" form={recipeEditFormId} class="hidden">
            {allIngredients.map(i => (
              <option value={i.id} data-unit={i.unit}>{formatIngredientLabel(i)}</option>
            ))}
          </select>
          <div class="relative">
            <input type="text"
              class="ingredient-search-input w-full bg-card md:bg-background border border-border rounded-xl pl-9 pr-8 p-2 text-sm font-semibold text-secondary-foreground focus:ring-2 focus:ring-accent-500/20 placeholder:text-muted-foreground"
              placeholder="Buscar..."
              autocomplete="off"
              value=""
            />
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <button type="button" class="ingredient-picker-clear absolute right-2 top-1/2 -translate-y-1/2 hidden" aria-label="Limpiar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </div>
          <div class="ingredient-dropdown hidden absolute z-50 left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-card border border-border rounded-xl shadow-lg">
            {allIngredients.map(i => {
              const displayName = formatIngredientLabel(i);
              return (
                <button type="button" class="ingredient-option w-full text-left px-3 py-2 text-sm text-secondary-foreground hover:bg-accent-50 hover:text-accent-600 transition-colors flex items-center justify-between gap-2" data-value={i.id} data-unit={i.unit} data-name={displayName}>
                  <span class="font-medium">{i.name}</span>
                  {i.brand ? <span class="text-xs text-subtle-foreground">({i.brand})</span> : null}
                </button>
              );
            })}
          </div>
        </div>
      </div>
      <div class="space-y-1 min-w-0">
        <label class="text-[10px] uppercase font-bold text-subtle-foreground md:hidden">Cantidad</label>
        <div class="grid min-w-0 grid-cols-[minmax(0,1fr)_5.5rem] items-center gap-2">
          <input type="number" step="0.01" name="quantity" form={recipeEditFormId} class="quantity-input w-full min-w-0 bg-card border border-border rounded-xl p-2 text-center font-bold text-secondary-foreground focus:ring-2 focus:ring-accent-500/20" value="1" />
          <select name="unit" form={recipeEditFormId} class="unit-select w-full min-w-0 bg-card border border-border rounded-xl p-2 text-sm text-muted-foreground focus:ring-2 focus:ring-accent-500/20">
            {getUnitOptionsForValue('').map((unitOption, index) => (
              <option value={unitOption.value} selected={index === 0}>{unitOption.label}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="space-y-1 min-w-0">
        <label class="text-[10px] uppercase font-bold text-subtle-foreground md:hidden">Notas</label>
        <input type="text" name="comment" form={recipeEditFormId} class="comment-input w-full bg-card border border-border rounded-xl p-2 text-sm text-muted-foreground focus:ring-2 focus:ring-accent-500/20" value="" placeholder="Opcional" />
      </div>
      <div class="flex items-center justify-end md:justify-center">
        <button type="button" class={ingredientRemoveButtonClasses} aria-label="Eliminar ingrediente">
          <Icon name="lucide:trash-2" size={18} />
        </button>
      </div>
    </div>
  </template>

  <script is:inline>
    function setupRecipeEditor() {
      const addBtn = document.getElementById('add-ingredient-btn');
      const tbody = document.getElementById('edit-ingredients-tbody');
      const template = document.getElementById('ingredient-row-template');

      if (addBtn && tbody && template && addBtn.dataset.bound !== '1') {
        addBtn.dataset.bound = '1';
        addBtn.addEventListener('click', () => {
          const clone = template.content.cloneNode(true);
          tbody.appendChild(clone);
        });
      }

      if (tbody && tbody.dataset.bound !== '1') {
        tbody.dataset.bound = '1';
        tbody.addEventListener('click', (e) => {
          const removeBtn = e.target.closest('.remove-ingredient-btn');
          if (removeBtn) {
            const row = removeBtn.closest('.edit-ingredient-row');
            if (row) row.remove();
          }
        });
      }

      const form = document.getElementById('recipe-edit-form');
      if (form instanceof HTMLFormElement && form.dataset.bound !== '1') {
        form.dataset.bound = '1';
        form.addEventListener('submit', (event) => {
          const tbody = document.getElementById('edit-ingredients-tbody');
          if (tbody) {
            tbody.querySelectorAll('.edit-ingredient-row').forEach((row) => {
              const select = row.querySelector<HTMLSelectElement>('select[name="ingredientId"]');
              const input = row.querySelector<HTMLInputElement>('.ingredient-search-input');
              if (select && input && input.value.trim() && !select.value) {
                const query = input.value.trim().toLowerCase();
                const dropdown = row.querySelector('.ingredient-dropdown');
                const options = dropdown?.querySelectorAll<HTMLElement>('.ingredient-option');
                let matchedVal = '';
                options?.forEach((opt) => {
                  const name = (opt.dataset.name || opt.textContent || '').toLowerCase();
                  if (!matchedVal && (name.includes(query) || query.includes(name))) {
                    matchedVal = opt.dataset.value || '';
                  }
                });
                if (matchedVal) select.value = matchedVal;
              }
            });
          }

          const rows = document.querySelectorAll(
            `[name="quantity"][form="${form.id}"]`,
          );
          const hasAtLeastOneIngredient = rows.length > 0;

          if (!hasAtLeastOneIngredient) {
            event.preventDefault();
            window.alert('Agrega al menos un ingrediente antes de guardar.');
          }
        });
      }

      // Ingredient picker — event delegation
      if (tbody && tbody.dataset.pickerBound !== '1') {
        tbody.dataset.pickerBound = '1';

        const closeAllDropdowns = () => {
          tbody.querySelectorAll('.ingredient-dropdown').forEach(d => d.classList.add('hidden'));
        };

        tbody.addEventListener('focusin', (e) => {
          const input = e.target.closest('.ingredient-search-input');
          if (input) {
            closeAllDropdowns();
            const picker = input.closest('.ingredient-picker');
            const dropdown = picker?.querySelector('.ingredient-dropdown');
            if (dropdown) dropdown.classList.remove('hidden');
          }
        });

        tbody.addEventListener('input', (e) => {
          const input = e.target.closest('.ingredient-search-input');
          if (!input) return;
          const picker = input.closest('.ingredient-picker');
          if (!picker) return;
          const dropdown = picker.querySelector('.ingredient-dropdown');
          const clearBtn = picker.querySelector('.ingredient-picker-clear');
          const query = input.value.toLowerCase().trim();

          if (clearBtn) clearBtn.classList.toggle('hidden', !query);

          const options = dropdown?.querySelectorAll('.ingredient-option');
          if (!options) return;
          let hasVisible = false;
          options.forEach(opt => {
            const text = (opt.dataset.name || opt.textContent || '').toLowerCase();
            const match = !query || text.includes(query);
            opt.classList.toggle('hidden', !match);
            if (match) hasVisible = true;
          });
          if (!hasVisible && dropdown) dropdown.classList.add('hidden');
          else if (dropdown) dropdown.classList.remove('hidden');
        });

        tbody.addEventListener('click', (e) => {
          const option = e.target.closest('.ingredient-option');
          if (!option) return;
          const picker = option.closest('.ingredient-picker');
          if (!picker) return;
          const select = picker.querySelector('select');
          const input = picker.querySelector('.ingredient-search-input');
          const dropdown = picker.querySelector('.ingredient-dropdown');
          const clearBtn = picker.querySelector('.ingredient-picker-clear');

          const val = option.dataset.value;
          const unit = option.dataset.unit;
          if (select && val) {
            select.value = val;
            select.dispatchEvent(new Event('change', { bubbles: true }));
          }
          if (input) input.value = option.dataset.name || option.textContent?.trim() || '';
          if (dropdown) dropdown.classList.add('hidden');
          if (clearBtn) clearBtn.classList.remove('hidden');

          const row = picker.closest('.edit-ingredient-row');
          const unitSelect = row?.querySelector<HTMLSelectElement>('.unit-select');
          if (unitSelect && unit) {
            unitSelect.value = unit;
          }
        });

        tbody.addEventListener('click', (e) => {
          const clearBtn = e.target.closest('.ingredient-picker-clear');
          if (!clearBtn) return;
          const picker = clearBtn.closest('.ingredient-picker');
          if (!picker) return;
          const select = picker.querySelector('select');
          const input = picker.querySelector('.ingredient-search-input');
          const dropdown = picker.querySelector('.ingredient-dropdown');
          const options = dropdown?.querySelectorAll('.ingredient-option');
          if (select) select.value = '';
          if (input) input.value = '';
          if (options) options.forEach(opt => opt.classList.remove('hidden'));
          if (clearBtn) clearBtn.classList.add('hidden');
          if (dropdown) dropdown.classList.add('hidden');
        });

        document.addEventListener('click', (e) => {
          const picker = e.target.closest('.ingredient-picker');
          if (!picker) closeAllDropdowns();
        });
      }

      // Close dropdowns on Escape
      if (document.body && document.body.dataset.escPickerBound !== '1') {
        document.body.dataset.escPickerBound = '1';
        document.body.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const tbody = document.getElementById('edit-ingredients-tbody');
          if (tbody) {
            tbody.querySelectorAll('.ingredient-dropdown').forEach(d => d.classList.add('hidden'));
          }
        });
      }
    }

    document.addEventListener('astro:page-load', setupRecipeEditor);
    document.addEventListener('astro:after-swap', setupRecipeEditor);
    setupRecipeEditor();
  </script>

</Layout>
