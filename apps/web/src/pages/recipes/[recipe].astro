---
import type {
  RecipeWithIngredients,
  RecipePresentation,
} from '@recetario/types';
import { z } from 'zod';
import {
  recipeCreateResponseSchema,
  presentationSchema,
  recipeFixedCostSchema,
  presentationFixedCostSchema,
  ingredientSchema,
  recipeWithIngredientsSchema,
} from '@recetario/types';
import Icon from "@/components/atoms/Icon.astro";
import Layout from "../../layouts/Layout.astro";
import PresentationCard from "../../components/organisms/recipes/PresentationCard.astro";
import { apiFetch, ApiError } from "@/lib/api-client";
import { hasFeature } from '@recetario/stripe';
import { parseNumberInput } from '@/lib/form-utils';
import { validateCsrf } from '@recetario/auth';
import { UNIT_OPTIONS } from '@/lib/constants';
import {
  aplicarRedondeoUnidadPequena,
  buildFinancialRows as buildRecipeFinancialRows,
  calcularCostoDirecto,
  calcularSubtotalIngrediente,
  computeFixedCostAmount,
} from '@/lib/recipe-financials';
import FeedbackAlert from '../../components/molecules/shared/FeedbackAlert.astro';
import Button from "../../components/atoms/Button.astro";
import Badge from "../../components/atoms/Badge.astro";
import FinancialSummary from "../../components/organisms/shared/FinancialSummary.astro";
import SectionHeading from "../../components/atoms/SectionHeading.astro";
import Card from "../../components/molecules/shared/Card.astro";


import RecipeActionsMenu from "../../components/molecules/recipes/RecipeActionsMenu.astro";
import RecipeFixedCosts from "../../components/molecules/recipes/RecipeFixedCosts.astro";

const recipeIdParam = Astro.params.recipe;
const recipeIdNumber = Number(recipeIdParam);

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect('/sign-in');
}

const subscription = Astro.locals.subscription;

const expectsJsonResponse = Astro.request.headers.get('accept')?.includes('application/json') ?? false;

const buildPresentationSectionUrl = (feedback?: { type: 'success' | 'error'; message: string }) => {
  const nextUrl = new URL(Astro.url);

  if (feedback) {
    nextUrl.searchParams.set('type', feedback.type);
    nextUrl.searchParams.set('message', feedback.message);
  } else {
    nextUrl.searchParams.delete('type');
    nextUrl.searchParams.delete('message');
  }

  nextUrl.hash = '#presentaciones';
  return `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`;
};

const redirectToPresentationSection = (feedback?: { type: 'success' | 'error'; message: string }) => (
  Astro.redirect(buildPresentationSectionUrl(feedback))
);

const buildRecipePageUrl = (feedback?: { type: 'success' | 'error'; message: string }) => {
  const nextUrl = new URL(Astro.url);

  if (feedback) {
    nextUrl.searchParams.set('type', feedback.type);
    nextUrl.searchParams.set('message', feedback.message);
  } else {
    nextUrl.searchParams.delete('type');
    nextUrl.searchParams.delete('message');
  }

  nextUrl.hash = '';
  return `${nextUrl.pathname}${nextUrl.search}`;
};

const redirectToRecipePage = (feedback?: { type: 'success' | 'error'; message: string }) => (
  Astro.redirect(buildRecipePageUrl(feedback))
);

const jsonResponse = (body: unknown, status = 200) => new Response(JSON.stringify(body), {
  status,
  headers: {
    'Content-Type': 'application/json',
  },
});

const respondPresentationError = (message: string, status = 400) => {
  if (expectsJsonResponse) {
    return new Response(message, { status });
  }
  return redirectToPresentationSection({ type: 'error', message });
};

const respondRecipeError = (message: string, status = 500) => {
  if (expectsJsonResponse) {
    return jsonResponse({ error: message }, status);
  }
  return redirectToRecipePage({ type: 'error', message });
};

const getPresentationFormErrorMessage = (error: unknown, fallback: string) => {
  if (!(error instanceof Error) || !error.message) {
    return fallback;
  }

  switch (error.message) {
    case 'Invalid presentation name':
      return 'El nombre de la presentación es obligatorio.';
    case 'Invalid presentation units':
      return 'Las piezas por mezcla deben ser mayores a 0.';
    case 'Invalid presentation sale price':
      return 'El precio de venta debe ser 0 o mayor.';
    case 'Recipe not found':
      return 'No se encontró la receta.';
    default:
      return fallback;
  }
};

// Recalcula las filas del FinancialSummary tras una mutación de costos
// fijos, para que la cabecera se actualice sin recargar la página.
// Best-effort: si falla, se omite el resumen y el guardado no se rompe.
const buildRecipeSummaryRows = async (recipeId: number) => {
  try {
    const detail = await apiFetch(
      `/api/recipes/${recipeId}`,
      { schema: recipeWithIngredientsSchema },
      Astro,
    );
    const multiplierValue = Math.max(
      parseFloat(Astro.url.searchParams.get('multiplier') ?? '1') || 1,
      0.01,
    );
    const clampPct = (value: number, max = Number.POSITIVE_INFINITY) =>
      !Number.isFinite(value) ? 0 : Math.min(max, Math.max(0, value));
    const directCost = calcularCostoDirecto(detail.ingredients, multiplierValue);
    const { rows } = buildRecipeFinancialRows({
      hasAdvancedCosts: hasFeature(subscription, 'advanced_costs'),
      costoDirectoTotal: directCost,
      recipeFixedCosts: detail.recipeFixedCosts ?? [],
      multiplier: multiplierValue,
      fixedCostsPercentageValue: clampPct(detail.fixedCostsPercentage),
      desiredMarginValue: clampPct(detail.desiredMargin, 99.99),
    });
    return rows.map((row) => ({
      label: row.label,
      value: row.value,
      secondaryValue: row.secondaryValue,
    }));
  } catch (error) {
    console.error('No se pudo recalcular el resumen financiero:', error);
    return [];
  }
};

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  if (!validateCsrf(Astro.request, formData)) {
    return Astro.redirect(Astro.url.pathname);
  }

  const action = String(formData.get('action') || '');

  if (action === 'update_presentation') {
    const presId = Number(formData.get('presentationId'));
    const presentationName = String(formData.get('presentationName') || '');
    const unitsPerBatch = parseNumberInput(formData.get('unitsPerBatch'));
    const rawSalePrice = String(formData.get('salePrice') ?? '').trim();
    const salePrice = parseNumberInput(formData.get('salePrice'));
    const nextSalePrice = formData.has('salePrice')
      ? rawSalePrice === ''
        ? null
        : salePrice
      : undefined;

    if (!Number.isFinite(recipeIdNumber) || !Number.isFinite(presId)) {
      return respondPresentationError('No se pudo actualizar la presentación.');
    }

    try {
      const presentation = await apiFetch(
        `/api/recipes/${recipeIdNumber}/presentations/${presId}`,
        {
          method: 'PATCH',
          body: {
            name: presentationName,
            unitsPerBatch,
            salePrice: nextSalePrice,
          },
          schema: presentationSchema,
        },
        Astro,
      );
      void presentation;

      if (expectsJsonResponse) {
        return jsonResponse({ presentation: presentation });
      }

      return redirectToPresentationSection();
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        return respondPresentationError('No se encontró la presentación.', 404);
      }
      return respondPresentationError(
        getPresentationFormErrorMessage(error, 'No se pudo actualizar la presentación.'),
      );
    }
  } else if (action === 'delete_presentation') {
    const presId = Number(formData.get('presentationId'));

    if (!Number.isFinite(recipeIdNumber) || !Number.isFinite(presId)) {
      return respondPresentationError('No se pudo eliminar la presentación.');
    }

    try {
      await apiFetch(
        `/api/recipes/${recipeIdNumber}/presentations/${presId}`,
        { method: 'DELETE' },
        Astro,
      );

      if (expectsJsonResponse) {
        return jsonResponse({ deleted: true, presentationId: presId });
      }

      return redirectToPresentationSection({ type: 'success', message: 'Presentación eliminada correctamente.' });
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        return respondPresentationError('No se encontró la presentación.', 404);
      }
      return respondPresentationError('No se pudo eliminar la presentación.');
    }
  } else if (action === 'create_presentation') {
    const presentationName = String(formData.get('presentationName') || '').trim();
    const unitsPerBatch = parseNumberInput(formData.get('unitsPerBatch'));
    const salePriceValue = String(formData.get('salePrice') || '').trim();
    const salePrice = parseNumberInput(formData.get('salePrice'));

    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    if (!presentationName) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'El nombre de la presentación es obligatorio.',
      });
    }

    if (!Number.isFinite(unitsPerBatch) || unitsPerBatch <= 0) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'Las piezas por mezcla deben ser mayores a 0.',
      });
    }

    if (salePriceValue && (!Number.isFinite(salePrice) || salePrice < 0)) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'El precio de venta debe ser 0 o mayor.',
      });
    }

    try {
      await apiFetch(
        `/api/recipes/${recipeIdNumber}/presentations`,
        {
          method: 'POST',
          body: {
            name: presentationName,
            unitsPerBatch,
            salePrice: salePriceValue ? salePrice : undefined,
          },
          schema: presentationSchema,
        },
        Astro,
      );
      return redirectToPresentationSection();
    } catch (error) {
      return redirectToPresentationSection({
        type: 'error',
        message: getPresentationFormErrorMessage(error, 'No se pudo crear la presentación.'),
      });
    }
  } else if (action === 'delete_recipe') {
    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    try {
      await apiFetch(
        `/api/recipes/${recipeIdNumber}`,
        { method: 'DELETE' },
        Astro,
      );
      return Astro.redirect('/recipes');
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        return Astro.redirect('/recipes');
      }
      return redirectToRecipePage({
        type: 'error',
        message: 'No se pudo eliminar la receta.',
      });
    }
  } else if (action === 'update_recipe') {
    if (Number.isFinite(recipeIdNumber)) {
      let currentRecipe: RecipeWithIngredients | null;
      try {
        currentRecipe = await apiFetch<RecipeWithIngredients>(`/api/recipes/${recipeIdNumber}`, {}, Astro);
      } catch {
        currentRecipe = null;
      }

      const rawName = String(formData.get('recipeName') || formData.get('name') || '').trim();
      const name = rawName || currentRecipe?.name || 'Receta';

      const ingredientIds = formData.getAll('ingredientId').map(String);
      const quantities = formData.getAll('quantity').map(String);
      const units = formData.getAll('unit').map(String);
      const comments = formData.getAll('comment').map(String);

      const ingredientsToSave = [];
      for (let i = 0; i < ingredientIds.length; i++) {
        const id = Number(ingredientIds[i]);
        const q = parseNumberInput(quantities[i]);
        if (Number.isFinite(id) && id > 0 && Number.isFinite(q) && q > 0) {
          const unit = (units[i] || '').trim() || 'unidad';
          ingredientsToSave.push({
            ingredientId: id,
            quantity: q,
            unit,
            comment: comments[i] ? String(comments[i]).trim() : undefined,
          });
        }
      }

      const parsedMargin = parseNumberInput(formData.get('desiredMargin'));
      const desiredMargin = Number.isFinite(parsedMargin) && parsedMargin >= 0 && parsedMargin < 100
        ? parsedMargin
        : (currentRecipe?.desiredMargin ?? 0);

      const parsedFcPct = parseNumberInput(formData.get('fixedCostsPercentage'));
      const fixedCostsPercentage = Number.isFinite(parsedFcPct) && parsedFcPct >= 0
        ? parsedFcPct
        : (currentRecipe?.fixedCostsPercentage ?? 0);

      const category = String(formData.get('category') || '').trim() || null;

      try {
        await apiFetch(`/api/recipes/${recipeIdNumber}`, {
          method: 'PATCH',
          body: {
            name,
            category,
            desiredMargin,
            fixedCostsPercentage,
            ingredients: ingredientsToSave,
          },
        }, Astro);
        return Astro.redirect(Astro.url.pathname);
      } catch (error) {
        const message = error && typeof error === 'object' && 'message' in error
          ? String((error as { message: string }).message)
          : 'No se pudo actualizar la receta.';
        return redirectToRecipePage({ type: 'error', message });
      }
    }
  } else if (action === 'duplicate_recipe') {
    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    if (!hasFeature(subscription, 'recipe_duplicate')) {
      if (expectsJsonResponse) {
        return jsonResponse({ error: 'Funcionalidad no disponible en tu plan.' }, 403);
      }
      return redirectToRecipePage({ type: 'error', message: 'Funcionalidad no disponible en tu plan.' });
    }

    try {
      const duplicated = await apiFetch(
        `/api/recipes/${recipeIdNumber}/duplicate`,
        { method: 'POST', schema: recipeCreateResponseSchema },
        Astro,
      );
      const redirectUrl = new URL(Astro.url);
      redirectUrl.pathname = `/recipes/${duplicated.id}`;
      redirectUrl.searchParams.set('edit', 'true');
      redirectUrl.searchParams.set('type', 'success');
      redirectUrl.searchParams.set('message', `Receta "${duplicated.name}" creada exitosamente.`);
      return Astro.redirect(redirectUrl.toString());
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        return respondRecipeError('No se encontró la receta original.', 404);
      }
      return respondRecipeError('Error al duplicar la receta.', 500);
    }
  } else if (action === 'create_recipe_fixed_cost') {
    if (!expectsJsonResponse) {
      return new Response('Expected JSON request', { status: 400 });
    }
    const fcRecipeId = Number(formData.get('recipeId') || formData.get('ownerId'));
    if (!Number.isFinite(fcRecipeId)) {
      return new Response('Invalid request', { status: 400 });
    }
    try {
      const name = String(formData.get('name') || '').trim() || 'Costo Fijo';
      const type = String(formData.get('type') || 'AMOUNT');
      const base = String(formData.get('base') || 'PER_BATCH');
      const value = parseNumberInput(formData.get('value'));
      const hoursRaw = formData.has('hours') ? formData.get('hours') : null;
      const parsedHours = hoursRaw !== null && hoursRaw !== '' ? parseNumberInput(hoursRaw) : null;
      const hours = parsedHours !== null && Number.isFinite(parsedHours) ? parsedHours : null;

      const created = await apiFetch(
        `/api/recipes/${fcRecipeId}/fixed-costs`,
        {
          method: 'POST',
          body: {
            name,
            type,
            base,
            value: Number.isFinite(value) ? value : 0,
            hours,
          },
          schema: recipeFixedCostSchema,
        },
        Astro,
      );

      return jsonResponse({
        fixedCost: {
          id: created.id,
          name: created.name,
          type: created.type,
          base: created.base,
          value: created.value,
          hours: created.hours,
        },
        summary: await buildRecipeSummaryRows(fcRecipeId),
      });
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        return new Response('Recipe not found', { status: 404 });
      }
      return new Response('Error al crear el costo fijo', { status: 500 });
    }
  } else if (action === 'create_presentation_fixed_cost') {
    if (!expectsJsonResponse) {
      return new Response('Expected JSON request', { status: 400 });
    }
    const presId = Number(formData.get('presentationId') || formData.get('ownerId'));
    if (!Number.isFinite(presId)) {
      return new Response('Invalid request', { status: 400 });
    }
    try {
      const name = String(formData.get('name') || '').trim() || 'Costo Fijo';
      const type = String(formData.get('type') || 'AMOUNT');
      const base = String(formData.get('base') || 'PER_BATCH');
      const value = parseNumberInput(formData.get('value'));

      const created = await apiFetch(
        `/api/presentations/${presId}/fixed-costs`,
        {
          method: 'POST',
          body: {
            name,
            type,
            base,
            value: Number.isFinite(value) ? value : 0,
          },
          schema: presentationFixedCostSchema,
        },
        Astro,
      );

      return jsonResponse({
        fixedCost: {
          id: created.id,
          name: created.name,
          type: created.type,
          base: created.base,
          value: created.value,
          hours: null,
        },
      });
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        return new Response('Presentation not found', { status: 404 });
      }
      return new Response('Error al crear el costo fijo', { status: 500 });
    }
  } else if (action === 'update_fixed_cost') {
    if (!expectsJsonResponse) {
      return new Response('Expected JSON request', { status: 400 });
    }
    const fixedCostId = Number(formData.get('fixedCostId'));
    const ownerType = String(formData.get('ownerType') || '');
    if (!Number.isFinite(fixedCostId) || !ownerType) {
      return new Response('Invalid request', { status: 400 });
    }
    try {
      const name = String(formData.get('name') || '').trim();
      const type = String(formData.get('type') || 'AMOUNT');
      const base = String(formData.get('base') || 'PER_BATCH');
      const value = parseNumberInput(formData.get('value'));
      const hoursRaw = formData.has('hours') ? formData.get('hours') : null;
      const parsedHours = hoursRaw !== null && hoursRaw !== '' ? parseNumberInput(hoursRaw) : null;
      const hours = parsedHours !== null && Number.isFinite(parsedHours) ? parsedHours : null;

      if (!Number.isFinite(value) || value < 0) {
        return new Response('El valor debe ser un número mayor o igual a 0', { status: 400 });
      }

      const targetRecipeId =
        Number(formData.get('recipeId') || formData.get('ownerId')) || recipeIdNumber;

      if (ownerType === 'recipe') {
        if (!Number.isFinite(targetRecipeId)) {
          return new Response('Invalid request', { status: 400 });
        }
        await apiFetch(
          `/api/recipes/${targetRecipeId}/fixed-costs/${fixedCostId}`,
          {
            method: 'PATCH',
            body: { name, type, base, value, hours },
            schema: recipeFixedCostSchema,
          },
          Astro,
        );
      } else {
        const presId = Number(formData.get('presentationId') || formData.get('ownerId'));
        if (!Number.isFinite(presId) || presId <= 0) {
          return new Response('Invalid request', { status: 400 });
        }
        await apiFetch(
          `/api/presentations/${presId}/fixed-costs/${fixedCostId}`,
          {
            method: 'PATCH',
            body: { name, type, base, value },
            schema: presentationFixedCostSchema,
          },
          Astro,
        );
      }

      return jsonResponse({
        fixedCost: { name, type, base, value, hours: ownerType === 'recipe' ? hours : null },
        ...(ownerType === 'recipe' && { summary: await buildRecipeSummaryRows(targetRecipeId) }),
      });
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        return new Response('Fixed cost not found', { status: 404 });
      }
      return new Response('Error al actualizar el costo fijo', { status: 500 });
    }
  } else if (action === 'delete_fixed_cost') {
    if (!expectsJsonResponse) {
      return new Response('Expected JSON request', { status: 400 });
    }
    const fixedCostId = Number(formData.get('fixedCostId'));
    const ownerType = String(formData.get('ownerType') || '');
    if (!Number.isFinite(fixedCostId) || !ownerType) {
      return new Response('Invalid request', { status: 400 });
    }
    try {
      const targetRecipeId =
        Number(formData.get('recipeId') || formData.get('ownerId')) || recipeIdNumber;

      if (ownerType === 'recipe') {
        if (!Number.isFinite(targetRecipeId)) {
          return new Response('Invalid request', { status: 400 });
        }
        await apiFetch(
          `/api/recipes/${targetRecipeId}/fixed-costs/${fixedCostId}`,
          { method: 'DELETE' },
          Astro,
        );
      } else {
        const presId = Number(formData.get('presentationId') || formData.get('ownerId'));
        if (!Number.isFinite(presId) || presId <= 0) {
          return new Response('Invalid request', { status: 400 });
        }
        await apiFetch(
          `/api/presentations/${presId}/fixed-costs/${fixedCostId}`,
          { method: 'DELETE' },
          Astro,
        );
      }

      return jsonResponse({
        deleted: true,
        ...(ownerType === 'recipe' && { summary: await buildRecipeSummaryRows(targetRecipeId) }),
      });
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        return new Response('Fixed cost not found', { status: 404 });
      }
      return new Response('Error al eliminar el costo fijo', { status: 500 });
    }
  }
}

// Obtener el ID de la receta desde los parámetros
if (!recipeIdParam) {
  return Astro.redirect('/recipes');
}

let recipe: RecipeWithIngredients;
try {
  recipe = await apiFetch<RecipeWithIngredients>(
    `/api/recipes/${recipeIdParam}`,
    {},
    Astro,
  );
} catch (error) {
  if (error && typeof error === 'object' && 'status' in error && (error as { status: number }).status === 404) {
    return Astro.redirect('/recipes');
  }
  throw error;
}

const { ingredients: recipeIngredients, name, category, id, desiredMargin, fixedCostsPercentage, presentations, updatedAt } = recipe;
const formatIngredientLabel = (i: { name?: string | null; brand?: string | null }) =>
  i.brand && i.name ? `${i.name} (${i.brand})` : (i.name ?? '');

const isEditMode = Astro.url.searchParams.get('edit') === 'true';
// The ingredient list is always fetched so the client-side edit toggle can
// render the ingredient picker instantly (no extra request when entering edit).
const allIngredients = await apiFetch(
  "/api/ingredients",
  { schema: z.array(ingredientSchema) },
  Astro,
);
const ingredientsDataJson = JSON.stringify(allIngredients);
const discoveredUnitOptions = [
  ...allIngredients.map((ingredient) => ingredient.unit),
  ...recipeIngredients.map((ingredient) => ingredient.unit),
]
  .map((unit) => unit.trim())
  .filter((unit) => unit.length > 0);
const unitOptions = Array.from(new Set([...UNIT_OPTIONS, ...discoveredUnitOptions]));
const getUnitOptionsForValue = (currentUnit: string) => {
  if (unitOptions.includes(currentUnit)) {
    return unitOptions.map((unit) => ({ value: unit, label: unit }));
  }

  return [
    {
      value: currentUnit,
      label: currentUnit.trim().length > 0 ? currentUnit : 'Sin unidad',
    },
    ...unitOptions.map((unit) => ({ value: unit, label: unit })),
  ];
};

let lastUpdatedText = '';
if (updatedAt) {
  const d = new Date(updatedAt);
  const now = new Date();
  const isToday = d.getDate() === now.getDate() && d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();

  const timeOpts: Intl.DateTimeFormatOptions = { hour: 'numeric', minute: '2-digit', hour12: true };
  const timeStr = d.toLocaleTimeString('es-MX', timeOpts);

  if (isToday) {
    lastUpdatedText = `Hoy, ${timeStr}`;
  } else {
    lastUpdatedText = `${d.toLocaleDateString('es-MX')} ${timeStr}`;
  }
}

// Multiplicador de batch (ej. 2 = doble receta)
const multiplierParam = Astro.url.searchParams.get('multiplier');
const multiplier = Math.max(parseFloat(multiplierParam ?? '1') || 1, 0.01);
const showAdjustedQuantity = Math.abs(multiplier - 1) > 0.0001;
const multiplierStep = multiplier >= 2 ? 1 : 0.5;
const normalizeMultiplier = (value: number) => Math.round(value * 10000) / 10000;
const decrementMultiplier = normalizeMultiplier(Math.max(multiplier - multiplierStep, 0.01));
const incrementMultiplier = normalizeMultiplier(multiplier + multiplierStep);
const multiplierDownHref = `${Astro.url.pathname}?multiplier=${decrementMultiplier}`;
const multiplierUpHref = `${Astro.url.pathname}?multiplier=${incrementMultiplier}`;
const recipeEditFormId = 'recipe-edit-form';
const createPresentationDialogId = 'create-presentation-dialog';
const ingredientRemoveButtonClasses = 'remove-ingredient-btn inline-flex min-h-11 min-w-11 items-center justify-center rounded-full text-danger transition-colors hover:bg-danger-bg hover:text-danger';

const clampPercentageValue = (value: number, max = Number.POSITIVE_INFINITY) => {
  if (!Number.isFinite(value)) return 0;
  return Math.min(max, Math.max(0, value));
};

const desiredMarginValue = clampPercentageValue(desiredMargin, 99.99);
const fixedCostsPercentageValue = clampPercentageValue(fixedCostsPercentage);
const feedbackTypeParam = Astro.url.searchParams.get('type');
const feedbackType = (feedbackTypeParam === 'error' || feedbackTypeParam === 'success') ? feedbackTypeParam : null;
const feedbackMessage = Astro.url.searchParams.get('message');

// Redondeo contable para unidades pequeñas (g/ml) — ver lib/recipe-financials
const formatCantidad = (cantidad: number, unidad: string) => {
  const ajustada = aplicarRedondeoUnidadPequena(cantidad, unidad);
  const u = unidad.toLowerCase();
  return (u === 'g' || u === 'ml') ? ajustada.toString() : ajustada.toFixed(2);
};

// --- Helpers de Cálculo ---

const costoDirectoTotal = calcularCostoDirecto(recipeIngredients, multiplier);
const costoOperativo = costoDirectoTotal * (fixedCostsPercentageValue / 100);

// --- Advanced Cost Calculations ---
const hasAdvancedCosts = hasFeature(subscription, 'advanced_costs');

const recipeFixedCostsTotal = recipe.recipeFixedCosts?.reduce(
  (sum, fc) => sum + computeFixedCostAmount(fc, costoDirectoTotal, multiplier), 0
) ?? 0;

const recipeBatchCost = costoDirectoTotal + (hasAdvancedCosts ? recipeFixedCostsTotal : costoOperativo);

const computePresentationBatchCost = (pres: RecipePresentation): number => {
  const presFixedCostsTotal = (pres.fixedCosts ?? []).reduce((sum, fc) => {
    if (fc.type === 'AMOUNT') {
      if (fc.base === 'PER_UNIT') return sum + fc.value * pres.unitsPerBatch * multiplier;
      return sum + fc.value * multiplier;
    }
    return sum + recipeBatchCost * (fc.value / 100);
  }, 0);
  return recipeBatchCost + presFixedCostsTotal;
};

void redirectToPresentationSection;
void redirectToRecipePage;
void jsonResponse;
void respondPresentationError;
void respondRecipeError;
void getPresentationFormErrorMessage;

// --- FinancialSummary rows ---
const { rows: financialRows, highlightIndex: financialHighlightIndex } =
  buildRecipeFinancialRows({
    hasAdvancedCosts,
    costoDirectoTotal,
    recipeFixedCosts: recipe.recipeFixedCosts ?? [],
    multiplier,
    fixedCostsPercentageValue,
    desiredMarginValue,
  });

const buildFinancialEditFields = () => {
  if (hasAdvancedCosts) {
    return [{ rowIndex: 3, name: "desiredMargin", currentValue: desiredMarginValue.toString(), suffix: "%" }];
  }
  return [
    { rowIndex: 1, name: "fixedCostsPercentage", currentValue: fixedCostsPercentageValue.toString(), suffix: "%" },
    { rowIndex: 3, name: "desiredMargin", currentValue: desiredMarginValue.toString(), suffix: "%" },
  ];
};

const financialEditFields = buildFinancialEditFields();
