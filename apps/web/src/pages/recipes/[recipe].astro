---
import type { Ingredient, RecipeIngredientWithData, RecipeIngredient, RecipePresentation } from '@recetario/db';
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PresentationCard from "../../components/PresentationCard.astro";
import {
  getRecipeById,
  deleteRecipe,
  duplicateRecipe,
  updateRecipe,
} from '@recetario/db';
import { listIngredients } from '@recetario/db';
import {
  createPresentation,
  updatePresentation,
  deletePresentation,
} from '@recetario/db';
import { hasFeature } from '@recetario/billing';
import { parseNumberInput } from '@/lib/form-utils';
import { sanitizeHtml } from '@/lib/html-sanitizer';
import { validateCsrf } from '@recetario/auth';
import { UNIT_OPTIONS } from '@/lib/constants';
import FeedbackAlert from '../../components/FeedbackAlert.astro';
import RecipeInstructions from '../../components/RecipeInstructions.astro';
import { Button, Badge, FinancialSummary, SectionHeading, Card } from "@recetario/ui";
import RecipeActionsMenu from "../../components/RecipeActionsMenu.astro";
import RecipeFixedCosts from "../../components/RecipeFixedCosts.astro";
import PresentationFixedCosts from "../../components/PresentationFixedCosts.astro";
import { prisma } from "@recetario/db";

const recipeIdParam = Astro.params.recipe;
const recipeIdNumber = Number(recipeIdParam);

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect('/sign-in');
}

const ownerId = Astro.locals.user!.id;
const subscription = Astro.locals.subscription;

const expectsJsonResponse = Astro.request.headers.get('accept')?.includes('application/json') ?? false;

const buildPresentationSectionUrl = (feedback?: { type: 'success' | 'error'; message: string }) => {
  const nextUrl = new URL(Astro.url);

  if (feedback) {
    nextUrl.searchParams.set('type', feedback.type);
    nextUrl.searchParams.set('message', feedback.message);
  } else {
    nextUrl.searchParams.delete('type');
    nextUrl.searchParams.delete('message');
  }

  nextUrl.hash = '#presentaciones';
  return `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`;
};

const redirectToPresentationSection = (feedback?: { type: 'success' | 'error'; message: string }) => (
  Astro.redirect(buildPresentationSectionUrl(feedback))
);

const buildRecipePageUrl = (feedback?: { type: 'success' | 'error'; message: string }) => {
  const nextUrl = new URL(Astro.url);

  if (feedback) {
    nextUrl.searchParams.set('type', feedback.type);
    nextUrl.searchParams.set('message', feedback.message);
  } else {
    nextUrl.searchParams.delete('type');
    nextUrl.searchParams.delete('message');
  }

  nextUrl.hash = '';
  return `${nextUrl.pathname}${nextUrl.search}`;
};

const redirectToRecipePage = (feedback?: { type: 'success' | 'error'; message: string }) => (
  Astro.redirect(buildRecipePageUrl(feedback))
);

const jsonResponse = (body: unknown, status = 200) => new Response(JSON.stringify(body), {
  status,
  headers: {
    'Content-Type': 'application/json',
  },
});

const respondPresentationError = (message: string, status = 400) => {
  if (expectsJsonResponse) {
    return new Response(message, { status });
  }
  return redirectToPresentationSection({ type: 'error', message });
};

const respondRecipeError = (message: string, status = 500) => {
  if (expectsJsonResponse) {
    return jsonResponse({ error: message }, status);
  }
  return redirectToRecipePage({ type: 'error', message });
};

const getPresentationFormErrorMessage = (error: unknown, fallback: string) => {
  if (!(error instanceof Error) || !error.message) {
    return fallback;
  }

  switch (error.message) {
    case 'Invalid presentation name':
      return 'El nombre de la presentación es obligatorio.';
    case 'Invalid presentation units':
      return 'Las piezas por mezcla deben ser mayores a 0.';
    case 'Invalid presentation sale price':
      return 'El precio de venta debe ser 0 o mayor.';
    case 'Recipe not found':
      return 'No se encontró la receta.';
    default:
      return fallback;
  }
};

/**
 * Render a FixedCostCard HTML snippet for AJAX response.
 * Replicates the display-mode structure from FixedCostCard.astro.
 */
function renderFixedCostCardSnippet(
  fc: { id: number; name: string; type: string; base: string; value: number; hours?: number | null },
  isRecipeLevel: boolean,
  ownerId: number,
  csrfToken: string,
): string {
  const typeLabel: Record<string, string> = { PERCENTAGE: "Porcentaje", AMOUNT: "Monto" };
  const baseLabel: Record<string, string> = { PER_BATCH: "Por Mezcla", PER_UNIT: "Por Unidad", PER_HOUR: "Por Hora" };
  const typeColor: Record<string, string> = {
    PERCENTAGE: "bg-turmeric-bg text-turmeric-solid border-turmeric-border",
    AMOUNT: "bg-accent-50 text-accent-600 border-accent-200",
  };
  const baseColor: Record<string, string> = {
    PER_BATCH: "bg-herb-bg text-herb-solid border-herb-border",
    PER_UNIT: "bg-accent-50 text-accent-600 border-accent-200",
    PER_HOUR: "bg-chili-bg text-chili-solid border-chili-border",
  };
  const displayValue = fc.type === "PERCENTAGE" ? `${fc.value}%` : `$${Number(fc.value).toFixed(2)}`;
  const ownerType = isRecipeLevel ? "recipe" : "presentation";
  const hoursHtml = fc.base === "PER_HOUR" && fc.hours != null
    ? `<span class="fixed-cost-hours text-muted-foreground text-xs tabular-nums">(${fc.hours}h)</span>`
    : "";

  return `<fixed-cost-card class="bg-card border-border flex flex-col rounded-2xl border p-5 shadow-sm transition-all" data-id="${fc.id}" data-type="${fc.type}" data-base="${fc.base}" data-value="${fc.value}" data-hours="${fc.hours ?? ""}" data-owner-type="${ownerType}">
<form method="post" class="flex flex-col">
<input type="hidden" name="action" value="update_fixed_cost" />
<input type="hidden" name="fixedCostId" value="${fc.id}" />
<input type="hidden" name="ownerType" value="${ownerType}" />
<input type="hidden" name="ownerId" value="${ownerId}" />
<input type="hidden" name="_csrf" value="${csrfToken}" />
<div class="display-content flex flex-wrap items-center gap-3">
<div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
<span class="fixed-cost-name text-foreground font-[family-name:var(--font-display)] text-base font-bold">${fc.name}</span>
<span class="type-badge inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide ${typeColor[fc.type]}">${typeLabel[fc.type]}</span>
<span class="base-badge inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide ${baseColor[fc.base]}">${baseLabel[fc.base]}</span>
<span class="fixed-cost-value text-foreground font-mono text-sm font-semibold tabular-nums">${displayValue}</span>
${hoursHtml}
</div>
<div class="flex shrink-0 items-center gap-1">
<button type="button" class="delete-btn hidden inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl text-danger transition-colors hover:bg-danger-bg" aria-label="Eliminar costo fijo" title="Eliminar"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
<button type="button" class="edit-btn inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl text-accent-600 transition-colors hover:bg-accent-50" aria-label="Editar costo fijo" aria-pressed="false" title="Editar"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg></button>
</div>
</div>
<div class="edit-content hidden space-y-4">
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
<div class="flex flex-col gap-1"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Nombre</label><input name="name" type="text" class="fixed-cost-name-input border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none" value="${fc.name}" required /></div>
<div class="flex flex-col gap-1"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Tipo</label><select name="type" class="fixed-cost-type-select border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none"><option value="PERCENTAGE"${fc.type === "PERCENTAGE" ? " selected" : ""}>Porcentaje</option><option value="AMOUNT"${fc.type === "AMOUNT" ? " selected" : ""}>Monto</option></select></div>
<div class="flex flex-col gap-1"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Base</label><select name="base" class="fixed-cost-base-select border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none"><option value="PER_BATCH"${fc.base === "PER_BATCH" ? " selected" : ""}>Por Mezcla</option><option value="PER_UNIT"${fc.base === "PER_UNIT" ? " selected" : ""}>Por Unidad</option>${isRecipeLevel ? `<option value="PER_HOUR"${fc.base === "PER_HOUR" ? " selected" : ""}>Por Hora</option>` : ""}</select></div>
</div>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
<div class="flex flex-col gap-1"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Valor</label><input name="value" type="text" inputmode="decimal" class="fixed-cost-value-input border-border bg-background text-foreground focus:ring-accent-500/20 font-mono rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none" value="${fc.value}" required /></div>
<div class="hours-field flex flex-col gap-1"${fc.base !== "PER_HOUR" ? ' style="display:none"' : ""}><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Horas</label><input name="hours" type="text" inputmode="decimal" class="fixed-cost-hours-input border-border bg-background text-foreground focus:ring-accent-500/20 font-mono rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none" value="${fc.hours ?? 1}" /></div>
<div class="hidden sm:block"></div>
</div>
<div class="flex flex-wrap items-center justify-between gap-3 border-t border-border-light pt-4">
<div class="flex items-center gap-2"><button type="button" class="edit-delete-btn inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-danger-border px-4 py-2.5 text-sm font-bold text-danger transition-colors hover:bg-danger-bg"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg> Eliminar</button></div>
<div class="flex items-center gap-2"><button type="button" class="cancel-btn border-border bg-card text-muted-foreground hover:bg-background inline-flex min-h-11 items-center justify-center rounded-xl border px-4 py-2.5 text-sm font-bold transition-colors">Cancelar</button><button type="submit" class="bg-accent-600 hover:bg-accent-700 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Guardar</button></div>
</div>
</div>
<p class="fixed-cost-error text-danger mt-2 hidden text-xs font-semibold"></p>
</form>
<dialog data-animated class="delete-dialog fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0 backdrop:bg-backdrop/50">
<div class="border-border bg-card rounded-3xl border p-6 shadow-2xl">
<div class="flex items-start gap-3"><div class="bg-danger-bg text-danger flex h-11 w-11 items-center justify-center rounded-2xl"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></div><div><h2 class="text-foreground text-lg font-bold">Confirmar eliminación</h2><p class="text-muted-foreground mt-2 text-sm">¿Eliminar este costo fijo? Esta acción no se puede deshacer.</p></div></div>
<div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
<button type="button" class="delete-cancel-btn border-border bg-card text-muted-foreground hover:bg-background inline-flex min-h-11 items-center justify-center rounded-xl border px-5 py-3 text-sm font-bold transition-colors">Cancelar</button>
<button type="button" class="delete-confirm-btn bg-danger-solid hover:bg-danger-hover inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-bold text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg> Eliminar</button>
</div></div></dialog>
</fixed-cost-card>`;
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  if (!validateCsrf(Astro.request, formData)) {
    return Astro.redirect(Astro.url.pathname);
  }

  const action = String(formData.get('action') || '');

  if (action === 'update_presentation') {
    const presId = Number(formData.get('presentationId'));
    const presentationName = String(formData.get('presentationName') || '');
    const unitsPerBatch = parseNumberInput(formData.get('unitsPerBatch'));
    const rawSalePrice = String(formData.get('salePrice') ?? '').trim();
    const salePrice = parseNumberInput(formData.get('salePrice'));
    const nextSalePrice = formData.has('salePrice')
      ? rawSalePrice === ''
        ? null
        : salePrice
      : undefined;

    if (!Number.isFinite(recipeIdNumber) || !Number.isFinite(presId)) {
      return respondPresentationError('No se pudo actualizar la presentación.');
    }

    try {
      const presentation = await updatePresentation(recipeIdNumber, presId, {
        name: presentationName,
        unitsPerBatch,
        salePrice: nextSalePrice,
      }, ownerId);

      if (!presentation) {
        return respondPresentationError('No se encontró la presentación.', 404);
      }

      if (expectsJsonResponse) {
        return jsonResponse({ presentation });
      }

      return redirectToPresentationSection();
    } catch (error) {
      return respondPresentationError(
        getPresentationFormErrorMessage(error, 'No se pudo actualizar la presentación.'),
      );
    }
  } else if (action === 'delete_presentation') {
    const presId = Number(formData.get('presentationId'));

    if (!Number.isFinite(recipeIdNumber) || !Number.isFinite(presId)) {
      return respondPresentationError('No se pudo eliminar la presentación.');
    }

    try {
      const result = await deletePresentation(recipeIdNumber, presId, ownerId);

      if (result.status === 'not-found') {
        return respondPresentationError('No se encontró la presentación.', 404);
      }

      if (expectsJsonResponse) {
        return jsonResponse({ deleted: true, presentationId: presId });
      }

      return redirectToPresentationSection({ type: 'success', message: 'Presentación eliminada correctamente.' });
    } catch {
      return respondPresentationError('No se pudo eliminar la presentación.');
    }
  } else if (action === 'create_presentation') {
    const presentationName = String(formData.get('presentationName') || '').trim();
    const unitsPerBatch = parseNumberInput(formData.get('unitsPerBatch'));
    const salePriceValue = String(formData.get('salePrice') || '').trim();
    const salePrice = parseNumberInput(formData.get('salePrice'));

    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    if (!presentationName) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'El nombre de la presentación es obligatorio.',
      });
    }

    if (!Number.isFinite(unitsPerBatch) || unitsPerBatch <= 0) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'Las piezas por mezcla deben ser mayores a 0.',
      });
    }

    if (salePriceValue && (!Number.isFinite(salePrice) || salePrice < 0)) {
      return redirectToPresentationSection({
        type: 'error',
        message: 'El precio de venta debe ser 0 o mayor.',
      });
    }

    try {
      await createPresentation(recipeIdNumber, {
        name: presentationName,
        unitsPerBatch,
        salePrice: salePriceValue ? salePrice : undefined,
      }, ownerId);
      return redirectToPresentationSection();
    } catch (error) {
      return redirectToPresentationSection({
        type: 'error',
        message: getPresentationFormErrorMessage(error, 'No se pudo crear la presentación.'),
      });
    }
  } else if (action === 'delete_recipe') {
    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    try {
      const result = await deleteRecipe(recipeIdNumber, ownerId);

      if (result.status === 'not-found') {
        return Astro.redirect('/recipes');
      }

      return Astro.redirect('/recipes');
    } catch {
      return redirectToRecipePage({
        type: 'error',
        message: 'No se pudo eliminar la receta.',
      });
    }
  } else if (action === 'duplicate_recipe') {
    if (!Number.isFinite(recipeIdNumber)) {
      return Astro.redirect('/recipes');
    }

    if (!hasFeature(subscription, 'recipe_duplicate')) {
      if (expectsJsonResponse) {
        return jsonResponse({ error: 'Funcionalidad no disponible en tu plan.' }, 403);
      }
      return redirectToRecipePage({ type: 'error', message: 'Funcionalidad no disponible en tu plan.' });
    }

    try {
      const duplicated = await duplicateRecipe(recipeIdNumber, ownerId);
      const redirectUrl = new URL(Astro.url);
      redirectUrl.pathname = `/recipes/${duplicated.id}`;
      redirectUrl.searchParams.set('edit', 'true');
      redirectUrl.searchParams.set('type', 'success');
      redirectUrl.searchParams.set('message', `Receta "${duplicated.name}" creada exitosamente.`);
      return Astro.redirect(redirectUrl.toString());
    } catch (error) {
      return respondRecipeError(
        error instanceof Error && error.message === 'Recipe not found'
          ? 'No se encontró la receta original.'
          : 'Error al duplicar la receta.',
        500,
      );
    }
  } else if (action === 'update_recipe') {
    if (Number.isFinite(recipeIdNumber)) {
      const name = String(formData.get('recipeName') || '');
      const ingredientIds = formData.getAll('ingredientId').map(String);
      const quantities = formData.getAll('quantity').map(String);
      const units = formData.getAll('unit').map(String);
      const comments = formData.getAll('comment').map(String);

      const ingredientsToSave = [];
      for (let i = 0; i < ingredientIds.length; i++) {
        const id = Number(ingredientIds[i]);
        const q = Number(quantities[i]);
        if (Number.isFinite(id) && Number.isFinite(q)) {
          ingredientsToSave.push({
            ingredientId: id,
            quantity: q,
            unit: units[i] || '',
            comment: comments[i] || null,
          });
        }
      }

      const desiredMargin = Number(formData.get('desiredMargin')) || 0;
      const fixedCostsPercentage = Number(formData.get('fixedCostsPercentage')) || 0;
      const category = String(formData.get('category') || '').trim() || null;
      const rawInstructions = String(formData.get('instructions') || '').trim();
      const instructions = rawInstructions ? sanitizeHtml(rawInstructions) : undefined;

      await updateRecipe(recipeIdNumber, {
        name,
        category,
        instructions,
        desiredMargin,
        fixedCostsPercentage,
        ingredients: ingredientsToSave,
      }, ownerId);
      return Astro.redirect(Astro.url.pathname);
    }
  } else if (action === 'create_recipe_fixed_cost') {
    if (!expectsJsonResponse) {
      return new Response('Expected JSON request', { status: 400 });
    }
    const fcRecipeId = Number(formData.get('recipeId'));
    if (!Number.isFinite(fcRecipeId)) {
      return new Response('Invalid request', { status: 400 });
    }
    try {
      const ownerCheck = await prisma.recipe.findFirst({
        where: { id: fcRecipeId, ownerId },
        select: { id: true },
      });
      if (!ownerCheck) {
        return new Response('Recipe not found', { status: 404 });
      }

      const name = String(formData.get('name') || '').trim() || 'Costo Fijo';
      const type = String(formData.get('type') || 'AMOUNT');
      const base = String(formData.get('base') || 'PER_BATCH');
      const value = parseNumberInput(formData.get('value'));
      const hoursRaw = formData.has('hours') ? formData.get('hours') : null;
      const hours = hoursRaw !== null && hoursRaw !== '' ? Number(hoursRaw) : null;

      const created = await prisma.recipeFixedCost.create({
        data: {
          recipeId: fcRecipeId,
          name,
          type: type as any,
          base: base as any,
          value: Number.isFinite(value) ? value : 0,
          hours,
        },
      });

      const fixedCostCardHtml = renderFixedCostCardSnippet(
        { id: created.id, name: created.name, type: created.type, base: created.base, value: created.value, hours: created.hours },
        true,
        fcRecipeId,
        Astro.locals.csrfToken || "",
      );

      return jsonResponse({
        fixedCost: {
          id: created.id,
          name: created.name,
          type: created.type,
          base: created.base,
          value: created.value,
          hours: created.hours,
        },
        fixedCostCardHtml,
      });
    } catch {
      return new Response('Error al crear el costo fijo', { status: 500 });
    }
  } else if (action === 'create_presentation_fixed_cost') {
    if (!expectsJsonResponse) {
      return new Response('Expected JSON request', { status: 400 });
    }
    const presId = Number(formData.get('presentationId'));
    if (!Number.isFinite(presId)) {
      return new Response('Invalid request', { status: 400 });
    }
    try {
      // Verify ownership via recipe
      const pres = await prisma.recipePresentation.findFirst({
        where: { id: presId },
        include: { recipe: { select: { ownerId: true } } },
      });
      if (!pres || pres.recipe.ownerId !== ownerId) {
        return new Response('Presentation not found', { status: 404 });
      }

      const name = String(formData.get('name') || '').trim() || 'Costo Fijo';
      const type = String(formData.get('type') || 'AMOUNT');
      const base = String(formData.get('base') || 'PER_BATCH');
      const value = parseNumberInput(formData.get('value'));

      const created = await prisma.presentationFixedCost.create({
        data: {
          presentationId: presId,
          name,
          type: type as any,
          base: base as any,
          value: Number.isFinite(value) ? value : 0,
        },
      });

      const fixedCostCardHtml = renderFixedCostCardSnippet(
        { id: created.id, name: created.name, type: created.type, base: created.base, value: created.value, hours: null },
        false,
        presId,
        Astro.locals.csrfToken || "",
      );

      return jsonResponse({
        fixedCost: {
          id: created.id,
          name: created.name,
          type: created.type,
          base: created.base,
          value: created.value,
          hours: null,
        },
        fixedCostCardHtml,
      });
    } catch {
      return new Response('Error al crear el costo fijo', { status: 500 });
    }
  } else if (action === 'update_fixed_cost') {
    if (!expectsJsonResponse) {
      return new Response('Expected JSON request', { status: 400 });
    }
    const fixedCostId = Number(formData.get('fixedCostId'));
    const ownerType = String(formData.get('ownerType') || '');
    if (!Number.isFinite(fixedCostId) || !ownerType) {
      return new Response('Invalid request', { status: 400 });
    }
    try {
      const name = String(formData.get('name') || '').trim();
      const type = String(formData.get('type') || 'AMOUNT');
      const base = String(formData.get('base') || 'PER_BATCH');
      const value = Number(formData.get('value'));
      const hoursRaw = formData.has('hours') ? formData.get('hours') : null;
      const hours = hoursRaw !== null && hoursRaw !== '' ? Number(hoursRaw) : null;

      // Verify ownership
      if (ownerType === 'recipe') {
        const fc = await prisma.recipeFixedCost.findFirst({
          where: { id: fixedCostId },
          include: { recipe: { select: { ownerId: true } } },
        });
        if (!fc || fc.recipe.ownerId !== ownerId) {
          return new Response('Fixed cost not found', { status: 404 });
        }
      } else {
        const fc = await prisma.presentationFixedCost.findFirst({
          where: { id: fixedCostId },
          include: { presentation: { include: { recipe: { select: { ownerId: true } } } } },
        });
        if (!fc || fc.presentation.recipe.ownerId !== ownerId) {
          return new Response('Fixed cost not found', { status: 404 });
        }
      }

      if (ownerType === 'recipe') {
        await prisma.recipeFixedCost.update({
          where: { id: fixedCostId },
          data: { name, type: type as any, base: base as any, value, hours },
        });
      } else {
        await prisma.presentationFixedCost.update({
          where: { id: fixedCostId },
          data: { name, type: type as any, base: base as any, value },
        });
      }

      return jsonResponse({
        fixedCost: { name, type, base, value, hours: ownerType === 'recipe' ? hours : null },
      });
    } catch {
      return new Response('Error al actualizar el costo fijo', { status: 500 });
    }
  } else if (action === 'delete_fixed_cost') {
    if (!expectsJsonResponse) {
      return new Response('Expected JSON request', { status: 400 });
    }
    const fixedCostId = Number(formData.get('fixedCostId'));
    const ownerType = String(formData.get('ownerType') || '');
    if (!Number.isFinite(fixedCostId) || !ownerType) {
      return new Response('Invalid request', { status: 400 });
    }
    try {
      // Verify ownership
      if (ownerType === 'recipe') {
        const fc = await prisma.recipeFixedCost.findFirst({
          where: { id: fixedCostId },
          include: { recipe: { select: { ownerId: true } } },
        });
        if (!fc || fc.recipe.ownerId !== ownerId) {
          return new Response('Fixed cost not found', { status: 404 });
        }
        await prisma.recipeFixedCost.delete({ where: { id: fixedCostId } });
      } else {
        const fc = await prisma.presentationFixedCost.findFirst({
          where: { id: fixedCostId },
          include: { presentation: { include: { recipe: { select: { ownerId: true } } } } },
        });
        if (!fc || fc.presentation.recipe.ownerId !== ownerId) {
          return new Response('Fixed cost not found', { status: 404 });
        }
        await prisma.presentationFixedCost.delete({ where: { id: fixedCostId } });
      }

      return jsonResponse({ deleted: true });
    } catch {
      return new Response('Error al eliminar el costo fijo', { status: 500 });
    }
  }
}

// Obtener el ID de la receta desde los parámetros
if (!recipeIdParam) {
  return Astro.redirect('/recipes');
}

// Obtener la receta desde la base de datos
const recipe = await getRecipeById(recipeIdParam, ownerId);
if (!recipe) {
  return Astro.redirect('/recipes');
}

const { ingredients: recipeIngredients, name, category, instructions, id, desiredMargin, fixedCostsPercentage, presentations, updatedAt } = recipe;
const ingredients = recipeIngredients.map((ri) => ({ id: ri.ingredient.id, name: ri.ingredient.name }));
const hasCookingMode = hasFeature(Astro.locals.subscription, "cooking_mode");

const isEditMode = Astro.url.searchParams.get('edit') === 'true';
const allIngredients = isEditMode ? await listIngredients(ownerId) : [];
const discoveredUnitOptions = [
  ...allIngredients.map((ingredient) => ingredient.unit),
  ...recipeIngredients.map((ingredient) => ingredient.unit),
]
  .map((unit) => unit.trim())
  .filter((unit) => unit.length > 0);
const unitOptions = Array.from(new Set([...UNIT_OPTIONS, ...discoveredUnitOptions]));
const getUnitOptionsForValue = (currentUnit: string) => {
  if (unitOptions.includes(currentUnit)) {
    return unitOptions.map((unit) => ({ value: unit, label: unit }));
  }

  return [
    {
      value: currentUnit,
      label: currentUnit.trim().length > 0 ? currentUnit : 'Sin unidad',
    },
    ...unitOptions.map((unit) => ({ value: unit, label: unit })),
  ];
};

let lastUpdatedText = '';
if (updatedAt) {
  const d = new Date(updatedAt);
  const now = new Date();
  const isToday = d.getDate() === now.getDate() && d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();

  const timeOpts: Intl.DateTimeFormatOptions = { hour: 'numeric', minute: '2-digit', hour12: true };
  const timeStr = d.toLocaleTimeString('es-MX', timeOpts);

  if (isToday) {
    lastUpdatedText = `Hoy, ${timeStr}`;
  } else {
    lastUpdatedText = `${d.toLocaleDateString('es-MX')} ${timeStr}`;
  }
}

// Multiplicador de batch (ej. 2 = doble receta)
const multiplierParam = Astro.url.searchParams.get('multiplier');
const multiplier = Math.max(parseFloat(multiplierParam ?? '1') || 1, 0.01);
const showAdjustedQuantity = Math.abs(multiplier - 1) > 0.0001;
const multiplierStep = multiplier >= 2 ? 1 : 0.5;
const normalizeMultiplier = (value: number) => Math.round(value * 10000) / 10000;
const decrementMultiplier = normalizeMultiplier(Math.max(multiplier - multiplierStep, 0.01));
const incrementMultiplier = normalizeMultiplier(multiplier + multiplierStep);
const multiplierDownHref = `${Astro.url.pathname}?multiplier=${decrementMultiplier}`;
const multiplierUpHref = `${Astro.url.pathname}?multiplier=${incrementMultiplier}`;
const recipeEditFormId = 'recipe-edit-form';
const createPresentationDialogId = 'create-presentation-dialog';
const ingredientRemoveButtonClasses = 'remove-ingredient-btn inline-flex min-h-11 min-w-11 items-center justify-center rounded-full text-danger transition-colors hover:bg-danger-bg hover:text-danger';

const clampPercentageValue = (value: number, max = Number.POSITIVE_INFINITY) => {
  if (!Number.isFinite(value)) return 0;
  return Math.min(max, Math.max(0, value));
};

const desiredMarginValue = clampPercentageValue(desiredMargin, 99.99);
const fixedCostsPercentageValue = clampPercentageValue(fixedCostsPercentage);
const feedbackTypeParam = Astro.url.searchParams.get('type');
const feedbackType = (feedbackTypeParam === 'error' || feedbackTypeParam === 'success') ? feedbackTypeParam : null;
const feedbackMessage = Astro.url.searchParams.get('message');

// Redondeo contable para unidades pequeñas (g/ml)
const roundHalfUp = (value: number) => {
  return value >= 0 ? Math.floor(value + 0.5) : Math.ceil(value - 0.5);
};

const aplicarRedondeoUnidadPequena = (cantidad: number, unidad: string) => {
  const u = unidad.toLowerCase();
  if (u === 'g' || u === 'ml') {
    return roundHalfUp(cantidad);
  }
  return cantidad;
};

const formatCantidad = (cantidad: number, unidad: string) => {
  const ajustada = aplicarRedondeoUnidadPequena(cantidad, unidad);
  const u = unidad.toLowerCase();
  return (u === 'g' || u === 'ml') ? ajustada.toString() : ajustada.toFixed(2);
};

// --- Helpers de Cálculo ---

const getCostoBaseCompra = (insumo: Ingredient) => {
  if (insumo.purchaseQuantity === 0) return 0;
  return insumo.price / insumo.purchaseQuantity;
};

const calcularSubtotalIngrediente = (ri: RecipeIngredient, insumo: Ingredient) => {
  if (!insumo) return 0;

  let cantidadAjustada = aplicarRedondeoUnidadPequena(ri.quantity * multiplier, ri.unit);
  const unidadInsumo = insumo.unit.toLowerCase();
  const unidadReceta = ri.unit.toLowerCase();

  // Conversión inteligente: si el insumo es kg/lt y la receta usa g/ml
  if ((unidadInsumo === 'kg' || unidadInsumo === 'lt') &&
      (unidadReceta === 'g' || unidadReceta === 'ml')) {
    cantidadAjustada = cantidadAjustada / 1000;
  }

  return getCostoBaseCompra(insumo) * cantidadAjustada;
};

const calcularCostoDirecto = (ingredients: RecipeIngredientWithData[]) => {
  return ingredients.reduce((total, ri) => {
    return total + calcularSubtotalIngrediente(ri, ri.ingredient!);
  }, 0);
};

const costoDirectoTotal = calcularCostoDirecto(recipeIngredients);
const costoOperativo = costoDirectoTotal * (fixedCostsPercentageValue / 100);

// --- Advanced Cost Calculations ---
const hasAdvancedCosts = hasFeature(subscription, 'advanced_costs');

const computeFixedCostAmount = (fc: { type: string; base: string; value: number; hours?: number | null }): number => {
  if (fc.type === 'AMOUNT') {
    if (fc.base === 'PER_HOUR') return fc.value * (fc.hours ?? 1);
    return fc.value * multiplier;
  }
  // PERCENTAGE
  return costoDirectoTotal * (fc.value / 100);
};

const recipeFixedCostsTotal = recipe.recipeFixedCosts?.reduce(
  (sum, fc) => sum + computeFixedCostAmount(fc), 0
) ?? 0;

const recipeBatchCost = costoDirectoTotal + (hasAdvancedCosts ? recipeFixedCostsTotal : costoOperativo);

const computePresentationBatchCost = (pres: RecipePresentation): number => {
  const presFixedCostsTotal = (pres.fixedCosts ?? []).reduce((sum, fc) => {
    if (fc.type === 'AMOUNT') {
      if (fc.base === 'PER_UNIT') return sum + fc.value * pres.unitsPerBatch * multiplier;
      return sum + fc.value * multiplier;
    }
    return sum + recipeBatchCost * (fc.value / 100);
  }, 0);
  return recipeBatchCost + presFixedCostsTotal;
};

void redirectToPresentationSection;
void redirectToRecipePage;
void jsonResponse;
void respondPresentationError;
void respondRecipeError;
void getPresentationFormErrorMessage;

// --- FinancialSummary rows ---
const buildFinancialRows = () => {
  if (hasAdvancedCosts) {
    const baseRows: Array<{ label: string; value: string; subtitle?: string; secondaryValue?: string; color?: string }> = [
      { label: "Costo Insumos", value: `$${costoDirectoTotal.toFixed(2)}`, subtitle: "Costo base de materiales", color: "danger" },
    ];

    // One row per fixed cost
    for (const fc of recipe.recipeFixedCosts ?? []) {
      const amount = computeFixedCostAmount(fc);
      const valDisplay = fc.type === 'PERCENTAGE'
        ? `${fc.value}%`
        : `$${Number(fc.value).toFixed(2)}`;
      const suffix = fc.base === 'PER_HOUR' && fc.hours != null ? ` (${fc.hours}h)` : '';
      baseRows.push({
        label: fc.name,
        value: `$${amount.toFixed(2)}`,
        subtitle: `${valDisplay}${suffix}`,
        color: "muted" as const,
      });
    }

    // Total fixed costs summary row
    baseRows.push({
      label: "Total Costos Fijos",
      value: `$${recipeFixedCostsTotal.toFixed(2)}`,
      subtitle: "Suma de costos fijos de la receta",
      color: "muted" as const,
    });

    // Total recipe cost
    baseRows.push({
      label: "Costo Total Receta",
      value: `$${recipeBatchCost.toFixed(2)}`,
      subtitle: "Insumos + Costos Fijos",
      color: "accent" as const,
    });

    // Desired margin
    baseRows.push({
      label: "Margen Deseado",
      value: `${desiredMarginValue}%`,
      subtitle: "Objetivo de ganancia",
      color: "success" as const,
    });

    return { rows: baseRows, highlightIndex: 3, editRowIndices: [4] };
  }

  // Legacy mode
  return {
    rows: [
      { label: "Costo Insumos", value: `$${costoDirectoTotal.toFixed(2)}`, subtitle: "Costo base de materiales", color: "danger" as const },
      { label: "Gastos Operativos", value: `${fixedCostsPercentageValue}%`, subtitle: "Servicios, labor, etc.", secondaryValue: `+$${costoOperativo.toFixed(2)}`, color: "muted" as const },
      { label: "Costo Total Real", value: `$${recipeBatchCost.toFixed(2)}`, subtitle: "Insumos + Operativos", color: "accent" as const },
      { label: "Margen Utilidad", value: `${desiredMarginValue}%`, subtitle: "Objetivo de ganancia", color: "success" as const },
    ],
    highlightIndex: 2,
    editRowIndices: hasAdvancedCosts ? [] : [1, 3],
  };
};

const { rows: financialRows, highlightIndex: financialHighlightIndex } = buildFinancialRows();

const buildFinancialEditFields = () => {
  if (hasAdvancedCosts) {
    return [{ rowIndex: 4, name: "desiredMargin", currentValue: desiredMarginValue.toString(), suffix: "%" }];
  }
  return [
    { rowIndex: 1, name: "fixedCostsPercentage", currentValue: fixedCostsPercentageValue.toString(), suffix: "%" },
    { rowIndex: 3, name: "desiredMargin", currentValue: desiredMarginValue.toString(), suffix: "%" },
  ];
};

const financialEditFields = buildFinancialEditFields();
