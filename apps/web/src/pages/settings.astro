---
import Layout from "@/layouts/Layout.astro";
import { ACCENT_FAMILIES, type AccentFamily } from "@/lib/accent-colors";
import { validateCsrf } from "@recetario/auth";
import { apiFetch } from "@/lib/api-client";
import { subscriptionResponseSchema } from "@recetario/types";
import SettingsContent from "@/components/templates/settings/SettingsContent.astro";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const user = Astro.locals.user;
const activeTab = Astro.url.searchParams.get("tab") || "profile";
const sessionId = Astro.url.searchParams.get("session_id");

if (sessionId) {
  try {
    await apiFetch("/api/stripe/sync-session", { method: "POST", body: { sessionId } }, Astro);
  } catch {
    // best effort sync
  }
}

const isSuccess = Astro.url.searchParams.get("success") === "1";
const isCanceled = Astro.url.searchParams.get("canceled") === "1";

let subscription = Astro.locals.subscription;
if (activeTab === "billing" || sessionId || isSuccess || isCanceled) {
  try {
    const freshSub = await apiFetch("/api/billing/subscription", { schema: subscriptionResponseSchema }, Astro);
    if (freshSub) {
      subscription = freshSub;
    }
  } catch {
    // fallback to middleware subscription
  }
}

type Feedback = { type: "success" | "error"; message: string };
let feedback: Feedback | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  if (!validateCsrf(Astro.request, formData)) {
    return Astro.redirect("/settings");
  }

  const theme = formData.get("theme") as string;
  const accentColor = formData.get("accentColor") as string;
  const validTheme = ["system", "light", "dark"].includes(theme) ? theme : "system";
  const validAccent = ACCENT_FAMILIES.includes(accentColor as AccentFamily)
    ? accentColor
    : "coral";

  try {
    await apiFetch(
      "/api/preferences",
      {
        method: "PUT",
        body: {
          theme: validTheme,
          accentColor: validAccent,
        },
      },
      Astro,
    );

    Astro.cookies.set("kitchcalc-theme", validTheme, {
      path: "/",
      sameSite: "lax",
      httpOnly: false,
      maxAge: 31536000,
    });
    Astro.cookies.set("kitchcalc-accent", validAccent, {
      path: "/",
      sameSite: "lax",
      httpOnly: false,
      maxAge: 31536000,
    });

    feedback = {
      type: "success",
      message: "Preferencias guardadas correctamente.",
    };
  } catch {
    feedback = { type: "error", message: "Error al guardar las preferencias." };
  }
}

const redirectUrl = new URL(Astro.url);
if (feedback) {
  redirectUrl.searchParams.set("type", feedback.type);
  redirectUrl.searchParams.set("message", feedback.message);
  return Astro.redirect(redirectUrl.toString());
}

const feedbackType = Astro.url.searchParams.get("type");
const feedbackMessage = Astro.url.searchParams.get("message");
---

<Layout
  currentPage="settings"
  showSideBar={true}
  breadcrumbs={[{ label: "Configuración" }]}
>
  <SettingsContent
    user={user}
    preferences={Astro.locals.preferences}
    subscription={subscription}
    activeTab={activeTab}
    feedbackType={feedbackType}
    feedbackMessage={feedbackMessage}
    csrfToken={Astro.locals.csrfToken || ""}
    isSuccess={isSuccess}
    isCanceled={isCanceled}
  />
</Layout>
