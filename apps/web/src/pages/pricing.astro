---
import Icon from "@/components/ui/Icon.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import Layout from "@/layouts/Layout.astro";
import { apiFetch } from "@/lib/api-client";
import { plansListResponseSchema } from "@recetario/types";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const subscription = Astro.locals.subscription;
const currentTier = subscription.tier;

const rawPlans = await apiFetch(
  "/api/billing/plans",
  { schema: plansListResponseSchema },
  Astro,
);
const plans = rawPlans;

const getButtonLabel = (planId: string) => {
  if (planId === currentTier) return "Plan actual";
  if (planId === "pro" && currentTier === "basic") return "Actualizar a Pro";
  if (planId !== "free") return "Suscribirse";
  return "Plan actual";
};

const isSuccess = Astro.url.searchParams.get("success") === "1";
const isCanceled = Astro.url.searchParams.get("canceled") === "1";
---

<Layout
  currentPage="pricing"
  showSideBar={true}
  breadcrumbs={[{ label: "Planes y Precios" }]}
>
  <section class="mx-auto max-w-6xl">
    {
      isSuccess && (
        <div class="border-success-border bg-success-bg mb-6 rounded-2xl border p-4">
          <div class="flex items-center gap-3">
            <Icon name="lucide:check-circle" size={20} class="text-success" />
            <div>
              <p class="text-success font-semibold">Suscripcion activada</p>
              <p class="text-success text-sm">
                Tu plan ya esta activo. Disfruta de todas las funciones.
              </p>
            </div>
          </div>
        </div>
      )
    }

    {
      isCanceled && (
        <div class="border-warning-border bg-warning-bg mb-6 rounded-2xl border p-4">
          <div class="flex items-center gap-3">
            <Icon name="lucide:alert-triangle" size={20} class="text-warning" />
            <div>
              <p class="text-warning font-semibold">Suscripcion cancelada</p>
              <p class="text-warning text-sm">
                No se realizo ningun cargo. Puedes intentarlo de nuevo cuando
                quieras.
              </p>
            </div>
          </div>
        </div>
      )
    }

    <Button
      variant="secondary"
      icon="arrow-left"
      href="/settings/billing"
      size="sm"
      class="mb-6"
    >
      Volver a Facturación
    </Button>

    <div class="mb-8 text-center">
      <h1 class="text-foreground text-3xl font-black">Planes y precios</h1>
      <p class="text-muted-foreground mt-2">
        Elige el plan que mejor se adapte a tu negocio.
      </p>
    </div>

    <div class="mb-8 flex justify-center">
      <div class="bg-muted inline-flex rounded-xl p-1" id="billing-toggle">
        <button
          type="button"
          data-billing-period="monthly"
          aria-pressed="true"
          class="bg-card text-foreground rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition-all"
          >Mensual</button
        >
        <button
          type="button"
          data-billing-period="yearly"
          aria-pressed="false"
          class="text-muted-foreground rounded-lg px-4 py-2 text-sm font-semibold transition-all"
          >Anual <span class="text-success text-xs font-bold">-20%</span
          ></button
        >
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        plans.map((plan) => {
          const current = plan.id === currentTier;
          const buttonLabel = getButtonLabel(plan.id);
          const isFree = plan.id === "free";

          return (
            <div
              class:list={[
                "bg-card flex flex-col rounded-2xl border p-6 shadow-sm",
                plan.id === "pro"
                  ? "border-accent-300 ring-accent-200 ring-1"
                  : "border-border",
              ]}
            >
              {plan.id === "pro" && (
                <Badge variant="tier" color="accent" class="mb-4 self-start">
                  Mas popular
                </Badge>
              )}
              {plan.badge && plan.id !== "pro" && (
                <Badge variant="tier" color="success" class="mb-4 self-start">
                  {plan.badge.text}
                </Badge>
              )}

              <h2 class="text-foreground text-xl font-black">{plan.name}</h2>
              <p class="text-muted-foreground mt-1 text-sm">
                {plan.description}
              </p>

              <div class="mt-4">
                <div data-plan-price-block data-plan={plan.id}>
                  <div data-plan-price-view="monthly">
                    {isFree ? (
                      <p class="text-foreground text-2xl font-black">Gratis</p>
                    ) : (
                      <>
                        <p class="text-foreground text-2xl font-black whitespace-nowrap">
                          {plan.currency} {plan.monthlyDisplay}
                          <span class="text-subtle-foreground text-sm font-semibold">
                            /mes
                          </span>
                        </p>
                        <p class="text-subtle-foreground mt-0.5 text-xs">
                          Facturado mensualmente
                        </p>
                      </>
                    )}
                  </div>
                  <div data-plan-price-view="yearly" class="hidden">
                    {!isFree ? (
                      <>
                        <p class="text-foreground text-2xl font-black whitespace-nowrap">
                          {plan.currency} {plan.yearlyPerMonthDisplay}
                          <span class="text-subtle-foreground text-sm font-semibold">
                            /mes
                          </span>
                        </p>
                        <p class="text-subtle-foreground mt-0.5 text-xs">
                          {plan.currency} {plan.yearlyDisplay} facturados
                          anualmente
                        </p>
                      </>
                    ) : (
                      <p class="text-foreground text-2xl font-black">Gratis</p>
                    )}
                  </div>
                </div>
              </div>

              <button
                type="button"
                data-subscribe-btn
                data-plan={plan.id}
                data-price-id-monthly={plan.monthlyPriceId ?? ""}
                data-price-id-yearly={plan.yearlyPriceId ?? ""}
                disabled={current || isFree}
                class:list={[
                  "mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-bold transition-colors",
                  current || isFree
                    ? "border-border bg-background text-subtle-foreground cursor-not-allowed border"
                    : plan.id === "pro"
                      ? "bg-accent-600 hover:bg-accent-700 text-white"
                      : "border-border bg-card text-muted-foreground hover:bg-background border",
                ]}
              >
                {buttonLabel}
              </button>

              <div class="mt-6 flex-1 space-y-3">
                {plan.features.map((feature) => {
                  const isComingSoon = feature.status === "coming_soon";
                  const icon = isComingSoon
                    ? "lucide:clock"
                    : feature.included
                      ? "lucide:check"
                      : "lucide:x";
                  const iconClass = isComingSoon
                    ? "text-subtle-foreground"
                    : feature.included
                      ? "text-success"
                      : "text-subtle-foreground";
                  const textClass = isComingSoon
                    ? "text-subtle-foreground"
                    : feature.included
                      ? "text-secondary-foreground"
                      : "text-subtle-foreground";
                  return (
                    <div class="flex items-center gap-2 text-sm">
                      <Icon name={icon} size={16} class:list={[iconClass]} />
                      <span class:list={[textClass]}>{feature.text}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</Layout>

<script>
  function setupPricing() {
    const toggle = document.getElementById("billing-toggle");
    if (!toggle || toggle.dataset.bound === "1") return;
    toggle.dataset.bound = "1";

    let activePeriod: "monthly" | "yearly" = "monthly";

    const monthlyBtn = toggle.querySelector('[data-billing-period="monthly"]');
    const yearlyBtn = toggle.querySelector('[data-billing-period="yearly"]');

    function updateToggleUI() {
      if (
        !(monthlyBtn instanceof HTMLButtonElement) ||
        !(yearlyBtn instanceof HTMLButtonElement)
      )
        return;

      if (activePeriod === "monthly") {
        monthlyBtn.className =
          "px-4 py-2 rounded-lg text-sm font-semibold bg-card text-foreground shadow-sm transition-all";
        yearlyBtn.className =
          "px-4 py-2 rounded-lg text-sm font-semibold text-muted-foreground transition-all";
        monthlyBtn.setAttribute("aria-pressed", "true");
        yearlyBtn.setAttribute("aria-pressed", "false");
      } else {
        yearlyBtn.className =
          "px-4 py-2 rounded-lg text-sm font-semibold bg-card text-foreground shadow-sm transition-all";
        monthlyBtn.className =
          "px-4 py-2 rounded-lg text-sm font-semibold text-muted-foreground transition-all";
        yearlyBtn.setAttribute("aria-pressed", "true");
        monthlyBtn.setAttribute("aria-pressed", "false");
      }
    }

    function syncPrices() {
      document.querySelectorAll("[data-plan-price-view]").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        if (el.dataset.planPriceView === activePeriod) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      });
    }

    monthlyBtn?.addEventListener("click", () => {
      activePeriod = "monthly";
      updateToggleUI();
      syncPrices();
    });

    yearlyBtn?.addEventListener("click", () => {
      activePeriod = "yearly";
      updateToggleUI();
      syncPrices();
    });

    updateToggleUI();
    syncPrices();

    document.querySelectorAll("[data-subscribe-btn]").forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.subscribeBound === "1") return;
      btn.dataset.subscribeBound = "1";

      btn.addEventListener("click", async () => {
        if (btn.disabled) return;

        const plan = btn.dataset.plan;
        if (plan === "free") return;

        const priceId =
          activePeriod === "monthly"
            ? btn.dataset.priceIdMonthly
            : btn.dataset.priceIdYearly;

        if (!priceId) {
          alert("Precio no configurado para este plan.");
          return;
        }

        const successUrl = `${window.location.origin}/settings/billing?success=1`;
        const cancelUrl = `${window.location.origin}/pricing?canceled=1`;

        btn.disabled = true;
        const originalText = btn.textContent;
        btn.textContent = "Redirigiendo...";

        try {
          const csrfToken = document.cookie
            .split("; ")
            .find((row) => row.startsWith("csrf_token="))
            ?.split("=")[1];

          const headers: Record<string, string> = {
            "Content-Type": "application/json",
          };
          if (csrfToken) headers["x-csrf-token"] = csrfToken;

          const res = await fetch("/api/stripe/checkout", {
            method: "POST",
            headers,
            body: JSON.stringify({ priceId, successUrl, cancelUrl }),
          });

          const data = await res.json();
          if (data.url) {
            window.location.href = data.url;
          } else {
            throw new Error(data.error || "Error desconocido");
          }
        } catch (err) {
          btn.disabled = false;
          btn.textContent = originalText;
          alert(
            "Error: " +
              (err instanceof Error
                ? err.message
                : "No se pudo iniciar el pago"),
          );
        }
      });
    });
  }

  document.addEventListener("astro:page-load", setupPricing);
  document.addEventListener("astro:after-swap", setupPricing);
  setupPricing();
</script>
