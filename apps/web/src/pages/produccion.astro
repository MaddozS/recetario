---
import Layout from "@/layouts/Layout.astro";
import { hasFeature } from "@recetario/stripe";
import ProductionContent from "@/components/templates/production/ProductionContent.astro";
import ProductionSkeleton from "@/components/templates/production/ProductionSkeleton.astro";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const subscription = Astro.locals.subscription;
const canAccess = hasFeature(subscription, "production_planner");

const recipeIdsParam = Astro.url.searchParams.get("recipes");
const batchesParam = Astro.url.searchParams.get("batches");
const presentationsParam = Astro.url.searchParams.get("presentations");
const hasUpgradeParam = Astro.url.searchParams.has("upgrade");
---

<Layout
  title="Planificador de Producción"
  currentPage="production"
  showSideBar={true}
  breadcrumbs={[{ label: "Planificador de Producción" }]}
>
  <ProductionContent
    server:defer
    subscription={subscription}
    canAccess={canAccess}
    recipeIdsParam={recipeIdsParam}
    batchesParam={batchesParam}
    presentationsParam={presentationsParam}
    hasUpgradeParam={hasUpgradeParam}
  >
    <ProductionSkeleton slot="fallback" />
  </ProductionContent>
</Layout>
