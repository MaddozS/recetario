---
import Icon from "@/components/ui/Icon.astro";
import Button from "../components/ui/Button.astro";
import PasswordInput from "../components/ui/PasswordInput.astro";

import LandingLayout from "@/layouts/LandingLayout.astro";

if (Astro.locals.session) return Astro.redirect("/recipes");

const AUTH_ERROR_MESSAGES: Record<string, string> = {
  account_not_linked:
    "No se pudo iniciar sesi\u00f3n con Google. La cuenta no est\u00e1 vinculada.",
  oauth_provider_not_found: "Proveedor de autenticaci\u00f3n no configurado.",
  state_mismatch: "Error de seguridad. Intenta de nuevo.",
  state_not_found: "Error de seguridad. Intenta de nuevo.",
  please_restart_the_process:
    "El proceso de autenticaci\u00f3n expir\u00f3. Intenta de nuevo.",
  invalid_callback_request: "Error de autenticaci\u00f3n. Intenta de nuevo.",
  internal_server_error: "Error interno. Intenta de nuevo m\u00e1s tarde.",
  unable_to_create_session: "Error al crear sesi\u00f3n. Intenta de nuevo.",
  email_not_found: "Error de autenticaci\u00f3n. Intenta de nuevo.",
};

const errorCode = Astro.url.searchParams.get("error");
const errorMessage = errorCode
  ? (AUTH_ERROR_MESSAGES[errorCode] ??
    "Error de autenticaci\u00f3n. Intenta de nuevo.")
  : "";
---

<LandingLayout>
  <nav
    class="border-border bg-background/80 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl"
  >
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
      <a href="/" class="flex shrink-0 items-center gap-2.5">
        <img
          src="/kitchcalc_logo.svg"
          alt="KitchCalc"
          class="h-9 w-9 rounded-xl"
        />
        <span class="text-foreground text-lg font-black">KitchCalc</span>
      </a>
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={18} class="block dark:hidden" />
        <Icon name="lucide:moon" size={18} class="hidden dark:block" />
      </button>
    </div>
  </nav>
  <div class="flex min-h-dvh items-center justify-center px-4 pt-16">
    <div
      class="bg-card shadow-accent-tint relative w-full max-w-sm rounded-2xl p-6 pt-8 shadow-lg sm:p-10 sm:pt-12"
    >
      <div
        aria-hidden="true"
        class="bg-accent-500 absolute top-0 right-8 left-8 h-1 rounded-full"
      >
      </div>
      <div class="mb-8 text-center">
        <div
          class="bg-accent-50 mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl"
        >
          <Icon name="lucide:chef-hat" size={28} class="text-accent-600" />
        </div>
        <h1 class="text-foreground text-2xl font-black">Iniciar sesión</h1>
        <p class="text-muted-foreground mt-1 text-sm">Accede a tu recetario</p>
      </div>

      <div
        id="sign-in-error"
        role="alert"
        class:list={{
          hidden: !errorMessage,
          "border-danger-border bg-danger-bg text-danger mb-4 rounded-xl border px-4 py-3 text-sm font-semibold": true,
        }}
      >
        {errorMessage}
      </div>
      <div
        id="sign-in-verify-error"
        role="alert"
        class="border-warning-border bg-warning-bg text-warning mb-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
      >
      </div>

      <form id="sign-in-form" class="space-y-4">
        <div>
          <label
            for="email"
            class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
          >
            Email
          </label>
          <input
            id="email"
            type="email"
            required
            class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
            placeholder="tu@email.com"
            autocomplete="email"
          />
        </div>
        <PasswordInput
          id="password"
          label="Contraseña"
          autocomplete="current-password"
          required
          showRequired={false}
        />
        <Button
          variant="primary"
          type="submit"
          id="sign-in-submit"
          class="w-full"
        >
          Iniciar sesión
        </Button>
        <p class="text-center">
          <Button variant="secondary" href="/forgot-password" size="sm"
            >¿Olvidaste tu contraseña?</Button
          >
        </p>
      </form>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="border-border w-full border-t"></div>
        </div>
        <div class="relative flex justify-center text-xs uppercase">
          <span class="bg-card text-muted-foreground px-3">o</span>
        </div>
      </div>

      <button
        type="button"
        id="google-sign-in-btn"
        class="border-border bg-card text-muted-foreground hover:bg-background inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border px-5 py-3 text-sm font-bold transition-colors"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24">
          <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
            fill="#4285F4"></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            fill="#FBBC05"></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            fill="#EA4335"></path>
        </svg>
        <span data-google-label>Continuar con Google</span>
      </button>

      <p class="text-muted-foreground mt-6 text-center text-sm">
        ¿No tienes cuenta?
        <Button variant="secondary" href="/sign-up" size="sm" class="ml-1"
          >Regístrate</Button
        >
      </p>
    </div>
  </div>
</LandingLayout>

<script>
  import {
    signInWithEmail,
    signInWithGoogle,
    getSafeRedirect,
  } from "@recetario/auth/client";
  import { setupPasswordToggles } from "../lib/password-toggle";
  import { showLoadingOverlay } from "../lib/loading-overlay";

  function setupSignIn() {
    const form = document.getElementById("sign-in-form");
    const emailInput = document.getElementById("email");
    const passwordInput = document.getElementById("password");
    const errorEl = document.getElementById("sign-in-error");
    const submitBtn = document.getElementById(
      "sign-in-submit",
    ) as HTMLButtonElement | null;
    const googleBtn = document.getElementById("google-sign-in-btn");

    function showError(msg: string) {
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.classList.remove("hidden");
      }
    }

    function hideError() {
      if (errorEl) errorEl.classList.add("hidden");
    }

    if (form && emailInput && passwordInput && submitBtn) {
      if (form.dataset.bound === "1") return;
      form.dataset.bound = "1";

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        hideError();

        const email = (emailInput as HTMLInputElement).value.trim();
        const password = (passwordInput as HTMLInputElement).value;

        submitBtn.disabled = true;
        submitBtn.textContent = "Iniciando sesión...";
        if (googleBtn) (googleBtn as HTMLButtonElement).disabled = true;

        const removeOverlay = showLoadingOverlay("Iniciando sesión…");

        try {
          await signInWithEmail(email, password);
          sessionStorage.removeItem("kitchcalc:signup_email");
          window.location.href = getSafeRedirect();
        } catch (err: unknown) {
          removeOverlay();
          submitBtn.disabled = false;
          submitBtn.textContent = "Iniciar sesión";
          if (googleBtn) (googleBtn as HTMLButtonElement).disabled = false;

          const e = err as { code?: string; message?: string };
          if (e.code === "EMAIL_NOT_VERIFIED") {
            hideError();
            const verifyEl = document.getElementById("sign-in-verify-error");
            if (verifyEl) {
              verifyEl.innerHTML =
                `Debes verificar tu email antes de iniciar sesi\u00f3n. Revisa tu bandeja. ` +
                `<button id="resend-verify-signin" class="underline font-bold hover:opacity-80">Reenviar correo</button>`;
              verifyEl.classList.remove("hidden");
              document
                .getElementById("resend-verify-signin")
                ?.addEventListener("click", async (ev) => {
                  const btn = ev.currentTarget as HTMLButtonElement;
                  btn.textContent = "Enviando...";
                  btn.setAttribute("disabled", "true");
                  try {
                    const { authClient } =
                      await import("@recetario/auth/client");
                    // eslint-disable-next-line @typescript-eslint/no-explicit-any
                    await (authClient as any).sendVerificationEmail({
                      email,
                      callbackURL: `${window.location.origin}/sign-in`,
                    });
                    btn.textContent = "Reenviado. Revisa tu correo!";
                    btn.classList.add("pointer-events-none");
                  } catch {
                    btn.textContent = "Error. Reintentar";
                    btn.removeAttribute("disabled");
                  }
                });
            }
          } else {
            showError("Credenciales inv\u00e1lidas.");
          }
        }
      });
    }

    if (googleBtn) {
      if (googleBtn.dataset.bound === "1") return;
      googleBtn.dataset.bound = "1";

      googleBtn.addEventListener("click", async () => {
        const btn = googleBtn as HTMLButtonElement;
        btn.disabled = true;
        btn.classList.add("opacity-60", "pointer-events-none");
        const label = btn.querySelector("[data-google-label]");
        if (label) label.textContent = "Redirigiendo...";
        if (submitBtn) submitBtn.disabled = true;

        const removeOverlay = showLoadingOverlay("Iniciando sesión…");

        try {
          await signInWithGoogle(getSafeRedirect());
        } catch {
          removeOverlay();
          btn.disabled = false;
          btn.classList.remove("opacity-60", "pointer-events-none");
          if (label) label.textContent = "Continuar con Google";
          if (submitBtn) submitBtn.disabled = false;
          showError("No se pudo iniciar sesi\u00f3n con Google.");
        }
      });
    }
  }

  document.addEventListener("astro:page-load", () => {
    setupSignIn();
    setupPasswordToggles();
  });
  document.addEventListener("astro:after-swap", () => {
    setupSignIn();
    setupPasswordToggles();
  });
  setupSignIn();
  setupPasswordToggles();
</script>
