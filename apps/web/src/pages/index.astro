---
import LandingLayout from "@/layouts/LandingLayout.astro";
import LandingNavbar from "@/components/organisms/landing/LandingNavbar.astro";
import HeroSection from "@/components/organisms/landing/HeroSection.astro";
import FeaturesSection from "@/components/organisms/landing/FeaturesSection.astro";
import HowItWorksSection from "@/components/organisms/landing/HowItWorksSection.astro";
import PricingSection from "@/components/organisms/landing/PricingSection.astro";
import CTASection from "@/components/organisms/landing/CTASection.astro";
import LandingFooter from "@/components/organisms/landing/LandingFooter.astro";
import { apiFetch } from "@/lib/api-client";
import { plansListResponseSchema } from "@recetario/types";

const isAuthenticated = Boolean(Astro.locals.user && Astro.locals.session);
const rawPlans = await apiFetch(
  "/api/billing/plans",
  { schema: plansListResponseSchema },
  Astro,
).catch((e: unknown) => {
  console.error("[landing/pricing] plans fetch failed, rendering with empty prices:", e);
  return [];
});
const plans = rawPlans;
---

<LandingLayout>
  <LandingNavbar isAuthenticated={isAuthenticated} />
  <main id="main-content" tabindex="-1">
    <HeroSection />
    <FeaturesSection />
    <HowItWorksSection />
    <PricingSection isAuthenticated={isAuthenticated} plans={plans} />
    <CTASection />
  </main>
  <LandingFooter />
</LandingLayout>
