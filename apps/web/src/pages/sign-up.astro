---
import { Icon } from "astro-icon/components";
import { Button, PasswordInput } from "@recetario/ui";
import LandingLayout from "@/layouts/LandingLayout.astro";

if (Astro.locals.session) return Astro.redirect("/recipes");
---

<LandingLayout>
  <nav
    class="border-border bg-background/80 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl"
  >
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
      <a href="/" class="flex shrink-0 items-center gap-2.5">
        <img
          src="/kitchcalc_logo.svg"
          alt="KitchCalc"
          class="h-9 w-9 rounded-xl"
        />
        <span class="text-foreground text-lg font-black">KitchCalc</span>
      </a>
      <button
        onclick="toggleLandingTheme()"
        class="text-muted-foreground hover:text-foreground hover:bg-hover-muted inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={18} class="block dark:hidden" />
        <Icon name="lucide:moon" size={18} class="hidden dark:block" />
      </button>
    </div>
  </nav>
  <div class="flex min-h-dvh items-center justify-center px-4 pt-16">
    <div
      class="bg-card shadow-accent-tint relative w-full max-w-sm rounded-2xl p-10 pt-12 shadow-lg"
    >
      <div
        aria-hidden="true"
        class="bg-accent-500 absolute top-0 right-8 left-8 h-1 rounded-full"
      >
      </div>
      <!-- Sign-up content (form + google + divider + footer) -->
      <div id="sign-up-content">
        <div class="mb-8 text-center">
          <div
            class="bg-accent-50 mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl"
          >
            <Icon name="lucide:chef-hat" size={28} class="text-accent-600" />
          </div>
          <h1 class="text-foreground text-2xl font-black">Crear cuenta</h1>
          <p class="text-muted-foreground mt-1 text-sm">
            Regístrate para empezar a costear
          </p>
        </div>
        <div
          id="sign-up-error"
          class="border-danger-border bg-danger-bg text-danger mb-4 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
        >
        </div>

        <p class="text-muted-foreground mb-4 text-xs">
          <span class="text-danger font-bold">*</span> Campos obligatorios
        </p>

        <form id="sign-up-form" class="space-y-4">
          <div>
            <label
              for="first_name"
              class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
            >
              Nombre <span class="text-danger">*</span>
            </label>
            <input
              id="first_name"
              type="text"
              required
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              placeholder="Tu nombre"
              autocomplete="given-name"
            />
          </div>
          <div>
            <label
              for="last_name"
              class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
            >
              Apellido <span class="text-danger">*</span>
            </label>
            <input
              id="last_name"
              type="text"
              required
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              placeholder="Tu apellido"
              autocomplete="family-name"
            />
          </div>
          <div>
            <label
              for="email"
              class="text-muted-foreground mb-1.5 block text-xs font-bold tracking-wider uppercase"
            >
              Email <span class="text-danger">*</span>
            </label>
            <input
              id="email"
              type="email"
              required
              class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:border-accent-300 focus:ring-accent-500/20 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
              placeholder="tu@email.com"
              autocomplete="email"
            />
          </div>
          <PasswordInput
            id="password"
            label="Contraseña"
            placeholder="Mínimo 8 caracteres"
            autocomplete="new-password"
            required
            minlength={8}
          />
          <div id="password-rules" class="mt-1 hidden space-y-0.5">
            <div id="rule-min" class="flex items-center gap-1.5 text-xs">
              <span class="rule-icon text-muted-foreground">○</span><span
                class="rule-text text-muted-foreground"
                >Al menos 8 caracteres</span>
            </div>
            <div id="rule-upper" class="flex items-center gap-1.5 text-xs">
              <span class="rule-icon text-muted-foreground">○</span><span
                class="rule-text text-muted-foreground"
                >Una letra mayúscula</span>
            </div>
            <div id="rule-lower" class="flex items-center gap-1.5 text-xs">
              <span class="rule-icon text-muted-foreground">○</span><span
                class="rule-text text-muted-foreground"
                >Una letra minúscula</span>
            </div>
            <div id="rule-digit" class="flex items-center gap-1.5 text-xs">
              <span class="rule-icon text-muted-foreground">○</span><span
                class="rule-text text-muted-foreground">Un número</span>
            </div>
            <div id="rule-special" class="flex items-center gap-1.5 text-xs">
              <span class="rule-icon text-muted-foreground">○</span><span
                class="rule-text text-muted-foreground"
                >Un carácter especial</span>
            </div>
          </div>
          <PasswordInput
            id="confirm-password"
            label="Confirmar contraseña"
            placeholder="Repite tu contraseña"
            autocomplete="new-password"
            required
            minlength={8}
          />
          <div id="password-match-status" class="mt-1 hidden text-xs"></div>
          <Button
            variant="primary"
            type="submit"
            id="sign-up-submit"
            class="w-full"
          >
            Crear cuenta
          </Button>
        </form>

        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="border-border w-full border-t"></div>
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-card text-muted-foreground px-3">o</span>
          </div>
        </div>

        <button
          type="button"
          id="google-sign-up-btn"
          class="border-border bg-card text-muted-foreground hover:bg-background inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border px-5 py-3 text-sm font-bold transition-colors"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24">
            <path
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
              fill="#4285F4"></path>
            <path
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              fill="#34A853"></path>
            <path
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
              fill="#FBBC05"></path>
            <path
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              fill="#EA4335"></path>
          </svg>
          <span data-google-label>Continuar con Google</span>
        </button>

        <p
          class="text-muted-foreground mt-6 text-center text-sm"
          data-sign-up-footer
        >
          ¿Ya tienes cuenta?
          <Button variant="secondary" href="/sign-in" size="sm" class="ml-1"
            >Inicia sesión</Button
          >
        </p>
      </div>

      <!-- Verification sent state -->
      <div
        id="sign-up-verified"
        class="flex hidden flex-col items-center text-center"
      >
        <div
          class="bg-success-bg mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl"
        >
          <Icon name="lucide:mail-check" size={28} class="text-success" />
        </div>
        <h1 class="text-foreground text-2xl font-black">Verifica tu email</h1>
        <p class="text-muted-foreground mt-1 text-sm">
          Te enviamos un enlace de verificación a
        </p>
        <p class="text-foreground mt-1 font-semibold" id="verified-email"></p>
        <p class="text-muted-foreground mt-3 text-xs">
          Haz clic en el enlace del correo para activar tu cuenta. Si no lo ves,
          revisa tu carpeta de spam.
        </p>
        <div class="mt-6 w-full space-y-3">
          <Button
            id="resend-verification"
            variant="secondary"
            class="w-full"
            type="button"
          >
            Reenviar correo
          </Button>
          <span id="resend-status" class="hidden text-xs"></span>
        </div>
        <div class="mt-4">
          <Button variant="secondary" href="/sign-in" size="sm"
            >Ir al inicio de sesión</Button
          >
        </div>
      </div>
    </div>
  </div>
</LandingLayout>

<script>
  import {
    signUpWithEmail,
    signInWithGoogle,
    getSafeRedirect,
  } from "@recetario/auth/client";
  import { setupPasswordToggles } from "@recetario/ui/password-toggle";
  import { showLoadingOverlay } from "@recetario/ui/loading-overlay";
  import { validatePassword, getRuleResults } from "@recetario/auth/client";

  function setupSignUp() {
    const form = document.getElementById("sign-up-form");
    const firstNameInput = document.getElementById("first_name");
    const lastNameInput = document.getElementById("last_name");
    const emailInput = document.getElementById("email");
    const passwordInput = document.getElementById("password");
    const confirmPasswordInput = document.getElementById("confirm-password");
    const errorEl = document.getElementById("sign-up-error");
    const submitBtn = document.getElementById(
      "sign-up-submit",
    ) as HTMLButtonElement | null;
    const googleBtn = document.getElementById("google-sign-up-btn");

    function showError(msg: string) {
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.classList.remove("hidden");
      }
    }

    function hideError() {
      if (errorEl) errorEl.classList.add("hidden");
    }

    if (
      form &&
      firstNameInput &&
      lastNameInput &&
      emailInput &&
      passwordInput &&
      confirmPasswordInput &&
      submitBtn
    ) {
      if (form.dataset.bound === "1") return;
      form.dataset.bound = "1";

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        hideError();

        const firstName = (firstNameInput as HTMLInputElement).value.trim();
        const lastName = (lastNameInput as HTMLInputElement).value.trim();
        const email = (emailInput as HTMLInputElement).value.trim();
        const password = (passwordInput as HTMLInputElement).value;
        const confirmPassword = (confirmPasswordInput as HTMLInputElement)
          .value;

        if (!firstName) {
          showError("El nombre no puede estar vacío.");
          (firstNameInput as HTMLInputElement).focus();
          return;
        }

        if (!lastName) {
          showError("El apellido no puede estar vacío.");
          (lastNameInput as HTMLInputElement).focus();
          return;
        }

        const pwValidation = validatePassword(password);
        if (!pwValidation.valid) {
          showError("La contraseña no cumple los requisitos de seguridad.");
          return;
        }

        if (password !== confirmPassword) {
          showError("Las contraseñas no coinciden.");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Creando cuenta...";
        if (googleBtn) (googleBtn as HTMLButtonElement).disabled = true;

        const removeOverlay = showLoadingOverlay("Creando cuenta…");

        try {
          await signUpWithEmail(email, password, firstName, lastName);
          removeOverlay();
          sessionStorage.setItem("kitchcalc:signup_email", email);
          showVerificationView(email);
        } catch (err: unknown) {
          removeOverlay();
          showError(
            (err as { message?: string })?.message ||
              "Error al crear la cuenta.",
          );
          submitBtn.disabled = false;
          submitBtn.textContent = "Crear cuenta";
          if (googleBtn) (googleBtn as HTMLButtonElement).disabled = false;
        }
      });

      function updatePasswordRules() {
        const pw = (passwordInput as HTMLInputElement).value;
        const rulesEl = document.getElementById("password-rules");
        if (pw.length > 0) {
          rulesEl?.classList.remove("hidden");
        } else {
          rulesEl?.classList.add("hidden");
        }
        const results = getRuleResults(pw);
        for (const r of results) {
          const row = document.getElementById(`rule-${r.key}`);
          if (!row) continue;
          const icon = row.querySelector(".rule-icon");
          const text = row.querySelector(".rule-text");
          if (r.passed) {
            icon!.textContent = "✓";
            (icon as HTMLElement).style.color = "var(--color-success, #16a34a)";
            text!.className = "rule-text text-success";
          } else {
            icon!.textContent = "○";
            (icon as HTMLElement).style.color = "";
            text!.className = "rule-text text-muted-foreground";
          }
        }
      }

      function updateMatchStatus() {
        const pw = (passwordInput as HTMLInputElement).value;
        const cpw = (confirmPasswordInput as HTMLInputElement).value;
        const el = document.getElementById("password-match-status");
        if (!el || cpw.length === 0) {
          if (el) el.classList.add("hidden");
          return;
        }
        el.classList.remove("hidden");
        if (pw === cpw) {
          el.textContent = "✓ Las contraseñas coinciden";
          el.style.color = "var(--color-success, #16a34a)";
        } else {
          el.textContent = "✗ Las contraseñas no coinciden";
          el.style.color = "var(--color-danger, #dc2626)";
        }
      }

      (passwordInput as HTMLInputElement).addEventListener("input", () => {
        updatePasswordRules();
        updateMatchStatus();
      });
      (confirmPasswordInput as HTMLInputElement).addEventListener(
        "input",
        updateMatchStatus,
      );
    }

    if (googleBtn) {
      if (googleBtn.dataset.bound === "1") return;
      googleBtn.dataset.bound = "1";

      googleBtn.addEventListener("click", async () => {
        const btn = googleBtn as HTMLButtonElement;
        btn.disabled = true;
        btn.classList.add("opacity-60", "pointer-events-none");
        const label = btn.querySelector("[data-google-label]");
        if (label) label.textContent = "Redirigiendo...";
        if (submitBtn) submitBtn.disabled = true;

        const removeOverlay = showLoadingOverlay("Creando cuenta…");

        try {
          const redirect = getSafeRedirect();
          await signInWithGoogle(redirect);
        } catch (err: unknown) {
          removeOverlay();
          btn.disabled = false;
          btn.classList.remove("opacity-60", "pointer-events-none");
          if (label) label.textContent = "Continuar con Google";
          if (submitBtn) submitBtn.disabled = false;
          showError(
            (err as { message?: string })?.message ||
              "Error al iniciar sesión con Google.",
          );
        }
      });
    }
  }

  document.addEventListener("astro:page-load", () => {
    setupSignUp();
    checkPendingVerification();
    setupPasswordToggles();
  });
  document.addEventListener("astro:after-swap", () => {
    setupSignUp();
    checkPendingVerification();
    setupPasswordToggles();
  });
  setupSignUp();
  checkPendingVerification();
  setupPasswordToggles();

  function showVerificationView(email: string) {
    const content = document.getElementById("sign-up-content");
    const verified = document.getElementById("sign-up-verified");
    const emailEl = document.getElementById("verified-email");
    if (content) content.classList.add("hidden");
    if (verified) verified.classList.remove("hidden");
    if (emailEl) emailEl.textContent = email;
    setupResend();
  }

  function setupResend() {
    const resendBtn = document.getElementById("resend-verification");
    const statusEl = document.getElementById("resend-status");
    const emailEl = document.getElementById("verified-email");

    if (!resendBtn || !statusEl || !emailEl) return;
    if (resendBtn.dataset.bound === "1") return;
    resendBtn.dataset.bound = "1";

    resendBtn.addEventListener("click", async () => {
      const email = emailEl.textContent;
      if (!email) return;

      resendBtn.setAttribute("disabled", "true");
      resendBtn.textContent = "Enviando...";
      statusEl.classList.add("hidden");

      try {
        const { authClient } = await import("@recetario/auth/client");
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        await (authClient as any).sendVerificationEmail({
          email,
          callbackURL: `${window.location.origin}/sign-in`,
        });
        statusEl.textContent = "Correo reenviado. Revisa tu bandeja.";
        statusEl.className = "text-success text-xs mt-1";
        statusEl.classList.remove("hidden");
      } catch {
        statusEl.textContent = "Error al reenviar. Intenta de nuevo.";
        statusEl.className = "text-danger text-xs mt-1";
        statusEl.classList.remove("hidden");
      } finally {
        resendBtn.removeAttribute("disabled");
        resendBtn.textContent = "Reenviar correo";
      }
    });
  }

  function checkPendingVerification() {
    const email = sessionStorage.getItem("kitchcalc:signup_email");
    if (email) {
      showVerificationView(email);
      setupResend();
    }
  }
</script>
