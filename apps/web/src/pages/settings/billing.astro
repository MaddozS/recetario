---
const redirectUrl = new URL("/settings", Astro.url.origin);
redirectUrl.searchParams.set("tab", "billing");
for (const [key, value] of Astro.url.searchParams.entries()) {
  if (key !== "tab") {
    redirectUrl.searchParams.append(key, value);
  }
}
return Astro.redirect(redirectUrl.pathname + redirectUrl.search, 301);
