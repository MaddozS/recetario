---
import Layout from "@/layouts/Layout.astro";
import {
  getRemainingRecipes,
  getRemainingIngredients,
} from "@recetario/billing";
import { countUserRecipes, countUserIngredients } from "@recetario/billing";
import { buildPricingPlans } from "@recetario/billing";
import { apiFetch } from "@/lib/api-client";
import { z } from "zod";
import BillingSection from "@/components/BillingSection.astro";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const ownerId = Astro.locals.user!.id;
const subscription = Astro.locals.subscription;

const [recipeCount, ingredientCount, rawPlans] = await Promise.all([
  countUserRecipes(ownerId),
  countUserIngredients(ownerId),
  apiFetch(
    "/api/billing/plans",
    {
      schema: z.array(
        z.object({
          id: z.string(),
          stripePriceId: z.string(),
          priceCents: z.number().int(),
          currency: z.string(),
        }),
      ),
    },
    Astro,
  ),
]);

const plans = buildPricingPlans(rawPlans);

const remainingRecipes = getRemainingRecipes(subscription, recipeCount);
const remainingIngredients = getRemainingIngredients(
  subscription,
  ingredientCount,
);

const isSuccess = Astro.url.searchParams.get("success") === "1";
const isCanceled = Astro.url.searchParams.get("canceled") === "1";
---

<Layout
  currentPage="settings"
  showSideBar={true}
  breadcrumbs={[
    { label: "Configuración", href: "/settings" },
    { label: "Facturación" },
  ]}
>
  <section class="mx-auto max-w-3xl space-y-6">
    <BillingSection
      {subscription}
      {plans}
      {recipeCount}
      {ingredientCount}
      {remainingRecipes}
      {remainingIngredients}
      showBackButton={true}
      {isSuccess}
      {isCanceled}
    />
  </section>
</Layout>
