---
import Layout from "@/layouts/Layout.astro";
import { getRemainingRecipes, getRemainingIngredients } from "@recetario/stripe";
import { apiFetch } from "@/lib/api-client";
import { plansListResponseSchema, usageCountsResponseSchema } from "@recetario/types";
import BillingSection from "@/components/organisms/settings/BillingSection.astro";

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/sign-in");
}

const subscription = Astro.locals.subscription;

const [counts, plans] = await Promise.all([
  apiFetch("/api/usage-counts", { schema: usageCountsResponseSchema }, Astro),
  apiFetch("/api/billing/plans", { schema: plansListResponseSchema }, Astro),
]);
const { recipes: recipeCount, ingredients: ingredientCount } = counts;

const remainingRecipes = getRemainingRecipes(subscription, recipeCount);
const remainingIngredients = getRemainingIngredients(
  subscription,
  ingredientCount,
);

const isSuccess = Astro.url.searchParams.get("success") === "1";
const isCanceled = Astro.url.searchParams.get("canceled") === "1";
---

<Layout
  currentPage="settings"
  showSideBar={true}
  breadcrumbs={[
    { label: "Configuración", href: "/settings" },
    { label: "Facturación" },
  ]}
>
  <section class="mx-auto max-w-3xl space-y-6">
    <BillingSection
      {subscription}
      {plans}
      {recipeCount}
      {ingredientCount}
      {remainingRecipes}
      {remainingIngredients}
      showBackButton={true}
      {isSuccess}
      {isCanceled}
    />
  </section>
</Layout>
