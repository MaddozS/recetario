---
import Card from "@/components/ui/Card.astro";
---

<div class="space-y-6 animate-pulse">
  <!-- Heading Skeleton -->
  <div class="h-8 w-64 bg-muted rounded-xl"></div>

  <!-- Recipe Selector Skeleton -->
  <Card padding="lg" class="h-64 bg-card/60 space-y-4">
    <div class="flex items-center justify-between border-b border-border pb-4">
      <div class="h-6 w-48 bg-muted rounded"></div>
      <div class="h-6 w-24 bg-muted rounded"></div>
    </div>
    <div class="space-y-3 pt-2">
      <div class="h-12 w-full bg-muted/50 rounded-xl"></div>
      <div class="h-12 w-full bg-muted/50 rounded-xl"></div>
      <div class="h-12 w-full bg-muted/50 rounded-xl"></div>
    </div>
  </Card>

  <!-- Summary Skeleton -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <Card padding="md" class="h-24 bg-card/60 space-y-2">
      <div class="h-3 w-24 bg-muted rounded"></div>
      <div class="h-6 w-32 bg-muted rounded"></div>
    </Card>
    <Card padding="md" class="h-24 bg-card/60 space-y-2">
      <div class="h-3 w-24 bg-muted rounded"></div>
      <div class="h-6 w-32 bg-muted rounded"></div>
    </Card>
  </div>
</div>
