---
import Icon from "@/components/atoms/Icon.astro";
import { apiFetch } from "@/lib/api-client";
import { z } from "zod";
import {
  recipeSummarySchema,
  ingredientUsageMapSchema,
} from "@recetario/types";
import { hasFeature, timeAgo } from "@recetario/stripe";
import type { UserSubscriptionInfo } from "@recetario/stripe";
import EmptyState from "@/components/molecules/shared/EmptyState.astro";
import RecipeMiniCard from "@/components/molecules/recipes/RecipeMiniCard.astro";
import RecipeGridCard from "@/components/molecules/recipes/RecipeGridCard.astro";
import RecipeStats from "@/components/molecules/recipes/RecipeStats.astro";
import Button from "@/components/atoms/Button.astro";
import Card from "@/components/molecules/shared/Card.astro";
import FeedbackAlert from "@/components/molecules/shared/FeedbackAlert.astro";

interface Props {
  subscription: UserSubscriptionInfo;
  selectedCategory?: string | null;
  feedbackType?: string | null;
  feedbackMessage?: string | null;
}

const {
  subscription,
  selectedCategory = null,
  feedbackType = null,
  feedbackMessage = null,
} = Astro.props;

const recipes = await apiFetch(
  "/api/recipes",
  { schema: z.array(recipeSummarySchema) },
  Astro,
);

const ingredientUsage = recipes.length > 0
  ? await apiFetch(
      "/api/ingredients/usage",
      { schema: ingredientUsageMapSchema },
      Astro,
    )
  : {};

const categoryCount = new Set(recipes.filter((r) => r.category).map((r) => r.category)).size;
const usedIngredientCount = Object.keys(ingredientUsage).length;

const recipesJson = JSON.stringify(recipes);

const incompleteRecipes = recipes.filter((r) => r.ingredientCount === 0).length;
const noCategoryRecipes = recipes.filter((r) => !r.category).length;

const lastUpdated = recipes.reduce<string | null>((latest, r) => {
  if (!r.updatedAt) return latest;
  return !latest || r.updatedAt > latest ? r.updatedAt : latest;
}, null);
const lastUpdatedLabel = lastUpdated ? timeAgo(lastUpdated) : "Sin actividad";

const recentRecipes = recipes
  .filter((r) => r.updatedAt)
  .sort((a, b) => new Date(b.updatedAt!).getTime() - new Date(a.updatedAt!).getTime())
  .slice(0, 5)
  .map((r) => ({ id: r.id, name: r.name, category: r.category, timeAgo: timeAgo(r.updatedAt!) }));
---

<div class="animate-fade-in">
  {
    feedbackType === "error" && feedbackMessage && (
      <div class="relative mb-6">
        <FeedbackAlert type="error" message={feedbackMessage} />
        <a href="/pricing" class="text-danger ml-2 font-bold underline">Actualizar plan</a>
      </div>
    )
  }

  {
    recipes.length === 0 ? (
      <Card padding="lg" class="mx-auto max-w-3xl p-8 shadow-md">
        <EmptyState
          icon="lucide:book-plus"
          iconSize={28}
          title="Todavia no tienes recetas"
          description="Entra por primera vez al recetario desde aqui y crea tu primera receta. El boton del sidebar ya funciona tambien para este estado vacio."
          titleTag="h1"
          titleClasses="mt-6 text-3xl font-black text-foreground"
          descClasses="mt-3 text-base text-muted-foreground"
        />

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button
            variant="primary"
            icon="plus"
            data-open-create-recipe-dialog="create-recipe-dialog"
          >
            Crear primera receta
          </Button>
          <Button variant="secondary" href="/ingredients" icon="package-search">
            Ver ingredientes
          </Button>
        </div>
      </Card>
    ) : (
      <div class="space-y-8">
        <RecipeStats
          recipeCount={recipes.length}
          categoryCount={categoryCount}
          ingredientCount={usedIngredientCount}
        />

        <div class="info-cards grid grid-cols-1 gap-3 sm:grid-cols-3">
          <Card padding="sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:alert-triangle" size={14} />
              Recetas por completar
            </div>
            {
              incompleteRecipes > 0 ? (
                <div class="mt-2">
                  <p class="font-bold text-foreground">{incompleteRecipes} recetas</p>
                  <p class="text-sm text-muted-foreground">sin ingredientes asignados</p>
                </div>
              ) : (
                <p class="mt-2 text-sm font-medium text-success">Todas tienen ingredientes</p>
              )
            }
          </Card>

          <Card padding="sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:tag" size={14} />
              Sin categoría
            </div>
            {
              noCategoryRecipes > 0 ? (
                <div class="mt-2">
                  <p class="font-bold text-foreground">{noCategoryRecipes} recetas</p>
                  <p class="text-sm text-muted-foreground">sin categoría asignada</p>
                </div>
              ) : (
                <p class="mt-2 text-sm font-medium text-success">Todas están categorizadas</p>
              )
            }
          </Card>

          <Card padding="sm">
            <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
              <Icon name="lucide:clock" size={14} />
              Última modificación
            </div>
            <p class="mt-2 font-bold text-foreground">
              {lastUpdatedLabel}
            </p>
          </Card>
        </div>

        {
          recentRecipes.length > 0 && (
            <div>
              <h2 class="mb-3 text-sm font-bold uppercase tracking-[0.12em] text-muted-foreground">
                Recientemente actualizadas
              </h2>
              <div class="flex gap-3 overflow-x-auto pb-3">
                {
                  recentRecipes.map((r, i) => (
                    <div style={`--stagger-index:${i}`} class="w-48 flex-none">
                      <RecipeMiniCard
                        id={r.id}
                        name={r.name}
                        category={r.category ?? undefined}
                        timeAgo={r.timeAgo}
                      />
                    </div>
                  ))
                }
              </div>
            </div>
          )
        }

        <div id="categories-container">
          <script type="application/json" id="recipes-data" is:inline set:html={recipesJson}></script>

          <div class="flex items-end justify-between gap-3 mb-3">
            <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-muted-foreground">
              Recetas
            </h2>
          </div>

          <div class="flex items-center gap-2 mb-3">
            <div class="relative flex-1">
              <label for="recipeSearch" class="sr-only">Buscar receta</label>
              <Icon name="lucide:search" size={18} class="text-subtle-foreground absolute top-1/2 left-3.5 -translate-y-1/2" />
              <input
                type="search"
                id="recipeSearch"
                placeholder="Buscar receta..."
                class="bg-background border-border focus:ring-accent-500/20 focus:border-accent-500 placeholder:text-subtle-foreground w-full rounded-xl border py-2.5 pr-4 pl-10 text-sm transition-colors focus:ring-2 focus:outline-none"
              />
            </div>
            <Button
              variant="primary"
              icon="plus"
              data-open-create-recipe-dialog="create-recipe-dialog"
              class="shrink-0"
            >
              <span class="hidden sm:inline">Nueva Receta</span>
            </Button>
          </div>

          <div class="flex items-center gap-2 overflow-x-auto pb-3 sm:flex-wrap sm:overflow-visible scrollbar-thin [-webkit-overflow-scrolling:touch]">
            {
              [...new Set(recipes.filter((r) => r.category).map((r) => r.category!))].map(
                (cat) => {
                  const count = recipes.filter((r) => r.category === cat).length;
                  const active = selectedCategory !== null && selectedCategory === cat;
                  return (
                    <button
                      type="button"
                      data-category={cat}
                      class={`filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold transition-colors shrink-0 ${active ? "bg-accent-600 text-white" : "bg-accent-50 text-accent-600 hover:bg-accent-100 border border-accent-200"} cursor-pointer`}
                    >
                      {cat}
                      <span class={`inline-flex min-w-5 items-center justify-center rounded-full px-1 text-[11px] font-bold ${active ? "bg-accent-500 text-white" : "bg-accent-200/50 text-accent-700"}`}>
                        {count}
                      </span>
                    </button>
                  );
                },
              )
            }
            {
              noCategoryRecipes > 0 && (
                <button
                  type="button"
                  data-category=""
                  class={`filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold transition-colors shrink-0 ${selectedCategory === "" ? "bg-accent-600 text-white" : "bg-muted text-muted-foreground hover:bg-border border border-border"} cursor-pointer`}
                >
                  Sin categoría
                  <span class={`inline-flex min-w-5 items-center justify-center rounded-full px-1 text-[11px] font-bold ${selectedCategory === "" ? "bg-accent-500 text-white" : "bg-border text-subtle-foreground"}`}>
                    {noCategoryRecipes}
                  </span>
                </button>
              )
            }
            <button
              type="button"
              id="clear-filter-btn"
              style={`display:${selectedCategory !== null ? "" : "none"}`}
              class="inline-flex items-center gap-1 rounded-full border border-border bg-card px-3 py-1.5 text-sm font-semibold text-muted-foreground transition-colors hover:bg-background shrink-0 cursor-pointer"
            >
              <Icon name="lucide:x" size={12} />
              Limpiar filtro
            </button>
          </div>

          <div id="filtered-grid-wrapper" class="mt-4">
            {
              recipes.length > 0 ? (
                <div id="filtered-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {recipes.map((r, i) => {
                    const matchesInitialFilter = selectedCategory === null ||
                      (r.category ?? "") === (selectedCategory || "");
                    return (
                      <div
                        style={`--stagger-index:${i}${matchesInitialFilter ? "" : "; display:none"}`}
                        class="snc-card"
                      >
                        <RecipeGridCard
                          id={r.id}
                          name={r.name}
                          category={r.category ?? undefined}
                          ingredientCount={r.ingredientCount}
                          canDuplicate={hasFeature(subscription, "recipe_duplicate")}
                        />
                      </div>
                    );
                  })}
                </div>
              ) : (
                <Card padding="lg" class="p-8 text-center">
                  <p class="text-muted-foreground">No hay recetas en esta categoría</p>
                </Card>
              )
            }
          </div>
        </div>
      </div>
    )
  }
</div>

<script>
  declare global {
    interface Window {
      __recipesPopstateBound?: boolean;
      __recipesFilterApi?: {
        setCategory: (cat: string | null) => void;
      };
    }
  }

  // Devuelve true si el grid ya estaba disponible (inicializó o ya estaba bound);
  // false si el island server:defer aún no ha inyectado su HTML.
  function setupRecipeFilters(): boolean {
    const dataEl = document.getElementById("recipes-data");
    const searchInput = document.getElementById("recipeSearch");
    const pills = document.querySelectorAll<HTMLElement>(".filter-btn");
    const clearBtn = document.getElementById("clear-filter-btn");
    const gridWrapper = document.getElementById("filtered-grid-wrapper");

    if (!dataEl || !dataEl.textContent || !gridWrapper) return false;
    if (gridWrapper.dataset.filterBound === "1") return true;
    gridWrapper.dataset.filterBound = "1";

    const recipesData: { id: number; name: string; category: string | null; ingredientCount: number }[] = JSON.parse(dataEl.textContent);

    let activeSearchTerm = "";
    let activeCategory: string | null = new URLSearchParams(window.location.search).get("category");

    const activeClasses = ["bg-accent-600", "text-white"];
    const inactiveClasses = {
      normal: ["bg-accent-50", "text-accent-600", "hover:bg-accent-100"],
      uncategorized: ["bg-muted", "text-muted-foreground", "hover:bg-border"],
    };

    function updateGrid() {
      const cardEls = gridWrapper!.querySelectorAll<HTMLElement>("[data-card-id]");
      let visibleCount = 0;

      cardEls.forEach((cardEl) => {
        const id = Number(cardEl.dataset.cardId);
        const recipe = recipesData.find((r) => r.id === id);
        if (!recipe) return;

        let matchesCategory = true;
        if (activeCategory !== null) {
          const catKey = activeCategory || "";
          matchesCategory = (recipe.category || "") === catKey;
        }

        let matchesSearch = true;
        if (activeSearchTerm) {
          const name = (recipe.name || "")
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
          matchesSearch = name.includes(activeSearchTerm);
        }

        const isVisible = matchesCategory && matchesSearch;
        // El SSR pre-oculta el wrapper .snc-card; el JS controla ese mismo wrapper
        const wrapper = cardEl.closest<HTMLElement>(".snc-card") ?? cardEl;
        wrapper.style.display = isVisible ? "" : "none";
        if (isVisible) visibleCount++;
      });

      let emptyMsg = gridWrapper!.querySelector<HTMLElement>(".snc-empty-grid-msg");
      if (visibleCount === 0) {
        if (!emptyMsg) {
          emptyMsg = document.createElement("div");
          emptyMsg.className =
            "snc-empty-grid-msg rounded-2xl border border-border bg-card p-8 text-center shadow-sm mt-4";
          emptyMsg.innerHTML =
            '<p class="text-muted-foreground text-sm">No se encontraron recetas</p>';
          gridWrapper!.appendChild(emptyMsg);
        }
        emptyMsg.style.display = "";
      } else if (emptyMsg) {
        emptyMsg.style.display = "none";
      }
    }

    function updatePillStyles(index: string | null) {
      pills.forEach((pill) => {
        const pillCat = pill.dataset.category ?? null;
        const isActive = pillCat === index;

        if (isActive) {
          pill.classList.remove(...inactiveClasses.normal, ...inactiveClasses.uncategorized);
          pill.classList.add(...activeClasses);
          const span = pill.querySelector("span");
          if (span) {
            span.classList.remove("bg-accent-200/50", "text-accent-700", "bg-border", "text-subtle-foreground");
            span.classList.add("bg-accent-500", "text-white");
          }
        } else {
          pill.classList.remove(...activeClasses);
          const useUncategorized = pillCat === "";
          const classes = useUncategorized ? inactiveClasses.uncategorized : inactiveClasses.normal;
          pill.classList.add(...classes);
          const span = pill.querySelector("span");
          if (span) {
            span.classList.remove("bg-accent-500", "text-white");
            if (useUncategorized) {
              span.classList.add("bg-border", "text-subtle-foreground");
            } else {
              span.classList.add("bg-accent-200/50", "text-accent-700");
            }
          }
        }
      });
      if (clearBtn) clearBtn.style.display = index === null ? "none" : "";
    }

    if (searchInput instanceof HTMLInputElement && searchInput.dataset.bound !== "1") {
      searchInput.dataset.bound = "1";
      searchInput.addEventListener("input", () => {
        activeSearchTerm = searchInput.value.trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        updateGrid();
      });
    }

    pills.forEach((pill) => {
      if (!(pill instanceof HTMLElement)) return;
      if (pill.dataset.filterBound === "1") return;
      pill.dataset.filterBound = "1";
      pill.addEventListener("click", () => {
        const cat = pill.dataset.category ?? "";
        if (activeCategory === cat) {
          activeCategory = null;
          updatePillStyles(null);
        } else {
          activeCategory = cat;
          updatePillStyles(cat);
        }
        updateGrid();
        const url = activeCategory !== null ? `/recipes?category=${encodeURIComponent(activeCategory)}` : "/recipes";
        history.pushState({}, "", url);
      });
    });

    if (clearBtn instanceof HTMLElement && clearBtn.dataset.bound !== "1") {
      clearBtn.dataset.bound = "1";
      clearBtn.addEventListener("click", () => {
        activeCategory = null;
        updatePillStyles(null);
        updateGrid();
        history.pushState({}, "", "/recipes");
      });
    }

    // Sincroniza estado inicial con la URL (pills + tarjetas pre-ocultadas por SSR)
    if (activeCategory !== null) updatePillStyles(activeCategory);
    updateGrid();

    // Botón atrás/adelante: refleja el filtro de la URL en el estado client-side.
    // El handler se registra una sola vez y delega en el estado del grid actual.
    if (!window.__recipesPopstateBound) {
      window.__recipesPopstateBound = true;
      window.addEventListener("popstate", () => {
        const api = window.__recipesFilterApi;
        if (!api) return;
        api.setCategory(new URLSearchParams(window.location.search).get("category"));
      });
    }

    window.__recipesFilterApi = {
      setCategory(cat: string | null) {
        activeCategory = cat;
        updatePillStyles(cat);
        updateGrid();
      },
    };

    return true;
  }

  document.addEventListener("astro:page-load", () => setupRecipeFilters());
  document.addEventListener("astro:after-swap", () => setupRecipeFilters());

  // El componente es un server island (server:defer): su HTML se inyecta de forma
  // asíncrona DESPUÉS de que astro:page-load / astro:after-swap ya se dispararon.
  // Un observer permanente detecta la aparición del grid en cada navegación y
  // ejecuta el setup (idempotente gracias al guard filterBound del gridWrapper).
  const gridObserver = new MutationObserver(() => {
    const dataEl = document.getElementById("recipes-data");
    const gridWrapper = document.getElementById("filtered-grid-wrapper");
    if (dataEl && dataEl.textContent && gridWrapper) {
      setupRecipeFilters();
    }
  });
  gridObserver.observe(document.documentElement, { childList: true, subtree: true });

  setupRecipeFilters();
</script>
