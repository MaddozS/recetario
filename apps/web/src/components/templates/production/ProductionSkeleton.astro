---
import Card from "@/components/molecules/shared/Card.astro";
---

<div class="animate-pulse space-y-6">
  <!-- Heading Skeleton -->
  <div class="space-y-2">
    <div class="bg-muted h-8 w-64 rounded-xl"></div>
    <div class="bg-muted/60 h-4 w-96 max-w-full rounded-lg"></div>
  </div>

  <!-- Recipe Selector Skeleton -->
  <Card padding="lg" class="bg-card/60 h-72 space-y-5">
    <div class="flex items-center justify-between gap-3">
      <div class="space-y-2">
        <div class="bg-muted h-6 w-48 rounded"></div>
        <div class="bg-muted/60 h-4 w-64 max-w-full rounded-lg"></div>
      </div>
      <div class="bg-muted h-7 w-20 rounded-full"></div>
    </div>
    <div class="space-y-3 pt-1">
      <div class="bg-muted/50 h-14 w-full rounded-xl"></div>
      <div class="bg-muted/50 h-14 w-full rounded-xl"></div>
      <div class="bg-muted/50 h-14 w-full rounded-xl"></div>
    </div>
  </Card>

  <!-- Results Skeleton -->
  <Card padding="md" class="bg-card/60 h-32 space-y-3">
    <div class="bg-muted h-5 w-40 rounded"></div>
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-muted/40 h-16 rounded-xl"></div>
      <div class="bg-muted/40 h-16 rounded-xl"></div>
    </div>
  </Card>
</div>
