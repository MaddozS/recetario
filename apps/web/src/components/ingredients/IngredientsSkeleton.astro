---
import Card from "@/components/ui/Card.astro";
---

<div class="space-y-6 animate-pulse">
  <!-- Desktop Create Form Skeleton -->
  <Card padding="lg" class="hidden lg:block h-48 bg-card/60 space-y-4">
    <div class="h-6 w-48 bg-muted rounded"></div>
    <div class="grid grid-cols-5 gap-4 pt-2">
      <div class="h-10 bg-muted rounded-xl"></div>
      <div class="h-10 bg-muted rounded-xl"></div>
      <div class="h-10 bg-muted rounded-xl"></div>
      <div class="h-10 bg-muted rounded-xl"></div>
      <div class="h-10 bg-muted rounded-xl"></div>
    </div>
  </Card>

  <!-- Table Card Skeleton -->
  <Card class="overflow-hidden p-6 space-y-4">
    <div class="flex items-center justify-between border-b border-border pb-4">
      <div class="h-6 w-40 bg-muted rounded"></div>
      <div class="h-10 w-72 bg-muted rounded-xl"></div>
    </div>
    <div class="space-y-3 pt-2">
      {Array.from({ length: 5 }).map(() => (
        <div class="h-14 w-full bg-muted/50 rounded-xl"></div>
      ))}
    </div>
  </Card>
</div>
