---
import Icon from "@/components/ui/Icon.astro";

interface IngredientRef {
  id: number;
  name: string;
}

interface Props {
  recipeEditFormId: string;
  instructions: string | undefined | null;
  ingredients: IngredientRef[];
  recipeIngredientIds: number[];
}

const { recipeEditFormId, instructions, ingredients, recipeIngredientIds } =
  Astro.props;
const ingredientJson = JSON.stringify(ingredients);
const recipeIngredientIdsJson = JSON.stringify(recipeIngredientIds);
---

<div class="border-border mx-1 mt-6 py-6 sm:mx-2 lg:mx-8">
  <label
    class="text-secondary-foreground mb-3 flex items-center gap-2 text-sm font-bold"
  >
    <Icon name="lucide:list-checks" size={16} class="text-accent-500" />
    Instrucciones de Preparación
  </label>

  <div
    class="instructions-editor"
    data-ingredients={ingredientJson}
    data-recipe-ingredient-ids={recipeIngredientIdsJson}
    data-initial={JSON.stringify(instructions || "")}
    data-form-id={recipeEditFormId}
  >
    <div
      class="instructions-toolbar border-border bg-muted flex items-center gap-1 overflow-x-auto rounded-t-xl border px-3 py-2"
    >
      <button
        type="button"
        class="toolbar-btn text-muted-foreground hover:bg-accent-50 hover:text-accent-600 inline-flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded-lg transition-colors"
        data-toolbar-btn="bold"
        title="Negritas"><Icon name="lucide:bold" size={16} /></button
      >
      <button
        type="button"
        class="toolbar-btn text-muted-foreground hover:bg-accent-50 hover:text-accent-600 inline-flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded-lg transition-colors"
        data-toolbar-btn="italic"
        title="Cursiva"><Icon name="lucide:italic" size={16} /></button
      >
      <div class="wysiwyg-separator mx-1 shrink-0"></div>
      <button
        type="button"
        class="toolbar-btn text-muted-foreground hover:bg-accent-50 hover:text-accent-600 inline-flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded-lg transition-colors"
        data-toolbar-btn="numbered-list"
        title="Lista numerada"
        ><Icon name="lucide:list-ordered" size={16} /></button
      >
      <button
        type="button"
        class="toolbar-btn text-muted-foreground hover:bg-accent-50 hover:text-accent-600 inline-flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded-lg transition-colors"
        data-toolbar-btn="bullet-list"
        title="Lista con viñetas"><Icon name="lucide:list" size={16} /></button
      >
      <div class="wysiwyg-separator mx-1 shrink-0"></div>
      <button
        type="button"
        class="toolbar-btn text-muted-foreground hover:bg-accent-50 hover:text-accent-600 inline-flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded-lg transition-colors"
        data-toolbar-btn="heading"
        title="Sección"><Icon name="lucide:heading" size={16} /></button
      >
      <div class="wysiwyg-separator mx-1 shrink-0"></div>

      <div class="relative shrink-0">
        <button
          type="button"
          class="text-accent-700 bg-accent-50 hover:bg-accent-100 inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-lg px-3 text-sm font-medium whitespace-nowrap transition-colors"
          data-ingredient-btn
          title="Insertar ingrediente"
        >
          <Icon name="lucide:chef-hat" size={16} />
          <span class="hidden sm:inline">@ Ingrediente</span>
          <Icon name="lucide:chevron-down" size={14} />
        </button>
        <div
          class="ingredient-dropdown bg-card border-border fixed z-30 hidden overflow-hidden rounded-xl border shadow-xl"
          data-ingredient-dropdown
        >
        </div>
      </div>

      <div class="relative shrink-0">
        <button
          type="button"
          class="text-secondary-foreground bg-muted hover:bg-hover-muted inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-lg px-3 text-sm font-medium whitespace-nowrap transition-colors"
          data-timer-btn
          title="Insertar temporizador"
        >
          <Icon name="lucide:timer" size={16} />
          <span class="hidden sm:inline">Temporizador</span>
          <Icon name="lucide:chevron-down" size={14} />
        </button>
        <div class="timer-popover fixed z-30" data-timer-popover></div>
      </div>
    </div>

    <div class="border-border overflow-hidden rounded-b-xl border-x border-b">
      <div
        class="contenteditable-editor bg-background text-secondary-foreground focus-visible:ring-accent-500 min-h-72 w-full border-0 p-4 text-sm leading-relaxed outline-none focus-visible:ring-2 lg:min-h-88"
        contenteditable="true"
        data-contenteditable
      >
      </div>
    </div>

    <div
      class="mention-dropdown bg-card border-border fixed z-30 overflow-hidden rounded-xl border shadow-xl"
      data-mention-dropdown
    >
    </div>
  </div>
</div>

<script>
  import { sanitizeHtml, looksLikeHtml } from "../lib/html-sanitizer";
  import { markdownToEditorHtml } from "../lib/instructions-parser";

  function setupInstructionsEditor() {
    const editor = document.querySelector<HTMLElement>(".instructions-editor");
    if (!editor || editor.dataset.editorBound) return;
    editor.dataset.editorBound = "1";

    const rawIngredients: { id: number; name: string }[] = editor.dataset
      .ingredients
      ? JSON.parse(editor.dataset.ingredients)
      : [];
    const recipeIds: number[] = editor.dataset.recipeIngredientIds
      ? JSON.parse(editor.dataset.recipeIngredientIds)
      : [];
    const recipeIdSet = new Set(recipeIds);
    const ingredientById = new Map<number, string>();
    for (const ing of rawIngredients) ingredientById.set(ing.id, ing.name);

    const initialContent: string = editor.dataset.initial
      ? JSON.parse(editor.dataset.initial)
      : "";
    const formId = editor.dataset.formId || "";

    const contentEditableCandidate = editor.querySelector<HTMLElement>(
      "[data-contenteditable]",
    );
    if (!contentEditableCandidate) return;
    const contentEditable: HTMLElement = contentEditableCandidate;

    const hiddenTA =
      document.querySelector<HTMLInputElement>("[data-hidden-ta]");
    const mentionDropdown = editor.querySelector<HTMLElement>(
      "[data-mention-dropdown]",
    );
    const ingredientDropdown = editor.querySelector<HTMLElement>(
      "[data-ingredient-dropdown]",
    );
    const ingredientBtn = editor.querySelector<HTMLElement>(
      "[data-ingredient-btn]",
    );
    const timerBtn = editor.querySelector<HTMLElement>("[data-timer-btn]");
    const timerPopover = editor.querySelector<HTMLElement>(
      "[data-timer-popover]",
    );

    // --- Helpers ---

    function idToName(id: number): string | undefined {
      return ingredientById.get(id);
    }

    function isInRecipe(id: number): boolean {
      return recipeIdSet.has(id);
    }

    function closeAllDropdowns() {
      closeMentionDropdown();
      closeIngredientDropdown();
      closeTimerPopover();
    }

    // --- Tag badge creation ---

    function createTagSpan(
      name: string,
      id: number,
      inRecipe: boolean,
    ): HTMLSpanElement {
      const span = document.createElement("span");
      span.contentEditable = "false";
      span.dataset.type = "ingredient";
      span.dataset.id = String(id);
      span.className = inRecipe ? "tag-badge" : "tag-badge tag-badge--outlined";
      span.textContent = name;
      span.appendChild(document.createTextNode("\u200B"));
      return span;
    }

    function createTimerSpan(value: string, unit: string): HTMLSpanElement {
      const span = document.createElement("span");
      span.contentEditable = "false";
      span.dataset.type = "timer";
      span.dataset.value = value;
      span.dataset.unit = unit;
      span.className = "timer-badge";
      span.textContent = "\u23F1 " + value + " " + unit;
      span.appendChild(document.createTextNode("\u200B"));
      return span;
    }

    // --- Serialization ---

    function serializeEditor(): string {
      return sanitizeHtml(contentEditable.innerHTML);
    }

    function updateHiddenTA() {
      if (hiddenTA) hiddenTA.value = serializeEditor();
    }

    // --- Content loading ---

    function loadContent(raw: string) {
      if (!raw) {
        contentEditable.innerHTML = "";
        return;
      }
      if (looksLikeHtml(raw)) {
        contentEditable.innerHTML = sanitizeHtml(raw);
      } else {
        contentEditable.innerHTML = markdownToEditorHtml(raw, rawIngredients);
      }
    }

    // --- Toolbar ---

    const toolbarBtns =
      editor.querySelectorAll<HTMLElement>("[data-toolbar-btn]");
    toolbarBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        contentEditable.focus();
        const action = btn.dataset.toolbarBtn;
        switch (action) {
          case "bold":
            document.execCommand("bold");
            break;
          case "italic":
            document.execCommand("italic");
            break;
          case "numbered-list":
            document.execCommand("insertOrderedList");
            break;
          case "bullet-list":
            document.execCommand("insertUnorderedList");
            break;
          case "heading":
            document.execCommand("formatBlock", false, "<h2>");
            break;
        }
      });
    });

    // --- Ingredient dropdown (toolbar button) ---

    function renderIngredientDropdown() {
      if (!ingredientDropdown) return;
      const recipeIngs = rawIngredients.filter((ing) =>
        recipeIdSet.has(ing.id),
      );
      const otherIngs = rawIngredients.filter(
        (ing) => !recipeIdSet.has(ing.id),
      );

      let html = "";
      if (recipeIngs.length > 0) {
        html +=
          '<div class="mention-section-header px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">En esta receta</div>';
        html += recipeIngs
          .map(
            (ing) =>
              `<button type="button" class="mention-item mention-item--recipe flex w-full items-center gap-2 px-3 py-2 text-sm text-left text-secondary-foreground hover:bg-accent-50 hover:text-accent-600 transition-colors" data-ingredient-id="${ing.id}"><svg class="mention-item-icon w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>${escapeHtml(ing.name)}</button>`,
          )
          .join("");
      }
      if (otherIngs.length > 0) {
        if (recipeIngs.length > 0) {
          html += '<div class="mention-divider"></div>';
        }
        html +=
          '<div class="mention-section-header px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Todos los ingredientes</div>';
        html += otherIngs
          .map(
            (ing) =>
              `<button type="button" class="mention-item flex w-full items-center gap-2 px-3 py-2 text-sm text-left text-secondary-foreground hover:bg-accent-50 hover:text-accent-600 transition-colors" data-ingredient-id="${ing.id}"><span class="w-3.5 shrink-0"></span>${escapeHtml(ing.name)}</button>`,
          )
          .join("");
      }
      if (rawIngredients.length === 0) {
        html +=
          '<div class="px-3 py-4 text-sm text-muted-foreground text-center">Primero agrega ingredientes a la receta</div>';
      }
      ingredientDropdown.innerHTML = html;

      ingredientDropdown
        .querySelectorAll<HTMLElement>("[data-ingredient-id]")
        .forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = Number(btn.dataset.ingredientId);
            const name = idToName(id);
            if (!name) return;
            contentEditable.focus();
            const sel = window.getSelection();
            if (sel && sel.rangeCount) {
              const range = sel.getRangeAt(0);
              range.deleteContents();
              const span = createTagSpan(name, id, isInRecipe(id));
              range.insertNode(span);
              const spacer = document.createTextNode(" ");
              span.after(spacer);
              range.setStartAfter(spacer);
              range.collapse(true);
              sel.removeAllRanges();
              sel.addRange(range);
            }
            closeIngredientDropdown();
            updateHiddenTA();
          });
        });
    }

    function openIngredientDropdown() {
      closeAllDropdowns();
      if (!ingredientDropdown) return;
      renderIngredientDropdown();
      ingredientDropdown.classList.remove("hidden");
      positionDropdown(ingredientBtn!, ingredientDropdown!);
    }

    function closeIngredientDropdown() {
      if (ingredientDropdown) ingredientDropdown.classList.add("hidden");
    }

    if (ingredientBtn) {
      ingredientBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (
          ingredientDropdown &&
          !ingredientDropdown.classList.contains("hidden")
        ) {
          closeIngredientDropdown();
        } else {
          openIngredientDropdown();
        }
      });
    }

    // --- Timer popover ---

    let timerValue = "15";
    let timerUnit = "min";

    function renderTimerPopover() {
      if (!timerPopover) return;
      timerPopover.innerHTML =
        "<label>A\u00f1adir tiempo</label>" +
        '<div class="flex gap-2 mb-3">' +
        '<input type="number" id="timer-value-input" value="' +
        timerValue +
        '" min="1" class="w-20 border border-border bg-background rounded-lg px-2 py-1.5 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-accent-500">' +
        '<select id="timer-unit-select" class="flex-1 border border-border bg-background rounded-lg px-2 py-1.5 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-accent-500">' +
        '<option value="seg"' +
        (timerUnit === "seg" ? " selected" : "") +
        ">Segundos</option>" +
        '<option value="min"' +
        (timerUnit === "min" ? " selected" : "") +
        ">Minutos</option>" +
        '<option value="hr"' +
        (timerUnit === "hr" ? " selected" : "") +
        ">Horas</option>" +
        "</select>" +
        "</div>" +
        '<button type="button" id="timer-insert-btn" class="w-full bg-accent-600 hover:bg-accent-700 text-white text-sm font-bold py-2 rounded-lg transition-colors">Insertar</button>';

      const valueInput =
        timerPopover.querySelector<HTMLInputElement>("#timer-value-input");
      const unitSelect =
        timerPopover.querySelector<HTMLSelectElement>("#timer-unit-select");

      valueInput?.addEventListener("input", () => {
        timerValue = valueInput.value || "1";
      });
      unitSelect?.addEventListener("change", () => {
        timerUnit = unitSelect.value;
      });

      const insertBtn =
        timerPopover.querySelector<HTMLElement>("#timer-insert-btn");
      if (insertBtn) {
        insertBtn.addEventListener("click", () => {
          const val = valueInput?.value || "15";
          const unit = unitSelect?.value || "min";
          contentEditable.focus();
          const sel = window.getSelection();
          if (sel && sel.rangeCount) {
            const range = sel.getRangeAt(0);
            range.deleteContents();
            const span = createTimerSpan(val, unit);
            range.insertNode(span);
            const spacer = document.createTextNode(" ");
            span.after(spacer);
            range.setStartAfter(spacer);
            range.collapse(true);
            sel.removeAllRanges();
            sel.addRange(range);
          }
          closeTimerPopover();
          updateHiddenTA();
        });
      }
    }

    function openTimerPopover() {
      closeAllDropdowns();
      if (!timerPopover) return;
      renderTimerPopover();
      timerPopover.classList.add("timer-popover-open");
      positionDropdown(timerBtn!, timerPopover!);
    }

    function closeTimerPopover() {
      if (timerPopover) timerPopover.classList.remove("timer-popover-open");
    }

    if (timerBtn) {
      timerBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (
          timerPopover &&
          timerPopover.classList.contains("timer-popover-open")
        ) {
          closeTimerPopover();
        } else {
          openTimerPopover();
        }
      });
    }

    // --- Position dropdown ---

    function positionDropdown(anchor: HTMLElement, dropdown: HTMLElement) {
      const rect = anchor.getBoundingClientRect();
      const spaceBelow = window.innerHeight - rect.bottom;
      const dropdownHeight = 320;
      if (spaceBelow < dropdownHeight && rect.top > dropdownHeight) {
        dropdown.style.top =
          rect.top - Math.min(dropdownHeight, rect.top - 8) + "px";
      } else {
        dropdown.style.top = rect.bottom + 4 + "px";
      }
      dropdown.style.left = Math.min(rect.left, window.innerWidth - 220) + "px";
      dropdown.style.minWidth = "200px";
      dropdown.style.maxHeight = "16rem";
      dropdown.style.overflowY = "auto";
    }

    // --- @mention autocomplete ---

    const filterMentions = (query: string) =>
      rawIngredients.filter((ing) =>
        ing.name.toLowerCase().includes(query.toLowerCase()),
      );

    let mentionResults: typeof rawIngredients = [];
    let mentionActiveIndex = -1;
    let mentionStartContainer: Node | null = null;
    let mentionStartOffset = 0;
    let mentionEndContainer: Node | null = null;
    let mentionEndOffset = 0;

    function closeMentionDropdown() {
      if (mentionDropdown) {
        mentionDropdown.classList.remove("mention-dropdown-open");
        mentionDropdown.innerHTML = "";
      }
      mentionResults = [];
      mentionActiveIndex = -1;
      mentionStartContainer = null;
      mentionStartOffset = 0;
      mentionEndContainer = null;
      mentionEndOffset = 0;
    }

    function updateMentionActive() {
      if (!mentionDropdown) return;
      mentionDropdown
        .querySelectorAll<HTMLElement>(".mention-item")
        .forEach((item, i) => {
          item.classList.toggle(
            "mention-item-active",
            i === mentionActiveIndex,
          );
        });
    }

    function renderMentionDropdown() {
      if (!mentionDropdown || mentionResults.length === 0) {
        closeMentionDropdown();
        return;
      }

      const recipeMentions = mentionResults.filter((ing) =>
        recipeIdSet.has(ing.id),
      );
      const otherMentions = mentionResults.filter(
        (ing) => !recipeIdSet.has(ing.id),
      );

      let html = "";
      if (recipeMentions.length > 0) {
        html +=
          '<div class="mention-section-header px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">En esta receta</div>';
        html += recipeMentions
          .map(
            (ing, i) =>
              `<button type="button" class="mention-item mention-item--recipe block w-full text-left px-3 py-2 text-sm text-secondary-foreground hover:bg-accent-50 hover:text-accent-600 transition-colors" data-mention-item="${i}"><svg class="mention-item-icon w-3.5 h-3.5 inline mr-1.5 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>${escapeHtml(ing.name)}</button>`,
          )
          .join("");
      }
      if (otherMentions.length > 0) {
        if (recipeMentions.length > 0) {
          html += '<div class="mention-divider"></div>';
        }
        html += otherMentions
          .map(
            (ing, i) =>
              `<button type="button" class="mention-item block w-full text-left px-3 py-2 text-sm text-secondary-foreground hover:bg-accent-50 hover:text-accent-600 transition-colors" data-mention-item="${recipeMentions.length + i}"><span class="w-4 inline-block"></span>${escapeHtml(ing.name)}</button>`,
          )
          .join("");
      }

      const allMentionResults = [...recipeMentions, ...otherMentions];
      mentionResults = allMentionResults;

      mentionDropdown.innerHTML = html;
      mentionDropdown.classList.add("mention-dropdown-open");
      mentionActiveIndex = 0;
      updateMentionActive();
    }

    function positionMentionDropdown() {
      if (!mentionDropdown) return;
      const sel = window.getSelection();
      if (!sel || !sel.rangeCount) return;
      const rect = sel.getRangeAt(0).getBoundingClientRect();
      mentionDropdown.style.top = rect.bottom + 4 + "px";
      mentionDropdown.style.left =
        Math.min(rect.left, window.innerWidth - 220) + "px";
      mentionDropdown.style.minWidth = "200px";
      mentionDropdown.style.maxHeight = "14rem";
      mentionDropdown.style.overflowY = "auto";
    }

    function selectMention(index: number) {
      if (
        index < 0 ||
        index >= mentionResults.length ||
        !mentionStartContainer ||
        !mentionEndContainer
      ) {
        closeMentionDropdown();
        return;
      }

      const sel = window.getSelection();
      if (!sel) return;
      try {
        const range = document.createRange();
        range.setStart(mentionStartContainer, mentionStartOffset);
        range.setEnd(mentionEndContainer, mentionEndOffset);
        sel.removeAllRanges();
        sel.addRange(range);
        range.deleteContents();

        const ing = mentionResults[index];
        const span = createTagSpan(ing.name, ing.id, isInRecipe(ing.id));
        range.insertNode(span);
        const spacer = document.createTextNode(" ");
        span.after(spacer);
        range.setStartAfter(spacer);
        range.collapse(true);
        sel.removeAllRanges();
        sel.addRange(range);
      } catch {
        // selection moved, dismiss
      }
      closeMentionDropdown();
      updateHiddenTA();
    }

    // --- Event listeners ---

    const syncObserver = new MutationObserver(() => {
      updateHiddenTA();
    });
    syncObserver.observe(contentEditable, {
      childList: true,
      characterData: true,
      subtree: true,
    });

    contentEditable.addEventListener("input", () => {
      if (!mentionDropdown) return;
      const sel = window.getSelection();
      if (!sel || !sel.rangeCount) {
        closeMentionDropdown();
        return;
      }
      const range = sel.getRangeAt(0);
      const node = range.startContainer;
      if (node.nodeType !== Node.TEXT_NODE) {
        closeMentionDropdown();
        return;
      }
      const text = node.textContent || "";
      const before = text.substring(0, range.startOffset);
      const match = before.match(/@([a-zA-Záéíóúñü_-]*)$/);
      if (match) {
        const query = match[1];
        mentionStartContainer = node;
        mentionStartOffset = range.startOffset - match[0].length;
        mentionEndContainer = node;
        mentionEndOffset = range.startOffset;
        mentionResults = filterMentions(query);
        if (mentionResults.length > 0) {
          positionMentionDropdown();
          renderMentionDropdown();
          return;
        }
      }
      closeMentionDropdown();
    });

    contentEditable.addEventListener("keydown", (e) => {
      if (
        mentionDropdown &&
        mentionDropdown.classList.contains("mention-dropdown-open")
      ) {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          mentionActiveIndex = (mentionActiveIndex + 1) % mentionResults.length;
          updateMentionActive();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          mentionActiveIndex =
            (mentionActiveIndex - 1 + mentionResults.length) %
            mentionResults.length;
          updateMentionActive();
        } else if (e.key === "Enter" || e.key === "Tab") {
          e.preventDefault();
          selectMention(mentionActiveIndex);
        } else if (e.key === "Escape") {
          e.preventDefault();
          closeMentionDropdown();
        }
        return;
      }

      if (e.key === "Backspace") {
        const sel = window.getSelection();
        if (!sel || !sel.rangeCount) return;
        const range = sel.getRangeAt(0);
        if (
          range.collapsed &&
          range.startContainer.nodeType === Node.TEXT_NODE &&
          range.startOffset === 0
        ) {
          const prev = range.startContainer.previousSibling;
          if (
            prev &&
            prev.nodeType === Node.ELEMENT_NODE &&
            ((prev as HTMLElement).classList?.contains("tag-badge") ||
              (prev as HTMLElement).classList?.contains("timer-badge") ||
              (prev as HTMLElement).classList?.contains("tag-badge--outlined"))
          ) {
            e.preventDefault();
            const tagRange = document.createRange();
            tagRange.selectNode(prev);
            sel.removeAllRanges();
            sel.addRange(tagRange);
            document.execCommand("delete", false);
            return;
          }
        }
      }
    });

    contentEditable.addEventListener("blur", () => {
      setTimeout(() => {
        if (
          mentionDropdown &&
          mentionDropdown.classList.contains("mention-dropdown-open") &&
          document.activeElement !== mentionDropdown &&
          !mentionDropdown.contains(document.activeElement)
        ) {
          closeMentionDropdown();
        }
        if (
          ingredientDropdown &&
          !ingredientDropdown.classList.contains("hidden") &&
          document.activeElement !== ingredientBtn &&
          !ingredientDropdown.contains(document.activeElement)
        ) {
          closeIngredientDropdown();
        }
        if (
          timerPopover &&
          timerPopover.classList.contains("timer-popover-open") &&
          document.activeElement !== timerBtn &&
          !timerPopover.contains(document.activeElement)
        ) {
          closeTimerPopover();
        }
      }, 150);
    });

    contentEditable.addEventListener("paste", (e) => {
      e.preventDefault();
      const text = e.clipboardData?.getData("text/plain") || "";
      try {
        document.execCommand("insertText", false, text);
      } catch {
        const sel = window.getSelection();
        if (!sel || !sel.rangeCount) return;
        const range = sel.getRangeAt(0);
        range.deleteContents();
        range.insertNode(document.createTextNode(text));
        range.collapse(false);
        sel.removeAllRanges();
        sel.addRange(range);
      }
    });

    if (mentionDropdown) {
      mentionDropdown.addEventListener("click", (e) => {
        const item = (e.target as HTMLElement).closest<HTMLElement>(
          ".mention-item",
        );
        if (item && item.dataset.mentionItem) {
          selectMention(Number(item.dataset.mentionItem));
        }
      });
    }

    // --- Close dropdowns on outside click ---

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (
        ingredientDropdown &&
        !ingredientDropdown.classList.contains("hidden") &&
        !ingredientBtn?.contains(target) &&
        !ingredientDropdown.contains(target)
      ) {
        closeIngredientDropdown();
      }
      if (
        timerPopover &&
        timerPopover.classList.contains("timer-popover-open") &&
        !timerBtn?.contains(target) &&
        !timerPopover.contains(target)
      ) {
        closeTimerPopover();
      }
      if (
        mentionDropdown &&
        mentionDropdown.classList.contains("mention-dropdown-open") &&
        !mentionDropdown.contains(target) &&
        !contentEditable.contains(target)
      ) {
        closeMentionDropdown();
      }
    });

    // --- Form submit sync ---
    if (formId) {
      const form = document.getElementById(formId);
      if (form) {
        form.addEventListener("submit", () => {
          const serialized = serializeEditor();
          if (serialized || !hiddenTA?.value) {
            if (hiddenTA) hiddenTA.value = serialized;
          }
        });
      }
    }

    // --- Cleanup on unload ---
    function cleanup() {
      syncObserver.disconnect();
    }
    window.addEventListener("beforeunload", cleanup);

    // --- Initialize ---
    loadContent(initialContent);
    updateHiddenTA();
  }

  function escapeHtml(text: string): string {
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  document.addEventListener("astro:page-load", setupInstructionsEditor);
  document.addEventListener("astro:after-swap", setupInstructionsEditor);
</script>
