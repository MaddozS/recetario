---
import Icon from "@/components/atoms/Icon.astro";
import Button from "@/components/atoms/Button.astro";
import Card from "@/components/molecules/shared/Card.astro";

import type { RecipeSummary } from "@recetario/types";
import type { ProductionRecipeSelection } from "@/lib/production-types";

interface PresentationOption {
  id: number;
  name: string;
}

interface Props {
  recipes: RecipeSummary[];
  selections: ProductionRecipeSelection[];
  recipePresentations?: Map<number, PresentationOption[]>;
  maxRecipes?: number;
}

const {
  recipes,
  selections,
  recipePresentations,
  maxRecipes = Infinity,
} = Astro.props;
const isProUser = maxRecipes === Infinity;
const selectedIds = new Set(selections.map((s) => s.recipeId));

// Agrupamos por categoría; si no hay categorías, se muestra una sola lista
// sin leyenda (key null).
const grouped: Record<string, RecipeSummary[]> = {};
for (const r of recipes) {
  const cat = r.category || "Sin categoría";
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(r);
}
// Orden alfabético dentro de cada grupo para que la lista sea estable.
for (const key of Object.keys(grouped)) {
  grouped[key].sort((a, b) => a.name.localeCompare(b.name, "es"));
}
const hasCategories = recipes.some((r) => Boolean(r.category));
const groupKeys = hasCategories
  ? [...new Set(recipes.map((r) => r.category || "Sin categoría"))]
  : [null as string | null];
const legendFor = (key: string | null) =>
  hasCategories ? key || "Sin categoría" : null;
---

<Card padding="lg" class="production-selector">
  <div class="mb-4 flex flex-wrap items-start justify-between gap-2">
    <div>
      <h2 class="text-foreground text-lg font-bold">Seleccionar recetas</h2>
      <p class="text-muted-foreground mt-0.5 text-sm">
        Marca las recetas y ajusta las mezclas para tu producción.
      </p>
    </div>
    <span
      class="border-border bg-background text-secondary-foreground rounded-full border px-3 py-1 text-xs font-semibold tabular-nums"
    >
      <span id="selected-count">{selections.length}</span>
      <span class="text-muted-foreground">
        / {recipes.length} seleccionadas
      </span>
    </span>
  </div>

  {
    recipes.length > 1 && (
      <label class="text-muted-foreground mb-4 flex cursor-pointer items-center gap-2 text-sm font-semibold select-none">
        <input
          id="select-all-recipes"
          type="checkbox"
          class="border-border text-accent-600 focus:ring-accent-500 h-5 w-5 shrink-0 rounded disabled:opacity-30"
        />
        Seleccionar todas
      </label>
    )
  }

  {
    recipes.length > 0 && (
      <>
        <div class="relative mb-4">
          <Icon
            name="lucide:search"
            size={16}
            class="text-subtle-foreground pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2"
          />
          <input
            id="recipe-search"
            type="search"
            placeholder="Buscar por nombre..."
            autocomplete="off"
            class="border-border bg-background text-foreground placeholder:text-subtle-foreground focus:ring-accent-500/20 focus:border-accent-500 w-full rounded-xl border py-2.5 pr-4 pl-10 text-sm transition-colors focus:ring-2 focus:outline-none"
          />
        </div>
        <div
          id="recipe-search-empty"
          class="text-muted-foreground bg-muted/40 border-border mb-4 hidden rounded-xl border px-4 py-3 text-sm"
        >
          No se encontraron recetas.
        </div>
      </>
    )
  }

  {
    recipes.length === 0 ? (
      <div class="flex flex-col items-center gap-3 py-8 text-center">
        <div class="bg-muted text-subtle-foreground flex h-12 w-12 items-center justify-center rounded-2xl">
          <Icon name="lucide:book-x" size={20} />
        </div>
        <p class="text-muted-foreground text-sm">
          No hay recetas. Crea una receta primero.
        </p>
        <Button variant="primary" icon="plus" href="/recipes">
          Ir a recetas
        </Button>
      </div>
    ) : (
      <form
        id="recipe-selector-form"
        class="flex flex-col gap-4"
        data-basic-limit={!isProUser ? "" : undefined}
      >
        <div
          id="recipe-groups"
          class="max-h-[420px] space-y-4 overflow-y-auto overscroll-contain pr-1 pb-2"
        >
          {!isProUser && (
            <div
              id="upgrade-banner"
              class:list={[
                "border-warning-border bg-warning-bg rounded-xl border p-4",
                selectedIds.size >= maxRecipes ? "" : "hidden",
              ]}
            >
              <p class="text-warning text-sm font-semibold">
                Límite de {maxRecipes} recetas alcanzado en plan Basic.
              </p>
              <a href="/pricing" class="text-accent-600 text-sm font-bold">
                Actualizar a Pro para planificar recetas ilimitadas →
              </a>
            </div>
          )}

          {groupKeys.map((key) => {
            const legend = legendFor(key);
            return (
              <fieldset>
                {legend && (
                  <legend class="text-muted-foreground mb-2 px-1 text-[11px] font-bold tracking-[0.18em] uppercase">
                    {legend}
                  </legend>
                )}
                <div class="space-y-2">
                  {(grouped[key || "Sin categoría"] || []).map(
                    (recipe: RecipeSummary) => {
                      const isSelected = selectedIds.has(recipe.id);
                      const atLimit =
                        !isProUser &&
                        selectedIds.size >= maxRecipes &&
                        !isSelected;
                      const sel = selections.find(
                        (s) => s.recipeId === recipe.id,
                      );
                      const presentations = recipePresentations?.get(recipe.id);
                      return (
                        <div
                          data-recipe-row
                          data-name={recipe.name}
                          class:list={[
                            "border-border flex flex-wrap items-center gap-x-3 gap-y-3 rounded-xl border p-3 transition-colors sm:flex-nowrap sm:p-3",
                            isSelected
                              ? "bg-accent-50 ring-accent-200 ring-1"
                              : "hover:bg-muted",
                            atLimit ? "opacity-40" : "",
                          ]}
                        >
                          <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-3">
                            <input
                              type="checkbox"
                              name="recipe_id"
                              value={recipe.id}
                              checked={isSelected}
                              disabled={atLimit}
                              class="border-border text-accent-600 focus:ring-accent-500 h-5 w-5 shrink-0 rounded disabled:opacity-30"
                            />
                            <span class="min-w-0 flex-1">
                              <span class="text-foreground block truncate text-sm font-semibold">
                                {recipe.name}
                              </span>
                              <span class="text-muted-foreground block text-xs">
                                {recipe.ingredientCount} ingrediente
                                {recipe.ingredientCount !== 1 ? "s" : ""}
                              </span>
                            </span>
                          </label>

                          <span
                            class="recipe-controls flex w-full shrink-0 flex-col gap-2 sm:w-auto sm:flex-row sm:items-center sm:justify-end"
                            class:list={[isSelected ? "" : "hidden"]}
                          >
                            {presentations && presentations.length > 1 && (
                              <select
                                name="presentation_id"
                                class="border-border bg-background text-foreground focus:ring-accent-500/20 focus:border-accent-500 min-h-11 rounded-xl border px-3 text-sm font-medium focus:ring-2 focus:outline-none md:w-44"
                              >
                                {presentations.map((p) => (
                                  <option
                                    value={p.id}
                                    selected={p.id === sel?.presentationId}
                                  >
                                    {p.name}
                                  </option>
                                ))}
                              </select>
                            )}

                            <div class="batch-stepper flex items-center gap-1">
                              <button
                                type="button"
                                data-batch-step="-0.5"
                                aria-label="Reducir mezclas"
                                class="border-border text-muted-foreground hover:text-secondary-foreground bg-background flex h-10 w-10 items-center justify-center rounded-full border font-bold transition-colors"
                              >
                                −
                              </button>
                              <span class="border-border bg-background text-muted-foreground inline-flex min-h-11 items-center gap-1.5 rounded-full border px-3">
                                <span class="text-xs font-semibold">
                                  Mezclas
                                </span>
                                <input
                                  type="number"
                                  name="batches"
                                  value={sel?.batches || 1}
                                  min="0.5"
                                  step="0.5"
                                  aria-label={`Mezclas de ${recipe.name}`}
                                  class="bg-background text-foreground w-14 border-none p-0 text-center font-mono text-sm font-semibold tabular-nums focus:ring-0 focus:outline-none"
                                />
                              </span>
                              <button
                                type="button"
                                data-batch-step="0.5"
                                aria-label="Aumentar mezclas"
                                class="border-border text-muted-foreground hover:text-secondary-foreground bg-background flex h-10 w-10 items-center justify-center rounded-full border font-bold transition-colors"
                              >
                                +
                              </button>
                            </div>
                          </span>
                        </div>
                      );
                    },
                  )}
                </div>
              </fieldset>
            );
          })}
        </div>

        <div class="border-border flex flex-col-reverse items-stretch gap-3 border-t pt-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-muted-foreground shrink-0 text-sm">
            Los costos y los insumos se recalculan al instante.
          </p>
          <Button
            id="calc-production-btn"
            type="button"
            variant="primary"
            icon="calculator"
            class="w-full sm:w-auto"
          >
            Calcular producción
          </Button>
        </div>
      </form>
    )
  }
</Card>
