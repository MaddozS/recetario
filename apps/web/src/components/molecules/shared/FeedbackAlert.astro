---
/**
 * Alerta contextual para mostrar feedback de operaciones.
 *
 * Se renderiza como un banner con borde y color semántico:
 * - `success` → verde (emerald)
 * - `error`   → rojo (rose)
 *
 * Soporta mostrar una lista opcional de recetas afectadas
 * (usado cuando no se puede eliminar un ingrediente en uso).
 *
 * @prop {"success" | "error"} type   - Tipo de feedback.
 * @prop {string}              message - Mensaje principal a mostrar.
 * @prop {string[]}            [recipes] - Nombres de recetas bloqueantes.
 *
 * @example
 * <FeedbackAlert type="error" message="No se puede eliminar" recipes={["Brownie"]} />
 * <FeedbackAlert type="success" message="Ingrediente guardado" />
 */
interface Props {
  type: "success" | "error";
  message: string;
  recipes?: string[];
}

const { type, message, recipes = [] } = Astro.props;
---

<div
  aria-atomic="true"
  aria-live={type === "success" ? "polite" : "assertive"}
  class:list={[
    "mb-4 rounded-2xl border px-4 py-3 text-sm",
    type === "success"
      ? "border-success-border bg-success-bg text-success"
      : "border-danger-border bg-danger-bg text-danger",
  ]}
  role={type === "success" ? "status" : "alert"}
>
  <p class="font-semibold">{message}</p>
  {
    recipes.length > 0 && (
      <p class="mt-2 text-xs">Recetas que lo usan: {recipes.join(", ")}</p>
    )
  }
</div>
