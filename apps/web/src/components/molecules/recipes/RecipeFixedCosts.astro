---
import Button from "@/components/atoms/Button.astro";
import SectionHeading from "@/components/atoms/SectionHeading.astro";
import FixedCostCard from "@/components/molecules/recipes/FixedCostCard.astro";

interface FixedCostLine {
  id: number;
  recipeId: number;
  name: string;
  type: "PERCENTAGE" | "AMOUNT";
  base: "PER_BATCH" | "PER_UNIT" | "PER_HOUR";
  value: number;
  hours?: number | null;
}

interface Props {
  recipeFixedCosts: FixedCostLine[];
  recipeId: number;
  isEditing: boolean;
}

const { recipeFixedCosts, recipeId } = Astro.props;
---

<section class="space-y-4" data-recipe-id={recipeId}>
  <div class="flex items-start justify-between gap-3">
    <SectionHeading title="Costos Fijos de la Receta" />
    <Button variant="primary" icon="plus" data-open-recipe-fixed-dialog="1">
      Agregar Costo Fijo
    </Button>
  </div>

  <div class="grid grid-cols-1 gap-3" data-recipe-fixed-costs-container="1">
    {
      recipeFixedCosts.length > 0 ? (
        recipeFixedCosts.map((fc) => (
          <FixedCostCard
            id={fc.id}
            name={fc.name}
            type={fc.type}
            base={fc.base}
            value={fc.value}
            hours={fc.hours ?? null}
            isRecipeLevel={true}
            recipeId={fc.recipeId}
          />
        ))
      ) : (
        <p
          class="text-muted-foreground py-8 text-center text-sm"
          data-recipe-fixed-costs-empty="1"
        >
          No hay costos fijos definidos para esta receta.
        </p>
      )
    }
  </div>
</section>

<script>
  const setupAddFixedCostButton = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "[data-open-recipe-fixed-dialog]",
    );

    buttons.forEach((button) => {
      if (button.dataset.addFcBound === "1") return;
      button.dataset.addFcBound = "1";

      button.addEventListener("click", () => {
        const container = document.querySelector(
          '[data-recipe-fixed-costs-container="1"]',
        );
        if (!container) return;

        const recipeId = container
          .closest("[data-recipe-id]")
          ?.getAttribute("data-recipe-id");

        const csrfToken =
          document.querySelector<HTMLInputElement>('input[name="_csrf"]')
            ?.value || "";

        const cardHtml = `<fixed-cost-card class="bg-card border-border flex flex-col rounded-2xl border p-5 shadow-sm transition-all" data-mode="create" data-owner-type="recipe">
<form method="post" class="flex flex-col">
<input type="hidden" name="action" value="create_recipe_fixed_cost" />
<input type="hidden" name="recipeId" value="${recipeId}" />
<input type="hidden" name="ownerId" value="${recipeId}" />
<input type="hidden" name="ownerType" value="recipe" />
<input type="hidden" name="_csrf" value="${csrfToken}" />
<div class="display-content hidden flex flex-wrap items-center gap-3"><div class="flex min-w-0 flex-1 flex-wrap items-center gap-2"></div></div>
<div class="edit-content space-y-4">
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
<div class="flex flex-col gap-1"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Nombre</label><input name="name" type="text" class="fixed-cost-name-input border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none" value="Costo Fijo" required /></div>
<div class="flex flex-col gap-1"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Tipo</label><select name="type" class="fixed-cost-type-select border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none"><option value="AMOUNT">Monto</option><option value="PERCENTAGE">Porcentaje</option></select></div>
<div class="flex flex-col gap-1"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Base</label><select name="base" class="fixed-cost-base-select border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none"><option value="PER_BATCH">Por Mezcla</option><option value="PER_UNIT">Por Unidad</option><option value="PER_HOUR">Por Hora</option></select></div>
</div>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
<div class="flex flex-col gap-1"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Valor</label><input name="value" type="text" inputmode="decimal" class="fixed-cost-value-input border-border bg-background text-foreground focus:ring-accent-500/20 font-mono rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none" value="0" required /></div>
<div class="hours-field flex flex-col gap-1" style="display:none"><label class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase">Horas</label><input name="hours" type="text" inputmode="decimal" class="fixed-cost-hours-input border-border bg-background text-foreground focus:ring-accent-500/20 font-mono rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none" value="1" /></div>
<div class="hidden sm:block"></div>
</div>
<div class="flex flex-wrap items-center justify-between gap-3 border-t border-border-light pt-4">
<div class="flex items-center gap-2"></div>
<div class="flex items-center gap-2"><button type="button" class="cancel-btn border-border bg-card text-muted-foreground hover:bg-background inline-flex min-h-11 items-center justify-center rounded-xl border px-4 py-2.5 text-sm font-bold transition-colors">Cancelar</button><button type="submit" class="bg-accent-600 hover:bg-accent-700 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Guardar</button></div>
</div>
</div>
<p class="fixed-cost-error text-danger mt-2 hidden text-xs font-semibold"></p>
</form>
</fixed-cost-card>`;

        const wrapper = document.createElement("div");
        wrapper.innerHTML = cardHtml;
        const card = wrapper.firstElementChild;
        if (card) {
          container.appendChild(card);
        }

        // Remove empty state
        const emptyState = document.querySelector(
          '[data-recipe-fixed-costs-empty="1"]',
        );
        if (emptyState) emptyState.remove();
      });
    });
  };

  document.addEventListener("astro:page-load", setupAddFixedCostButton);
  document.addEventListener("astro:after-swap", setupAddFixedCostButton);
</script>
