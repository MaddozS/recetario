---
interface Props {
  id: number;
  name: string;
  category?: string;
  timeAgo: string;
}

const { id, name, category, timeAgo } = Astro.props;
---

<a
  href={`/recipes/${id}`}
  class="group recipe-mini-card border-border bg-card hover:border-accent-300 block rounded-xl border p-3 shadow-sm transition-all hover:shadow-md"
>
  <p
    class="text-secondary-foreground group-hover:text-accent-700 truncate text-sm font-bold transition-colors"
  >
    {name}
  </p>
  <div class="mt-1.5 flex items-center gap-2">
    {
      category && (
        <span class="bg-accent-50 text-accent-600 border-accent-200 inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold">
          {category}
        </span>
      )
    }
    <span class="text-subtle-foreground text-[10px]">
      {timeAgo}
    </span>
  </div>
</a>

<style define:vars={{}}>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes miniCardFadeIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .recipe-mini-card {
      animation: miniCardFadeIn 0.2s var(--ease-out) both;
      animation-delay: calc(var(--stagger-index, 0) * 50ms);
    }
  }
</style>
