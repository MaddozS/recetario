---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  recipeCount: number;
  categoryCount: number;
  ingredientCount: number;
}

const { recipeCount, categoryCount, ingredientCount } = Astro.props;
---

<div class="flex flex-wrap items-center gap-3">
  <div
    class="recipe-stat bg-accent-50 text-accent-600 border-accent-200 inline-flex items-center gap-1.5 rounded-xl border px-3 py-1.5 text-sm font-semibold"
  >
    <Icon name="lucide:book-open" size={14} />
    {recipeCount}
    {recipeCount === 1 ? "Receta" : "Recetas"}
  </div>
  {
    categoryCount > 0 && (
      <div class="recipe-stat bg-accent-50 text-accent-600 border-accent-200 inline-flex items-center gap-1.5 rounded-xl border px-3 py-1.5 text-sm font-semibold">
        <Icon name="lucide:folders" size={14} />
        {categoryCount} {categoryCount === 1 ? "Categoría" : "Categorías"}
      </div>
    )
  }
  {
    ingredientCount > 0 && (
      <div class="recipe-stat bg-accent-50 text-accent-600 border-accent-200 inline-flex items-center gap-1.5 rounded-xl border px-3 py-1.5 text-sm font-semibold">
        <Icon name="lucide:package" size={14} />
        {ingredientCount}{" "}
        {ingredientCount === 1 ? "Ingrediente" : "Ingredientes"}
      </div>
    )
  }
</div>

<style define:vars={{}}>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes statFadeIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .recipe-stat {
      animation: statFadeIn 0.2s var(--ease-out) both;
    }
    .recipe-stat:nth-child(1) {
      animation-delay: 0ms;
    }
    .recipe-stat:nth-child(2) {
      animation-delay: 60ms;
    }
    .recipe-stat:nth-child(3) {
      animation-delay: 120ms;
    }
  }
</style>
