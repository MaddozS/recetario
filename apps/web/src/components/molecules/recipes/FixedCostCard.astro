---
import Icon from "@/components/atoms/Icon.astro";
import Button from "@/components/atoms/Button.astro";

interface Props {
  id: number;
  name: string;
  type: "PERCENTAGE" | "AMOUNT";
  base: "PER_BATCH" | "PER_UNIT" | "PER_HOUR";
  value: number;
  hours?: number | null;
  isRecipeLevel: boolean;
  recipeId?: number;
  presentationId?: number;
}

const {
  id,
  name,
  type,
  base,
  value,
  hours,
  isRecipeLevel,
  recipeId,
  presentationId,
} = Astro.props;

const typeLabels: Record<string, string> = {
  PERCENTAGE: "Porcentaje",
  AMOUNT: "Monto",
};

const baseLabels: Record<string, string> = {
  PER_BATCH: "Por Mezcla",
  PER_UNIT: "Por Unidad",
  PER_HOUR: "Por Hora",
};

const typeBadgeColors: Record<string, string> = {
  PERCENTAGE: "bg-turmeric-bg text-turmeric-solid border-turmeric-border",
  AMOUNT: "bg-accent-50 text-accent-600 border-accent-200",
};

const baseBadgeColors: Record<string, string> = {
  PER_BATCH: "bg-herb-bg text-herb-solid border-herb-border",
  PER_UNIT: "bg-accent-50 text-accent-600 border-accent-200",
  PER_HOUR: "bg-chili-bg text-chili-solid border-chili-border",
};

const displayValue =
  type === "PERCENTAGE" ? `${value}%` : `$${Number(value).toFixed(2)}`;

const ownerType = recipeId ? "recipe" : "presentation";
const ownerId = recipeId || presentationId;
---

<fixed-cost-card
  class="bg-card border-border flex flex-col rounded-2xl border p-5 shadow-sm transition-all"
  data-mode="display"
  data-id={id}
  data-type={type}
  data-base={base}
  data-value={value}
  data-hours={hours ?? ""}
  data-owner-type={ownerType}
>
  <form method="post" class="flex flex-col">
    <input type="hidden" name="action" value="update_fixed_cost" />
    <input type="hidden" name="fixedCostId" value={id} />
    <input type="hidden" name="ownerType" value={ownerType} />
    <input type="hidden" name="ownerId" value={ownerId} />
    {presentationId && <input type="hidden" name="presentationId" value={presentationId} />}
    {recipeId && <input type="hidden" name="recipeId" value={recipeId} />}
    <input type="hidden" name="_csrf" value={Astro.locals.csrfToken || ""} />

    <!-- Display Mode -->
    <div class="display-content flex flex-wrap items-center gap-3">
      <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
        <span
          class="fixed-cost-name text-foreground font-display text-base font-bold"
          >{name}</span
        >

        <!-- Type Badge -->
        <span
          class={`type-badge inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide ${typeBadgeColors[type]}`}
        >
          {typeLabels[type]}
        </span>

        <!-- Base Badge -->
        <span
          class={`base-badge inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide ${baseBadgeColors[base]}`}
        >
          {baseLabels[base]}
        </span>

        <!-- Value -->
        <span
          class="fixed-cost-value text-foreground font-mono text-sm font-semibold tabular-nums"
        >
          {displayValue}
        </span>

        <!-- Hours (PER_HOUR only) -->
        {
          base === "PER_HOUR" && hours != null && (
            <span class="fixed-cost-hours text-muted-foreground text-xs tabular-nums">
              ({hours}h)
            </span>
          )
        }
      </div>

      <!-- Action Buttons (always available, like presentation cards) -->
      <div class="flex shrink-0 items-center gap-1">
        <Button
          variant="iconDanger"
          iconOnly
          icon="trash-2"
          class="delete-btn hidden"
          ariaLabel="Eliminar costo fijo"
          title="Eliminar"
        />
        <Button
          variant="iconAccent"
          iconOnly
          icon="pencil"
          class="edit-btn"
          ariaLabel="Editar costo fijo"
          aria-pressed="false"
          title="Editar"
        />
      </div>
    </div>

    <!-- Edit Mode -->
    <div class="edit-content hidden space-y-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Name -->
        <div class="flex flex-col gap-1">
          <label
            class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase"
          >
            Nombre
          </label>
          <input
            name="name"
            type="text"
            class="fixed-cost-name-input border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none"
            value={name}
            required
          />
        </div>

        <!-- Type -->
        <div class="flex flex-col gap-1">
          <label
            class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase"
          >
            Tipo
          </label>
          <select
            name="type"
            class="fixed-cost-type-select border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none"
          >
            <option value="PERCENTAGE" selected={type === "PERCENTAGE"}>
              Porcentaje
            </option>
            <option value="AMOUNT" selected={type === "AMOUNT"}> Monto </option>
          </select>
        </div>

        <!-- Base -->
        <div class="flex flex-col gap-1">
          <label
            class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase"
          >
            Base
          </label>
          <select
            name="base"
            class="fixed-cost-base-select border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 text-sm transition-all focus:ring-2 focus:outline-none"
          >
            <option value="PER_BATCH" selected={base === "PER_BATCH"}>
              Por Mezcla
            </option>
            <option value="PER_UNIT" selected={base === "PER_UNIT"}>
              Por Unidad
            </option>
            {
              isRecipeLevel && (
                <option value="PER_HOUR" selected={base === "PER_HOUR"}>
                  Por Hora
                </option>
              )
            }
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <!-- Value -->
        <div class="flex flex-col gap-1">
          <label
            class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase"
          >
            Valor
          </label>
          <input
            name="value"
            type="text"
            inputmode="decimal"
            class="fixed-cost-value-input border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 font-mono text-sm transition-all focus:ring-2 focus:outline-none"
            value={value}
            required
          />
        </div>

        <!-- Hours (shown conditionally via JS but always rendered for PER_HOUR context) -->
        <div
          class="hours-field flex flex-col gap-1"
          style={base !== "PER_HOUR" ? "display:none" : undefined}
        >
          <label
            class="text-subtle-foreground text-[11px] font-bold tracking-[0.16em] uppercase"
          >
            Horas
          </label>
          <input
            name="hours"
            type="text"
            inputmode="decimal"
            class="fixed-cost-hours-input border-border bg-background text-foreground focus:ring-accent-500/20 rounded-xl border px-3 py-2 font-mono text-sm transition-all focus:ring-2 focus:outline-none"
            value={hours ?? 1}
          />
        </div>

        <!-- Spacer for grid alignment -->
        <div class="hidden sm:block"></div>
      </div>

      <!-- Action Buttons -->
      <div
        class="border-border-light flex flex-wrap items-center justify-between gap-3 border-t pt-4"
      >
        <div class="flex items-center gap-2">
          <Button variant="danger" icon="trash-2" class="edit-delete-btn">
            Eliminar
          </Button>
        </div>
        <div class="flex items-center gap-2">
          <Button variant="secondary" class="cancel-btn"> Cancelar </Button>
          <Button variant="primary" icon="check" type="submit">
            Guardar
          </Button>
        </div>
      </div>
    </div>

    <!-- Error Display -->
    <p class="fixed-cost-error text-danger mt-2 hidden text-xs font-semibold">
    </p>
  </form>

  <!-- Delete Confirmation Dialog -->
  <dialog
    data-animated
    class="delete-dialog backdrop:bg-backdrop/50 fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0"
  >
    <div class="border-border bg-card rounded-3xl border p-6 shadow-2xl">
      <div class="flex items-start gap-3">
        <div
          class="bg-danger-bg text-danger flex h-11 w-11 items-center justify-center rounded-2xl"
        >
          <Icon name="lucide:trash-2" size={18} />
        </div>
        <div>
          <h2 class="text-foreground text-lg font-bold">
            Confirmar eliminación
          </h2>
          <p class="text-muted-foreground mt-2 text-sm">
            ¿Eliminar este costo fijo? Esta acción no se puede deshacer.
          </p>
        </div>
      </div>

      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button
          type="button"
          class="delete-cancel-btn border-border bg-card text-muted-foreground hover:bg-background inline-flex min-h-11 items-center justify-center rounded-xl border px-5 py-3 text-sm font-bold transition-colors"
        >
          Cancelar
        </button>
        <button
          type="button"
          class="delete-confirm-btn bg-danger-solid hover:bg-danger-hover inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-bold text-white transition-colors"
        >
          <Icon name="lucide:trash-2" size={16} /> Eliminar
        </button>
      </div>
    </div>
  </dialog>
</fixed-cost-card>

<script>
  import "@/lib/fixed-cost-card";
</script>
