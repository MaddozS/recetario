---
import Icon from "@/components/atoms/Icon.astro";
import Button from "@/components/atoms/Button.astro";


interface Props {
  recipeId: number;
  editHref: string;
  canDuplicate?: boolean;
  canDelete?: boolean;
  variant?: "card" | "page";
}

const {
  recipeId,
  editHref,
  canDuplicate = false,
  canDelete = false,
  variant = "page",
} = Astro.props;

const menuId = `ram-menu-${recipeId}`;
const duplicateDialogId = `ram-dup-dialog-${recipeId}`;
const deleteDialogId = `ram-del-dialog-${recipeId}`;
const duplicateFormId = `ram-dup-form-${recipeId}`;
const deleteFormId = `ram-del-form-${recipeId}`;
---

<!-- Hidden forms (outside positioning context) -->{
  canDuplicate && (
    <form method="POST" id={duplicateFormId} data-astro-reload class="hidden">
      <input type="hidden" name="action" value="duplicate_recipe" />
      <input type="hidden" name="recipeId" value={recipeId} />
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken || ""} />
    </form>
  )
}

{
  canDelete && (
    <form method="POST" id={deleteFormId} data-astro-reload class="hidden">
      <input type="hidden" name="action" value="delete_recipe" />
      <input type="hidden" name="recipeId" value={recipeId} />
      <input type="hidden" name="_csrf" value={Astro.locals.csrfToken || ""} />
    </form>
  )
}

<!-- Positioning wrapper -->
<div class:list={[variant === "page" ? "relative" : ""]}>
  <!-- Trigger -->
  <button
    type="button"
    data-card-menu-trigger={menuId}
    class:list={[
      "focus-visible:ring-accent-500 inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center transition-all focus:outline-none focus-visible:ring-2",
      variant === "card"
        ? "text-subtle-foreground hover:bg-muted hover:text-secondary-foreground absolute top-3 right-3 z-10 rounded-lg"
        : "border-border bg-card hover:bg-muted rounded-xl border",
    ]}
    aria-label={variant === "card" ? "Acciones" : "Opciones de receta"}
    aria-haspopup="true"
    aria-expanded="false"
  >
    <Icon name="lucide:ellipsis-vertical" size={variant === "card" ? 16 : 18} />
  </button>

  <!-- Menu panel -->
  <div
    id={menuId}
    data-card-menu
    class:list={[
      "hidden border-border bg-card z-30 min-w-40 rounded-xl border p-1 shadow-lg",
      variant === "card"
        ? "absolute top-11 right-3"
        : "absolute top-full right-0 mt-1",
    ]}
    role="menu"
  >
    {
      variant === "page" ? (
        <button
          type="button"
          data-edit-toggle-trigger
          class="text-muted-foreground hover:bg-accent-50 hover:text-accent-600 flex w-full cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors"
          role="menuitem"
        >
          <Icon name="lucide:pencil" size={16} /> Editar
        </button>
      ) : (
        <a
          href={editHref}
          data-astro-reload
          class="text-muted-foreground hover:bg-accent-50 hover:text-accent-600 flex cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors"
          role="menuitem"
        >
          <Icon name="lucide:pencil" size={16} /> Editar
        </a>
      )
    }

    {
      canDuplicate && (
        <button
          type="button"
          data-open-duplicate-dialog={duplicateDialogId}
          class="text-muted-foreground hover:bg-accent-50 hover:text-accent-600 flex w-full cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors"
          role="menuitem"
        >
          <Icon name="lucide:copy" size={16} /> Duplicar
        </button>
      )
    }

    {
      canDelete && (
        <button
          type="button"
          data-open-delete-dialog={deleteDialogId}
          class="text-danger hover:bg-danger-bg flex w-full cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors"
          role="menuitem"
        >
          <Icon name="lucide:trash-2" size={16} /> Eliminar
        </button>
      )
    }
  </div>
</div>

<!-- Dialogs -->
{
  canDuplicate && (
    <dialog
      data-animated
      id={duplicateDialogId}
      class="backdrop:bg-backdrop/50 fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0"
    >
      <div class="border-border bg-card rounded-3xl border p-6 shadow-2xl">
        <div class="flex items-start gap-3">
          <div class="bg-accent-50 text-accent-600 flex h-11 w-11 items-center justify-center rounded-2xl">
            <Icon name="lucide:copy" size={18} />
          </div>
          <div>
            <h2 class="text-foreground text-lg font-bold">Duplicar receta</h2>
            <p class="text-muted-foreground mt-2 text-sm">
              Se creará una copia de esta receta con todos sus ingredientes y
              presentaciones.
            </p>
          </div>
        </div>

        <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <Button variant="secondary" data-close-duplicate-dialog>
            Cancelar
          </Button>
          <Button
            variant="primary"
            icon="copy"
            type="submit"
            form={duplicateFormId}
          >
            Duplicar
          </Button>
        </div>
      </div>
    </dialog>
  )
}

{
  canDelete && (
    <dialog
      data-animated
      id={deleteDialogId}
      class="backdrop:bg-backdrop/50 fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0"
    >
      <div class="border-border bg-card rounded-3xl border p-6 shadow-2xl">
        <div class="flex items-start gap-3">
          <div class="bg-danger-bg text-danger flex h-11 w-11 items-center justify-center rounded-2xl">
            <Icon name="lucide:trash-2" size={18} />
          </div>
          <div>
            <h2 class="text-foreground text-lg font-bold">
              Confirmar eliminación
            </h2>
            <p class="text-muted-foreground mt-2 text-sm">
              ¿Eliminar esta receta? Esta acción no se puede deshacer.
            </p>
          </div>
        </div>

        <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <Button variant="secondary" data-close-delete-dialog>
            Cancelar
          </Button>
          <Button
            variant="danger"
            icon="trash-2"
            type="submit"
            form={deleteFormId}
          >
            Eliminar
          </Button>
        </div>
      </div>
    </dialog>
  )
}

<style is:global>
  [data-card-menu] {
    opacity: 0;
    transform: scale(0.95);
    pointer-events: none;
    transition:
      opacity 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }
  [data-card-menu].card-menu-open {
    opacity: 1 !important;
    transform: scale(1) !important;
    pointer-events: auto !important;
  }
</style>

<script>
  import { bindDialogBackdrop } from "@/lib/dialog";

  function closeAllMenus() {
    document
      .querySelectorAll<HTMLElement>("[data-card-menu]")
      .forEach((menu) => {
        menu.classList.remove("card-menu-open");
        menu.classList.add("hidden");
        const trigger = document.querySelector(
          `[data-card-menu-trigger="${menu.id}"]`,
        );
        if (trigger) {
          trigger.setAttribute("aria-expanded", "false");
        }
      });
  }

  function setupRecipeActionsMenus() {
    const triggers = document.querySelectorAll<HTMLElement>(
      "[data-card-menu-trigger]",
    );
    triggers.forEach((trigger) => {
      if (trigger.dataset.cardMenuBound === "1") return;
      trigger.dataset.cardMenuBound = "1";

      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const menuId =
          trigger.dataset.cardMenuTrigger ||
          trigger.getAttribute("data-card-menu-trigger");
        if (!menuId) return;
        const menu = document.getElementById(menuId);
        if (!menu) return;

        const isOpen =
          menu.classList.contains("card-menu-open") &&
          !menu.classList.contains("hidden");

        closeAllMenus();

        if (!isOpen) {
          menu.classList.remove("hidden");
          menu.classList.add("card-menu-open");
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });

    if (document.documentElement.dataset.ramDocClickBound !== "1") {
      document.documentElement.dataset.ramDocClickBound = "1";
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (
          target &&
          !target.closest("[data-card-menu-trigger]") &&
          !target.closest("[data-card-menu]")
        ) {
          closeAllMenus();
        }
      });
    }
  }

  function setupEditToggleTrigger() {
    document.querySelectorAll<HTMLElement>("[data-edit-toggle-trigger]").forEach((trigger) => {
      if (trigger.dataset.editToggleBound === "1") return;
      trigger.dataset.editToggleBound = "1";

      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeAllMenus();
        document.dispatchEvent(
          new CustomEvent("recipe:edit-toggle", { bubbles: true }),
        );
      });
    });
  }

  function setupRecipeActionsDialogs() {
    const dupTriggers = document.querySelectorAll<HTMLElement>(
      "[data-open-duplicate-dialog]",
    );
    dupTriggers.forEach((dupTrigger) => {
      if (dupTrigger.dataset.dupBound === "1") return;
      dupTrigger.dataset.dupBound = "1";

      dupTrigger.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeAllMenus();

        const dialogId =
          dupTrigger.dataset.openDuplicateDialog ||
          dupTrigger.getAttribute("data-open-duplicate-dialog");
        if (!dialogId) return;
        const dialog = document.getElementById(
          dialogId,
        ) as HTMLDialogElement | null;
        if (!dialog) return;

        bindDialogBackdrop(dialog);
        delete dialog.dataset.submitting;
        dialog
          .querySelectorAll<
            HTMLInputElement | HTMLSelectElement | HTMLButtonElement | HTMLTextAreaElement
          >("input, select, button, textarea")
          .forEach((el) => {
            el.disabled = false;
            if (
              el instanceof HTMLInputElement ||
              el instanceof HTMLTextAreaElement
            ) {
              el.readOnly = false;
            }
            el.style.pointerEvents = "";
          });

        if (!dialog.open) dialog.showModal();
      });
    });

    const delTriggers = document.querySelectorAll<HTMLElement>(
      "[data-open-delete-dialog]",
    );
    delTriggers.forEach((delTrigger) => {
      if (delTrigger.dataset.delBound === "1") return;
      delTrigger.dataset.delBound = "1";

      delTrigger.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeAllMenus();

        const dialogId =
          delTrigger.dataset.openDeleteDialog ||
          delTrigger.getAttribute("data-open-delete-dialog");
        if (!dialogId) return;
        const dialog = document.getElementById(
          dialogId,
        ) as HTMLDialogElement | null;
        if (!dialog) return;

        bindDialogBackdrop(dialog);
        delete dialog.dataset.submitting;
        dialog
          .querySelectorAll<
            HTMLInputElement | HTMLSelectElement | HTMLButtonElement | HTMLTextAreaElement
          >("input, select, button, textarea")
          .forEach((el) => {
            el.disabled = false;
            if (
              el instanceof HTMLInputElement ||
              el instanceof HTMLTextAreaElement
            ) {
              el.readOnly = false;
            }
            el.style.pointerEvents = "";
          });

        if (!dialog.open) dialog.showModal();
      });
    });

    document
      .querySelectorAll<HTMLElement>(
        "[data-close-duplicate-dialog], [data-close-delete-dialog]",
      )
      .forEach((closeBtn) => {
        if (closeBtn.dataset.closeBound === "1") return;
        closeBtn.dataset.closeBound = "1";

        closeBtn.addEventListener("click", (e) => {
          e.preventDefault();
          const dialog = closeBtn.closest<HTMLDialogElement>("dialog");
          if (dialog && dialog.dataset.submitting !== "1" && dialog.open) {
            dialog.close();
          }
        });
      });
  }

  function initRecipeActions() {
    setupRecipeActionsMenus();
    setupEditToggleTrigger();
    setupRecipeActionsDialogs();
  }

  document.addEventListener("astro:page-load", initRecipeActions);
  document.addEventListener("astro:after-swap", initRecipeActions);
  initRecipeActions();
</script>
