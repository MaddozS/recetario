---
import { Icon } from "astro-icon/components";
import { Button } from "@recetario/ui";

export type BreadcrumbItem = { label: string; href?: string };

type Props = {
  currentPage?: string;
  showMenuButton?: boolean;
  isAuthenticated?: boolean;
  subscription?: unknown;
  breadcrumbs?: BreadcrumbItem[];
};

const { showMenuButton, isAuthenticated = false, breadcrumbs = [] as BreadcrumbItem[] } = Astro.props as Props;

const showMobileBreadcrumb = breadcrumbs.length > 0;
// Top-level page: single item with no href (e.g., [{ label: "Ingredientes" }])
const isTopLevel = breadcrumbs.length === 1 && !breadcrumbs[0]?.href;
// Current page label (last item in breadcrumbs)
const currentLabel = breadcrumbs.length > 0 ? breadcrumbs[breadcrumbs.length - 1]?.label ?? '' : '';
// Parent for back-navigation (only on nested pages)
const parentItem = breadcrumbs.length >= 2 ? breadcrumbs[breadcrumbs.length - 2] : null;
const parentLabel = parentItem?.label ?? '';
const parentHref = parentItem?.href ?? '';
---

<header
  class="bg-card border-border relative z-10 flex flex-none items-center gap-3 border-b px-4 py-3 md:gap-4 md:px-6 md:py-4"
  transition:animate="none"
>
  <div class="flex min-w-0 flex-1 items-center gap-3 md:gap-4">
    {
      showMenuButton && (
        <button
          id="mobile-menu-btn"
          class="text-muted-foreground hover:text-secondary-foreground border-border hover:bg-background inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border p-2 transition-colors md:hidden"
          aria-label="Abrir menú"
        >
          <Icon name="lucide:menu" size={20} />
        </button>
      )
    }

    {showMobileBreadcrumb && !isTopLevel && (
      <nav aria-label="Breadcrumb" class="flex items-center gap-1 min-w-0 md:hidden">
        <a href={parentHref} class="flex items-center text-sm font-medium text-muted-foreground hover:text-secondary-foreground transition-colors min-h-11">
          <span class="truncate">{parentLabel}</span>
        </a>
        <Icon name="lucide:chevron-right" size={14} class="text-accent-600 shrink-0" aria-hidden="true" />
        <span class="text-foreground font-semibold text-sm truncate">{currentLabel}</span>
      </nav>
    )}
    {showMobileBreadcrumb && isTopLevel && (
      <nav aria-label="Breadcrumb" class="flex items-center min-w-0 md:hidden">
        <span class="text-foreground font-semibold text-sm truncate min-h-11 flex items-center">{currentLabel}</span>
      </nav>
    )}

    <img
      src="/kitchcalc_logo.svg"
      alt="KitchCalc"
      class:list={["shadow-accent-100 h-9 w-9 rounded-xl shadow-md sm:h-10 sm:w-10", showMobileBreadcrumb && "hidden md:block"]}
    />
    <div class:list={[showMobileBreadcrumb && "hidden md:block"]}>
      <h1 class="text-foreground text-lg leading-tight font-bold sm:text-xl">
        KitchCalc
      </h1>
      <p class="text-muted-foreground text-[10px] font-medium sm:text-xs">
        Costeo Inteligente
      </p>
    </div>

    {showMobileBreadcrumb && (
      <div class="hidden md:block h-6 w-px bg-border" aria-hidden="true"></div>
    )}

    {
      showMobileBreadcrumb && (
        <nav aria-label="Breadcrumb" class="hidden md:flex items-center gap-1.5 text-sm min-w-0">
          <Icon name="lucide:folder-open" size={16} class="text-accent-600 shrink-0 opacity-70" aria-hidden="true" />
          {breadcrumbs.map((item, i) => (
            <>
              {i > 0 && <Icon name="lucide:chevron-right" size={16} class="text-accent-600 shrink-0" aria-hidden="true" />}
              {item.href ? (
                <a href={item.href} class="text-muted-foreground hover:text-secondary-foreground font-medium transition-colors whitespace-nowrap">
                  {item.label}
                </a>
              ) : (
                <span class="text-foreground font-semibold truncate max-w-[200px]">{item.label}</span>
              )}
            </>
          ))}
        </nav>
      )
    }
  </div>
  {
    isAuthenticated && (
      <div class="ml-auto flex shrink-0 items-center justify-end gap-2 sm:gap-3">
        <Button
          variant="secondary"
          icon="log-out"
          id="sign-out-button"
          ariaLabel="Cerrar sesión"
        >
          <span data-sign-out-label class="hidden sm:inline">
            Cerrar sesión
          </span>
        </Button>
      </div>
    )
  }
</header>

<script>
  import { signOut } from "@recetario/auth";
  import { showLoadingOverlay } from "@recetario/ui/loading-overlay";

  function setupSignOut() {
    const button = document.getElementById("sign-out-button");

    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    if (button.dataset.signOutBound === "1") {
      return;
    }

    button.dataset.signOutBound = "1";

    const label = button.querySelector("[data-sign-out-label]");
    const defaultLabel = label?.textContent ?? "Cerrar sesión";

    const setPendingState = (isPending: boolean) => {
      button.disabled = isPending;
      button.setAttribute("aria-busy", isPending ? "true" : "false");

      if (label instanceof HTMLElement) {
        label.textContent = isPending ? "Cerrando..." : defaultLabel;
      }
    };

    button.addEventListener("click", async () => {
      if (button.disabled) {
        return;
      }

      setPendingState(true);

      const removeOverlay = showLoadingOverlay("Cerrando sesión…");

      try {
        await signOut();
        window.location.assign("/sign-in");
      } catch (error) {
        removeOverlay();
        setPendingState(false);
        console.error("Sign-out failed:", error);
        window.alert("No se pudo cerrar sesión. Inténtalo de nuevo.");
      }
    });
  }

  document.addEventListener("astro:page-load", setupSignOut);
  document.addEventListener("astro:after-swap", setupSignOut);
  setupSignOut();
</script>
