---
import { Button, SectionHeading } from "@recetario/ui";
import { Icon } from "astro-icon/components";
import FixedCostCard from "./FixedCostCard.astro";

interface FixedCostLine {
  id: number;
  recipeId: number;
  name: string;
  type: "PERCENTAGE" | "AMOUNT";
  base: "PER_BATCH" | "PER_UNIT" | "PER_HOUR";
  value: number;
  hours?: number | null;
}

interface Props {
  recipeFixedCosts: FixedCostLine[];
  recipeId: number;
  isEditing: boolean;
}

const { recipeFixedCosts, recipeId, isEditing } = Astro.props;
const createDialogId = `create-recipe-fixed-cost-dialog`;
---

<section class="space-y-4">
  <div class="flex items-start justify-between gap-3">
    <SectionHeading title="Costos Fijos de la Receta" />
    {
      isEditing && (
        <Button
          variant="primary"
          icon="plus"
          data-open-recipe-fixed-dialog={createDialogId}
        >
          Agregar Costo Fijo
        </Button>
      )
    }
  </div>

  {
    recipeFixedCosts.length > 0 ? (
      <div class="grid grid-cols-1 gap-3">
        {recipeFixedCosts.map((fc) => (
          <FixedCostCard
            id={fc.id}
            name={fc.name}
            type={fc.type}
            base={fc.base}
            value={fc.value}
            hours={fc.hours ?? null}
            isRecipeLevel={true}
            recipeId={fc.recipeId}
          />
        ))}
      </div>
    ) : (
      <p class="text-muted-foreground py-8 text-center text-sm">
        No hay costos fijos definidos para esta receta.
      </p>
    )
  }

  <!-- Create Recipe Fixed Cost Dialog -->
  {
    isEditing && (
      <dialog
        data-animated
        id={createDialogId}
        class="fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-md max-h-[calc(100dvh-2rem)] rounded-3xl border border-border p-0 shadow-2xl backdrop:bg-backdrop/50"
      >
        <form
          method="post"
          action={Astro.url.pathname + Astro.url.search}
          class="max-h-[calc(100dvh-2rem)] overflow-auto rounded-3xl bg-card p-6"
        >
          <input type="hidden" name="action" value="create_recipe_fixed_cost" />
          <input type="hidden" name="recipeId" value={recipeId} />
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken || ""} />

          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-accent-500 text-xs font-black uppercase tracking-[0.18em]">
                Nuevo costo fijo
              </p>
              <h2 class="text-foreground mt-2 text-xl font-black">
                Agregar costo fijo a la receta
              </h2>
              <p class="text-muted-foreground mt-2 text-sm">
                Define un costo operativo adicional (servicios, mano de obra, etc.).
              </p>
            </div>
            <button
              type="button"
              data-close-recipe-fixed-dialog={createDialogId}
              class="border-border text-muted-foreground hover:bg-background hover:text-secondary-foreground inline-flex h-10 w-10 items-center justify-center rounded-xl border transition-colors"
              aria-label="Cerrar modal"
            >
              <Icon name="lucide:x" size={18} />
            </button>
          </div>

          <label
            class="mt-6 block text-sm font-semibold text-secondary-foreground"
            for="create-recipe-fc-name"
          >
            Nombre
          </label>
          <input
            id="create-recipe-fc-name"
            name="name"
            type="text"
            required
            maxlength="120"
            placeholder="Ej. Electricidad, Mano de obra, Envío"
            class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
          />

          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label
                class="block text-sm font-semibold text-secondary-foreground"
                for="create-recipe-fc-type"
              >
                Tipo
              </label>
              <select
                id="create-recipe-fc-type"
                name="type"
                required
                class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none transition-colors focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              >
                <option value="AMOUNT">Monto ($)</option>
                <option value="PERCENTAGE">Porcentaje (%)</option>
              </select>
            </div>

            <div>
              <label
                class="block text-sm font-semibold text-secondary-foreground"
                for="create-recipe-fc-base"
              >
                Base
              </label>
              <select
                id="create-recipe-fc-base"
                name="base"
                required
                class="create-recipe-fc-base-select mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none transition-colors focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              >
                <option value="PER_BATCH">Por Mezcla</option>
                <option value="PER_UNIT">Por Unidad</option>
                <option value="PER_HOUR">Por Hora</option>
              </select>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label
                class="block text-sm font-semibold text-secondary-foreground"
                for="create-recipe-fc-value"
              >
                Valor
              </label>
              <input
                id="create-recipe-fc-value"
                name="value"
                type="number"
                min="0"
                step="0.01"
                required
                placeholder="0.00"
                class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground font-mono outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              />
            </div>

            <div class="create-recipe-fc-hours-field" style="display:none">
              <label
                class="block text-sm font-semibold text-secondary-foreground"
                for="create-recipe-fc-hours"
              >
                Horas
              </label>
              <input
                id="create-recipe-fc-hours"
                name="hours"
                type="number"
                min="0.01"
                step="0.5"
                placeholder="1"
                class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground font-mono outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              />
            </div>
          </div>

          <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <Button
              variant="secondary"
              data-close-recipe-fixed-dialog={createDialogId}
            >
              Cancelar
            </Button>
            <Button variant="primary" icon="plus" type="submit">
              Agregar Costo Fijo
            </Button>
          </div>
        </form>
      </dialog>
    )
  }
</section>

<script>
  import { bindDialogBackdrop } from "@recetario/ui/dialog";

  const dialogId = "create-recipe-fixed-cost-dialog";

  const setupDialog = () => {
    const dialog = document.getElementById(dialogId);
    const nameInput = document.getElementById("create-recipe-fc-name");

    if (!(dialog instanceof HTMLDialogElement)) return;

    const openButtons = document.querySelectorAll(
      `[data-open-recipe-fixed-dialog="${dialogId}"]`,
    );
    const closeButtons = document.querySelectorAll(
      `[data-close-recipe-fixed-dialog="${dialogId}"]`,
    );

    const openDialog = () => {
      const form = dialog.querySelector("form");
      if (form instanceof HTMLFormElement) {
        form.reset();
        // Reset hours field visibility
        const hoursField = form.querySelector<HTMLDivElement>(".create-recipe-fc-hours-field");
        if (hoursField) hoursField.style.display = "none";
      }
      if (!dialog.open) {
        dialog.showModal();
      }
      if (nameInput instanceof HTMLInputElement) {
        requestAnimationFrame(() => nameInput.focus());
      }
    };

    const closeDialog = () => {
      if (dialog.open) dialog.close();
    };

    openButtons.forEach((button) => {
      if (!(button instanceof HTMLElement)) return;
      if (button.dataset.openRecipeFixedDialogBound === "1") return;
      button.dataset.openRecipeFixedDialogBound = "1";
      button.addEventListener("click", openDialog);
    });

    closeButtons.forEach((button) => {
      if (!(button instanceof HTMLElement)) return;
      if (button.dataset.closeRecipeFixedDialogBound === "1") return;
      button.dataset.closeRecipeFixedDialogBound = "1";
      button.addEventListener("click", closeDialog);
    });

    if (dialog.dataset.createRecipeFixedDialogBound === "1") return;
    dialog.dataset.createRecipeFixedDialogBound = "1";
    bindDialogBackdrop(dialog);

    // Base select change - toggle hours field visibility
    const baseSelect = dialog.querySelector<HTMLSelectElement>(".create-recipe-fc-base-select");
    const hoursField = dialog.querySelector<HTMLDivElement>(".create-recipe-fc-hours-field");
    if (baseSelect && hoursField) {
      if (baseSelect.dataset.createRecipeFcBound === "1") return;
      baseSelect.dataset.createRecipeFcBound = "1";
      baseSelect.addEventListener("change", () => {
        hoursField.style.display =
          baseSelect.value === "PER_HOUR" ? "block" : "none";
      });
    }

    // Form submission
    const form = dialog.querySelector("form");
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      try {
        const formData = new FormData(form);
        const response = await fetch(window.location.href, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: formData,
        });

        if (response.redirected) {
          throw new Error(
            "Tu sesión expiró. Recarga la página e inicia sesión nuevamente.",
          );
        }

        if (!response.ok) {
          const message = (await response.text()).trim();
          throw new Error(message || "Hubo un error al crear el costo fijo.");
        }

        const contentType = response.headers.get("content-type") || "";
        if (!contentType.includes("application/json")) {
          throw new Error("La respuesta del servidor no fue válida.");
        }

        const payload = await response.json().catch(() => null);
        if (!payload?.fixedCost) {
          throw new Error("La respuesta del servidor no fue válida.");
        }

        // Append new FixedCostCard to the list
        const container = document.querySelector(
          '[data-recipe-fixed-costs-container="1"]',
        );
        if (container) {
          const wrapper = document.createElement("div");
          wrapper.innerHTML = payload.fixedCostCardHtml;
          const card = wrapper.firstElementChild;
          if (card) {
            container.appendChild(card);
          }
        }

        // Remove empty state if present
        const emptyState = document.querySelector(
          '[data-recipe-fixed-costs-empty="1"]',
        );
        if (emptyState) emptyState.remove();

        closeDialog();
      } catch (error) {
        console.error(error);
        const message =
          error instanceof Error && error.message
            ? error.message
            : "Hubo un error al crear el costo fijo.";
        const errorEl = form.querySelector<HTMLParagraphElement>(
          ".recipe-fixed-cost-error",
        );
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.classList.remove("hidden");
        }
      }
    });
  };

  document.addEventListener("astro:page-load", setupDialog);
  document.addEventListener("astro:after-swap", setupDialog);
</script>
