---
import Card from "@/components/ui/Card.astro";
---

<div class="mx-auto max-w-3xl space-y-6 animate-pulse">
  <!-- Nav Skeleton -->
  <div class="border-b border-border pb-3 flex gap-6">
    <div class="h-5 w-20 bg-muted rounded"></div>
    <div class="h-5 w-28 bg-muted rounded"></div>
    <div class="h-5 w-24 bg-muted rounded"></div>
  </div>

  <!-- Profile Card Skeleton -->
  <Card padding="lg" class="h-28 bg-card/60 flex items-center gap-4">
    <div class="h-16 w-16 bg-muted rounded-2xl shrink-0"></div>
    <div class="space-y-2 flex-1">
      <div class="h-3 w-28 bg-muted rounded"></div>
      <div class="h-6 w-40 bg-muted rounded"></div>
      <div class="h-4 w-48 bg-muted rounded"></div>
    </div>
  </Card>

  <!-- Section Card Skeleton -->
  <Card padding="lg" class="h-48 bg-card/60 space-y-3">
    <div class="h-5 w-32 bg-muted rounded"></div>
    <div class="h-4 w-64 bg-muted rounded"></div>
    <div class="pt-4 h-10 w-full bg-muted/60 rounded-xl"></div>
  </Card>
</div>
