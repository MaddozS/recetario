---
import { Button } from "@recetario/ui";
import { Icon } from "astro-icon/components";
import FixedCostCard from "./FixedCostCard.astro";

interface PresentationFixedCostLine {
  id: number;
  presentationId: number;
  name: string;
  type: "PERCENTAGE" | "AMOUNT";
  base: "PER_BATCH" | "PER_UNIT" | "PER_HOUR";
  value: number;
}

interface Props {
  presentationFixedCosts: PresentationFixedCostLine[];
  presentationId: number;
  isEditing: boolean;
}

const { presentationFixedCosts, presentationId, isEditing } = Astro.props;
const createDialogId = `create-presentation-fc-dialog-${presentationId}`;
---

<section class="space-y-3">
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-foreground text-sm font-bold">
      Costos Fijos
    </h3>
    {
      isEditing && (
        <Button
          variant="secondary"
          icon="plus"
          size="sm"
          data-open-presentation-fc-dialog={createDialogId}
        >
          Agregar
        </Button>
      )
    }
  </div>

  {
    presentationFixedCosts.length > 0 ? (
      <div class="flex flex-col gap-2">
        {presentationFixedCosts.map((fc) => (
          <FixedCostCard
            id={fc.id}
            name={fc.name}
            type={fc.type}
            base={fc.base}
            value={fc.value}
            hours={null}
            isRecipeLevel={false}
            presentationId={fc.presentationId}
          />
        ))}
      </div>
    ) : (
      <p class="text-muted-foreground py-4 text-center text-xs">
        Sin costos fijos
      </p>
    )
  }

  <!-- Create Presentation Fixed Cost Dialog -->
  {
    isEditing && (
      <dialog
        data-animated
        id={createDialogId}
        class="fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-sm max-h-[calc(100dvh-2rem)] rounded-3xl border border-border p-0 shadow-2xl backdrop:bg-backdrop/50"
      >
        <form
          method="post"
          action={Astro.url.pathname + Astro.url.search}
          class="max-h-[calc(100dvh-2rem)] overflow-auto rounded-3xl bg-card p-5"
        >
          <input type="hidden" name="action" value="create_presentation_fixed_cost" />
          <input type="hidden" name="presentationId" value={presentationId} />
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken || ""} />

          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-accent-500 text-[11px] font-black uppercase tracking-[0.18em]">
                Costo fijo
              </p>
              <h3 class="text-foreground mt-1 text-base font-black">
                Agregar costo fijo
              </h3>
            </div>
            <button
              type="button"
              data-close-presentation-fc-dialog={createDialogId}
              class="border-border text-muted-foreground hover:bg-background hover:text-secondary-foreground inline-flex h-8 w-8 items-center justify-center rounded-xl border transition-colors"
              aria-label="Cerrar"
            >
              <Icon name="lucide:x" size={16} />
            </button>
          </div>

          <label
            class="mt-4 block text-xs font-semibold text-secondary-foreground"
            for={`create-pres-fc-name-${presentationId}`}
          >
            Nombre
          </label>
          <input
            id={`create-pres-fc-name-${presentationId}`}
            name="name"
            type="text"
            required
            maxlength="120"
            placeholder="Ej. Empaque, Etiqueta"
            class="mt-1.5 w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-foreground outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
          />

          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label
                class="block text-xs font-semibold text-secondary-foreground"
                for={`create-pres-fc-type-${presentationId}`}
              >
                Tipo
              </label>
              <select
                id={`create-pres-fc-type-${presentationId}`}
                name="type"
                required
                class="mt-1.5 w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-foreground outline-none transition-colors focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              >
                <option value="AMOUNT">Monto ($)</option>
                <option value="PERCENTAGE">Porcentaje (%)</option>
              </select>
            </div>

            <div>
              <label
                class="block text-xs font-semibold text-secondary-foreground"
                for={`create-pres-fc-base-${presentationId}`}
              >
                Base
              </label>
              <select
                id={`create-pres-fc-base-${presentationId}`}
                name="base"
                required
                class="mt-1.5 w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-foreground outline-none transition-colors focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              >
                <option value="PER_BATCH">Por Mezcla</option>
                <option value="PER_UNIT">Por Unidad</option>
              </select>
            </div>

            <div>
              <label
                class="block text-xs font-semibold text-secondary-foreground"
                for={`create-pres-fc-value-${presentationId}`}
              >
                Valor
              </label>
              <input
                id={`create-pres-fc-value-${presentationId}`}
                name="value"
                type="number"
                min="0"
                step="0.01"
                required
                placeholder="0.00"
                class="mt-1.5 w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-foreground font-mono outline-none transition-colors placeholder:text-subtle-foreground focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              />
            </div>
          </div>

          <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <Button
              variant="secondary"
              size="sm"
              data-close-presentation-fc-dialog={createDialogId}
            >
              Cancelar
            </Button>
            <Button variant="primary" icon="plus" size="sm" type="submit">
              Agregar
            </Button>
          </div>
        </form>
      </dialog>
    )
  }
</section>

<script>
  import { bindDialogBackdrop } from "@recetario/ui/dialog";

  const setupPresentationFcDialogs = () => {
    const dialogSelector = '[id^="create-presentation-fc-dialog-"]';

    document.querySelectorAll(dialogSelector).forEach((dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (dialog.dataset.createPresentationFcBound === "1") return;
      dialog.dataset.createPresentationFcBound = "1";

      const dialogId = dialog.id;
      const nameInput = dialog.querySelector<HTMLInputElement>(
        `input[name="name"]`,
      );

      const openButtons = document.querySelectorAll(
        `[data-open-presentation-fc-dialog="${dialogId}"]`,
      );
      const closeButtons = document.querySelectorAll(
        `[data-close-presentation-fc-dialog="${dialogId}"]`,
      );

      const openDialog = () => {
        const form = dialog.querySelector("form");
        if (form instanceof HTMLFormElement) {
          form.reset();
        }
        if (!dialog.open) {
          dialog.showModal();
        }
        if (nameInput instanceof HTMLInputElement) {
          requestAnimationFrame(() => nameInput.focus());
        }
      };

      const closeDialog = () => {
        if (dialog.open) dialog.close();
      };

      openButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;
        if (button.dataset.openPresentationFcBound === "1") return;
        button.dataset.openPresentationFcBound = "1";
        button.addEventListener("click", openDialog);
      });

      closeButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;
        if (button.dataset.closePresentationFcBound === "1") return;
        button.dataset.closePresentationFcBound = "1";
        button.addEventListener("click", closeDialog);
      });

      bindDialogBackdrop(dialog);

      // Form submission
      const form = dialog.querySelector("form");
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!(form instanceof HTMLFormElement)) return;

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        try {
          const formData = new FormData(form);
          const response = await fetch(window.location.href, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: formData,
          });

          if (response.redirected) {
            throw new Error(
              "Tu sesión expiró. Recarga la página e inicia sesión nuevamente.",
            );
          }

          if (!response.ok) {
            const message = (await response.text()).trim();
            throw new Error(
              message || "Hubo un error al crear el costo fijo.",
            );
          }

          const contentType = response.headers.get("content-type") || "";
          if (!contentType.includes("application/json")) {
            throw new Error("La respuesta del servidor no fue válida.");
          }

          const payload = await response.json().catch(() => null);
          if (!payload?.fixedCost) {
            throw new Error("La respuesta del servidor no fue válida.");
          }

          // Append new FixedCostCard to the container
          const container = dialog.closest("[data-presentation-fc-container]");
          if (container) {
            const listEl = container.querySelector(
              "[data-presentation-fc-list]",
            );
            if (listEl) {
              const wrapper = document.createElement("div");
              wrapper.innerHTML = payload.fixedCostCardHtml;
              const card = wrapper.firstElementChild;
              if (card) {
                listEl.appendChild(card);
              }
            }

            // Remove empty state
            const emptyEl = container.querySelector(
              "[data-presentation-fc-empty]",
            );
            if (emptyEl) emptyEl.remove();
          }

          closeDialog();
        } catch (error) {
          console.error(error);
          const message =
            error instanceof Error && error.message
              ? error.message
              : "Hubo un error al crear el costo fijo.";
          const errorEl = form.querySelector<HTMLParagraphElement>(
            ".presentation-fc-error",
          );
          if (errorEl) {
            errorEl.textContent = message;
            errorEl.classList.remove("hidden");
          }
        }
      });
    });
  };

  document.addEventListener("astro:page-load", setupPresentationFcDialogs);
  document.addEventListener("astro:after-swap", setupPresentationFcDialogs);
</script>
