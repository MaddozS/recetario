---
import Icon from "@/components/ui/Icon.astro";
import Badge from "./ui/Badge.astro";
import type { UserSubscriptionInfo } from "@recetario/stripe";

interface Props {
  currentPage: string;
  isAuthenticated?: boolean;
  userName?: string | null;
  userImage?: string | null;
  subscription?: UserSubscriptionInfo | null;
  showProduction?: boolean;
}

const {
  currentPage,
  isAuthenticated = false,
  subscription = null,
  showProduction = false,
} = Astro.props;

const isActive = (page: string) => currentPage === page;
---

<div class="bg-card relative flex h-full flex-col">
  <!-- Mobile Sidebar Header (close button + user/logo) -->
  <div
    class="border-border flex flex-none items-center gap-3 border-b p-4 md:hidden"
  >
    <button
      id="close-sidebar-btn"
      class="text-muted-foreground hover:text-secondary-foreground border-border hover:bg-background rounded-xl border p-2 transition-colors"
      aria-label="Cerrar menú"
    >
      <Icon name="lucide:x" size={20} />
    </button>
    {
      isAuthenticated ? (
        <div class="flex items-center gap-3">
          <Badge variant="tier" color="accent">
            {subscription?.tier === "free"
              ? "Free"
              : subscription?.tier === "basic"
                ? "Basic"
                : subscription?.tier === "pro"
                  ? "Pro"
                  : "Free"}
          </Badge>
        </div>
      ) : (
        <>
          <div class="bg-accent-600 shadow-accent-100 rounded-xl p-2 text-white shadow-md">
            <Icon name="lucide:chef-hat" size={20} />
          </div>
          <div>
            <p class="text-foreground text-base leading-tight font-bold">
              KitchCalc
            </p>
            <p class="text-muted-foreground text-[10px] font-medium">
              Costeo Inteligente
            </p>
          </div>
        </>
      )
    }
  </div>

  <!-- Section Navigation -->
  <nav
    class="flex-1 space-y-1 overflow-y-auto px-3 pt-4 pb-2"
    aria-label="Secciones"
  >
    <a
      href="/recipes"
      data-astro-prefetch="hover"
      class:list={[
        "sidebar-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors",
        isActive("recipes")
          ? "bg-accent-600 text-white"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
      title="Recetas"
    >
      <Icon
        name="lucide:book-open"
        size={20}
        class="sidebar-link-icon shrink-0"
      />
      <span class="sidebar-label truncate">Recetas</span>
    </a>
    <a
      href="/ingredients"
      data-astro-prefetch="hover"
      class:list={[
        "sidebar-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors",
        isActive("ingredients")
          ? "bg-accent-600 text-white"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
      title="Ingredientes"
    >
      <Icon
        name="lucide:package-search"
        size={20}
        class="sidebar-link-icon shrink-0"
      />
      <span class="sidebar-label truncate">Ingredientes</span>
    </a>
    {
      showProduction && (
        <a
          href="/produccion"
          data-astro-prefetch="hover"
          class:list={[
            "sidebar-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors",
            isActive("production")
              ? "bg-accent-600 text-white"
              : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
          ]}
          title="Producción"
        >
          <Icon
            name="lucide:factory"
            size={20}
            class="sidebar-link-icon shrink-0"
          />
          <span class="sidebar-label truncate">Producción</span>
        </a>
      )
    }
    <a
      href="/settings"
      data-astro-prefetch="hover"
      class:list={[
        "sidebar-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors",
        isActive("settings")
          ? "bg-accent-600 text-white"
          : "text-muted-foreground hover:text-secondary-foreground hover:bg-muted",
      ]}
      title="Configuración"
    >
      <Icon
        name="lucide:settings"
        size={20}
        class="sidebar-link-icon shrink-0"
      />
      <span class="sidebar-label truncate">Configuración</span>
    </a>
  </nav>

  <!-- Sidebar Footer: plan badge + collapse toggle (desktop only) -->
  <div class="border-border hidden border-t md:block">
    <div class="flex items-center justify-between p-3">
      <div class="flex items-center gap-2">
        <Badge variant="tier" color="accent" class="sidebar-footer-badge">
          {
            subscription?.tier === "free"
              ? "Free"
              : subscription?.tier === "basic"
                ? "Basic"
                : subscription?.tier === "pro"
                  ? "Pro"
                  : "Free"
          }
        </Badge>
      </div>
      <button
        type="button"
        id="sidebar-collapse-toggle"
        class="sidebar-collapse-btn text-subtle-foreground hover:text-secondary-foreground hover:bg-muted inline-flex h-11 min-h-11 w-11 min-w-11 shrink-0 items-center justify-center rounded-lg transition-colors"
        aria-label="Colapsar sidebar"
        title="Colapsar sidebar"
      >
        <Icon
          id="collapse-icon-collapsed"
          name="lucide:chevron-right"
          size={18}
          class="hidden"
        />
        <Icon
          id="collapse-icon-expanded"
          name="lucide:chevron-left"
          size={18}
        />
      </button>
    </div>
  </div>
</div>

<style is:global>
  #app-sidebar {
    transition: translate 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobile-sidebar-overlay {
    transition: opacity 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    #app-sidebar {
      width: 220px;
      transition:
        translate 250ms cubic-bezier(0.16, 1, 0.3, 1),
        width 200ms ease;
    }
    #app-sidebar[data-collapsed="1"] {
      width: 64px;
    }
    #app-sidebar[data-collapsed="1"] .sidebar-label {
      opacity: 0;
      width: 0;
      overflow: hidden;
    }
    #app-sidebar[data-collapsed="1"] a.sidebar-link {
      justify-content: center;
      padding-left: 0;
      padding-right: 0;
      gap: 0;
    }
    #app-sidebar[data-collapsed="1"] .sidebar-link-icon {
      margin: 0;
    }
    #app-sidebar[data-collapsed="1"] .sidebar-footer-badge {
      display: none;
    }
    #app-sidebar[data-collapsed="1"] .sidebar-collapse-btn {
      margin: 0 auto;
    }
    .sidebar-label {
      transition: opacity 150ms ease;
    }
  }
</style>

<script>
  function setupSidebarCollapse() {
    const sidebar = document.getElementById("app-sidebar");
    const toggle = document.getElementById("sidebar-collapse-toggle");
    const iconCollapsed = document.getElementById("collapse-icon-collapsed");
    const iconExpanded = document.getElementById("collapse-icon-expanded");

    if (!sidebar || !toggle || !iconCollapsed || !iconExpanded) return;
    if (toggle.dataset.collapseBound === "1") return;
    toggle.dataset.collapseBound = "1";

    const STORAGE_KEY = "kitchcalc-sidebar-collapsed";

    function setCollapsed(collapsed: boolean) {
      sidebar!.setAttribute("data-collapsed", collapsed ? "1" : "0");
      iconCollapsed!.classList.toggle("hidden", !collapsed);
      iconExpanded!.classList.toggle("hidden", collapsed);
      toggle!.setAttribute(
        "aria-label",
        collapsed ? "Expandir sidebar" : "Colapsar sidebar",
      );
      toggle!.setAttribute(
        "title",
        collapsed ? "Expandir sidebar" : "Colapsar sidebar",
      );

      try {
        localStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0");
        document.cookie = `kitchcalc-sidebar-collapsed=${collapsed ? "1" : "0"}; path=/; max-age=31536000; SameSite=Lax`;
      } catch {
        /* noop */
      }
    }

    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored === "1") setCollapsed(true);
    } catch {
      /* noop */
    }

    toggle.addEventListener("click", () => {
      const isCollapsed = sidebar.getAttribute("data-collapsed") === "1";
      setCollapsed(!isCollapsed);
    });
  }

  document.addEventListener("astro:page-load", setupSidebarCollapse);
  document.addEventListener("astro:after-swap", setupSidebarCollapse);
  setupSidebarCollapse();
</script>
