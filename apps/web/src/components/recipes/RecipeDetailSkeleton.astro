---
import Card from "@/components/ui/Card.astro";
---

<div class="space-y-6 animate-pulse">
  <!-- Header Skeleton -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-2">
      <div class="h-4 w-20 bg-muted rounded"></div>
      <div class="h-8 w-64 bg-muted rounded-xl"></div>
      <div class="h-4 w-36 bg-muted rounded"></div>
    </div>
    <div class="flex items-center gap-2">
      <div class="h-10 w-24 bg-muted rounded-xl"></div>
      <div class="h-10 w-10 bg-muted rounded-xl"></div>
    </div>
  </div>

  <!-- Financial Summary Skeleton -->
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
    <Card padding="sm" class="h-20 bg-card/60">
      <div class="h-3 w-20 bg-muted rounded"></div>
      <div class="mt-3 h-6 w-24 bg-muted rounded"></div>
    </Card>
    <Card padding="sm" class="h-20 bg-card/60">
      <div class="h-3 w-20 bg-muted rounded"></div>
      <div class="mt-3 h-6 w-24 bg-muted rounded"></div>
    </Card>
    <Card padding="sm" class="h-20 bg-card/60">
      <div class="h-3 w-20 bg-muted rounded"></div>
      <div class="mt-3 h-6 w-24 bg-muted rounded"></div>
    </Card>
    <Card padding="sm" class="h-20 bg-card/60">
      <div class="h-3 w-20 bg-muted rounded"></div>
      <div class="mt-3 h-6 w-24 bg-muted rounded"></div>
    </Card>
  </div>

  <!-- Main Content Skeleton -->
  <Card padding="lg" class="space-y-4">
    <div class="flex items-center justify-between border-b border-border pb-4">
      <div class="h-6 w-32 bg-muted rounded"></div>
      <div class="h-8 w-24 bg-muted rounded-xl"></div>
    </div>
    <div class="space-y-3 pt-2">
      <div class="h-12 w-full bg-muted/60 rounded-xl"></div>
      <div class="h-12 w-full bg-muted/60 rounded-xl"></div>
      <div class="h-12 w-full bg-muted/60 rounded-xl"></div>
    </div>
  </Card>
</div>
