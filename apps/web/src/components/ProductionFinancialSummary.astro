---
import { FinancialSummary } from "@recetario/ui";
import type { ProductionSummary } from "@/lib/production-types";
import { formatCurrency } from "@recetario/billing";

interface Props {
  summary: ProductionSummary;
}

const { summary } = Astro.props;

const noRevenue = summary.projectedRevenue <= 0;
---

<div class="production-sheet financial-summary">
  <FinancialSummary
    rows={[
      {
        label: "Costo Insumos",
        value: formatCurrency(summary.totalIngredientsCost),
        subtitle: "Insumos de todas las recetas",
        color: "danger",
      },
      {
        label: "Costo Operativo",
        value: formatCurrency(summary.totalOperationalCost),
        subtitle: "Servicios, labor, etc.",
        color: "muted",
      },
      {
        label: "Ingresos Proyectados",
        value: noRevenue ? "N/A" : formatCurrency(summary.projectedRevenue),
        subtitle: noRevenue
          ? "Sin precios de venta configurados"
          : "Ventas totales proyectadas",
        color: "accent",
      },
      {
        label: "Ganancia Estimada",
        value: noRevenue
          ? "Sin datos"
          : `${formatCurrency(summary.estimatedProfit)} (${summary.effectiveMargin.toFixed(1)}%)`,
        subtitle: noRevenue ? "" : "Margen de ganancia estimado",
        color: "success",
      },
    ]}
    highlightRow={2}
  />
</div>
