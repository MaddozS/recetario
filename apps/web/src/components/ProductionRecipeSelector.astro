---
import { Icon } from "astro-icon/components";
import { Button, Card } from "@recetario/ui";
import type { RecipeSummary } from "@recetario/db";
import type { ProductionRecipeSelection } from "@/lib/production-types";

interface PresentationOption {
  id: number;
  name: string;
}

interface Props {
  recipes: RecipeSummary[];
  selections: ProductionRecipeSelection[];
  recipePresentations?: Map<number, PresentationOption[]>;
  maxRecipes?: number;
}

const {
  recipes,
  selections,
  recipePresentations,
  maxRecipes = Infinity,
} = Astro.props;
const isProUser = maxRecipes === Infinity;
const selectedIds = new Set(selections.map((s) => s.recipeId));
const categories = [
  ...new Set(
    recipes.map((r) => r.category).filter((c): c is string => Boolean(c)),
  ),
];
const grouped: Record<string, RecipeSummary[]> = {};
for (const r of recipes) {
  const cat = r.category || "Sin categoría";
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(r);
}
---

<Card padding="lg" class="production-selector">
  <h2 class="text-foreground mb-4 text-lg font-bold">Seleccionar recetas</h2>

  {
    recipes.length === 0 ? (
      <div class="flex flex-col items-center gap-3 py-8 text-center">
        <div class="bg-muted text-subtle-foreground flex h-12 w-12 items-center justify-center rounded-2xl">
          <Icon name="lucide:book-x" size={20} />
        </div>
        <p class="text-muted-foreground text-sm">
          No hay recetas. Crea una receta primero.
        </p>
        <Button variant="primary" icon="plus" href="/recipes">
          Ir a recetas
        </Button>
      </div>
    ) : (
      <form
        id="recipe-selector-form"
        class="space-y-4"
        data-basic-limit={!isProUser ? "" : undefined}
      >
        {!isProUser && (
          <div
            class="border-warning-border bg-warning-bg rounded-xl border p-4"
            id="upgrade-banner"
            class:list={[
              "hidden",
              selectedIds.size >= maxRecipes ? "" : "hidden",
            ]}
          >
            <p class="text-warning text-sm font-semibold">
              Límite de {maxRecipes} recetas alcanzado en plan Basic.
            </p>
            <a href="/pricing" class="text-accent-600 text-sm font-bold">
              Actualizar a Pro para planificar recetas ilimitadas →
            </a>
          </div>
        )}
        {categories.length > 0
          ? categories.map((cat) => (
              <fieldset>
                <legend class="text-muted-foreground mb-2 px-1 text-[11px] font-bold tracking-[0.18em] uppercase">
                  {cat}
                </legend>
                <div class="space-y-2">
                  {(grouped[cat] || []).map((recipe: RecipeSummary) => {
                    const isSelected = selectedIds.has(recipe.id);
                    const atLimit =
                      !isProUser &&
                      selectedIds.size >= maxRecipes &&
                      !isSelected;
                    return (
                      <label
                        data-recipe-row
                        class:list={[
                          "flex cursor-pointer flex-wrap items-center gap-3 rounded-xl p-3 transition-colors",
                          isSelected
                            ? "bg-accent-50 ring-accent-200 ring-1"
                            : "hover:bg-muted",
                          atLimit ? "opacity-40" : "",
                        ]}
                      >
                        <input
                          type="checkbox"
                          name="recipe_id"
                          value={recipe.id}
                          checked={isSelected}
                          disabled={atLimit}
                          class="border-border text-accent-600 focus:ring-accent-500 h-4 w-4 rounded disabled:opacity-30"
                        />
                        <span class="min-w-0 flex-1">
                          <span class="text-foreground block truncate text-sm font-semibold">
                            {recipe.name}
                          </span>
                          <span class="text-muted-foreground block text-xs">
                            {recipe.ingredientCount} ingredientes
                          </span>
                        </span>
                        <span
                          class="recipe-controls flex w-full shrink-0 items-center justify-end gap-2 sm:w-auto sm:justify-start"
                          class:list={[isSelected ? "" : "hidden"]}
                        >
                          {(() => {
                            const sel = selections.find(
                              (s) => s.recipeId === recipe.id,
                            );
                            const presentations = recipePresentations?.get(
                              recipe.id,
                            );
                            return (
                              <>
                                {presentations && presentations.length > 1 && (
                                  <select
                                    name="presentation_id"
                                    class="border-border bg-background text-foreground focus:ring-accent-500/20 focus:border-accent-500 rounded-lg border px-2 py-2 text-xs font-medium focus:ring-2 focus:outline-none"
                                  >
                                    {presentations.map((p) => (
                                      <option
                                        value={p.id}
                                        selected={p.id === sel?.presentationId}
                                      >
                                        {p.name}
                                      </option>
                                    ))}
                                  </select>
                                )}
                                <span class="text-muted-foreground text-[11px] font-semibold">
                                  Batches:
                                </span>
                                <input
                                  type="number"
                                  name="batches"
                                  value={sel?.batches || 1}
                                  min="0.5"
                                  step="0.5"
                                  class="border-border bg-background text-foreground focus:ring-accent-500/20 focus:border-accent-500 w-20 rounded-lg border px-3 py-2 text-center font-mono text-sm focus:ring-2 focus:outline-none"
                                />
                              </>
                            );
                          })()}
                        </span>
                      </label>
                    );
                  })}
                </div>
              </fieldset>
            ))
          : recipes.map((recipe) => {
              const isSelected = selectedIds.has(recipe.id);
              const atLimit =
                !isProUser && selectedIds.size >= maxRecipes && !isSelected;
              return (
                <label
                  data-recipe-row
                  class:list={[
                    "flex cursor-pointer flex-wrap items-center gap-3 rounded-xl p-3 transition-colors",
                    isSelected
                      ? "bg-accent-50 ring-accent-200 ring-1"
                      : "hover:bg-muted",
                    atLimit ? "opacity-40" : "",
                  ]}
                >
                  <input
                    type="checkbox"
                    name="recipe_id"
                    value={recipe.id}
                    checked={isSelected}
                    disabled={atLimit}
                    class="border-border text-accent-600 focus:ring-accent-500 h-4 w-4 rounded disabled:opacity-30"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="text-foreground block truncate text-sm font-semibold">
                      {recipe.name}
                    </span>
                    <span class="text-muted-foreground block text-xs">
                      {recipe.ingredientCount} ingredientes
                    </span>
                  </span>
                  <span
                    class="recipe-controls flex w-full shrink-0 items-center justify-end gap-2 sm:w-auto sm:justify-start"
                    class:list={[isSelected ? "" : "hidden"]}
                  >
                    {(() => {
                      const sel = selections.find(
                        (s) => s.recipeId === recipe.id,
                      );
                      const presentations = recipePresentations?.get(recipe.id);
                      return (
                        <>
                          {presentations && presentations.length > 1 && (
                            <select
                              name="presentation_id"
                              class="border-border bg-background text-foreground focus:ring-accent-500/20 focus:border-accent-500 rounded-lg border px-2 py-2 text-xs font-medium focus:ring-2 focus:outline-none"
                            >
                              {presentations.map((p) => (
                                <option
                                  value={p.id}
                                  selected={p.id === sel?.presentationId}
                                >
                                  {p.name}
                                </option>
                              ))}
                            </select>
                          )}
                          <span class="text-muted-foreground text-[11px] font-semibold">
                            Batches:
                          </span>
                          <input
                            type="number"
                            name="batches"
                            value={sel?.batches || 1}
                            min="0.5"
                            step="0.5"
                            class="border-border bg-background text-foreground focus:ring-accent-500/20 focus:border-accent-500 w-20 rounded-lg border px-3 py-2 text-center font-mono text-sm focus:ring-2 focus:outline-none"
                          />
                        </>
                      );
                    })()}
                  </span>
                </label>
              );
            })}

        <div class="flex items-center justify-between pt-2">
          <span class="text-muted-foreground text-sm">
            <span id="selected-count">{selections.length}</span> de{" "}
            {recipes.length} recetas seleccionadas
          </span>
          <button
            id="calc-production-btn"
            type="button"
            class="bg-accent-600 hover:bg-accent-700 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-bold text-white transition-colors"
          >
            <Icon name="lucide:calculator" size={16} />
            Calcular producción
          </button>
        </div>
      </form>
    )
  }
</Card>
