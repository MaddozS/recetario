---
import type { ConsolidatedIngredient } from "@/lib/production-types";
import { formatCurrency } from "@recetario/billing";
import { Card } from "@recetario/ui";

interface Props {
  ingredients: ConsolidatedIngredient[];
}

const { ingredients } = Astro.props;

const formatQuantity = (value: number): string => {
  if (value < 1) return value.toFixed(3);
  if (Number.isInteger(value)) return String(value);
  return value.toFixed(2);
};

const smartQuantity = (value: number, unit: string): string => {
  const u = unit.toLowerCase();
  if ((u === "g" || u === "ml") && value >= 1000) {
    const converted = value / 1000;
    return `${formatQuantity(converted)} ${u === "g" ? "kg" : "lt"}`;
  }
  return `${formatQuantity(value)} ${unit}`;
};
---

<Card class="production-sheet ingredients-table overflow-hidden !p-0">
  <div class="border-border border-b px-6 py-4">
    <h2 class="text-foreground text-lg font-bold">Ingredientes consolidados</h2>
    <p class="text-muted-foreground mt-0.5 text-sm">
      {ingredients.length} ingrediente{ingredients.length !== 1 ? "s" : ""} en total
    </p>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full table-fixed text-left" id="ingredients-sort-table">
      <thead
        class="bg-background text-muted-foreground text-[11px] font-bold tracking-[0.16em] uppercase"
      >
        <tr>
          <th class="w-[35%] px-6 py-4" data-sort="name">Ingrediente</th>
          <th class="w-[17%] px-6 py-4" colspan="2" data-sort="quantity"
            >Cantidad total</th
          >
          <th class="w-[13%] px-6 py-4" data-sort="unitCost">Costo unitario</th>
          <th class="w-[13%] px-6 py-4" data-sort="totalCost">Costo total</th>
          <th class="w-[22%] px-6 py-4">Recetas</th>
        </tr>
      </thead>
      <tbody class="divide-border-light divide-y">
        {
          ingredients.map((ing) => (
            <tr
              class="hover:bg-hover-muted dark:hover:bg-hover-muted transition-colors"
              data-name={ing.name.toLowerCase()}
              data-quantity={ing.totalQuantity}
              data-unitCost={ing.unitCost}
              data-totalCost={ing.totalCost}
            >
              <td class="px-6 py-4 break-words">
                <div>
                  <p class="text-foreground font-semibold">{ing.name}</p>
                  {ing.brand && (
                    <p class="text-subtle-foreground mt-0.5 text-xs">
                      {ing.brand}
                      {ing.supplier ? ` · ${ing.supplier}` : ""}
                    </p>
                  )}
                </div>
              </td>
              <td
                class="text-secondary-foreground px-6 py-4 font-mono font-semibold whitespace-nowrap tabular-nums"
                colspan="2"
              >
                {smartQuantity(ing.totalQuantity, ing.unit)}
              </td>
              <td class="text-secondary-foreground px-6 py-4 font-mono text-sm whitespace-nowrap tabular-nums">
                {formatCurrency(ing.unitCost)}/{ing.unit}
              </td>
              <td class="text-foreground px-6 py-4 font-mono font-semibold whitespace-nowrap tabular-nums">
                {formatCurrency(ing.totalCost)}
              </td>
              <td class="px-6 py-4 break-words">
                <div class="flex flex-wrap gap-1.5">
                  {ing.sourceRecipes.map((src) => (
                    <span class="bg-muted text-secondary-foreground inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium">
                      <span class="max-w-[20ch] truncate">
                        {src.recipeName}
                      </span>
                      <span class="text-subtle-foreground shrink-0">
                        (
                        {src.quantity < 1
                          ? src.quantity.toFixed(2)
                          : Number.isInteger(src.quantity)
                            ? src.quantity
                            : src.quantity.toFixed(1)}{" "}
                        {ing.unit})
                      </span>
                    </span>
                  ))}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Card>

<script>
  function setupSortableTable() {
    const table = document.getElementById("ingredients-sort-table");
    if (!table || table.dataset.sortBound === "1") return;
    table.dataset.sortBound = "1";

    const headers = table.querySelectorAll<HTMLElement>("th[data-sort]");
    const tbody = table.querySelector("tbody");
    if (!tbody) return;

    headers.forEach((th) => {
      const col = th.dataset.sort as string;
      th.style.cursor = "pointer";

      const iconSpan = document.createElement("span");
      iconSpan.className = "ml-1 inline-block text-[10px]";
      iconSpan.textContent = " ";
      th.appendChild(iconSpan);

      th.addEventListener("click", () => {
        const dir = th.dataset.dir === "asc" ? "desc" : "asc";

        headers.forEach((h) => {
          delete h.dataset.dir;
          const icon = h.querySelector("span:last-child");
          if (icon) icon.textContent = " ";
        });

        th.dataset.dir = dir;
        iconSpan.textContent = dir === "asc" ? "▲" : "▼";

        const rows = Array.from(tbody.querySelectorAll<HTMLElement>("tr"));

        rows.sort((a, b) => {
          let aVal: string | number = a.dataset[col] || "";
          let bVal: string | number = b.dataset[col] || "";

          if (col === "name") {
            aVal = String(aVal);
            bVal = String(bVal);
            return dir === "asc"
              ? aVal.localeCompare(bVal)
              : bVal.localeCompare(aVal);
          }

          aVal = parseFloat(String(aVal)) || 0;
          bVal = parseFloat(String(bVal)) || 0;
          return dir === "asc" ? aVal - bVal : bVal - aVal;
        });

        rows.forEach((row) => tbody.appendChild(row));
      });
    });
  }

  document.addEventListener("astro:page-load", setupSortableTable);
  document.addEventListener("astro:after-swap", setupSortableTable);
</script>
