---
import { Icon } from "astro-icon/components";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
import { isPaid } from "@recetario/billing";
import { formatCurrency } from "@recetario/billing";
import PricingModal from "@/components/PricingModal.astro";
import type { UserSubscriptionInfo } from "@recetario/billing";
import type { PricingPlan } from "@recetario/billing";

interface Props {
  subscription: UserSubscriptionInfo;
  plans: PricingPlan[];
  recipeCount: number;
  ingredientCount: number;
  remainingRecipes: number | null;
  remainingIngredients: number | null;
  showBackButton?: boolean;
  isCanceled?: boolean;
  isSuccess?: boolean;
}

const {
  subscription,
  plans,
  recipeCount,
  ingredientCount,
  remainingRecipes,
  remainingIngredients,
  showBackButton = false,
  isCanceled = false,
  isSuccess = false,
} = Astro.props;

const priceDisplay =
  subscription.tier !== "free" && subscription.priceCents != null
    ? formatCurrency(subscription.priceCents / 100)
    : null;
const currencyLabel = subscription.currency?.toUpperCase() ?? "";

const trialEndDate = subscription.trialEnd ?? subscription.currentPeriodEnd;
const isTrialEndValid = trialEndDate && trialEndDate.getFullYear() >= 2025;
---

<section class="mx-auto max-w-3xl space-y-6">
  {
    showBackButton && (
      <Button variant="secondary" icon="arrow-left" href="/settings" size="sm">
        Volver a Configuración
      </Button>
    )
  }

  {
    isSuccess && (
      <div class="border-success-border bg-success-bg rounded-2xl border p-4">
        <div class="flex items-center gap-3">
          <Icon name="lucide:check-circle" size={20} class="text-success" />
          <div>
            <p class="text-success font-semibold">Pago exitoso</p>
            <p class="text-success text-sm">Tu suscripcion ha sido activada.</p>
          </div>
        </div>
      </div>
    )
  }

  {
    isCanceled && (
      <div class="border-warning-border bg-warning-bg rounded-2xl border p-4">
        <div class="flex items-center gap-3">
          <Icon name="lucide:alert-triangle" size={20} class="text-warning" />
          <div>
            <p class="text-warning font-semibold">Pago cancelado</p>
            <p class="text-warning text-sm">No se realizo ningun cargo.</p>
          </div>
        </div>
      </div>
    )
  }

  {
    subscription.isTrial && isTrialEndValid && (
      <div class="border-accent-200 bg-accent-50 rounded-2xl border p-4">
        <div class="flex items-center gap-3">
          <Icon name="lucide:clock" size={20} class="text-accent-600" />
          <div>
            <p class="text-accent-700 font-semibold">
              Periodo de prueba activo
            </p>
            <p class="text-accent-600 text-sm">
              Tu prueba termina el {trialEndDate!.toLocaleDateString("es-MX")}.
            </p>
          </div>
        </div>
      </div>
    )
  }

  {
    subscription.cancelAtPeriodEnd && subscription.currentPeriodEnd && (
      <div class="border-warning-border bg-warning-bg rounded-2xl border p-4">
        <div class="flex items-center gap-3">
          <Icon name="lucide:alert-triangle" size={20} class="text-warning" />
          <div>
            <p class="text-warning font-semibold">Suscripcion cancelada</p>
            <p class="text-warning text-sm">
              Tu plan seguira activo hasta el{" "}
              {subscription.currentPeriodEnd.toLocaleDateString("es-MX")}.
            </p>
          </div>
        </div>
      </div>
    )
  }

  <Card padding="lg">
    <div class="flex items-start justify-between">
      <div>
        <p
          class="text-muted-foreground text-xs font-bold tracking-[0.18em] uppercase"
        >
          Plan actual
        </p>
        <h2 class="text-foreground mt-1 text-2xl font-black">
          KitchCalc {
            subscription.tier === "free"
              ? "Free"
              : subscription.tier === "basic"
                ? "Basic"
                : "Pro"
          }
        </h2>
        <p class="text-muted-foreground mt-1 text-sm">
          {
            subscription.tier === "free"
              ? "Gratis para siempre"
              : subscription.isTrial
                ? "En periodo de prueba de 14 dias"
                : "Renovacion recurrente"
          }
        </p>
      </div>
      <div class="text-right">
        {
          subscription.tier !== "free" && priceDisplay && (
            <p class="text-foreground text-2xl font-black whitespace-nowrap">
              {currencyLabel} {priceDisplay}
              <span class="text-subtle-foreground text-sm font-semibold">
                /{subscription.billingInterval === "yearly" ? "año" : "mes"}
              </span>
            </p>
          )
        }
        {
          subscription.cancelAtPeriodEnd && (
            <Badge variant="status" color="warning" class="mt-1">
              Cancelado
            </Badge>
          )
        }
        {
          subscription.status === "trialing" && (
            <Badge variant="status" color="accent" class="mt-1">
              Trial
            </Badge>
          )
        }
      </div>
    </div>

    <div
      id="billing-error"
      class="border-danger-border bg-danger-bg text-danger mt-3 hidden rounded-xl border p-3 text-sm font-semibold"
      role="alert"
    >
      <p id="billing-error-msg"></p>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      {
        subscription.tier !== "pro" && (
          <Button
            variant="primary"
            icon="arrow-up-circle"
            data-open-pricing-modal
          >
            {subscription.tier === "free" ? "Suscribirse" : "Actualizar a Pro"}
          </Button>
        )
      }
      {
        isPaid(subscription) && !subscription.cancelAtPeriodEnd && (
          <Button
            variant="secondary"
            icon="credit-card"
            id="manage-subscription-btn"
          >
            Gestionar suscripcion
          </Button>
        )
      }
    </div>
  </Card>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <Card padding="lg">
      <div class="mb-4 flex items-center justify-between">
        <p class="text-secondary-foreground text-sm font-bold">Recetas</p>
        <span class="text-subtle-foreground text-xs font-bold"
          >{recipeCount} / {
            remainingRecipes === null ? "∞" : subscription.recipesLimit
          }</span
        >
      </div>
      <div class="bg-muted h-2 overflow-hidden rounded-full">
        <div
          class="bg-accent-500 h-full rounded-full transition-all"
          style={`width: ${remainingRecipes === null ? 0 : Math.min(100, (recipeCount / (subscription.recipesLimit ?? 1)) * 100)}%`}
        >
        </div>
      </div>
      {
        remainingRecipes !== null && !(remainingRecipes > 3) && (
          <p class="text-warning mt-2 text-xs font-semibold">
            Te quedan {remainingRecipes} recetas.{" "}
            <a href="/pricing" class="underline">
              Actualizar plan
            </a>
          </p>
        )
      }
    </Card>

    <Card padding="lg">
      <div class="mb-4 flex items-center justify-between">
        <p class="text-secondary-foreground text-sm font-bold">Ingredientes</p>
        <span class="text-subtle-foreground text-xs font-bold"
          >{ingredientCount} / {
            remainingIngredients === null ? "∞" : subscription.ingredientsLimit
          }</span
        >
      </div>
      <div class="bg-muted h-2 overflow-hidden rounded-full">
        <div
          class="bg-accent-500 h-full rounded-full transition-all"
          style={`width: ${remainingIngredients === null ? 0 : Math.min(100, (ingredientCount / (subscription.ingredientsLimit ?? 1)) * 100)}%`}
        >
        </div>
      </div>
      {
        remainingIngredients !== null && !(remainingIngredients > 5) && (
          <p class="text-warning mt-2 text-xs font-semibold">
            Te quedan {remainingIngredients} ingredientes.{" "}
            <a href="/pricing" class="underline">
              Actualizar plan
            </a>
          </p>
        )
      }
    </Card>
  </div>

  <Card padding="lg">
    <h3 class="text-secondary-foreground mb-4 text-sm font-bold">
      Funciones incluidas
    </h3>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
      {
        (
          [
            { key: "recipe_duplicate", label: "Duplicar recetas" },
            { key: "recipe_photos", label: "Fotos de recetas" },
            { key: "stock_tracking", label: "Stock de ingredientes" },
            { key: "production_planner", label: "Planificador de produccion" },
            { key: "pdf_export", label: "Exportar a PDF" },
            { key: "advanced_costs", label: "Costos fijos avanzados" },
            { key: "change_history", label: "Historial de cambios" },
            { key: "data_import_export", label: "Importar/Exportar datos" },
          ] as const
        ).map((feature) => {
          const hasIt = subscription.features[feature.key] === true;
          return (
            <div
              class={`flex items-center gap-2 text-sm ${hasIt ? "text-secondary-foreground" : "text-subtle-foreground"}`}
            >
              <Icon
                name={hasIt ? "lucide:check" : "lucide:x"}
                size={16}
                class={hasIt ? "text-success" : "text-subtle-foreground"}
              />
              {feature.label}
            </div>
          );
        })
      }
    </div>
  </Card>
</section>

<PricingModal {plans} {subscription} />

<script>
  function setupBillingSection() {
    const manageBtn = document.getElementById("manage-subscription-btn");
    if (!(manageBtn instanceof HTMLButtonElement)) return;
    if (manageBtn.dataset.bound === "1") return;
    manageBtn.dataset.bound = "1";

    manageBtn.addEventListener("click", async () => {
      manageBtn.disabled = true;
      const originalHTML = manageBtn.innerHTML;
      manageBtn.innerHTML =
        '<span class="flex items-center gap-2"><svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> Cargando...</span>';

      try {
        const csrfToken = document.cookie
          .split("; ")
          .find((row) => row.startsWith("csrf_token="))
          ?.split("=")[1];

        const headers: Record<string, string> = {};
        if (csrfToken) headers["x-csrf-token"] = csrfToken;

        const res = await fetch("/api/stripe/portal", {
          method: "POST",
          headers,
        });
        const data = await res.json();

        if (data.url) {
          window.location.href = data.url;
        } else {
          throw new Error(data.error || "Error al abrir el portal");
        }
      } catch (err) {
        manageBtn.disabled = false;
        manageBtn.innerHTML = originalHTML;
        const errorEl = document.getElementById("billing-error");
        const errorMsg = document.getElementById("billing-error-msg");
        if (errorEl && errorMsg) {
          errorMsg.textContent =
            err instanceof Error ? err.message : "No se pudo abrir el portal";
          errorEl.classList.remove("hidden");
          setTimeout(() => errorEl.classList.add("hidden"), 6000);
        }
      }
    });
  }

  document.addEventListener("astro:page-load", setupBillingSection);
  document.addEventListener("astro:after-swap", setupBillingSection);
  setupBillingSection();
</script>
