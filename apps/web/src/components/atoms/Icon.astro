---
import * as LucideIcons from "@lucide/astro";

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  [key: string]: unknown;
}

const { name, size = 16, class: className = "", ...props } = Astro.props;

function toPascalCase(str: string): string {
  const clean = str.replace(/^lucide:/, "");
  return clean
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join("");
}

const iconName = toPascalCase(name);
const Component = (LucideIcons as Record<string, unknown>)[iconName] as (_props: Record<string, unknown>) => unknown;
---

{Component ? <Component size={size} class={className} {...props} /> : null}
