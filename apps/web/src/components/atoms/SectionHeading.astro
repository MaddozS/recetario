---
import Icon from "@/components/atoms/Icon.astro";

interface Props {
  icon?: string;
  title: string;
  subtitle?: string;
  level?: "h1" | "h2" | "h3";
  class?: string;
}

const {
  icon,
  title,
  subtitle,
  level = "h2",
  class: extraClass = "",
} = Astro.props;

const Tag = level;
---

<div class:list={[extraClass]}>
  <Tag class="text-foreground flex items-center gap-2 text-lg font-bold">
    {icon && <Icon name={`lucide:${icon}`} size={20} class="text-accent-600" />}
    {title}
  </Tag>
  {subtitle && <p class="text-muted-foreground mt-1 text-sm">{subtitle}</p>}
</div>
