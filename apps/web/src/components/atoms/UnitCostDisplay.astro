---
import Icon from "@/components/atoms/Icon.astro";

/**
 * Display de costo unitario calculado en tiempo real.
 *
 * Muestra el costo por unidad (ej. $12.50 / kg) que se actualiza
 * vía JavaScript cuando el usuario modifica los campos del formulario
 * de ingrediente. Los `data-unit-cost-value` y `data-unit-cost-unit`
 * son utilizados por el script del formulario para reflejar el cálculo.
 *
 * Pensado para usarse dentro de formularios de creación/edición de
 * ingredientes. Aparece en tres lugares del flujo: escritorio, modal
 * mobile y modal de edición.
 *
 * @prop {string} defaultUnit - Etiqueta de unidad a mostrar (ej. "kg").
 *
 * @example
 * <UnitCostDisplay defaultUnit="kg" />
 */
interface Props {
  defaultUnit: string;
}

const { defaultUnit } = Astro.props;
---

<div class="flex items-start gap-3">
  <div
    class="bg-card text-accent-600 shadow-accent-100 mt-0.5 flex h-10 w-10 items-center justify-center rounded-2xl shadow-sm dark:shadow-none"
  >
    <Icon name="lucide:info" size={18} />
  </div>

  <div>
    <p
      class="text-muted-foreground text-xs font-bold tracking-[0.16em] uppercase"
    >
      Costo unitario calculado:
    </p>
    <div class="mt-1 flex items-end gap-2">
      <span
        class="text-accent-700 font-mono text-3xl font-semibold tabular-nums"
        data-unit-cost-value
      >
        $0.00
      </span>
      <span class="text-accent-400 pb-1 text-sm font-semibold">
        / <span data-unit-cost-unit>{defaultUnit}</span>
      </span>
    </div>
  </div>
</div>
