---
import Icon from "./Icon.astro";

interface Props {
  variant?: "primary" | "secondary" | "danger" | "ghost" | "iconAccent" | "iconDanger";
  size?: "sm" | "md" | "lg";
  iconOnly?: boolean;
  href?: string;
  icon?: string;
  type?: "button" | "submit";
  disabled?: boolean;
  loading?: boolean;
  id?: string;
  ariaLabel?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  iconOnly = false,
  href,
  icon,
  type = "button",
  disabled = false,
  loading = false,
  id,
  ariaLabel: rawAriaLabel,
  class: extraClass = "",
  ...attrs
} = Astro.props;

// Runtime validation: iconAccent/iconDanger require iconOnly
let resolvedVariant = variant;
if ((variant === "iconAccent" || variant === "iconDanger") && !iconOnly) {
  console.warn(
    `Button: variant "${variant}" requires iconOnly=true. Falling back to "ghost".`,
  );
  resolvedVariant = "ghost";
}

const base =
  "inline-flex items-center justify-center gap-2 font-bold transition-colors focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-70 cursor-pointer";

const variantClasses: Record<
  string,
  { solid: string; iconOnly: string }
> = {
  primary: {
    solid: "bg-accent-600 text-white hover:bg-accent-700 rounded-xl shadow-sm",
    iconOnly: "bg-accent-600 text-white hover:bg-accent-700 rounded-full",
  },
  secondary: {
    solid:
      "border border-border bg-card text-muted-foreground hover:bg-background rounded-xl",
    iconOnly:
      "border border-border bg-card text-muted-foreground hover:bg-background rounded-full",
  },
  danger: {
    solid: "bg-danger-solid text-white hover:bg-danger-hover rounded-xl",
    iconOnly: "bg-danger-solid text-white hover:bg-danger-hover rounded-full",
  },
  ghost: {
    solid:
      "text-muted-foreground hover:bg-muted hover:text-secondary-foreground rounded-xl",
    iconOnly:
      "text-muted-foreground hover:bg-muted hover:text-secondary-foreground rounded-full",
  },
  iconAccent: {
    solid: "text-muted-foreground hover:bg-muted rounded-xl",
    iconOnly: "text-muted-foreground hover:text-accent-600 hover:bg-accent-50 rounded-full",
  },
  iconDanger: {
    solid: "text-muted-foreground hover:bg-muted rounded-xl",
    iconOnly: "text-danger hover:bg-danger-bg rounded-full",
  },
};

const sizeClasses: Record<string, string> = {
  sm: "min-h-10 px-4 py-2 text-xs",
  md: "min-h-11 px-5 py-3 text-sm",
  lg: "min-h-12 px-6 py-3.5 text-sm",
};

const iconSize = iconOnly ? 14 : size === "sm" ? 14 : size === "lg" ? 18 : 16;
---

{
  href ? (
    <a
      href={href}
      id={id}
      aria-label={rawAriaLabel}
      class={`${base} ${variantClasses[resolvedVariant][iconOnly ? "iconOnly" : "solid"]} ${iconOnly ? "min-h-10 min-w-10 p-2" : sizeClasses[size]} ${extraClass}`}
      {...attrs}
    >
      {icon && <Icon name={`lucide:${icon}`} size={iconSize} />}
      {!iconOnly && <slot />}
    </a>
  ) : (
    <button
      type={type}
      id={id}
      aria-label={rawAriaLabel}
      disabled={disabled || loading}
      class={`${base} ${variantClasses[resolvedVariant][iconOnly ? "iconOnly" : "solid"]} ${iconOnly ? "min-h-10 min-w-10 p-2" : sizeClasses[size]} ${extraClass}`}
      aria-busy={loading ? "true" : undefined}
      {...attrs}
    >
      {loading ? (
        <svg
          class="h-4 w-4 animate-[sp_0.7s_linear_infinite]"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12a9 9 0 1 1-6.219-8.56" />
        </svg>
      ) : icon ? (
        <Icon name={`lucide:${icon}`} size={iconSize} />
      ) : null}
      {!iconOnly && <slot />}
    </button>
  )
}
