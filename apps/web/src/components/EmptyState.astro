---
import { Icon } from "astro-icon/components";

/**
 * Estado vacío genérico con icono, título, descripción y CTA opcional.
 *
 * Usado en páginas que no tienen datos aún (ingredientes, recetas).
 * Soporta dos estilos de CTA:
 * - `actionHref` → renderiza un `<a>` (navegación a otra página).
 * - Sin `actionHref` → renderiza un `<button>` con `data-open-create-modal`
 *   (abre un modal vía JavaScript en la misma página).
 *
 * @prop {string}      icon        - Nombre del icono de lucide (ej. "lucide:package-plus").
 * @prop {number}      [iconSize]  - Tamaño del icono en px (default: 24).
 * @prop {string}      title       - Título del estado vacío.
 * @prop {string}      description - Texto descriptivo debajo del título.
 * @prop {"h1" | "h3"} [titleTag]  - Tag HTML para el título (default: "h3").
 * @prop {string}      [titleClasses] - Clases CSS para el título.
 * @prop {string}      [descClasses]  - Clases CSS para la descripción.
 * @prop {string}      [actionLabel]  - Texto del botón CTA. Si se omite, no se muestra CTA.
 * @prop {string}      [actionHref]   - URL del CTA. Si se omite, el CTA abre un modal.
 *
 * @example
 * // Sin CTA
 * <EmptyState icon="lucide:book-plus" title="No hay recetas" description="Crea una para empezar." />
 *
 * // Con link
 * <EmptyState icon="lucide:plus" title="Vacío" description="..." actionLabel="Crear" actionHref="/nuevo" />
 */
interface Props {
  icon: string;
  iconSize?: number;
  title: string;
  description: string;
  titleTag?: "h1" | "h3";
  titleClasses?: string;
  descClasses?: string;
  actionLabel?: string;
  actionHref?: string;
}

const {
  icon,
  iconSize = 24,
  title,
  description,
  titleTag: TitleTag = "h3",
  titleClasses = "mt-5 text-lg font-bold text-foreground",
  descClasses = "mt-2 text-sm text-muted-foreground",
  actionLabel,
  actionHref,
} = Astro.props;
---

<div class="mx-auto flex max-w-md flex-col items-center">
  <div
    class="bg-accent-50 text-accent-600 flex h-14 w-14 items-center justify-center rounded-2xl"
  >
    <Icon name={icon} size={iconSize} />
  </div>
  <TitleTag class={titleClasses}>
    {title}
  </TitleTag>
  <p class={descClasses}>
    {description}
  </p>
  {
    actionLabel && (
      <>
        {actionHref ? (
          <a
            href={actionHref}
            class="bg-accent-600 hover:bg-accent-700 mt-5 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-bold text-white transition-colors"
          >
            <Icon name="lucide:plus" size={18} />
            {actionLabel}
          </a>
        ) : (
          <button
            type="button"
            class="bg-accent-600 hover:bg-accent-700 mt-5 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-bold text-white transition-colors lg:hidden"
            data-open-create-modal
          >
            <Icon name="lucide:plus" size={18} />
            {actionLabel}
          </button>
        )}
      </>
    )
  }
</div>
