---
import Icon from "@/components/atoms/Icon.astro";
import Button from "@/components/atoms/Button.astro";
import Badge from "@/components/atoms/Badge.astro";
import Card from "@/components/molecules/shared/Card.astro";
import ConfirmPlanChangeModal from "./ConfirmPlanChangeModal.astro";
import type { PricingPlan } from "@recetario/types";
import type { UserSubscriptionInfo } from "@recetario/types";

interface Props {
  plans: PricingPlan[];
  subscription: UserSubscriptionInfo;
}

const { plans, subscription } = Astro.props;
const currentTier = subscription.tier;
const currentInterval = subscription.billingInterval || "monthly";
const currentPeriodEndFormatted = subscription.currentPeriodEnd
  ? new Date(subscription.currentPeriodEnd).toLocaleDateString("es-MX", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;
---

<dialog
  data-animated
  id="pricing-modal"
  class="backdrop:bg-backdrop/50 fixed inset-0 m-auto max-h-[90dvh] w-[calc(100vw-2rem)] max-w-5xl rounded-3xl p-0 shadow-2xl"
>
  <div
    class="bg-card border-border max-h-[90dvh] overflow-auto rounded-3xl border p-6 md:p-8"
  >
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-foreground text-2xl font-black">Planes y precios</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Elige el plan que mejor se adapte a tu negocio.
        </p>
      </div>
      <Button
        variant="ghost"
        icon="x"
        data-close-pricing-modal
        ariaLabel="Cerrar"
      />
    </div>

    <div class="mb-6 flex justify-center">
      <div
        class="bg-muted inline-flex rounded-xl p-1"
        id="pricing-modal-toggle"
      >
        <button
          type="button"
          data-modal-period="monthly"
          class="bg-card text-foreground rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition-all"
          >Mensual</button
        >
        <button
          type="button"
          data-modal-period="yearly"
          class="text-muted-foreground rounded-lg px-4 py-2 text-sm font-semibold transition-all"
          >Anual <span class="text-success text-xs font-bold">-20%</span
          ></button
        >
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        plans.map((plan) => {
          const isCurrent = plan.id === currentTier;
          const isFree = plan.id === "free";

          let buttonLabel = "Suscribirse";
          if (isCurrent) buttonLabel = "Plan actual";
          else if (plan.id === "pro" && currentTier === "basic")
            buttonLabel = "Actualizar a Pro";
          else if (plan.id === "basic" && currentTier === "pro")
            buttonLabel = "Cambiar a Basic";
          else if (plan.id === "free") buttonLabel = "Plan actual";

          return (
            <Card
              padding="md"
              class:list={[
                "flex flex-col",
                plan.id === "pro"
                  ? "border-accent-300 ring-accent-200 ring-1"
                  : "",
              ]}
            >
              {plan.badge && (
                <Badge
                  variant="tier"
                  color={plan.id === "pro" ? "accent" : "success"}
                  class="mb-3 self-start"
                >
                  {plan.badge.text}
                </Badge>
              )}

              <h3 class="text-foreground text-lg font-black">{plan.name}</h3>
              <p class="text-muted-foreground mt-1 text-sm">
                {plan.description}
              </p>

              <div class="mt-3">
                <div data-modal-price data-plan={plan.id}>
                  <div data-modal-price-view="monthly">
                    {isFree ? (
                      <p class="text-foreground text-2xl font-black">Gratis</p>
                    ) : (
                      <>
                        <p class="text-foreground text-2xl font-black whitespace-nowrap">
                          {plan.currency}{" "}
                          <span class="font-mono tabular-nums">
                            {plan.monthlyDisplay}
                          </span>
                          <span class="text-subtle-foreground text-sm font-semibold">
                            /mes
                          </span>
                        </p>
                        <p class="text-subtle-foreground mt-0.5 text-xs">
                          Facturado mensualmente
                        </p>
                      </>
                    )}
                  </div>
                  <div data-modal-price-view="yearly" class="hidden">
                    {!isFree ? (
                      <>
                        <p class="text-foreground text-2xl font-black whitespace-nowrap">
                          {plan.currency}{" "}
                          <span class="font-mono tabular-nums">
                            {plan.yearlyPerMonthDisplay}
                          </span>
                          <span class="text-subtle-foreground text-sm font-semibold">
                            /mes
                          </span>
                        </p>
                        <p class="text-subtle-foreground mt-0.5 text-xs">
                          {plan.currency}{" "}
                          <span class="font-mono tabular-nums">
                            {plan.yearlyDisplay}
                          </span>{" "}
                          facturados anualmente
                        </p>
                      </>
                    ) : (
                      <p class="text-foreground text-2xl font-black">Gratis</p>
                    )}
                  </div>
                </div>
              </div>

              <div class="mt-4">
                <Button
                  variant={plan.id === "pro" ? "primary" : "secondary"}
                  size="sm"
                  data-subscribe-btn
                  data-plan={plan.id}
                  data-plan-name={plan.name}
                  data-price-id-monthly={plan.monthlyPriceId ?? ""}
                  data-price-id-yearly={plan.yearlyPriceId ?? ""}
                  data-monthly-display={plan.monthlyDisplay ?? ""}
                  data-yearly-display={plan.yearlyDisplay ?? ""}
                  data-current-tier={currentTier}
                  data-current-interval={currentInterval}
                  data-current-period-end={currentPeriodEndFormatted || ""}
                  disabled={isCurrent || isFree}
                  class="w-full"
                >
                  {buttonLabel}
                </Button>
              </div>

              <div class="mt-4 flex-1 space-y-2">
                {plan.features.map((feature) => {
                  const isComingSoon = feature.status === "coming_soon";
                  const icon = isComingSoon
                    ? "lucide:clock"
                    : feature.included
                      ? "lucide:check"
                      : "lucide:x";
                  const iconClass = isComingSoon
                    ? "text-subtle-foreground"
                    : feature.included
                      ? "text-success"
                      : "text-subtle-foreground";
                  const textClass = isComingSoon
                    ? "text-subtle-foreground"
                    : feature.included
                      ? "text-secondary-foreground"
                      : "text-subtle-foreground";
                  return (
                    <div class="flex items-center gap-2 text-sm">
                      <Icon name={icon} size={14} class:list={[iconClass]} />
                      <span class:list={[textClass]}>{feature.text}</span>
                    </div>
                  );
                })}
              </div>
            </Card>
          );
        })
      }
    </div>

    <div
      id="pricing-modal-error"
      class="border-danger-border bg-danger-bg text-danger mt-4 hidden rounded-xl border p-3 text-sm font-semibold"
      role="alert"
    >
      <p id="pricing-modal-error-msg"></p>
    </div>
  </div>
</dialog>

<ConfirmPlanChangeModal />

<script>
  import { bindDialogBackdrop } from "@/lib/dialog";

  function checkIsUpgrade(
    currentTier: string,
    currentInterval: string,
    targetTier: string,
    targetInterval: string,
  ): boolean {
    const curTier = currentTier || "free";
    const tarTier = targetTier || "free";
    const curInt = currentInterval || "monthly";
    const tarInt = targetInterval || "monthly";

    if (curInt === "monthly" && tarInt === "yearly") {
      return true;
    }

    if (curInt === "yearly" && tarInt === "monthly") {
      return false;
    }

    const TIER_RANKS: Record<string, number> = { free: 0, basic: 1, pro: 2 };
    const curRank = TIER_RANKS[curTier] ?? 0;
    const tarRank = TIER_RANKS[tarTier] ?? 0;

    return tarRank > curRank;
  }

  function setupPricingModal() {
    const modal = document.getElementById("pricing-modal");
    const openBtns = document.querySelectorAll("[data-open-pricing-modal]");
    const closeBtns = document.querySelectorAll("[data-close-pricing-modal]");
    const confirmDialog = document.getElementById("confirm-plan-change-dialog");
    const confirmBtn = document.getElementById("confirm-plan-change-btn");
    const closeConfirmBtns = document.querySelectorAll("[data-close-confirm-modal]");

    if (!(modal instanceof HTMLDialogElement)) return;

    let activePeriod: "monthly" | "yearly" = "monthly";
    let pendingCheckoutPayload: { priceId: string; successUrl: string; cancelUrl: string } | null = null;
    let pendingSubscribeBtn: HTMLButtonElement | null = null;

    const toggle = document.getElementById("pricing-modal-toggle");

    function updateToggleUI() {
      if (!toggle) return;
      const monthlyBtn = toggle.querySelector('[data-modal-period="monthly"]');
      const yearlyBtn = toggle.querySelector('[data-modal-period="yearly"]');
      if (
        !(monthlyBtn instanceof HTMLButtonElement) ||
        !(yearlyBtn instanceof HTMLButtonElement)
      )
        return;

      if (activePeriod === "monthly") {
        monthlyBtn.className =
          "px-4 py-2 rounded-lg text-sm font-semibold bg-card text-foreground shadow-sm transition-all";
        yearlyBtn.className =
          "px-4 py-2 rounded-lg text-sm font-semibold text-muted-foreground transition-all";
      } else {
        yearlyBtn.className =
          "px-4 py-2 rounded-lg text-sm font-semibold bg-card text-foreground shadow-sm transition-all";
        monthlyBtn.className =
          "px-4 py-2 rounded-lg text-sm font-semibold text-muted-foreground transition-all";
      }

      document.querySelectorAll("[data-modal-price-view]").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        if (el.dataset.modalPriceView === activePeriod) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      });

      document.querySelectorAll("#pricing-modal [data-subscribe-btn]").forEach((btn) => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const plan = btn.dataset.plan;
        if (plan === "free") {
          btn.disabled = true;
          btn.textContent = "Plan actual";
          return;
        }

        const currentTier = btn.dataset.currentTier || "free";
        const currentInterval = btn.dataset.currentInterval || "monthly";
        const targetPlan = plan || "free";
        const isSamePlan = currentTier === targetPlan && currentInterval === activePeriod;
        const isUpgradePlan = checkIsUpgrade(currentTier, currentInterval, targetPlan, activePeriod);

        if (isSamePlan) {
          btn.disabled = true;
          btn.textContent = "Plan actual";
        } else if (isUpgradePlan) {
          btn.disabled = false;
          btn.textContent = plan === "pro" ? "Actualizar a Pro" : "Actualizar a Basic";
        } else {
          btn.disabled = false;
          btn.textContent = plan === "pro" ? "Cambiar a Pro Mensual" : "Cambiar a Basic";
        }
      });
    }

    toggle
      ?.querySelector('[data-modal-period="monthly"]')
      ?.addEventListener("click", () => {
        activePeriod = "monthly";
        updateToggleUI();
      });

    toggle
      ?.querySelector('[data-modal-period="yearly"]')
      ?.addEventListener("click", () => {
        activePeriod = "yearly";
        updateToggleUI();
      });

    openBtns.forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.pricingModalBound === "1") return;
      btn.dataset.pricingModalBound = "1";
      btn.addEventListener("click", () => {
        activePeriod = "monthly";
        updateToggleUI();
        if (!modal.open) modal.showModal();
      });
    });

    closeBtns.forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.pricingModalCloseBound === "1") return;
      btn.dataset.pricingModalCloseBound = "1";
      btn.addEventListener("click", () => {
        if (
          modal.dataset.submitting === "1" ||
          modal.getAttribute("aria-busy") === "true"
        ) {
          return;
        }
        if (modal.open) modal.close();
      });
    });

    closeConfirmBtns.forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.confirmCloseBound === "1") return;
      btn.dataset.confirmCloseBound = "1";
      btn.addEventListener("click", () => {
        if (
          confirmDialog instanceof HTMLDialogElement &&
          (confirmDialog.dataset.submitting === "1" ||
            confirmDialog.getAttribute("aria-busy") === "true")
        ) {
          return;
        }
        if (confirmDialog instanceof HTMLDialogElement && confirmDialog.open) {
          confirmDialog.close();
        }
      });
    });

    bindDialogBackdrop(modal);
    if (confirmDialog instanceof HTMLDialogElement) {
      bindDialogBackdrop(confirmDialog);
    }

    document
      .querySelectorAll("#pricing-modal [data-subscribe-btn]")
      .forEach((btn) => {
        if (!(btn instanceof HTMLButtonElement)) return;
        if (btn.dataset.subscribeBound === "1") return;
        btn.dataset.subscribeBound = "1";

        btn.addEventListener("click", async () => {
          if (btn.disabled) return;

          const plan = btn.dataset.plan;
          if (plan === "free") return;

          const priceId =
            activePeriod === "monthly"
              ? btn.dataset.priceIdMonthly
              : btn.dataset.priceIdYearly;

          if (!priceId) {
            alert("Precio no configurado para este plan.");
            return;
          }

          const successUrl = `${window.location.origin}/settings?tab=billing&success=1`;
          const cancelUrl = `${window.location.origin}/settings?tab=billing&canceled=1`;

          const currentTier = btn.dataset.currentTier || "free";
          const currentInterval = btn.dataset.currentInterval || "monthly";
          const targetPlan = plan || "free";

          if (confirmDialog instanceof HTMLDialogElement) {
            const currentPlanNameEl = document.getElementById("confirm-current-plan-name");
            const targetPlanNameEl = document.getElementById("confirm-target-plan-name");
            const container = document.getElementById("confirm-change-type-container");
            const titleEl = document.getElementById("confirm-change-type-title");
            const descEl = document.getElementById("confirm-change-type-desc");
            const detailsEl = document.getElementById("confirm-charge-details");
            const errorEl = document.getElementById("confirm-modal-error");

            if (errorEl) errorEl.classList.add("hidden");

            const isUpgrade = checkIsUpgrade(
              currentTier,
              currentInterval,
              targetPlan,
              activePeriod,
            );
            const targetPlanName = `${btn.dataset.planName || "KitchCalc"} ${activePeriod === "yearly" ? "Anual" : "Mensual"}`;
            const currentPlanName = `${currentTier.toUpperCase()} ${currentInterval === "yearly" ? "Anual" : "Mensual"}`;
            const effectiveDate = btn.dataset.currentPeriodEnd || "el final del periodo actual";

            if (currentPlanNameEl) currentPlanNameEl.textContent = currentPlanName;
            if (targetPlanNameEl) targetPlanNameEl.textContent = targetPlanName;

            if (container && titleEl && descEl && detailsEl) {
              if (isUpgrade) {
                container.className = "rounded-xl p-3 border border-accent-300 bg-accent-50/50 text-accent-700 text-xs space-y-1.5";
                titleEl.textContent = "Cambio inmediato (Upgrade)";
                descEl.textContent = `Tu suscripción se actualizará de forma inmediata al plan ${targetPlanName}. Se aplicará el prorrateo ajustado de tus días restantes.`;
                detailsEl.textContent = "Se procesará el cobro inmediato correspondiente a la actualización en Stripe.";
              } else {
                container.className = "rounded-xl p-3 border border-amber-300 bg-amber-50/50 text-amber-800 text-xs space-y-1.5";
                titleEl.textContent = "Cambio programado (Downgrade)";
                descEl.textContent = `Tu plan actual (${currentPlanName}) seguirá activo con todas sus funciones hasta ${effectiveDate}. El nuevo plan (${targetPlanName}) comenzará a partir de esa fecha.`;
                detailsEl.textContent = `No se realizará ningún cobro el día de hoy. El cobro del nuevo plan se aplicará cuando inicie el próximo periodo de facturación (${effectiveDate}).`;
              }
            }

            pendingCheckoutPayload = { priceId, successUrl, cancelUrl };
            pendingSubscribeBtn = btn;
            confirmDialog.showModal();
            return;
          }

          executeCheckout(btn, { priceId, successUrl, cancelUrl });
        });
      });

    if (confirmBtn instanceof HTMLButtonElement) {
      if (confirmBtn.dataset.bound !== "1") {
        confirmBtn.dataset.bound = "1";
        confirmBtn.addEventListener("click", () => {
          if (pendingSubscribeBtn && pendingCheckoutPayload) {
            executeCheckout(pendingSubscribeBtn, pendingCheckoutPayload);
          }
        });
      }
    }

    async function executeCheckout(
      btn: HTMLButtonElement,
      payload: { priceId: string; successUrl: string; cancelUrl: string },
    ) {
      const cancelBtns = confirmDialog?.querySelectorAll("[data-close-confirm-modal]") || [];
      const confirmBtnEl = document.getElementById("confirm-plan-change-btn") as HTMLButtonElement | null;
      const originalConfirmText = confirmBtnEl?.textContent || "Confirmar cambio";

      if (confirmDialog instanceof HTMLDialogElement) {
        confirmDialog.dataset.submitting = "1";
        confirmDialog.setAttribute("aria-busy", "true");
      }
      if (modal instanceof HTMLDialogElement) {
        modal.dataset.submitting = "1";
        modal.setAttribute("aria-busy", "true");
      }

      btn.disabled = true;
      if (confirmBtnEl) {
        confirmBtnEl.disabled = true;
        confirmBtnEl.textContent = "Procesando...";
      }
      cancelBtns.forEach((cBtn) => {
        if (cBtn instanceof HTMLButtonElement) cBtn.disabled = true;
      });

      const errorEl = document.getElementById("confirm-modal-error");
      const errorMsg = document.getElementById("confirm-modal-error-msg");
      if (errorEl) errorEl.classList.add("hidden");

      try {
        const csrfToken = document.cookie
          .split("; ")
          .find((row) => row.startsWith("csrf_token="))
          ?.split("=")[1];

        const headers: Record<string, string> = {
          "Content-Type": "application/json",
        };
        if (csrfToken) headers["x-csrf-token"] = csrfToken;

        const res = await fetch("/api/stripe/checkout", {
          method: "POST",
          headers,
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || "No se pudo procesar el cambio de plan");
        }

        if (data.url) {
          window.location.href = data.url;
        } else {
          if (confirmDialog instanceof HTMLDialogElement && confirmDialog.open) {
            delete confirmDialog.dataset.submitting;
            confirmDialog.removeAttribute("aria-busy");
            confirmDialog.close();
          }
          if (modal instanceof HTMLDialogElement && modal.open) {
            delete modal.dataset.submitting;
            modal.removeAttribute("aria-busy");
            modal.close();
          }
          window.location.href = `${window.location.origin}/settings?tab=billing&success=1`;
        }
      } catch (err) {
        if (confirmDialog instanceof HTMLDialogElement) {
          delete confirmDialog.dataset.submitting;
          confirmDialog.removeAttribute("aria-busy");
        }
        if (modal instanceof HTMLDialogElement) {
          delete modal.dataset.submitting;
          modal.removeAttribute("aria-busy");
        }

        btn.disabled = false;
        if (confirmBtnEl) {
          confirmBtnEl.disabled = false;
          confirmBtnEl.textContent = originalConfirmText;
        }
        cancelBtns.forEach((cBtn) => {
          if (cBtn instanceof HTMLButtonElement) cBtn.disabled = false;
        });

        if (errorEl && errorMsg) {
          errorMsg.textContent =
            err instanceof Error ? err.message : "No se pudo iniciar el cambio de plan";
          errorEl.classList.remove("hidden");
        }
      }
    }
  }

  document.addEventListener("astro:page-load", setupPricingModal);
  document.addEventListener("astro:after-swap", setupPricingModal);
  setupPricingModal();
</script>
