---
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
---

<dialog
  data-animated
  id="confirm-plan-change-dialog"
  class="backdrop:bg-backdrop/50 fixed inset-0 m-auto max-h-[90dvh] w-[calc(100vw-2rem)] max-w-md rounded-3xl p-0 shadow-2xl"
>
  <div class="bg-card border-border max-h-[90dvh] overflow-auto rounded-3xl border p-6 space-y-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-foreground text-xl font-black">Confirmar cambio de plan</h3>
        <p class="text-subtle-foreground mt-0.5 text-xs">Revisa los detalles antes de continuar</p>
      </div>
      <Button
        variant="ghost"
        icon="x"
        data-close-confirm-modal
        ariaLabel="Cerrar"
      />
    </div>

    <div class="rounded-xl border border-border bg-card p-4 space-y-3">
      <div class="flex items-center justify-between text-xs text-subtle-foreground">
        <span>Plan actual</span>
        <span id="confirm-current-plan-name" class="font-semibold text-foreground"></span>
      </div>
      <div class="flex items-center justify-between text-xs text-subtle-foreground">
        <span>Nuevo plan</span>
        <span id="confirm-target-plan-name" class="font-bold text-accent-600"></span>
      </div>
    </div>

    <div id="confirm-change-type-container" class="rounded-xl p-3 border text-xs space-y-1.5">
      <div class="flex items-center gap-2 font-bold">
        <Icon name="lucide:info" size={16} class="shrink-0" />
        <span id="confirm-change-type-title"></span>
      </div>
      <p id="confirm-change-type-desc" class="text-subtle-foreground leading-relaxed"></p>
    </div>

    <div class="rounded-xl border border-border bg-muted/40 p-3 text-xs space-y-1">
      <p class="font-semibold text-foreground">Cobro y Facturación</p>
      <p id="confirm-charge-details" class="text-subtle-foreground leading-relaxed"></p>
    </div>

    <div
      id="confirm-modal-error"
      class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-400 space-y-1"
    >
      <p class="font-bold">Error al procesar el cambio</p>
      <p id="confirm-modal-error-msg" class="leading-relaxed"></p>
    </div>

    <div class="flex justify-end gap-3 pt-2">
      <Button variant="secondary" size="sm" data-close-confirm-modal>
        Cancelar
      </Button>
      <Button variant="primary" size="sm" id="confirm-plan-change-btn">
        Confirmar cambio
      </Button>
    </div>
  </div>
</dialog>
