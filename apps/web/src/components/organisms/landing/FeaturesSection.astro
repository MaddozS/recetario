---
import { ZoomIn, X } from "@lucide/astro";

const features = [
  {
    icon: "lucide:calculator",
    title: "Costeo con márgenes",
    description:
      "Calcula el costo real de cada receta con ingredientes, márgenes y precios de venta sugeridos automáticamente.",
    imageLight: "/receta_light.webp",
    imageDark: "/receta_dark.webp",
  },
  {
    icon: "lucide:package-search",
    title: "Gestión de ingredientes",
    description:
      "Administra tu inventario de ingredientes con precios actualizados, unidades y stock disponible.",
    imageLight: "/ingredientes_light.webp",
    imageDark: "/ingredientes_dark.webp",
  },
  {
    icon: "lucide:trending-up",
    title: "Planificador de producción",
    description:
      "Planifica tu producción con multiplicadores de batch, costos por unidad y proyecciones de rentabilidad.",
    imageLight: "/produccion_light.webp",
    imageDark: "/produccion_dark.webp",
  },
];
---

<section
  id="features"
  class="bg-background scroll-mt-16 py-24 md:py-32"
  style="content-visibility: auto; contain-intrinsic-size: 800px"
>
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2
        class="landing-heading text-foreground text-3xl font-black md:text-4xl"
      >
        Todo lo que necesitas para costear
      </h2>
      <p class="text-muted-foreground mt-4 text-lg">
        Desde el costo de cada ingrediente hasta el precio final al público,
        KitchCalc cubre cada etapa.
      </p>
    </div>

    <div class="mt-12 space-y-12 sm:mt-20 sm:space-y-20 md:space-y-28">
      {
        features.map((f, i) => {
          const isEven = i % 2 === 0;
          return (
            <div
              class="grid items-center gap-10 md:grid-cols-2 md:gap-16"
              data-reveal={isEven ? "left" : "right"}
            >
              <div class={isEven ? "md:order-1" : "md:order-2"}>
                <div class="mx-auto max-w-lg">
                  <h3 class="text-foreground text-2xl font-bold">{f.title}</h3>
                  <p class="text-muted-foreground mt-3 text-base leading-relaxed">
                    {f.description}
                  </p>
                </div>
              </div>
              <div class={isEven ? "md:order-2" : "md:order-1"}>
                <div class="mx-auto w-full max-w-md">
                  <button
                    type="button"
                    data-lightbox-trigger
                    data-light-src={f.imageLight}
                    data-dark-src={f.imageDark}
                    class="group/lightbox w-full cursor-pointer text-left"
                    aria-label={`Ampliar imagen de ${f.title}`}
                  >
                    <img
                      src={f.imageLight}
                      data-light-src={f.imageLight}
                      data-dark-src={f.imageDark}
                      alt={`Pantalla de la funcionalidad de ${f.title} en KitchCalc`}
                      class="shadow-accent-tint border-border/50 group-hover/lightbox:shadow-accent-300/20 theme-aware-img h-auto w-full rounded-2xl border transition-shadow duration-200 group-hover/lightbox:shadow-lg"
                      loading="lazy"
                      decoding="async"
                      width="800"
                      height="600"
                    />
                    <span class="text-muted-foreground/60 mt-1.5 flex items-center gap-1.5 text-xs transition-opacity group-hover/lightbox:opacity-100 md:opacity-0">
                      <ZoomIn size={14} />
                      Click para ampliar
                    </span>
                  </button>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<dialog
  data-lightbox
  class="backdrop:bg-backdrop/50 border-none bg-transparent p-0 open:grid open:h-dvh open:w-screen open:place-items-center"
>
  <div class="relative">
    <img
      data-lightbox-img
      class="border-border/30 block h-auto max-h-[85dvh] w-auto max-w-[90vw] rounded-2xl border object-contain shadow-2xl"
      alt=""
    />
  </div>
  <button
    type="button"
    data-lightbox-close
    class="text-muted-foreground hover:text-foreground bg-background/80 hover:bg-background fixed top-4 right-4 z-20 flex min-h-10 min-w-10 cursor-pointer items-center justify-center rounded-full backdrop-blur-sm transition-colors"
    aria-label="Cerrar"
  >
    <X size={22} />
  </button>
</dialog>

<style>
  [data-lightbox]::backdrop {
    backdrop-filter: blur(4px);
    animation: backdropIn 200ms var(--ease-out);
  }

  [data-lightbox].closing::backdrop {
    animation: backdropOut 150ms var(--ease-in);
  }

  [data-lightbox][open] > div:first-child {
    animation: lightboxIn 200ms var(--ease-out);
  }

  [data-lightbox].closing > div:first-child {
    animation: lightboxOut 150ms var(--ease-in);
  }

  @keyframes lightboxIn {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes lightboxOut {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(0.92);
    }
  }

  @keyframes backdropIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes backdropOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-lightbox]::backdrop,
    [data-lightbox].closing::backdrop {
      animation: none !important;
    }
    [data-lightbox][open] > div:first-child,
    [data-lightbox].closing > div:first-child {
      animation: none !important;
    }
  }
</style>

<script>
  function setupLightbox() {
    const dialog = document.querySelector(
      "[data-lightbox]",
    ) as HTMLDialogElement | null;
    const img = dialog?.querySelector(
      "[data-lightbox-img]",
    ) as HTMLImageElement | null;
    const closeBtn = dialog?.querySelector(
      "[data-lightbox-close]",
    ) as HTMLButtonElement | null;
    if (!dialog || !img || !closeBtn) return;
    if (dialog.dataset.lightboxBound === "1") return;
    dialog.dataset.lightboxBound = "1";

    const triggers = document.querySelectorAll(
      "[data-lightbox-trigger]",
    ) as NodeListOf<HTMLElement>;

    function closeLightbox() {
      if (!dialog!.open) return;
      dialog!.classList.add("closing");
      setTimeout(() => {
        dialog!.classList.remove("closing");
        dialog!.close();
      }, 150);
    }

    function openLightbox(src: string, alt: string) {
      img!.src = src;
      img!.alt = alt;
      dialog!.showModal();
    }

    triggers.forEach((trigger) => {
      if (trigger.dataset.triggerBound === "1") return;
      trigger.dataset.triggerBound = "1";

      trigger.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark");
        const src = isDark
          ? trigger.getAttribute("data-dark-src")
          : trigger.getAttribute("data-light-src");
        const imgEl = trigger.querySelector("img");
        const alt = imgEl?.getAttribute("alt") ?? "";
        if (src) openLightbox(src, alt);
      });
    });

    closeBtn.addEventListener("click", closeLightbox);

    dialog.addEventListener("click", (e: MouseEvent) => {
      if (e.target === dialog) closeLightbox();
    });
  }

  function setupFeatureThemeImages() {
    const imgs =
      document.querySelectorAll<HTMLImageElement>(".theme-aware-img");
    if (imgs.length === 0) return;

    function updateImages() {
      const isDark = document.documentElement.classList.contains("dark");
      imgs.forEach((img) => {
        const key = isDark ? "darkSrc" : "lightSrc";
        const src = img.dataset[key];
        if (src && img.src !== src) img.src = src;
      });
    }

    updateImages();

    const observer = new MutationObserver(() => updateImages());
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }

  document.addEventListener("astro:page-load", setupLightbox);
  document.addEventListener("astro:after-swap", setupLightbox);
  document.addEventListener("astro:page-load", setupFeatureThemeImages);
  document.addEventListener("astro:after-swap", setupFeatureThemeImages);
  setupLightbox();
  setupFeatureThemeImages();
</script>
