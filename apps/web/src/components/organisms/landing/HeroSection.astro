---
import Button from "../ui/Button.astro";

---

<section
  data-landing-hero
  data-reveal
  class="hero-bg relative grid min-h-[calc(100dvh-1px)] overflow-hidden sm:min-h-dvh"
>
  <div
    aria-hidden="true"
    class="hero-pattern pointer-events-none absolute inset-0"
  >
  </div>
  <div
    class="relative z-10 mx-auto w-full max-w-7xl place-self-center px-6 py-16 sm:py-20 md:py-24 lg:py-28 xl:py-32 2xl:py-36"
  >
    <div
      class="grid items-center gap-12 lg:grid-cols-[1fr_auto] lg:gap-16 xl:gap-20 2xl:gap-24"
    >
      <div class="text-center lg:text-left" data-reveal-parent>
        <h1
          class="landing-heading text-foreground reveal-item leading-[1.05] font-black tracking-[-0.03em] sm:leading-[0.95]"
          style="--reveal-delay: 0ms; font-size: clamp(2.5rem, 7vw, 5.5rem)"
        >
          Calcula el costo real
          <span class="text-accent-600"> de tus recetas</span>
        </h1>
        <p
          class="text-secondary-foreground landing-heading reveal-item mx-auto mt-5 max-w-lg text-lg leading-relaxed sm:text-xl md:mt-6 lg:mx-0"
          style="--reveal-delay: 100ms"
        >
          KitchCalc te ayuda a calcular costos, márgenes y precios de venta.
          Gestiona ingredientes, stock y producción en un solo lugar.
        </p>
        <div
          class="reveal-item mt-8 flex flex-col items-center gap-4 sm:mt-10 sm:flex-row sm:justify-center sm:gap-5 lg:justify-start"
          style="--reveal-delay: 200ms"
        >
          <Button
            variant="primary"
            icon="arrow-up-circle"
            href="/sign-in"
            class="shadow-accent-tint hover:shadow-xl active:scale-[0.97]"
          >
            Comenzar gratis
          </Button>
          <a
            href="#features"
            class="text-muted-foreground hover:text-foreground relative inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold transition-colors after:absolute after:-bottom-0.5 after:left-0 after:h-px after:w-full after:origin-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 hover:after:origin-left hover:after:scale-x-100"
          >
            Conocer más
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>
        </div>

        <div
          class="reveal-item mt-10 flex justify-center lg:justify-start"
          style="--reveal-delay: 350ms"
        >
          <div
            class="bg-card border-border min-w-60 rounded-2xl border p-5 shadow-sm sm:p-6"
          >
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span
                  class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
                  >Costo base</span
                >
                <span
                  class="text-foreground font-mono text-base font-bold tabular-nums"
                  data-count-up="2.40">$0.00</span
                >
              </div>
              <div class="flex items-center justify-between">
                <span
                  class="text-accent-600/80 text-xs font-semibold tracking-widest uppercase"
                  >Margen 50%</span
                >
                <span
                  class="text-accent-600 font-mono text-base font-bold tabular-nums"
                  data-count-up="1.20">+$0.00</span
                >
              </div>
              <div
                aria-hidden="true"
                class="border-border my-2 border-t border-dashed"
              >
              </div>
              <div class="flex items-center justify-between">
                <span
                  class="text-success text-xs font-semibold tracking-widest uppercase"
                  >Precio venta</span
                >
                <span
                  class="text-success font-mono text-lg font-black tabular-nums"
                  data-count-up="3.60">$0.00</span
                >
              </div>
            </div>
          </div>
        </div>

        <p
          class="text-muted-foreground reveal-item mt-6 text-sm"
          style="--reveal-delay: 400ms"
        >
          Sin tarjeta de crédito. Prueba gratis.
        </p>
      </div>

      <div class="hidden items-center justify-end lg:flex">
        <div
          class="relative"
          data-reveal="scale"
          style="transition-delay: 150ms"
        >
          <div
            class="shadow-accent-tint bg-accent-500/35 absolute -inset-10 rounded-[3rem] blur-3xl"
          >
          </div>
          <img
            src="/kitchcalc_logo.svg"
            alt="KitchCalc"
            class="relative h-72 w-72 drop-shadow-2xl"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupHeroCountUp() {
    const targets = document.querySelectorAll("[data-count-up]");
    if (targets.length === 0) return;

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          const target = entry.target as HTMLElement;
          if (entry.isIntersecting && target.dataset.counted !== "1") {
            target.dataset.counted = "1";
            animateCountUp(target);
          }
        });
      },
      { threshold: 0.6 },
    );

    targets.forEach(function (el) {
      const tel = el as HTMLElement;
      if (tel.dataset.counted !== "1") observer.observe(tel);
    });
  }

  function animateCountUp(el: HTMLElement) {
    const rawValue = el.dataset.countUp || "0";
    const target = parseFloat(rawValue);
    const decimalPlaces = (rawValue.split(".")[1] || "").length;
    const prefix = el.textContent.startsWith("+$") ? "+$" : "$";

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.textContent = prefix + target.toFixed(decimalPlaces);
      return;
    }

    const duration = 800;
    const start = performance.now();

    function update(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 4);
      const current = target * eased;
      el.textContent = prefix + current.toFixed(decimalPlaces);
      if (progress < 1) {
        requestAnimationFrame(update);
      }
    }

    requestAnimationFrame(update);
  }

  document.addEventListener("astro:page-load", setupHeroCountUp);
  document.addEventListener("astro:after-swap", setupHeroCountUp);
  setupHeroCountUp();
</script>
