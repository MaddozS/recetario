{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@recetario/*": ["../../packages/*/src"],
      "@recetario/config/*": ["../../packages/config/dist/src/*"]
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    ".agent/**",
    ".astro/**",
    "node_modules/**",
    "../../packages/**/node_modules",
    "../../packages/**/dist"
  ]
}
