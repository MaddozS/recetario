{
  "name": "@recetario/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/sync-cloudflare-dev-vars.mjs && nuxt dev --port 4321",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "lint": "eslint .",
    "type-check": "nuxt typecheck",
    "test": "nuxt prepare && vitest run",
    "test:e2e": "nuxt prepare && playwright test",
    "wrangler:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "@recetario/auth": "workspace:^",
    "@recetario/config": "workspace:^",
    "@recetario/stripe": "workspace:^",
    "@recetario/types": "workspace:^",
    "@tailwindcss/vite": "4.3.0",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "25.8.0",
    "@typescript-eslint/parser": "^8.59.3",
    "@vue/test-utils": "^2.5.0",
    "eslint": "10.4.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.12.0",
    "playwright": "^1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.59.3",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.118.0"
  },
  "license": "AGPL-3.0-only"
}
