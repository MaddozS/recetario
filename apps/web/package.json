{
  "name": "@recetario/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/sync-cloudflare-dev-vars.mjs && nuxt dev --port 4321",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "format": "prettier --write .",
    "lint": "eslint .",
    "type-check": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "wrangler:dry-run": "wrangler deploy --dry-run --config wrangler.nuxt.jsonc --outdir .wrangler/dry-run",
    "cloudflare-build": "$npm_execpath --filter @recetario/db exec prisma generate && $npm_execpath --filter @recetario/db exec prisma migrate deploy && astro build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@lucide/astro": "^1.28.0",
    "@lucide/vue": "^1.45.0",
    "@recetario/auth": "workspace:^",
    "@recetario/config": "workspace:^",
    "@recetario/stripe": "workspace:^",
    "@recetario/types": "workspace:^",
    "@tailwindcss/vite": "4.3.0",
    "astro": "7.1.6",
    "dotenv": "17.4.2",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.0.2",
    "@astrojs/ts-plugin": "1.10.10",
    "@eslint/js": "10.0.1",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "25.8.0",
    "@types/pg": "8.20.0",
    "@typescript-eslint/parser": "^8.59.3",
    "@vue/test-utils": "^2.5.0",
    "eslint": "10.4.0",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.12.0",
    "playwright": "^1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.59.3",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.118.0"
  }
}
