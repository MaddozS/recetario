{
  "name": "@recetario/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "format": "prettier --write .",
    "lint": "eslint .",
    "type-check": "astro check",
    "test": "vitest run",
    "cloudflare-build": "$npm_execpath --filter @recetario/db exec prisma generate && $npm_execpath --filter @recetario/db exec prisma migrate deploy && astro build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@lucide/astro": "^1.28.0",
    "@recetario/auth": "workspace:^",
    "@recetario/config": "workspace:^",
    "@recetario/stripe": "workspace:^",
    "@recetario/types": "workspace:^",
    "@tailwindcss/vite": "4.3.0",
    "astro": "7.1.6",
    "dotenv": "17.4.2",
    "tailwindcss": "4.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.0.2",
    "@astrojs/ts-plugin": "1.10.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "25.8.0",
    "@types/pg": "8.20.0",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "10.4.0",
    "eslint-plugin-astro": "1.7.0",
    "playwright": "^1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.59.3",
    "vitest": "^3.0.0",
    "wrangler": "4.118.0"
  }
}
