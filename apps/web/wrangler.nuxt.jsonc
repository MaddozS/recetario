// Temporal hasta la Task 13: permite validar el output Nitro con un dry-run
// (`pnpm --filter @recetario/web wrangler:dry-run`) sin tocar `wrangler.jsonc`,
// que sigue siendo el config de producción del worker Astro.
// Nunca deployar desde acá.
{
  "name": "recetario-web-nuxt",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "services": [
    {
      "binding": "API",
      "service": "recetario-api"
    }
  ]
}
