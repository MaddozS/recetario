# ==============================================================================
# KitchCalc (Recetario) - Variables de Entorno de Ejemplo
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto para desarrollo local:
#   cp .env.example .env
#
# Al ejecutar `pnpm dev`, este archivo se sincroniza automáticamente con
# `apps/web/.dev.vars` y `apps/api/.dev.vars`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL / Neon / Prisma Postgres)
# ------------------------------------------------------------------------------
# URL de conexión a PostgreSQL. En desarrollo puedes usar una base local o Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recetario?schema=public"
# Opcional si usas Neon o connection pooling con conexión directa separada:
# DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/recetario?schema=public"

# ------------------------------------------------------------------------------
# 2. Autenticación (Better Auth en apps/api)
# ------------------------------------------------------------------------------
# Secreto para firmar cookies y tokens (mínimo 32 caracteres aleatorios).
# Puedes generar uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="tu_clave_secreta_aleatoria_de_al_menos_32_caracteres_123456"

# URL pública o interna del API worker donde corre Better Auth
BETTER_AUTH_URL="http://localhost:8787"

# Origen de la aplicación web cliente (para CORS y redirecciones seguras)
WEB_ORIGIN="http://localhost:4321"

# Google OAuth (opcional para desarrollo local; deja vacío si solo usarás email/contraseña)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 3. Facturación y Suscripciones (Stripe)
# ------------------------------------------------------------------------------
# Clave secreta de prueba de Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_tu_stripe_secret_key"

# Secreto de webhook para verificar firmas de eventos Stripe
# En desarrollo local se obtiene con: stripe listen --forward-to localhost:8787/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_tu_webhook_secret_local"

# Identificadores de precios (Price IDs) de Stripe para los planes Free, Basic y Pro:
STRIPE_PRICE_ID_BASIC_MONTHLY="price_basic_monthly_test"
STRIPE_PRICE_ID_BASIC_YEARLY="price_basic_yearly_test"
STRIPE_PRICE_ID_PRO_MONTHLY="price_pro_monthly_test"
STRIPE_PRICE_ID_PRO_YEARLY="price_pro_yearly_test"

# ------------------------------------------------------------------------------
# 4. Servicio de Correo Transaccional (Resend)
# ------------------------------------------------------------------------------
# Clave de API de Resend (https://resend.com) para verificación de email y reseteo de password
RESEND_API_KEY="re_tu_resend_api_key_de_prueba"

# Remitente de los correos salientes
SENDER_EMAIL="KitchCalc <no-reply@resend.dev>"

# ------------------------------------------------------------------------------
# 5. Configuración de Semilla / QA Local (Opcional)
# ------------------------------------------------------------------------------
# ID y correo estático asignado a las recetas e ingredientes de prueba al correr `prisma/seed.ts`
RECIPES_STATIC_OWNER_ID="recetario-local-owner-id"
RECIPES_STATIC_OWNER_EMAIL="qa@example.com"
